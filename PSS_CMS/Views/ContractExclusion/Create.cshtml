@model PSS_CMS.Models.ContractExclusion

@{ ViewData["Title"] = "Contract Exclusion Create";
    ViewBag.PageTitle = "Contract Exclusion Create";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-tools nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">@Session["CT_CUSTOMERNAME"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductList", "Contract")">Contract (@Session["CP_CODE"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "ContractProduct")">@Session["CT_CONTRACTREFERENCENUMBER"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "ContractExclusion")">Contract Exclusion</a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-slash-circle" style="font-size:15px;color:#3C3489;"></i>
            </span>
            New Contract Exclusion
        </h6>
    </div>

    @using (Html.BeginForm("Create", "ContractExclusion", FormMethod.Post, new { id = "createform", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
<div style="padding:24px 20px 8px;">

    <p class="form-section-title">Exclusion Details</p>
    <div class="form-grid" style="margin-bottom:24px;">

        <!-- Description -->
        <div class="form-group">
            @Html.LabelFor(m => m.CEX_DESCRIPTION, new { @class = "form-label" })
            @Html.EditorFor(m => m.CEX_DESCRIPTION, new { htmlAttributes = new { @class = "form-input-text", autocomplete = "off" } })
        </div>

        <!-- Sort Order -->
        <div class="form-group">
            @Html.LabelFor(m => m.CEX_SORTORDER, new { @class = "form-label" })
            @Html.EditorFor(m => m.CEX_SORTORDER, new { htmlAttributes = new { @class = "form-input-num", autocomplete = "off", placeholder = "0" } })
        </div>

        <!-- Exclusion Disable Toggle -->
        <div class="form-group">
            <p class="form-section-title">Settings</p>
            <label class="check-row">
                @Html.CheckBoxFor(m => m.CEX_ExclusionDisable, new { @class = "form-check-input" })
                <div class="check-row-label">
                    <span>Disable Exclusion</span>
                    <small>Exclude this item from active exclusions</small>
                </div>
            </label>
        </div>

    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("List", "ContractExclusion")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>

    </div>

</div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
        <span>Number Field</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Logoutjs.js"></script>

    <script>
        $(document).ready(function () {

            $("#createform").submit(function (e) {
                e.preventDefault();

                $("#savebutton").prop("disabled", true);
                $("body").css("pointer-events", "none");

                $.ajax({
                    url: '@Url.Action("Create", "ContractExclusion")',
                    type: 'POST',
                    data: new FormData(this),
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we save your changes.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });

                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    showCancelButton: true,
                                    confirmButtonText: "Continue",
                                    cancelButtonText: "Back to List",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: "swal-btn-continue",
                                        cancelButton: "swal-btn-back"
                                    },
                                    didOpen: () => {
                                        $(".swal2-container").css("pointer-events", "auto");
                                    }
                                }).then(function (result) {
                                    if (result.isConfirmed) {
                                        location.reload();
                                    } else {
                                        window.location.href = '@Url.Action("List", "ContractExclusion")';
                                    }
                                });
                            }, 1000);

                        } else {
                            Swal.fire({
                                title: "Message",
                                text: response.message,
                                icon: "info",
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            resetButton();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: "Error!",
                            text: "An unexpected error occurred.",
                            icon: "error",
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        resetButton();
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
