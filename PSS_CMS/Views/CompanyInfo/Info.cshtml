@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // ── Tab switching ──────────────────────────────────────────
        function switchTab(btn) {
            var targetId = btn.getAttribute('data-tab');

            document.querySelectorAll('.tab-btn').forEach(function (b) {
                b.classList.remove('active');
            });
            document.querySelectorAll('.tab-panel').forEach(function (p) {
                p.classList.remove('active');
            });

            btn.classList.add('active');
            document.getElementById(targetId).classList.add('active');
        }

        // ── Report image previews ─────────────────────────────────────
        function previewImage(inputId, previewId) {

            var input = document.getElementById(inputId);
            var preview = document.getElementById(previewId);

            if (!input || !preview) {
                return;
            }

            if (input.files && input.files.length > 0) {

                var file = input.files[0];

                if (!file.type.startsWith("image/")) {
                    alert("Please select an image file.");
                    input.value = "";
                    return;
                }

                var reader = new FileReader();

                reader.onload = function (e) {

                    preview.src = e.target.result;
                    preview.style.display = "block";

                    var placeholder =
                        preview.parentElement.querySelector(
                            ".ci-img-preview__placeholder"
                        );

                    if (placeholder) {
                        placeholder.style.display = "none";
                    }
                };

                reader.readAsDataURL(file);
            }
        }

        function showLabels() {
            // Hook for updating file-name labels next to upload buttons if needed.
        }

        // ── File picker ────────────────────────────────────────────
        function handleFileChange(input) {
            if (!input.files || !input.files[0]) return;

            var file  = input.files[0];
            document.getElementById('fileNameLabel').textContent = file.name;

            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.getElementById('logoPreview');
                img.src          = e.target.result;
                img.style.display = 'block';

                var ph = document.querySelector('.logo-placeholder');
                if (ph) ph.style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        // ── AJAX submit ────────────────────────────────────────────
function submitLogo() {

    var btn = document.getElementById('saveButton');
    var btnText = document.getElementById('saveButtonText');
    btn.disabled = true;
    btnText.textContent = "Saving...";

    var formData = new FormData(
        document.getElementById('logoForm')
    );

    $.ajax({
        url: '@Url.Action("UpdateLogo", "CompanyInfo")',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        dataType: 'json',

        success: function (res) {

            console.log("API Response:", res);

            // =========================
            // ERROR / INFORMATION
            // =========================
            if (res.status === "error") {

                Swal.fire({
                    icon: "info",
                    title: "Information",
                    text: res.message,
                    confirmButtonText: "Ok",
                    confirmButtonColor: "#6c5ce7",
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });

                return;
            }

            // =========================
            // SUCCESS
            // =========================
            if (res.status === "success") {

                Swal.fire({
                    icon: "success",
                    title: "Success!",
                    text: res.message,
                    confirmButtonText: "Ok",
                    confirmButtonColor: "#6c5ce7",
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then(function () {

                    window.location.href =
                        '@Url.Action("Info", "CompanyInfo")';

                });

                return;
            }

            // =========================
            // UNKNOWN RESPONSE
            // =========================
            Swal.fire({
                icon: "info",
                title: "Information",
                text: res.message || "Unable to update company logo.",
                confirmButtonText: "Ok",
                confirmButtonColor: "#6c5ce7",
                allowOutsideClick: false,
                allowEscapeKey: false
            });
        },

        // =========================
        // AJAX ERROR
        // =========================
        error: function (xhr) {

            console.log("AJAX Error:", xhr);
            console.log("Response:", xhr.responseText);

            var message = "An unexpected error occurred.";

            if (xhr.responseJSON &&
                xhr.responseJSON.message) {

                message = xhr.responseJSON.message;
            }

            Swal.fire({
                icon: "info",
                title: "Information",
                text: message,
                confirmButtonText: "Ok",
                confirmButtonColor: "#6c5ce7",
                allowOutsideClick: false,
                allowEscapeKey: false
            });
        },

        // =========================
        // COMPLETE
        // =========================
        complete: function () {

            btn.disabled = false;

            $('body').css(
                'pointer-events',
                'auto'
            );
        }
    });
}

