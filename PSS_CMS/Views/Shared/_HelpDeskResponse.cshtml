@model PSS_CMS.Models.Ticket

<style>
    /* ── Response card ──────────────────────────── */
    .response-card {
        background: #fff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .response-card-header {
        display: flex;
        align-items: center;
        padding: 13px 18px;
        border-bottom: 1px solid var(--border-color);
        background: #E1F5EE;
        border-left: 4px solid #1D9E75;
    }

    .response-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 600;
        color: #085041;
    }

        .response-title i {
            font-size: 16px;
        }

    .response-card-body {
        padding: 20px 18px 8px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .res-form-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .res-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
    }

        .res-label .req {
            color: #E24B4A;
            margin-left: 2px;
        }

    .res-textarea {
        border: 1px solid var(--border-color);
        border-left: 3px solid #1D9E75;
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 13px;
        color: var(--text-dark);
        background: #fff;
        outline: none;
        font-family: inherit;
        width: 100%;
        resize: vertical;
        min-height: 140px;
        line-height: 1.65;
        transition: border-color .15s, box-shadow .15s;
    }

        .res-textarea:focus {
            border-color: #1D9E75;
            box-shadow: 0 0 0 3px rgba(29,158,117,.08);
        }

    /* ── File upload ────────────────────────────── */
    #res-fileError {
        font-size: 11px;
        color: #E24B4A;
        margin-top: 4px;
        display: none;
    }

    /* ── Footer actions ─────────────────────────── */
    .response-card-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 8px;
        padding: 14px 18px;
        border-top: 1px solid var(--border-color);
        background: var(--body-bg);
        flex-wrap: wrap;
    }
</style>

@using (Html.BeginForm("ClientResponseTicket", "HelpDesk", FormMethod.Post, new { id = "ticketForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
@Html.AntiForgeryToken()

                <div class="response-card">

                    <!-- Header -->
                    <div class="response-card-header">
                        <div class="response-title">
                            <i class="bi bi-reply-fill"></i>
                            Your Response
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="response-card-body">

                        <!-- Comments -->
                        <div class="res-form-group">
                            <label class="res-label">
                                @Html.LabelFor(m => m.TC_COMMENTS, "User Comments")
                                <span class="req">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.TC_COMMENTS, new
                            {
                                @class = "res-textarea",
                                placeholder = "Please enter your comments here....",
                                rows = "6",
                                required = "required"
                            })
                        </div>

                        <!-- Attachment -->
                        <div class="res-form-group">
                            <label class="res-label">Attachments</label>
                            <div class="file-upload-wrap">
                                <div class="file-upload-icon">
                                    <i class="bi bi-paperclip"></i>
                                </div>
                                <div class="file-upload-text">
                                    <span id="res-fileNameDisplay">Choose file to attach</span>
                                    <small>Supported: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv, .mp4</small>
                                </div>
                                <label class="btn-browse" for="myfile">
                                    <i class="bi bi-folder2-open"></i> Browse
                                </label>
                                <input type="file" id="myfile" name="myfile"
                                       class="file-input-hidden"
                                       accept=".pdf,.xlsx,.jpeg,.png,.jpg,.docx,.csv,.mp4"
                                       onchange="validateFile()" />
                            </div>
                            <small id="res-fileError">
                                This file format is not supported. Allowed: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv, .mp4
                            </small>
                        </div>

                    </div>

                    <!-- Footer actions -->
                    <div class="response-card-footer">
                        <button type="button" class="btn-cancel"
                                onclick="window.location.href='@Url.Action("Ticket_History","HelpDesk")'">
                            <i class="bi bi-x-lg"></i> Cancel
                        </button>
                        <button type="submit" id="submitBtn" class="btn-save">
                            <i class="bi bi-send"></i> Submit
                        </button>

                    </div>

                </div>}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/Formatcheck.js"></script>

<script>
    // Show selected filename
    document.getElementById("myfile").addEventListener("change", function () {
        var name = this.files.length ? this.files[0].name : "Choose file to attach";
        document.getElementById("res-fileNameDisplay").textContent = name;
    });

    $(document).ready(function () {

        $("#ticketForm").submit(function (e) {
            e.preventDefault();

            var submitBtn = $("#submitBtn");
            submitBtn.prop("disabled", true).html('<i class="bi bi-hourglass-split"></i> Submitting...');

            Swal.fire({
                title: "Processing...",
                text: "Please wait while we submit your response.",
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("ClientResponseTicket","HelpDesk")',
                type: "POST",
                data: new FormData(this),
                processData: false,
                contentType: false,
                success: function (response) {
                    Swal.close();

                    if (response.status === "Y") {
                        Swal.fire({
                            title: "Success!",
                            text: response.message,
                            icon: "success",
                            confirmButtonText: "OK"
                        }).then(function () {
                            window.location.href = '@Url.Action("Ticket_History","HelpDesk")';
                        });
                    } else {
                        Swal.fire({
                            title: "Error!",
                            text: response.message,
                            icon: "error",
                            confirmButtonText: "OK"
                        });
                        submitBtn.prop("disabled", false).html('<i class="bi bi-send"></i> Submit');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({
                        title: "Error!",
                        text: "Something went wrong. Please try again.",
                        icon: "error",
                        confirmButtonText: "OK"
                    });
                    submitBtn.prop("disabled", false).html('<i class="bi bi-send"></i> Submit');
                }
            });
        });
    });
</script>
