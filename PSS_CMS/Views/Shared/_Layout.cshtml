<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Box Icons -->
    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>
    <!-- Google Font: DM Sans -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Side bar and Top bar Css -->
    <link href="~/Content/UISidebarLayout.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- ═══════════════════════════════════
         PRELOADER
    ═══════════════════════════════════ -->
    <div id="preloader">
        <div class="pre-spinner">
            <div class="pre-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
        </div>
       
    </div>
    <!-- Sidebar Backdrop (mobile) -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <!-- ─── SIDEBAR ─── -->
    <nav id="sidebar">
        <!-- Brand / Logo -->
            <a class="sidebar-brand">
                @if (Session["Logo"] != null)
                {
                    <img src="data:image/png;base64,@Session["Logo"]" alt="Logo" class="brand-logo" /> 
                }
                else
                {
                    <div class="brand-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
                }
                <span class="brand-text">TICKET SYSTEM</span>
            </a>
 
            <div class="sidebar-scroll">

                <!-- OVERVIEW -->
                <div class="nav-section-label">Overview</div>
                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "sa")
                {


                    <a href="@Url.Action("SuperAdminCountDashboard", "DashBoard")" class="nav-item-link">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }
                else if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "accountant")
                {


                    <a href="@Url.Action("ContractDashboard", "Contract")" class="nav-item-link">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }
                else if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "user")
                {


                    <a href="@Url.Action("UserDashboardCount", "UserDashboard")" class="nav-item-link">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }
                else if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "helpdesk")
                {


                    <a href="@Url.Action("HDDashboard", "HelpDesk")" class="nav-item-link">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Dashboard", "DashBoard")" class="nav-item-link">
                        <i class="bi bi-house-door-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                }



                <!-- BUSINESS -->
                <div class="nav-section-label">Business</div>

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "user")
                {

                    <a href="@Url.Action("Ticket_History", "Tickets")" class="nav-item-link">
                        <i class="bi-ticket-detailed nav-icon"></i>
                        <span class="nav-label">Service Tickets</span>
                    </a>

                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "helpdesk")
                {
                    <a href="@Url.Action("AddOnCustomerList", "AddonCustomer")" class="nav-item-link">
                        <i class="bi bi-person-plus nav-icon"></i>
                        <span class="nav-label">Customer</span>
                    </a>
                    <a href="@Url.Action("Ticket", "HelpDesk")" class="nav-item-link">
                        <i class="bi bi-receipt-cutoff nav-icon"></i>
                        <span class="nav-label">Create Ticket</span>
                    </a>
                    <a href="@Url.Action("SalesheaderList", "HelpdeskSalesInvoice")" class="nav-item-link">
                        <i class="bi bi-receipt-cutoff nav-icon"></i>
                        <span class="nav-label">Sales Invoice</span>
                    </a>
                    <a href="@Url.Action("Ticket_History", "HelpDesk")" class="nav-item-link">
                        <i class="bi-ticket-detailed nav-icon"></i>
                        <span class="nav-label">Service Tickets</span>
                    </a>



                }


                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "accountant")
                {
                    <a href="@Url.Action("CustomerList", "Contract")" class="nav-item-link">
                        <i class="bi bi-shield-check nav-icon"></i>
                        <span class="nav-label">Warranty Products</span>
                    </a>

                    <a href="@Url.Action("SalesheaderList", "AccountantCustomerInvoice")" class="nav-item-link">
                        <i class="bi bi-receipt-cutoff nav-icon"></i>
                        <span class="nav-label">Sales Invoice</span>
                    </a>

                    <a href="@Url.Action("ContractList", "Contract")" class="nav-item-link">
                        <i class="bi bi-file-earmark-text nav-icon"></i>
                        <span class="nav-label">Service Contract</span>
                    </a>

                    <a href="@Url.Action("Index", "ServiceInvoice")" class="nav-item-link">
                        <i class="bi bi-tools nav-icon"></i>
                        <span class="nav-label">Service Invoice</span>
                    </a>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "accountant" &&
                     Session["UserRole"].ToString().ToLower() != "user"

                    )
                {
                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "sa" && Session["UserRole"].ToString().ToLower() != "helpdesk")
                    {
                        <a href="@Url.Action("RecentTicket", "RecentTickets")" class="nav-item-link">
                            <i class="bi-ticket-detailed nav-icon"></i>
                            <span class="nav-label">Service Requests</span>
                        </a>
                    }


                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "admin" && Session["UserRole"].ToString().ToLower() != "helpdesk")
                    {
                        <a href="@Url.Action("List", "ProductMaster")" class="nav-item-link">
                            <i class="bi bi-shield-check nav-icon"></i>
                            <span class="nav-label">Warranty Products</span>
                        </a>
                        <a href="@Url.Action("SalesheaderAdminListView", "AccountantCustomerInvoice")" class="nav-item-link">
                            <i class="bi bi-receipt nav-icon"></i>
                            <span class="nav-label">Sales Invoice</span>
                        </a>
                        <a href="@Url.Action("ContractProductListView", "Contract")" class="nav-item-link">
                            <i class="bi bi-file-earmark-text nav-icon"></i>
                            <span class="nav-label">Service Contract</span>
                        </a>
                    }

                    if ((Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "sa") && (Session["MaterialConsumptionFlag"] != null && Session["MaterialConsumptionFlag"].ToString().ToLower() == "y"))
                    {
                        <a href="@Url.Action("List", "HSNCategory")" class="nav-item-link">
                            <i class="bi bi-grid-3x3 nav-icon"></i>
                            <span class="nav-label">HSN Configuration</span>
                        </a>
                        <a href="@Url.Action("List", "ItemGroup")" class="nav-item-link">
                            <i class="bi bi-cart3 nav-icon"></i>
                            <span class="nav-label">Item Configuration</span>
                        </a>
                    }


                }


                <!-- REPORTS -->


                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "user")
                {
                    <div class="nav-section-label">Reports</div>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "sa" ||
                              Session["UserRole"].ToString().ToLower() == "manager")
                {

                    <a href="@Url.Action("TicketAgeingReportPdf", "RecentTickets")" class="nav-item-link">
                        <i class="bi bi-clock-history nav-icon"></i>
                        <span class="nav-label">Aging Reports</span>
                    </a>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "admin")
                {
                    <a href="@Url.Action("ServiceProductReport", "ContractExpiryReport")" class="nav-item-link">
                        <i class="bi bi-clipboard-data nav-icon"></i>
                        <span class="nav-label">Service Product Report</span>
                    </a>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "admin" ||
                               Session["UserRole"].ToString().ToLower() == "manager")
                {
                    <a href="@Url.Action("PrioritywiseReport", "PriorityWiseReport")" class="nav-item-link">
                        <i class="bi bi-flag nav-icon"></i>
                        <span class="nav-label">Priority Based Reports</span>
                    </a>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "accountant")
                {
                    <a href="@Url.Action("Locklog", "SalesInvoiceProduct")" class="nav-item-link">
                        <i class="bi bi-clipboard-data nav-icon"></i>
                        <span class="nav-label">Data Audit</span>
                    </a>

                    <a href="@Url.Action("ContractExpiryReport", "ContractexpiryReport")" class="nav-item-link">
                        <i class="bi bi-file-earmark-text nav-icon"></i>
                        <span class="nav-label">Contract Expiry Reports</span>
                    </a>
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "helpdesk")
                {
                    <a href="@Url.Action("PrioritywiseReport", "HelpDesk")" class="nav-item-link">
                        <i class="bi bi-flag nav-icon"></i>
                        <span class="nav-label">Priority Based Reports</span>
                    </a>
                }

                <!-- SETTINGS -->
                <div class="nav-section-label">Settings</div>
                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "user" && Session["UserRole"].ToString().ToLower() != "helpdesk")
                {
                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "admin" && Session["UserRole"].ToString().ToLower() != "accountant")
                    {
                        <a href="@Url.Action("List", "UserGroup")" class="nav-item-link">
                            <i class="bi bi-people nav-icon"></i>
                            <span class="nav-label">User Accounts</span>
                        </a>
                    }

                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "accountant")
                    {
                        <a href="@Url.Action("Info", "CompanyInfo")" class="nav-item-link">
                            <i class="bi bi-buildings nav-icon"></i>
                            <span class="nav-label">Company</span>
                        </a>

                    }
                }

                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "user")
                {
                    <a href="@Url.Action("UserChangePassword", "ChangePassword")" class="nav-item-link">
                        <i class="bi bi-file-earmark-lock nav-icon"></i>
                        <span class="nav-label">Change Password</span>
                    </a>
                }
                else if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "helpdesk")
                {
                    <a href="@Url.Action("HelpdeskChangePassword", "ChangePassword")" class="nav-item-link">
                        <i class="bi bi-file-earmark-lock nav-icon"></i>
                        <span class="nav-label">Change Password</span>
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ChangePassword", "ChangePassword")" class="nav-item-link">
                        <i class="bi bi-file-earmark-lock nav-icon"></i>
                        <span class="nav-label">Change Password</span>
                    </a>
                }


                @if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "accountant" && Session["UserRole"].ToString().ToLower() != "helpdesk")
                {
                    <!-- KNOWLEDGE BASED -->
                    <div class="nav-section-label">KNOWLEDGE BASE</div>
                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() == "user")
                    {
                        <a href="@Url.Action("FAQ", "Tickets")" class="nav-item-link">
                            <i class="bi bi-question-circle nav-icon"></i>
                            <span class="nav-label">FAQ</span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("FAQADMIN", "RecentTickets")" class="nav-item-link">
                            <i class="bi bi-question-circle nav-icon"></i>
                            <span class="nav-label">FAQ</span>
                        </a>
                    }


                    if (Session["UserRole"] != null && Session["UserRole"].ToString().ToLower() != "user")
                    {
                        <a href="@Url.Action("Whitepaper", "KnowledgeBased")" class="nav-item-link">
                            <i class="bi bi-file-earmark-text nav-icon"></i>
                            <span class="nav-label">White Paper</span>
                        </a>
                    }

                }

            </div>

        <!-- Logout -->
        <div class="sidebar-footer">
            <a href="@Url.Action("Index", "Login")" class="nav-item-link">
                <i class="bi bi-box-arrow-left nav-icon"></i>
                <span class="nav-label">Logout</span>
            </a>
        </div>
    </nav>

    <!-- ─── MAIN WRAPPER ─── -->
    <div id="main-wrapper">

        <!-- TOPBAR -->
        <header id="topbar">
            <button class="topbar-toggle" onclick="toggleSidebar()" title="Toggle Sidebar">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-page">
                <h1 id="pageTitle">@ViewBag.PageTitle</h1>
                <p id="pageSubtitle">@ViewBag.PageSubtitle</p>
            </div>

            <div class="topbar-actions">
                <!-- User pill -->
                <div class="topbar-user">
                    <div class="user-avatar-initials">
                        @if (Session["UserName"] != null)
                        {@(Session["UserName"].ToString().Length > 0 ? Session["UserName"].ToString().Substring(0, 1).ToUpper() : "U") @(Session["UserName"].ToString().Contains(" ") ? Session["UserName"].ToString().Split(' ')[1].Substring(0, 1).ToUpper() : "") }
                        else
                        {
            @:U
        }
                    </div>
                    <div class="user-info d-none d-sm-block">
                        <div class="user-name"> @(Session["UserName"] != null ? Session["UserName"].ToString() : "User")</div>
                        <div class="user-role"> @(Session["Role"] != null ? Session["Role"].ToString().ToUpper() : "")</div>
                    </div>
                </div>

            </div>
        </header>

        <!-- PAGE CONTENT -->
        <main class="page-content">
            @RenderBody()
        </main>

    </div><!-- /main-wrapper -->
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        /* ══════════════════════════════
           PRELOADER
        ══════════════════════════════ */
        const preloader = document.getElementById('preloader');

        /* ══════════════════════════════
           HIDE LOADER AFTER PAGE LOAD
        ══════════════════════════════ */
        window.addEventListener('load', function () {

            setTimeout(function () {

                preloader.classList.add('hide');

                preloader.addEventListener('transitionend', function () {

                    preloader.style.display = 'none';

                }, { once: true });

            }, 300);

        });

        /* ══════════════════════════════
           FIX BROWSER BACK/FORWARD
        ══════════════════════════════ */
        window.addEventListener('pageshow', function () {

            preloader.classList.add('hide');
            preloader.style.display = 'none';

        });

        /* ══════════════════════════════
           SHOW LOADER ON LINKS / FORMS
        ══════════════════════════════ */
        document.addEventListener('DOMContentLoaded', function () {

            /* LINKS */
            document.querySelectorAll('a[href]').forEach(link => {

                link.addEventListener('click', function () {

                    // IGNORE DELETE POPUP LINKS
                    if (this.classList.contains('no-loader')) {
                        return;
                    }

                    const href = this.getAttribute('href');

                    // Ignore empty/js/anchor links
                    if (
                        !href ||
                        href === '#' ||
                        href.startsWith('javascript') ||
                        href.startsWith('mailto:') ||
                        href.startsWith('tel:') ||
                        this.hasAttribute('target')
                    ) {
                        return;
                    }

                    // Ignore same page navigation
                    const currentPath = window.location.pathname.toLowerCase();
                    const linkPath = new URL(href, window.location.origin)
                        .pathname
                        .toLowerCase();

                    if (currentPath === linkPath) {
                        return;
                    }

                    preloader.classList.remove('hide');
                    preloader.style.display = 'flex';

                });

            });

            /* FORMS */
            document.querySelectorAll('form').forEach(form => {

                form.addEventListener('submit', function () {

                    // Skip AJAX forms
                    if (this.classList.contains('no-preloader')) {
                        return;
                    }

                    setTimeout(() => {

                        preloader.classList.remove('hide');
                        preloader.style.display = 'flex';

                    }, 100);

                });

            });

        });

        /* ══════════════════════════════
           SIDEBAR TOGGLE
        ══════════════════════════════ */
        // ── Sidebar toggle logic ──
        const sidebar = document.getElementById('sidebar');
        const mainWrapper = document.getElementById('main-wrapper');
        const topbar = document.getElementById('topbar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const isMobile = () => window.innerWidth < 992;

        function toggleSidebar() {
            if (isMobile()) {
                sidebar.classList.toggle('mobile-open');
                backdrop.style.display = sidebar.classList.contains('mobile-open') ? 'block' : 'none';
            } else {
                sidebar.classList.toggle('collapsed');
                const w = sidebar.classList.contains('collapsed')
                    ? 'var(--sidebar-collapsed-width)'
                    : 'var(--sidebar-width)';
                mainWrapper.style.marginLeft = w;
                topbar.style.left = w;
            }
        }

        // Close mobile sidebar on resize to desktop
        window.addEventListener('resize', () => {
            if (!isMobile()) {
                sidebar.classList.remove('mobile-open');
                backdrop.style.display = 'none';
            }
        });

        // Active nav link
        // ── Active nav highlight based on current URL ──
        (function () {

            const currentPath = window.location.pathname.toLowerCase();

            let bestMatch = null;
            let bestMatchLength = 0;

            document.querySelectorAll('.nav-item-link').forEach(function (link) {

                link.classList.remove('active');

                const href = link.getAttribute('href');

                // Ignore invalid links + logout
                if (
                    href &&
                    href !== '#' &&
                    !href.toLowerCase().includes('/login')
                ) {

                    const linkPath = new URL(href, window.location.origin)
                        .pathname
                        .toLowerCase();

                    // Exact match OR proper folder match
                    if (
                        currentPath === linkPath ||
                        currentPath.startsWith(linkPath + '/')
                    ) {

                        if (linkPath.length > bestMatchLength) {
                            bestMatch = link;
                            bestMatchLength = linkPath.length;
                        }
                    }
                }
            });

            if (bestMatch) {
                bestMatch.classList.add('active');
            }

        })();

        // Chevron rotation for collapse
        document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(btn => {
            const target = document.querySelector(btn.getAttribute('href'));
            if (target) {
                target.addEventListener('show.bs.collapse', () => {
                    const arrow = btn.querySelector('.nav-arrow');
                    if (arrow) arrow.style.transform = 'rotate(0deg)';
                });
                target.addEventListener('hide.bs.collapse', () => {
                    const arrow = btn.querySelector('.nav-arrow');
                    if (arrow) arrow.style.transform = 'rotate(-90deg)';
                });
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
