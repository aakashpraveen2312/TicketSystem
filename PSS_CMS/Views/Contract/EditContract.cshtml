@model PSS_CMS.Models.Contract

@{ ViewData["Title"] = "Edit Party";
                ViewBag.PageTitle = "Edit Party";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-text nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">Party</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">
        @(Session["CT_CONTRACTREFERENCENUMBER"] != null ? Session["CT_CONTRACTREFERENCENUMBER"].ToString() : "")
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

@using (Html.BeginForm("EditContract", "Contract", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-pencil-square" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Edit Party
        </h6>
    </div>

    <!-- Form Body -->
    <div class="form-body">

        <!-- Section: Basic Info -->

        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label">
                    Code
                </label>
                @Html.EditorFor(m => m.CT_CODE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "Auto-Code"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>
            <!-- Customer Name -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_NAME)
                </label>
                @Html.EditorFor(m => m.CT_CUSTOMERNAME, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Party Details -->

        <div class="form-grid">



            <!-- Email -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_EMAIL)
                </label>
                @Html.EditorFor(m => m.CT_EMAIL, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        id = "CT_EMAIL",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>

            <!-- Mobile -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_MOBILE)
                </label>
                @Html.EditorFor(m => m.CT_MOBILE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        id = "CT_MOBILE",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>

            <!-- Address -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_ADDRESS)
                </label>
                @Html.EditorFor(m => m.CT_ADDRESS, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        id = "CT_ADDRESS",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>
            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_SORTORDER)
                </label>
                @Html.EditorFor(m => m.CT_SORTORDER, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-num",
                        autocomplete = "off",
                        type = "text",
                        inputmode = "numeric",
                        oninput = "this.value=this.value.replace(/[^0-9]/g,'')",
                        placeholder = "0"
                    }
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Settings -->
        <p class="form-section-title">Settings</p>

        <div class="form-grid" style="margin-top:8px;">

            <!-- Existing User -->
            <label class="check-row" for="existingUserCheckbox">
                @Html.CheckBoxFor(m => m.EXISTINGUSER, new
                {
                    @class = "form-check-input",
                    id = "existingUserCheckbox",
                    onclick = "return false;"
                })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.EXISTINGUSER)</span>
                    <small>Link contract to an existing system user</small>
                </div>
            </label>

            <!-- New User -->
            <label class="check-row" for="newUserCheckbox">
                @Html.CheckBoxFor(m => m.NEWUSER, new
                {
                    @class = "form-check-input",
                    id = "newUserCheckbox",
                    onclick = "return false;"
                })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.NEWUSER)</span>
                    <small>Create a new user account for this contract</small>
                </div>
            </label>

        </div>

    </div>

    <!-- Legend Bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("ContractList", "Contract")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        /* ── Mutual-exclusion checkboxes (display only — onclick=false) ── */
        document.getElementById('existingUserCheckbox').addEventListener('change', function () {
            if (this.checked) document.getElementById('newUserCheckbox').checked = false;
        });
        document.getElementById('newUserCheckbox').addEventListener('change', function () {
            if (this.checked) document.getElementById('existingUserCheckbox').checked = false;
        });
    </script>

    <script>
        /* ── AJAX submit with processing spinner first ── */
        $(document).ready(function () {
            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);
                $("body").css("pointer-events", "none");

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("EditContract", "Contract")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "Ok",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue"
                                            },
                                            didOpen: function () {
                                                $(".swal2-container").css("pointer-events", "auto");
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) {
                                                window.location.href = '@Url.Action("ContractList", "Contract", new { CompanyRecID = Session["CompanyID"] })';
                                            } else {
                                                window.location.href = '@Url.Action("ContractList", "Contract")';
                                            }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
