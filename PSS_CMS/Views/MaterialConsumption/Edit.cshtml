@model PSS_CMS.Models.Materialconsumption

@{ ViewData["Title"] = "Edit Line Item";
                ViewBag.PageTitle = "Edit Line Item";
                Layout = "~/Views/Shared/_Layout.cshtml";

                string typeName = Session["Type"]?.ToString() ?? "";
                string pName = Session["P_NAME"]?.ToString() ?? "";
                string macName = Session["MACNAME"]?.ToString() ?? ""; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />

}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    @if (!string.IsNullOrEmpty(pName))
    {
<a href="@Url.Action("RecentTicket","RecentTickets")">@pName</a>
                <i class="bi bi-chevron-right"></i>}
    @if (!string.IsNullOrEmpty(typeName))
    {
<a href="@Url.Action("List","MaterialConsumption")">@typeName</a>
                <i class="bi bi-chevron-right"></i>}
    @if (!string.IsNullOrEmpty(macName))
    {
<a href="@Url.Action("List","MaterialConsumption")">@macName</a>
                <i class="bi bi-chevron-right"></i>}
    <a href="@Url.Action("List","MaterialConsumption")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Edit", "MaterialConsumption", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon"><i class="bi bi-pencil-square"></i></span>
            Edit @(string.IsNullOrEmpty(typeName) ? "Line Item" : typeName)
            <span class="edit-badge">Editing</span>
        </h6>
    </div>

    <div class="form-body">

        <!-- ── Item Info (readonly in edit) ──── -->

        <div class="form-grid">

            <!-- Item Group (readonly in edit) -->
            <div class="form-group">
                <label class="form-label" for="IG_DESCRIPTION">
                    @Html.DisplayNameFor(m => m.ITEMGROUP)
                </label>
                @Html.TextBoxFor(m => m.IG_DESCRIPTION, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly"
                })
                @Html.HiddenFor(m => m.tM_MGRECID)
            </div>

            <!-- Item Category (readonly in edit) -->
            <div class="form-group">
                <label class="form-label" for="IC_DESCRIPTION">
                    @Html.DisplayNameFor(m => m.ITEMCATEGORY)
                </label>
                @Html.TextBoxFor(m => m.IC_DESCRIPTION, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly"
                })
                @Html.HiddenFor(m => m.tM_MCRECID)
            </div>

            <!-- Material / Item (readonly in edit) -->
            <div class="form-group">
                <label class="form-label" for="I_DESCRIPTION">
                    @Html.DisplayNameFor(m => m.MATERIAL)
                </label>
                @Html.TextBoxFor(m => m.I_DESCRIPTION, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly"
                })
                @Html.HiddenFor(m => m.tM_MRECID)
            </div>

            <!-- UOM (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_UOM">@Html.DisplayNameFor(m => m.tM_UOM)</label>
                @Html.TextBoxFor(m => m.tM_UOM, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly",
                    placeholder = "Auto-filled"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Pricing & Tax ─────────────────── -->

        <div class="form-grid">

            <!-- Price (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_PRICE">@Html.DisplayNameFor(m => m.tM_PRICE)</label>
                @Html.TextBoxFor(m => m.tM_PRICE, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    placeholder = "0.00",
                    @readonly = "readonly"
                })
            </div>

            <!-- Quantity (editable) -->
            <div class="form-group">
                <label class="form-label" for="tM_QUANTITY">
                    @Html.DisplayNameFor(m => m.tM_QUANTITY) <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.tM_QUANTITY, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    oninput = "Netamount()",
                    type = "text",
                    placeholder = "0"
                })
            </div>

            <!-- Discount (editable) -->
            <div class="form-group">
                <label class="form-label" for="tM_DISCOUNT">@Html.DisplayNameFor(m => m.tM_DISCOUNT)</label>
                @Html.TextBoxFor(m => m.tM_DISCOUNT, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    oninput = "Netamount()",
                    type = "text",
                    placeholder = "0.00"
                })
            </div>

            <!-- Sort Order (editable) -->
            <div class="form-group">
                <label class="form-label" for="tM_SORTORDER">@Html.DisplayNameFor(m => m.tM_SORTORDER)</label>
                @Html.TextBoxFor(m => m.tM_SORTORDER, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    type = "text",
                    placeholder = "0"
                })
            </div>

            <!-- SGST (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_SGST">@Html.DisplayNameFor(m => m.tM_SGST)</label>
                @Html.TextBoxFor(m => m.tM_SGST, "{0:0.00}", new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    placeholder = "0.00",
                    @readonly = "readonly"
                })
            </div>

            <!-- CGST (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_CGST">@Html.DisplayNameFor(m => m.tM_CGST)</label>
                @Html.TextBoxFor(m => m.tM_CGST, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly",
                    type = "text"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Amount Summary ────────────────── -->


        <div class="form-grid">
            <div class="amount-summary">

                <div class="amount-item">
                    <span class="amount-label">
                        <i class="bi bi-calculator"></i>
                        @Html.DisplayNameFor(m => m.tM_TOTALAMOUNT)
                    </span>
                    @Html.TextBoxFor(m => m.tM_TOTALAMOUNT, new
                    {
                        @class = "form-input-calc",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "0.00"
                    })
                </div>

                <div class="amount-item">
                    <span class="amount-label">
                        <i class="bi bi-currency-rupee"></i>
                        @Html.DisplayNameFor(m => m.tM_NETAMOUNT)
                    </span>
                    @Html.TextBoxFor(m => m.tM_NETAMOUNT, new
                    {
                        @class = "form-input-calc",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "0.00"
                    })
                </div>

            </div>
        </div>

        <div class="form-divider"></div>

        <!-- ── Settings ──────────────────────── -->
        <p class="form-section-title">Settings</p>

        <div class="form-grid">

            <!-- Type (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_TYPE">@Html.DisplayNameFor(m => m.tM_TYPE)</label>
                @Html.TextBoxFor(m => m.tM_TYPE, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly"
                })
            </div>

            <!-- Billable checkbox -->
            <label class="check-row" for="tM_BILLABLE">
                @Html.CheckBoxFor(m => m.tM_BILLABLE,
                              new { @class = "form-check-input", id = "tM_BILLABLE" })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.tM_BILLABLE)</span>
                    <small>Mark this line item as billable to the customer</small>
                </div>
            </label>



        </div>

    </div>

    <!-- Legend bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#BA7517;flex-shrink:0;"></span>
            <span>Calculated Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("List","MaterialConsumption")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save Changes
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Net Amount Calculation ──────────────── */
        function Netamount() {
            var price    = parseFloat($('#tM_PRICE').val())    || 0;
            var qty      = parseFloat($('#tM_QUANTITY').val()) || 0;
            var discount = parseFloat($('#tM_DISCOUNT').val()) || 0;
            var sgst     = parseFloat($('#tM_SGST').val())     || 0;
            var cgst     = parseFloat($('#tM_CGST').val())     || 0;

            var total = (price * qty) * (1 - discount / 100);
            var net   = total + (total * sgst / 100) + (total * cgst / 100);

            $('#tM_TOTALAMOUNT').val(total.toFixed(2));
            $('#tM_NETAMOUNT').val(net.toFixed(2));
        }

        /* ── AJAX submit ─────────────────────────── */
        $(document).ready(function () {

            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Edit","MaterialConsumption")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue"
                                            }
                                        }).then(function () {
                                            window.location.href = '@Url.Action("List","MaterialConsumption")';
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
            }
        });
    </script>
}
