@model IEnumerable<PSS_CMS.Models.TicketAgeingViewModel>

@{ ViewData["Title"] = "Aging Report";
                ViewBag.PageTitle = "Aging Report";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Filter Card ───────────────────────────────────────── */
        .filter-card {
            background: white;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 20px 22px;
            margin-bottom: 18px;
        }

        .filter-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .filter-title i { color: var(--primary); }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        @@media (max-width: 768px) {
            .filter-grid { grid-template-columns: 1fr; }
        }

        .form-group label {
            display: block;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .filter-input {
            width: 100%;
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 9px;
            padding: 7px 12px;
            font-size: 12.5px;
            font-family: inherit;
            color: var(--text-dark);
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .filter-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(108,92,231,.1);
            }

        .filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 18px;
        }

        .btn-filter {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 18px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-filter:hover { background: #5a4bd1; }

        .btn-pdf {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #e74c3c;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 18px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-pdf:hover { background: #c0392b; }

        /* ── Status Badge ──────────────────────────────────────── */
        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .s-open      { background: #eef6ff; color: #1a73e8; }
        .s-closed    { background: #e8faf6; color: #00916e; }
        .s-pending   { background: #fff4db; color: #c47a00; }
        .s-escalated { background: #ffeaea; color: #e74c3c; }

        /* ── Bucket Badge ──────────────────────────────────────── */
        .bucket-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .b-0 { background: #e8faf6; color: #00916e; }
        .b-1 { background: #fff4db; color: #c47a00; }
        .b-2 { background: #ffeaea; color: #e74c3c; }
        .b-3 { background: #f3f0ff; color: #5a4bd1; }

        /* ── Record Count Badge ────────────────────────────────── */
        .record-badge {
            background: #f3f0ff;
            color: #5a4bd1;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 20px;
            margin-left: 6px;
        }

        .ref-code {
            font-weight: 600;
            color: var(--primary);
            font-size: 12px;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-clock-history"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Report</span>

    <i class="bi bi-chevron-right"></i>

    <span>Aging Report</span>

</div>

<!-- Filter Card -->
<div class="filter-card">

    <div class="filter-title">
        <i class="bi bi-funnel"></i>
        Ticket Aging Report — Filters
    </div>

    @using (Html.BeginForm(
        "TicketAgeingReportPdf",
        "RecentTickets",
        FormMethod.Post,
        new { id = "filterForm", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
<div class="filter-grid">

    <!-- From Date -->
    <div class="form-group">
        <label>From Date</label>
        <input type="date"
               name="FromDate"
               id="fromDate"
               class="filter-input"
               value="@Request["FromDate"]" />
    </div>

    <!-- To Date -->
    <div class="form-group">
        <label>To Date</label>
        <input type="date"
               name="ToDate"
               id="toDate"
               class="filter-input"
               value="@Request["ToDate"]" />
    </div>

    <!-- Product -->
    <div class="form-group">
        <label>Product</label>
        @Html.DropDownList(
                 "ProductId",
                 ViewBag.Product as IEnumerable<SelectListItem> ?? new List<SelectListItem>(),
                 "-- Select Product --",
                 new { @class = "filter-input" })
    </div>

</div>

                <div class="filter-actions">

                    <button type="submit"
                            name="ActionType"
                            value="Filter"
                            class="btn-filter">
                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>

                    <button type="submit"
                            name="ActionType"
                            value="PDF"
                            class="btn-pdf">
                        <i class="bi bi-file-earmark-pdf"></i>
                        PDF
                    </button>

                </div>}

</div>

<!-- Report Table -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <h6 class="page-card-title">
            <i class="bi bi-clock-history" style="color:var(--primary)"></i>
            Aging Report
            <span class="record-badge">
                @(Model != null ? Model.Count() : 0) records
            </span>
        </h6>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>
        <tr>
            <th>Date</th>
            <th>Reference No</th>
            <th>Customer Name</th>
            <th>Status</th>
            <th>Age</th>
            <th>Bucket</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            var statusClass =
                item.Status == "Open" ? "s-open" :
                item.Status == "Closed" ? "s-closed" :
                item.Status == "Pending" ? "s-pending" :
                item.Status == "Escalated" ? "s-escalated" :
                                             "s-open";

            var bucketClass =
                item.AgeBucket == "0-7 Days" ? "b-0" :
                item.AgeBucket == "8-30 Days" ? "b-1" :
                item.AgeBucket == "31-60 Days" ? "b-2" :
                                                 "b-3";

<tr>
    <td>@item.ticketDate</td>
    <td class="ref-code">@item.referenceNo</td>
    <td>@item.CustomerName</td>
    <td>
        <span class="status-badge @statusClass">
            @item.Status
        </span>
    </td>
    <td>@item.ageText</td>
    <td>
        <span class="bucket-badge @bucketClass">
            @item.AgeBucket
        </span>
    </td>
</tr>}

    </tbody>

</table> <!-- Pagination -->
                                <div class="table-pagination">

                                    <button id="prevBtn" class="page-btn">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </button>

                                    <span id="pageInfo" class="page-info"></span>

                                    <button id="nextBtn" class="page-btn">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </button>

                                </div> }
                                            else
                                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox"
                                       style="font-size:40px;color:var(--text-muted)"></i>
                                    <p class="mt-2 text-muted fw-semibold">No records found</p>
                                </div>}

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/UIPagination.js"></script>

    @if (TempData["ErrorMessage"] != null)
    {
<script>
            $(document).ready(function () {
                Swal.fire({
                    icon: 'info',
                    title: 'Message',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#6c5ce7',
                    confirmButtonText: 'OK'
                });
            });
</script>}
}
