                                {
            <a href="@Url.Action("List","MaterialConsumption", new {
                                               TC_RECID = o.TC_RECID, Type = "Material",
                                               P_RECID = o.P_RECID, P_NAME = o.P_NAME,
                                               Comprehensive = o.P_Comprehensivewarranty })"
               class="act act-cart" title="Job Card Items">
                <i class="bx bx-cart-alt"></i>
            </a>
                                    <a href="@Url.Action("List","MaterialConsumption", new {
                                               TC_RECID = o.TC_RECID, Type = "Service",
                                               P_RECID = o.P_RECID, P_NAME = o.P_NAME,
                                               Comprehensive = o.P_Comprehensivewarranty })"
                                       class="act act-service" title="Services">
                                        <i class="bi bi-card-checklist"></i>
                                    </a> } @* PDF (Closed + MC flag) *@
                                @if (o.TC_STATUS == "C" && hasMC)
                                {
            <a href="#" class="act act-pdf download-pdf"
               data-id="@o.TC_RECID" title="Download PDF">
                <i class="bx bxs-file-pdf"></i>
            </a> } @* Pick ticket *@
                                @if (o.TC_STATUS != "C")
                                {
