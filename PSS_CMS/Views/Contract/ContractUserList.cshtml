@model IEnumerable<PSS_CMS.Models.ContractUser>

@{
    ViewData["Title"] = "User List";
    ViewBag.PageTitle = "User List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string searchPhrase = Request["searchPharse"] ?? "";
    var customerName = Session["CUSTOMERNAME"] != null
                    ? Session["CUSTOMERNAME"].ToString()
                    : "";
    var filtered = Model?.Where(x =>
string.IsNullOrEmpty(searchPhrase) ||
(x.U_CONTRACTUSERFIRSTNAME != null && x.U_CONTRACTUSERFIRSTNAME.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
(x.U_CONTRACTUSERLASTNAME != null && x.U_CONTRACTUSERLASTNAME.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
(x.U_CONTRACTUSEREMAIL != null && x.U_CONTRACTUSEREMAIL.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
(x.U_CONTRACTMOBILE != null && x.U_CONTRACTMOBILE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
).ToList();
}

@section Styles {

    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-earmark-text nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Party</span>

    <i class="bi bi-chevron-right"></i>
    <span>@customerName</span>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductList", "Contract")">
        Contracts
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>User List</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("ContractUserList", "Contract", FormMethod.Get, new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@searchPhrase"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(searchPhrase))
                    {
                        <a href="@Url.Action("ContractUserList","Contract")" title="Clear">
                            <i class="bi bi-x-circle text-muted"></i>
                        </a>
                    }

                </div>
            }

            <!-- Add -->
            <a href="@Url.Action("CreateContractUser", "Contract")"
               class="btn-add">

                <i class="bi bi-plus-circle"></i>
                Add User

            </a>

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (filtered != null && filtered.Any())
        {

            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center" style="width:70px;">S.No</th>

                        <th style="min-width:180px;">First Name</th>

                        <th style="min-width:180px;">Last Name</th>

                        <th style="min-width:150px;">Email</th>

                        <th style="min-width:150px;">Mobile</th>

                        <th class="text-center" style="width:120px;">Desigination</th>

                        <th class="text-center" style="width:100px;">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in filtered)
                    {
                        var editUrl = Url.Action("EditContractUser", "Contract",
                            new
                            {
                                Contractid = o.U_CONTRACTRECID
                            });

                        var deleteUrl = Url.Action
                            ("DeleteContractUser",
                            "Contract",
                            new
                            {
                                id = o.U_CONTRACTRECID
                            });

                        <tr>

                            <td class="text-center serial-text">
                                @o.SerialNumber
                            </td>

                            <td>
                                <span class="customer-code">
                                    @o.U_CONTRACTUSERFIRSTNAME
                                </span>
                            </td>

                            <td>
                                <span class="customer-code">
                                    @o.U_CONTRACTUSERLASTNAME
                                </span>
                            </td>

                            <td>

                                <div class="customer-name">
                                    @o.U_CONTRACTUSEREMAIL
                                </div>

                            </td>

                            <td>
                                <i class="bi bi-telephone-fill" style="color: #3498db;"></i>

                                @o.U_CONTRACTMOBILE
                            </td>

                            <td class="text-center">

                                <span class="sort-badge">
                                    @o.U_CONTRACTDESIGNATION
                                </span>

                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- Edit -->
                                    <a href="@editUrl"
                                       class="act-btn act-edit"
                                       title="Edit">

                                        <i class='bx bxs-pencil'></i>

                                    </a>

                                    <!-- Delete -->
                                    <!-- Delete — FIXED -->
                                    <a href="@deleteUrl"
                                       class="act-btn act-delete no-loader"
                                       title="Delete"
                                       data-name="@o.U_CONTRACTUSERFIRSTNAME"
                                       onclick="return confirmDelete(this);">
                                        <i class='bx bxs-trash'></i>
                                    </a>
                                   

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->
            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

        }
        else
        {
            <div class="empty-wrap">

                <i class="bi bi-inbox"></i>

                <h5>No users available</h5>

            </div>
        }

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    <div class="legend-item">

        <span class="act-btn act-edit"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-pencil'></i>

        </span>

        Edit

    </div>

    <div class="legend-item">

        <span class="act-btn act-delete"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-trash'></i>

        </span>

        Delete

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>


}