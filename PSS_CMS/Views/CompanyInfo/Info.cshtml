@model PSS_CMS.Models.CompanyInfo
@functions {

    public string GetImageSrc(string base64Image)
    {
        if (string.IsNullOrWhiteSpace(base64Image))
        {
            return "";
        }

        base64Image = base64Image.Trim();

        // Already contains data:image...
        if (base64Image.StartsWith(
            "data:image",
            StringComparison.OrdinalIgnoreCase))
        {
            return base64Image;
        }

        // If value contains something like:
        // data:image/png;base64,XXXXX
        // remove the prefix before decoding

        if (base64Image.Contains(","))
        {
            base64Image =
                base64Image.Substring(
                    base64Image.IndexOf(",") + 1
                );
        }

        try
        {
            Convert.FromBase64String(base64Image);

            return "data:image/png;base64," + base64Image;
        }
        catch
        {
            return "";
        }
    }

}




