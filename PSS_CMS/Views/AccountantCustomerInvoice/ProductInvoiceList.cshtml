@model IEnumerable<PSS_CMS.Models.ProductInvoice>

@{ ViewData["Title"] = "Products Invoice List";
                ViewBag.PageTitle = "Products Invoice List";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-shield-check nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("CustomerList", "Contract")">
        Warranty Products
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Products Invoice List</span>

</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm("List",
                "ProductInvoice",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
<div class="search-box">

    <i class="bi bi-search"></i>

    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />

    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("List", "ProductInvoice")"
   title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}

</div>            }

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>

        <tr>

            <th class="text-center"
                style="width:60px;">
                S.No
            </th>

            <th>
                Invoice Number
            </th>

            <th class="text-center">
                Invoice Date
            </th>

            <th class="text-right"
                style="text-align:right;">
                Invoice Amount
            </th>

            <th>
                Product Serial No
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var o in Model)
        {
            var invoiceDate = string.IsNullOrEmpty(o.SIH_INVOICEDATE)
                ? ""
                : Convert.ToDateTime(o.SIH_INVOICEDATE).ToString("dd-MM-yyyy");

            var invoiceAmount = String.Format("{0:N2}", o.SIH_INVOICEAMOUNT);

<tr>

    <td class="text-center">
        <span class="serial-text">@o.SerialNumber</span>
    </td>

    <td>
        <span class="contract-code">@o.SIH_INVOICENO</span>
    </td>

    <td class="text-center">
        <span class="date-cell">@invoiceDate</span>
    </td>

    <td class="amount-cell">
        @invoiceAmount
    </td>

    <td>
        <span class="product-serial">@o.SIP_PRODUCTSERIALNUMBER</span>
    </td>

</tr>}

    </tbody>

</table> <!-- Pagination -->
                                <div class="table-pagination">

                                    <button id="prevBtn"
                                            class="page-btn">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </button>

                                    <span id="pageInfo"
                                          class="page-info">
                                    </span>

                                    <button id="nextBtn"
                                            class="page-btn">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </button>

                                </div> }
                                            else
                                            {
                                <div class="text-center py-5">

                                    <i class="bi bi-receipt"
                                       style="font-size:40px;color:var(--text-muted)"></i>

                                    <p class="mt-2 text-muted fw-semibold">
                                        No invoice records available
                                    </p>

                                </div>}

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    @if (TempData["SuccessMessage"] != null)
    {
<script>
            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["SuccessMessage"]',
                confirmButtonColor: '#3085d6'
            });
</script>}

    @if (TempData["ErrorMessage"] != null)
    {
<script>
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#d33'
            });
</script>}

    <script>
        function confirmProcess(url) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to process this invoice?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Process it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }

        function confirmUnlock(url) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to unlock this invoice?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Unlock it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }

        function DownloadWarrantyPDF(id) {
            Swal.fire({
                title: 'Processing...',
                text: 'Generating Warranty PDF',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/AccountantCustomerInvoice/WarrantyPDF',
                type: 'POST',
                data: { CU_RECID: id },
                xhrFields: { responseType: 'blob' },
                success: function (data) {
                    var blob = new Blob([data], { type: "application/pdf" });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = "Warranty.pdf";
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    Swal.close();
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to download PDF' });
                }
            });
        }

        function SendWarrantyEmail(id, email) {
            Swal.fire({
                title: 'Processing...',
                text: 'Sending Warranty PDF to Email',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/AccountantCustomerInvoice/WarrantyPDFToEmail',
                type: 'POST',
                data: { CU_RECID: id, Email: email },
                success: function (response) {
                    Swal.close();
                    if (response.status === "Y") {
                        Swal.fire({ icon: 'success', title: 'Success', text: response.message });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: response.message });
                    }
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong' });
                }
            });
        }
    </script>

    <script src="~/Scripts/Logoutjs.js"></script>

}
