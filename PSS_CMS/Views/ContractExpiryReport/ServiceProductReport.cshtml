@model IEnumerable<PSS_CMS.Models.Prioritywise>

@{ ViewData["Title"] = "Service Product Report";
                ViewBag.PageTitle = "Service Product Report";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Filter Card ─────────────────────────────── */
        .filter-card {
            background: white;
            border-radius: 14px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            padding: 20px 22px;
            margin-bottom: 18px;
        }

        .filter-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .filter-title i {
                color: var(--primary);
            }

        .filter-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
        }

        @@media (max-width: 1024px) {
            .filter-grid {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width: 640px) {
            .filter-grid {
                grid-template-columns: 1fr;
            }
        }

        .form-group label {
            display: block;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        /* ── Shared input style ──────────────────────── */
        .filter-input {
            width: 100%;
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 9px;
            padding: 7px 12px;
            font-size: 12.5px;
            font-family: inherit;
            color: var(--text-dark);
            outline: none;
            transition: border-color .15s, box-shadow .15s;
        }

            .filter-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(108,92,231,.1);
            }

        /* ── Custom multi-select dropdown ───────────── */
        .dropdown-check-list {
            position: relative;
        }

            .dropdown-check-list .anchor {
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: space-between;
                width: 100%;
                background: var(--body-bg);
                border: 1px solid var(--border-color);
                border-radius: 9px;
                padding: 7px 12px;
                font-size: 12.5px;
                font-family: inherit;
                color: var(--text-muted);
                user-select: none;
                transition: border-color .15s;
            }

                .dropdown-check-list .anchor::after {
                    content: "\F229";
                    font-family: "bootstrap-icons";
                    font-size: 11px;
                    flex-shrink: 0;
                    margin-left: 6px;
                    transition: transform .2s;
                }

            .dropdown-check-list.visible .anchor {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(108,92,231,.1);
                color: var(--text-dark);
            }

                .dropdown-check-list.visible .anchor::after {
                    transform: rotate(180deg);
                }

            .dropdown-check-list ul.items {
                position: absolute;
                top: calc(100% + 4px);
                left: 0;
                width: 100%;
                z-index: 9999;
                background: #fff;
                border: 1px solid var(--border-color);
                border-radius: 9px;
                box-shadow: var(--shadow-md);
                max-height: 220px;
                overflow-y: auto;
                display: none;
                list-style: none;
                padding: 6px 0;
                margin: 0;
            }

            .dropdown-check-list.visible ul.items {
                display: block;
            }

            .dropdown-check-list ul.items li {
                padding: 6px 12px;
                font-size: 12.5px;
                display: flex;
                align-items: center;
                gap: 8px;
                cursor: pointer;
                transition: background .1s;
            }

                .dropdown-check-list ul.items li:hover {
                    background: var(--body-bg);
                }

                .dropdown-check-list ul.items li strong {
                    font-weight: 600;
                }

            .dropdown-check-list ul.items input[type=checkbox] {
                accent-color: var(--primary);
                width: 13px;
                height: 13px;
                flex-shrink: 0;
            }

        /* ── Filter actions ──────────────────────────── */
        .filter-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 18px;
        }

        .btn-filter {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 18px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-filter:hover {
                background: #5a4bd1;
            }

        .btn-pdf {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #e74c3c;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 18px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-pdf:hover {
                background: #c0392b;
            }

        /* ── Record badge ────────────────────────────── */
        .record-badge {
            background: #f3f0ff;
            color: #5a4bd1;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 20px;
            margin-left: 6px;
        }

        /* ── Type badge ──────────────────────────────── */
        .type-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .t-billable {
            background: #e8faf6;
            color: #00916e;
        }

        .t-nonbillable {
            background: #ffeaea;
            color: #e74c3c;
        }

        .t-default {
            background: #f3f0ff;
            color: #5a4bd1;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-earmark-bar-graph"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Report</span>
    <i class="bi bi-chevron-right"></i>
    <span>Service Product Report</span>
</div>

<!-- Filter Card -->
<div class="filter-card">

    <div class="filter-title">
        <i class="bi bi-funnel"></i>
        Service Product Report — Filters
    </div>

    <form method="post"
          id="financeForm"
          action="@Url.Action("ServiceProductReport","ContractExpiryReport")"
          class="no-preloader">

        <input type="hidden" id="ItemGroupRecid" name="Productrecid" />
        <input type="hidden" id="ItemCategoryRecid" name="contractrecid" />
        <input type="hidden" id="MaterialRecid" name="Materialrecid" />

        <div class="filter-grid">

            <!-- Customers multi-select -->
            <div class="form-group">
                <label>Customers</label>
                <div id="itemGroupDropdown" class="dropdown-check-list" tabindex="100">
                    <span class="anchor">-- Select Customer --</span>
                    <ul class="items" id="itemGroupList">
                        <li>
                            <input type="checkbox" id="selectAllItemGroups" />
                            <strong>Select All</strong>
                        </li>
                        @if (ViewBag.Customer != null)
                        {
                            foreach (var g in ViewBag.Customer)
                            {
            <li>
                <input type="checkbox" class="itemGroupCheck" value="@g.Value" />
                @g.Text
            </li>}
                        }
                    </ul>
                </div>
            </div>

            <!-- Products multi-select (loaded dynamically) -->
            <div class="form-group">
                <label>Products</label>
                <div id="itemCategoryDropdown" class="dropdown-check-list">
                    <span class="anchor">-- Select Product --</span>
                    <ul class="items" id="itemCategoryList"></ul>
                </div>
            </div>

            <!-- Material multi-select -->
            <div class="form-group">
                <label>Material</label>
                <div id="materialDropdown" class="dropdown-check-list" tabindex="100">
                    <span class="anchor">-- Select Material --</span>
                    <ul class="items" id="materialList">
                        <li>
                            <input type="checkbox" id="selectMaterials" />
                            <strong>Select All</strong>
                        </li>
                        @if (ViewBag.Material != null)
                        {
                            foreach (var g in ViewBag.Material)
                            {
            <li>
                <input type="checkbox" class="materialCheck" value="@g.Value" />
                @g.Text
            </li>}
                        }
                    </ul>
                </div>
            </div>

            <!-- Type select -->
            <div class="form-group">
                <label>Select Type</label>
                <select id="comboBox" name="Type" class="filter-input">
                    <option value="">-- Select Type --</option>
                    <option value="Billable">Billable</option>
                    <option value="Non Billable">Non Billable</option>
                </select>
            </div>

        </div>

        <div class="filter-actions">
            <button type="submit" name="ActionType" value="Filter" class="btn-filter">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <button type="submit" name="ActionType" value="PDF" class="btn-pdf">
                <i class="bi bi-file-earmark-pdf"></i> PDF
            </button>
        </div>

    </form>

</div>

<!-- Report Table -->
<div class="page-card">

    <div class="page-card-header">
        <h6 class="page-card-title">
            <i class="bi bi-file-earmark-bar-graph" style="color:var(--primary)"></i>
            Service Product Report
            <span class="record-badge">
                @(Model != null ? Model.Count() : 0) records
            </span>
        </h6>
    </div>

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">
    <thead>
        <tr>
            <th>Ticket No</th>
            <th>Customer Name</th>
            <th>Product Name</th>
            <th>Material Name</th>
            <th>Qty Used</th>
            <th>Type</th>
            <th>Service Engineer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var typeClass =
                item.Type == "Billable" ? "t-billable" :
                item.Type == "Non Billable" ? "t-nonbillable" :
                                              "t-default";
<tr>
    <td><span class="ref-code">@item.TicketNo</span></td>
    <td>@item.customerName</td>
    <td>@item.ProductName</td>
    <td>@item.MaterialName</td>
    <td>@item.QtyUsed</td>
    <td>
        <span class="type-badge @typeClass">@item.Type</span>
    </td>
    <td>@item.ServiceEngineer</td>
</tr>}
    </tbody>
</table>

                <div class="table-pagination">
                    <button id="prevBtn" class="page-btn">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>
                    <span id="pageInfo" class="page-info"></span>
                    <button id="nextBtn" class="page-btn">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </div> }
                            else
                            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size:40px;color:var(--text-muted)"></i>
                    <p class="mt-2 text-muted fw-semibold">No records found</p>
                </div>}

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/UIPagination.js"></script>

    @if (TempData["ErrorMessage"] != null)
    {
<script>
            $(document).ready(function () {
                Swal.fire({
                    icon: 'info',
                    title: 'Message',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#6c5ce7',
                    confirmButtonText: 'OK'
                });
            });
</script>}

    <script>
    $(document).ready(function () {

        /* ── Dropdown open / close ───────────────────── */
        $(".dropdown-check-list .anchor").click(function (e) {
            e.stopPropagation();
            $(".dropdown-check-list").not($(this).parent()).removeClass("visible");
            $(this).parent().toggleClass("visible");
        });

        $(document).on("click", ".dropdown-check-list", function (e) {
            e.stopPropagation();
        });

        $(document).click(function () {
            $(".dropdown-check-list").removeClass("visible");
        });

        /* ── Select All — Customers ──────────────────── */
        $(document).on("change", "#selectAllItemGroups", function () {
            $(".itemGroupCheck").prop("checked", this.checked);
            loadProducts();
        });

        $(document).on("change", ".itemGroupCheck", function () {
            $("#selectAllItemGroups").prop(
                "checked",
                $(".itemGroupCheck").length === $(".itemGroupCheck:checked").length
            );
            loadProducts();
        });

        /* ── Select All — Products ───────────────────── */
        $(document).on("change", "#selectAllCategories", function () {
            $(".categoryCheck").prop("checked", this.checked);
        });

        $(document).on("change", ".categoryCheck", function () {
            $("#selectAllCategories").prop(
                "checked",
                $(".categoryCheck").length === $(".categoryCheck:checked").length
            );
        });

        /* ── Select All — Materials ──────────────────── */
        $(document).on("change", "#selectMaterials", function () {
            $(".materialCheck").prop("checked", this.checked);
        });

        $(document).on("change", ".materialCheck", function () {
            $("#selectMaterials").prop(
                "checked",
                $(".materialCheck").length === $(".materialCheck:checked").length
            );
        });

        /* ── Load Products based on selected Customers ─ */
        function loadProducts() {
            var selected = [];
            $(".itemGroupCheck:checked").each(function () {
                selected.push($(this).val());
            });

            $("#itemCategoryList").empty();
            if (selected.length === 0) return;

            $("#itemCategoryList").html("<li style='padding:8px 12px;color:var(--text-muted)'>Loading…</li>");

            $.getJSON(
                '@Url.Action("CustomerBasedProduct","ContractExpiryReport")',
                { ProductRecid: selected.join(",") },
                function (response) {
                    $("#itemCategoryList").empty();
                    $("#itemCategoryList").append(`
                        <li>
                            <input type="checkbox" id="selectAllCategories" />
                            <strong>Select All</strong>
                        </li>
                    `);
                    $.each(response.data, function (i, item) {
                        $("#itemCategoryList").append(`
                            <li>
                                <input type="checkbox" class="categoryCheck" value="${item.Value}" />
                                ${item.Text}
                            </li>
                        `);
                    });
                }
            ).fail(function () {
                $("#itemCategoryList").html(
                    "<li style='padding:8px 12px;color:#e74c3c'>Error loading products</li>"
                );
            });
        }

        /* ── Form submit ─────────────────────────────── */
        $("#financeForm").submit(function (e) {
            var customers  = [];
            var products   = [];
            var materials  = [];

            $(".itemGroupCheck:checked").each(function () { customers.push($(this).val()); });
            $(".categoryCheck:checked").each(function ()  { products.push($(this).val()); });
            $(".materialCheck:checked").each(function ()  { materials.push($(this).val()); });

            var type = $("#comboBox").val();

            if (customers.length === 0 && products.length === 0 && type === "") {
                e.preventDefault();
                Swal.fire({
                    icon: "warning",
                    title: "Filter Required",
                    text: "Please select at least one filter before proceeding.",
                    confirmButtonColor: "#6c5ce7",
                    confirmButtonText: "OK"
                });
                return;
            }

            $("#ItemGroupRecid").val(customers.join(","));
            $("#ItemCategoryRecid").val(products.join(","));
            $("#MaterialRecid").val(materials.join(","));
        });

    });
    </script>
}
