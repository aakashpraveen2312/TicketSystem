@section Scripts {
    <link href="https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Filters + Date Range -->
    <script>
        $(function () {

            var savedStatus      = localStorage.getItem('ticketStatus')  || '';
            var savedProjectType = localStorage.getItem('projectType')   || '';
            var savedTicketType  = localStorage.getItem('ticketType')    || '';
            var savedStart       = localStorage.getItem('StartDate')     || '';
            var savedEnd         = localStorage.getItem('EndDate')       || '';

            if (savedStatus)      $("#statusDropdown1").val(savedStatus);
            if (savedProjectType) $("#projectTypeFilter1").val(savedProjectType);
            if (savedTicketType)  $("#ticketTypeFilter1").val(savedTicketType);

            function updateTickets() {
                var status      = $("#statusDropdown1").val();
                var projectType = $("#projectTypeFilter1").val();
                var ticketType  = $("#ticketTypeFilter1").val();
                var startDate   = $('input[name="StartDate"]').val();
                var endDate     = $('input[name="EndDate"]').val();

                localStorage.setItem('ticketStatus',  status);
                localStorage.setItem('projectType',   projectType);
                localStorage.setItem('ticketType',    ticketType);
                localStorage.setItem('StartDate',     startDate);
                localStorage.setItem('EndDate',       endDate);

                var url = '@Url.Action("RecentTicket","RecentTickets")'
                    + "?status="      + encodeURIComponent(status)
                    + "&projectType=" + encodeURIComponent(projectType)
                    + "&ticketType="  + encodeURIComponent(ticketType)
                    + "&StartDate="   + encodeURIComponent(startDate)
                    + "&EndDate="     + encodeURIComponent(endDate);

                $("#ticketLoader").fadeIn(150).css("display","flex");

                $.ajax({
                    url: url, type: 'GET',
                    success: function (response) {
                        $("#ticketLoader").fadeOut(150);
                        var html = $(response).find("#ticketTable1").html();
                        if (html) { $("#ticketTable1").html(html); initializePagination(); }
                    },
                    error: function () { $("#ticketLoader").fadeOut(150); }
                });
            }

            $("#statusDropdown1, #projectTypeFilter1, #ticketTypeFilter1").change(updateTickets);

            $('#daterange').daterangepicker({
                locale: { format: 'DD-MM-YYYY', cancelLabel: 'Cancel', applyLabel: 'Apply' },
                opens: 'left', autoApply: false, showDropdowns: true
            }, function (start, end) {
                $('input[name="StartDate"]').val(start.format('YYYY-MM-DD'));
                $('input[name="EndDate"]').val(end.format('YYYY-MM-DD'));
                updateTickets();
            });

            $('#resetFilters').click(function () {
                localStorage.clear();
                $("#statusDropdown1, #projectTypeFilter1, #ticketTypeFilter1, #searchPharse").val('');
                $('input[name="StartDate"], input[name="EndDate"]').val('');
                updateTickets();
            });

            $("a, button, li").click(function () { localStorage.clear(); });
            $(window).on("beforeunload", function () { localStorage.clear(); });
        });
    </script>

    <!-- PDF download -->
    <script>
        $(document).on('click', '.download-pdf', function (e) {
            e.preventDefault();
            var trecid = $(this).data('id');
            Swal.fire({ title: 'Processing PDF...', text: 'Please wait.', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            $.ajax({
                url: '@Url.Action("DownloadPDF","PDF")', type: 'POST', data: { TRECID: trecid },
                success: function (res) {
                    Swal.close();
                    if (res.status === "success") { window.open(res.url, '_blank'); }
                    else { Swal.fire({ icon: 'info', title: 'Message', text: res.message }); }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.' });
                }
            });
        });
    </script>

    <!-- Pick ticket -->
    <script>
        $(document).on("click", ".pick-ticket", function (e) {
            e.preventDefault();
            var recid2 = $(this).data("recid");
            Swal.fire({ title: "Processing...", text: "Please wait.", icon: "info", showConfirmButton: false, allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            $.ajax({
                url: "/AssignTo/PickTicket", type: "POST", data: { recid2: recid2 },
                success: function (res) {
                    Swal.close();
                    if (res.success) {
                        Swal.fire({ title: "Ticket Picked!", text: res.message, icon: "success", showConfirmButton: false, timer: 2000 })
                            .then(() => { location.reload(); });
                    } else {
                        Swal.fire({ title: "Message", text: res.message, icon: "info", showConfirmButton: false, timer: 2000 });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ title: "Error!", text: "Something went wrong.", icon: "error", showConfirmButton: false, timer: 2000 });
                }
            });
        });
    </script>

    <!-- Pagination -->
    <script>
        function initializePagination() {
            var rowsPerPage = 10;
            var table = document.querySelector(".tickets-table tbody");
            if (!table) return;
            var rows = table.querySelectorAll("tr");
            var pageInfo = document.getElementById("pageInfo");
            var prevBtn = document.getElementById("prevBtn");
            var nextBtn = document.getElementById("nextBtn");
            if (!prevBtn || !nextBtn || !pageInfo) return;

            var currentPage = 1;
            var totalPages = Math.ceil(rows.length / rowsPerPage);

            function showPage(page) {
                var start = (page - 1) * rowsPerPage;
                var end = start + rowsPerPage;
                rows.forEach(function (row, i) {
                    row.style.display = (i >= start && i < end) ? "" : "none";
                });
                pageInfo.innerText = "Page " + page + " of " + totalPages;
                prevBtn.disabled = page === 1;
                nextBtn.disabled = page === totalPages || totalPages === 0;
            }

            prevBtn.replaceWith(prevBtn.cloneNode(true));
            nextBtn.replaceWith(nextBtn.cloneNode(true));
            var np = document.getElementById("prevBtn");
            var nn = document.getElementById("nextBtn");
            np.addEventListener("click", function () { if (currentPage > 1) { currentPage--; showPage(currentPage); } });
            nn.addEventListener("click", function () { if (currentPage < totalPages) { currentPage++; showPage(currentPage); } });
            showPage(currentPage);
        }

        document.addEventListener("DOMContentLoaded", function () { initializePagination(); });
    </script>
}
