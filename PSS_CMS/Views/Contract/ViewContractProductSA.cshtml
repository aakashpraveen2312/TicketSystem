@model PSS_CMS.Models.Contract
@using GridMvc.Html

@{ ViewData["Title"] = "Contract View";
                ViewBag.PageTitle = "Contract View";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-earmark-text nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductListView", "Contract")">Contract</a>
    <i class="bi bi-chevron-right"></i>
    <span>View</span>
</div>

@using (Html.BeginForm("EditContractProduct", "Contract", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{<!-- Main Card -->
                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-file-earmark-text" style="font-size:15px;color:#3C3489;"></i>
                            </span>
                            Contract Details
                        </h6>
                    </div>

                    <!-- Form Body -->
                    <div class="form-body">

                        <div class="form-grid">

                            <div class="form-group">
                                @Html.LabelFor(m => m.SC_CODE, "Code", new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CODE, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_CONTRACTREFERENCENUMBER, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CONTRACTREF, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_FROMDATE, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_FROMDATE, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", type = "date", @readonly = "readonly" } })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_TODATE, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_TODATE, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", type = "date", @readonly = "readonly" } })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_CONTRACTAMOUNT, "Contract Amount", new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CONTRACTAMOUNT, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-input-auto",
                                        autocomplete = "off",
                                        @readonly = "readonly"
                                    }
                                })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_SORTORDER, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_SORT, new
                                {
                                    htmlAttributes = new
                                    {
                                        @class = "form-input-auto",
                                        autocomplete = "off",
                                        type = "text",
                                        @readonly = "readonly",
                                        placeholder = "0"
                                    }
                                })
                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <div class="form-grid">

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_CONTRACTCREATEDBY, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CONTRACTCREATEDBY, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_CONTRACTAPPROVEDBY, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CONTRACTAPPROVEDBY, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.CT_CONTRACTAPPROVEDDATE, new { @class = "form-label" })
                                @Html.EditorFor(m => m.CP_CONTRACTAPPROVEDDATE, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", type = "date", @readonly = "readonly" } })
                            </div>

                        </div>

                        <div class="form-divider"></div>
                        <p class="form-section-title">Settings</p>
                        <div class="form-grid">

                            <label class="check-row" for="CPDISABLE">
                                @Html.CheckBoxFor(m => m.CPDISABLE, new { @class = "form-check-input", id = "CPDISABLE", disabled = "disabled" })
                                <div class="check-row-label">
                                    <span>@Html.DisplayNameFor(m => m.CPDISABLE)</span>
                                    <small>Hide this contract from active listings</small>
                                </div>
                            </label>

                        </div>

                    </div>

                    <!-- Legend bar -->
                    <div class="legend-bar">
                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
                            <span>Read-only Field</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("ContractProductListView", "Contract")" class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>

                </div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            // Set product name on page load
            var productName = $("#SelectedProduct option:selected").text();
            $("#CP_PRODUCTNAME").val(productName);

            // Update product name when dropdown changes
            $("#SelectedProduct").change(function () {
                var productName = $("#SelectedProduct option:selected").text();
                $("#CP_PRODUCTNAME").val(productName);
            });

        });
    </script>

    <script>
        $(document).ready(function () {
            var selectedAdmin = '@Model.CP_ADMINRECID';
            var cmprecid = '@Session["CompanyID"]';

            function loadAdmins() {
                var productId = $("#SelectedProduct").val();

                if (!productId) {
                    $("#AdminDropdown").empty().append('<option value="">-- Select Admin --</option>').prop("disabled", true);
                    $("#CP_ADMINRECID").val('');
                    return;
                }

                $("#AdminDropdown").prop("disabled", true);
                $("#AdminDropdown").html('<option>Loading admins...</option>');

                $.ajax({
                    url: '@Url.Action("GetProductAdmins", "Contract")',
                    type: 'GET',
                    data: { cmprecid: cmprecid, precid: productId },
                    success: function (res) {
                        $("#AdminDropdown").empty();

                        if (res.status === "Y" && Array.isArray(res.data) && res.data.length > 0) {
                            $("#AdminDropdown").append('<option value="">-- Select Admin --</option>');

                            $.each(res.data, function (index, admin) {
                                var option = $('<option></option>')
                                    .val(admin.u_RECID)
                                    .text(admin.u_USERNAME);

                                if (selectedAdmin && admin.u_RECID.toString() === selectedAdmin.toString()) {
                                    option.prop('selected', true);
                                    $("#CP_ADMINRECID").val(selectedAdmin);
                                }

                                $("#AdminDropdown").append(option);
                            });

                            $("#AdminDropdown").prop("disabled", false);
                        } else {
                            $("#AdminDropdown").append('<option value="">No Admin Found</option>');
                            $("#AdminDropdown").prop("disabled", true);
                            $("#CP_ADMINRECID").val('');
                        }
                    },
                    error: function () {
                        $("#AdminDropdown").empty().append('<option value="">Error loading admins</option>').prop("disabled", true);
                        $("#CP_ADMINRECID").val('');
                    }
                });
            }

            $("#SelectedProduct").on("change", function () { loadAdmins(); });
            $("#AdminDropdown").on("change", function () { $("#CP_ADMINRECID").val($(this).val()); });

            if ($("#SelectedProduct").val()) { loadAdmins(); }
        });
    </script>
}
