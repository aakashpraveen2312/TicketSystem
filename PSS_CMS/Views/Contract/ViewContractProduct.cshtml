@model PSS_CMS.Models.Contract

@{ ViewData["Title"] = "View Contract";
                ViewBag.PageTitle = "View Contract";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-text nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">Party</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">
        @(Session["CT_CUSTOMERNAME"] != null ? Session["CT_CUSTOMERNAME"].ToString() : "")
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>Contract</span>
    <i class="bi bi-chevron-right"></i>
    <span>View</span>
</div>

<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#E1F5EE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-eye" style="font-size:15px;color:#085041;"></i>
            </span>
            View Contract
        </h6>
    </div>

    <!-- Form Body -->
    <div class="form-body">

        <!-- Section: Basic Info -->

        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label">
                   Code
                </label>
                @Html.EditorFor(m => m.CP_CODE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>

            <!-- Contract Reference Number -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTREFERENCENUMBER)
                </label>
                @Html.EditorFor(m => m.CP_CONTRACTREF, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-lock"></i> Read-only
                </span>
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Contract Period -->


        <div class="form-grid">

            <!-- From Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_FROMDATE)
                </label>
                @Html.EditorFor(m => m.CP_FROMDATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        type = "date",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

            <!-- To Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_TODATE)
                </label>
                @Html.EditorFor(m => m.CP_TODATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        type = "date",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

            <!-- Contract Amount -->
            <div class="form-group">
                <label class="form-label">Contract Amount</label>
                @Html.EditorFor(m => m.CP_CONTRACTAMOUNT, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        inputmode = "decimal",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

            <!-- Created By -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTCREATEDBY)
                </label>
                @Html.EditorFor(m => m.CP_CONTRACTCREATEDBY, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Authorization -->

        <div class="form-grid">



            <!-- Approved By -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTAPPROVEDBY)
                </label>
                @Html.EditorFor(m => m.CP_CONTRACTAPPROVEDBY, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

            <!-- Approved Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTAPPROVEDDATE)
                </label>
                @Html.EditorFor(m => m.CP_CONTRACTAPPROVEDDATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        type = "date",
                        @readonly = "readonly"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_SORTORDER)
                </label>
                @Html.EditorFor(m => m.CP_SORT, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        type = "text",
                        @readonly = "readonly",
                        placeholder = "0"
                    }
                })
                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only</span>
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Settings -->
        <p class="form-section-title">Settings</p>

        <div class="form-grid" style="margin-top:8px;">

            <!-- Disable (view-only) -->
            <label class="check-row" style="cursor:default;">
                @Html.CheckBoxFor(m => m.CPDISABLE, new
                {
                    @class = "form-check-input",
                    id = "cpdisableCheckbox",
                    disabled = "disabled"
                })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.CPDISABLE)</span>
                    <small>Indicates if this contract is hidden from active listings</small>
                </div>
            </label>

        </div>

    </div>

    <!-- Legend Bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only Field</span>
        </div>
    </div>

    <!-- Actions — view mode has only Back button -->
    <div class="form-actions">
        <a href="@Url.Action("ContractProductList", "Contract")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        /* ── Product name sync (kept for parity if SelectedProduct exists) ── */
        $(document).ready(function () {
            var productName = $("#SelectedProduct option:selected").text();
            $("#CP_PRODUCTNAME").val(productName);

            $("#SelectedProduct").on("change", function () {
                $("#CP_PRODUCTNAME").val($(this).find(":selected").text());
            });
        });
    </script>
}
