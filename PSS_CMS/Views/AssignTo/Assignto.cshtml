@model PSS_CMS.Models.AssignTo

@{ ViewData["Title"] = "Assign To";
                ViewBag.PageTitle = "Assign To";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── 3-column grid ──────────────────────── */
        .form-grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 18px;
        }

        @@media (max-width: 768px) {
            .form-grid-3 { grid-template-columns: 1fr; }
        }

    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    <span>Assign To</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Assignto", "AssignTo", FormMethod.Post,
    new { id = "AdminResponseForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-person-check"></i>
            </span>
            Assign Ticket
        </h6>
    </div>

    <div class="form-body">

        <!-- ── Assignment Details ──────────── -->

        <div class="form-grid-3">

            <!-- Assigned Date -->
            <div class="form-group">
                <label class="form-label" for="assigneddate">
                    Assigned Date &amp; Time <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.A_ASSIGNEDDATEANDTIME, new
                {
                    @class = "form-input-text",
                    id = "assigneddate",
                    type = "datetime-local",
                    required = "required",
                    tabindex = "1"
                })
            </div>

            <!-- Select Admin -->
            <div class="form-group">
                <label class="form-label" for="SelectedAdmin">
                    Select Admin <span class="req">*</span>
                </label>

                @if (ViewBag.Admin != null)
                {
                    var admin = ViewBag.Admin as IEnumerable<SelectListItem>;
                    if (admin != null && admin.Any())
                    {
                        var modifiedAdmin = new List<SelectListItem>(admin);
                        if (admin.Count() > 1)
                        {
                            modifiedAdmin.Insert(0, new SelectListItem { Text = "-- Select Admin --", Value = "" });
                        }
@Html.DropDownList("SelectedAdmin", modifiedAdmin,
         new { @class = "form-input-text", required = "required", tabindex = "2" }) }
                    else
                    {
                        var emptyList = new List<SelectListItem>
                            {
                                new SelectListItem { Text = "No admins available", Value = "" }
                            };
@Html.DropDownList("SelectedAdmin", emptyList, new { @class = "form-input-text" }) }
                }
                else
                {
<p style="font-size:12px;color:var(--text-muted);">No admins available</p>}
            </div>

            <!-- Expected Completion Date -->
            <div class="form-group">
                <label class="form-label" for="expecteddate">
                    Expected Completion Date <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.A_EXPECTEDDATEANDTIME, new
                {
                    @class = "form-input-text",
                    id = "expecteddate",
                    type = "datetime-local",
                    required = "required",
                    tabindex = "3"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Comments ────────────────────── -->

        <div class="form-group">
            <label class="form-label" for="A_COMMENTS">
                Comments
            </label>
            @Html.TextAreaFor(m => m.A_COMMENTS, new
            {
                @class = "form-textarea",
                placeholder = "Please enter your assignment notes here…",
                rows = "7",
                required = "required",
                tabindex = "4"
            })
            @Html.ValidationMessageFor(m => m.A_COMMENTS, "", new { @class = "text-danger", style = "font-size:11px" })
        </div>

    </div>

    <!-- Legend bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Input Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("RecentTicket","RecentTickets")"
           class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit"
                class="btn-save"
                id="submitBtn"
                tabindex="5">
            <i class="bi bi-person-check"></i> Assign
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Set both date fields to now on load ── */
        (function () {
            function nowLocalISO() {
                var d = new Date();
                return d.getFullYear() + '-' +
                    String(d.getMonth() + 1).padStart(2, '0') + '-' +
                    String(d.getDate()).padStart(2, '0') + 'T' +
                    String(d.getHours()).padStart(2, '0') + ':' +
                    String(d.getMinutes()).padStart(2, '0');
            }
            var now = nowLocalISO();
            var ad = document.getElementById('assigneddate');
            var ed = document.getElementById('expecteddate');
            if (ad && !ad.value) ad.value = now;
            if (ed && !ed.value) ed.value = now;
        })();

        /* ── AJAX submit — processing spinner first ── */
        $(document).ready(function () {

            $("#AdminResponseForm").submit(function (e) {
                e.preventDefault();

                var btn      = $("#submitBtn");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Assignto","AssignTo")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton:  "swal-btn-back"
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) { location.reload(); }
                                            else { window.location.href = '@Url.Action("RecentTicket","RecentTickets")'; }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() { $("#submitBtn").prop("disabled", false); }
        });
    </script>
}
