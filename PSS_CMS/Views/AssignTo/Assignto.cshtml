@model PSS_CMS.Models.AssignTo

@{ ViewData["Title"] = "Assign To";
    ViewBag.PageTitle = "Assign To";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── 3-column grid ──────────────────────── */
        .form-grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 18px;
        }

        @@media (max-width: 768px) {
            .form-grid-3 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    <span>Assign To</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Assignto", "AssignTo", FormMethod.Post,
    new { id = "AdminResponseForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-person-check"></i>
            </span>
            Assign Ticket
        </h6>
    </div>

    <div class="form-body">

        <!-- ── Assignment Details ──────────── -->

        <div class="form-grid-3">

            <!-- Assigned Date -->
            <div class="form-group">
                <label class="form-label" for="assigneddate">
                    Assigned Date &amp; Time <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.A_ASSIGNEDDATEANDTIME, new
                {
                    @class = "form-input-text",
                    id = "assigneddate",
                    type = "datetime-local",
                    required = "required",
                    tabindex = "1"
                })
            </div>

            <!-- Select Admin -->
            <div class="form-group">
                <label class="form-label" for="SelectedAdmin">
                    Select Admin <span class="req">*</span>
                </label>

                @if (ViewBag.Admin != null)
                {
                    var admin = ViewBag.Admin as IEnumerable<SelectListItem>;
                    if (admin != null && admin.Any())
                    {
                        var modifiedAdmin = new List<SelectListItem>(admin);
                        if (admin.Count() > 1)
                        {
                            modifiedAdmin.Insert(0, new SelectListItem { Text = "-- Select Admin --", Value = "" });
                        }
@Html.DropDownList("SelectedAdmin", modifiedAdmin,
         new { @class = "form-input-text", required = "required", tabindex = "2" }) }
else
{
var emptyList = new List<SelectListItem>
{
                                new SelectListItem { Text = "No admins available", Value = "" }
                            };
@Html.DropDownList("SelectedAdmin", emptyList, new { @class = "form-input-text" }) }
}
else
{
<p style="font-size:12px;color:var(--text-muted);">No admins available</p>}
            </div>

            <!-- Expected Completion Date -->
            <div class="form-group">
                <label class="form-label" for="expecteddate">
                    Expected Completion Date <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.A_EXPECTEDDATEANDTIME, new
                {
                    @class = "form-input-text",
                    id = "expecteddate",
                    type = "date",
                    required = "required",
                    tabindex = "3"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Comments ────────────────────── -->

        <div class="form-group">
            <label class="form-label" for="A_COMMENTS">
                Comments
            </label>
            @Html.TextAreaFor(m => m.A_COMMENTS, new
            {
                @class = "form-textarea",
                placeholder = "Please enter your assignment notes here…",
                rows = "7",
                required = "required",
                tabindex = "4"
            })
            @Html.ValidationMessageFor(m => m.A_COMMENTS, "", new { @class = "text-danger", style = "font-size:11px" })
        </div>

    </div>

    <!-- Legend bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Input Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("RecentTicket","RecentTickets")"
           class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit"
                class="btn-save"
                id="submitBtn"
                tabindex="5">
            <i class="bi bi-person-check"></i> Assign
        </button>
    </div>

</div>}

<!-- ── Assigned Tickets Panel ── -->
<div id="assignedTicketsPanel" style="display:none;margin-top:20px;">

    <!-- Summary chips -->
    <div class="page-card" style="margin-bottom:16px;">
        <div class="page-card-header">
            <h6 class="page-card-title">
                <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-list-check" style="font-size:15px;color:#3C3489;"></i>
                </span>
                Assigned Ticket Summary
            </h6>
            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <span class="custom-badge badge-warning">
                    Assigned: <strong id="statAssigned">0</strong>
                </span>
                <span class="custom-badge" style="background:#E1F5EE;color:#085041;">
                    Completed: <strong id="statCompleted">0</strong>
                </span>
            </div>
        </div>
    </div>

    <!-- Tickets table -->
    <div class="page-card">
        <div class="page-card-header">
            <h6 class="page-card-title">
                <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                    <i class="bi bi-ticket-detailed" style="font-size:15px;color:#3C3489;"></i>
                </span>
                Ticket Details
            </h6>
        </div>
        <div class="grid-wrap">
            <table id="assignedTicketTable">
                <thead>
                    <tr>
                        <th>Ref No</th>
                        <th>User</th>
                        <th>Subject</th>
                        <th>Product Serial</th>
                        <th>Ticket Type</th>
                        <th>Priority</th>
                        <th>Assigned Date</th>
                        <th>Expected Date</th>
                        <th style="text-align:center;">Status</th>
                    </tr>
                </thead>
                <tbody id="assignedTicketBody">
                </tbody>
            </table>
        </div>

        <div id="assignedTicketsEmpty" style="display:none;padding:48px 20px;text-align:center;color:var(--text-muted);">
            <i class="bi bi-inbox" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
            <span style="font-size:14px;font-weight:600;">No assigned tickets found</span>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Set both date fields to now on load ── */
        (function () {
            function nowLocalISO() {
                var d = new Date();
                return d.getFullYear() + '-' +
                    String(d.getMonth() + 1).padStart(2, '0') + '-' +
                    String(d.getDate()).padStart(2, '0') + 'T' +
                    String(d.getHours()).padStart(2, '0') + ':' +
                    String(d.getMinutes()).padStart(2, '0');
            }
            var now = nowLocalISO();
            var ad = document.getElementById('assigneddate');
            var ed = document.getElementById('expecteddate');
            if (ad && !ad.value) ad.value = now;
            if (ed && !ed.value) ed.value = now;
        })();

        /* ── AJAX submit — processing spinner first ── */
        $(document).ready(function () {

            $("#AdminResponseForm").submit(function (e) {
                e.preventDefault();

                var btn      = $("#submitBtn");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Assignto","AssignTo")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton:  "swal-btn-back"
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) { location.reload(); }
                                            else { window.location.href = '@Url.Action("RecentTicket","RecentTickets")'; }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() { $("#submitBtn").prop("disabled", false); }
        });
    </script>

    <script>
$(document).ready(function () {

    // ── Load assigned tickets when admin changes ──
    $("#SelectedAdmin").on("change", function () {
        loadAssignedTickets();
    });

    // ── Also reload when expected date changes ──
    $("#expecteddate").on("change", function () {
        if ($("#SelectedAdmin").val()) loadAssignedTickets();
    });

    function loadAssignedTickets() {

        var adminId      = $("#SelectedAdmin").val();
        var expectedDate = $("#expecteddate").val();
        var cmprecid     = '@Session["CompanyID"]';

        if (!adminId) {
            $("#assignedTicketsPanel").hide();
            return;
        }

        // Show panel with loading state
        $("#assignedTicketsPanel").show();
        $("#assignedTicketBody").html(
            '<tr><td colspan="10" style="text-align:center;padding:20px;color:var(--text-muted);">' +
            '<i class="bi bi-hourglass-split"></i> Loading tickets...</td></tr>'
        );
        $("#assignedTicketsEmpty").hide();

        $.ajax({
            url: '@Url.Action("AssignedTicketList", "AssignTo")',
            type: 'GET',
            data: {
                cmprecid:             cmprecid,
                TC_ASSIGNTOURECID:    adminId,
                TC_EXPECTEDDATETIME:  expectedDate
            },
            success: function (response) {

                // Update summary chips
               
                $("#statAssigned").text(response.AssignedCount || 0);
                $("#statCompleted").text(response.AssignedCompletedCount || 0);

                var tickets = response.TicketDetails || [];
                var $body   = $("#assignedTicketBody").empty();

                if (tickets.length === 0) {
                    $body.closest(".grid-wrap").hide();
                    $("#assignedTicketsEmpty").show();
                    return;
                }

                $body.closest(".grid-wrap").show();
                $("#assignedTicketsEmpty").hide();

                $.each(tickets, function (i, t) {

                    var st      = (t.TC_STATUS || "").trim();
                    var stClass = st === "S" ? "badge-pending"
                                : st === "R" ? "badge-processed"
                                : st === "C" ? "custom-badge"
                                : "badge-pending";
                    var stText  = st === "S" ? "Submitted"
                               : st === "R" ? "Resolved"
                               : st === "C" ? "Closed"
                               : st === "O" ? "Re-Opened" : st;

                    var priClass = (t.TC_PRIORITYTYPE || "").toLowerCase() === "urgent"    ? "color:#c47a00"
                                 : (t.TC_PRIORITYTYPE || "").toLowerCase() === "critical"  ? "color:#e74c3c"
                                 : (t.TC_PRIORITYTYPE || "").toLowerCase() === "emergency" ? "color:#3C3489"
                                 : "color:var(--text-muted)";

                    var assignedDt = t.TC_ASSIGNETODATETIME
                        ? new Date(t.TC_ASSIGNETODATETIME).toLocaleString('en-IN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })
                        : '-';

                    var expectedDt = t.TC_EXPECTEDDATETIME
                        ? new Date(t.TC_EXPECTEDDATETIME).toLocaleString('en-IN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' })
                        : '-';

                    var row = '<tr>' +
                        '<td><span class="contract-code">' + (t.TC_REFERENCENO || '-') + '</span></td>' +
                        '<td>' + (t.TC_USERNAME || '-') + '</td>' +
                        '<td>' + (t.TC_SUBJECT  || '-') + '</td>' +
                        '<td style="font-size:12px;">' + (t.TC_PRODUCTSERIALNUMBER || '-') + '</td>' +
                        '<td><span class="service-badge">' + (t.TC_TICKETTYPE || '-') + '</span></td>' +
                        '<td><span style="font-size:12px;font-weight:600;' + priClass + '">' + (t.TC_PRIORITYTYPE || '-') + '</span></td>' +
                        '<td style="font-size:12px;color:var(--text-muted);">' + assignedDt + '</td>' +
                        '<td style="font-size:12px;color:var(--text-muted);">' + expectedDt + '</td>' +
                        '<td style="text-align:center;"><span class="' + stClass + '">' + stText + '</span></td>' +
                        '</tr>';

                    $body.append(row);
                });
            },
            error: function () {
                $("#assignedTicketBody").html(
                    '<tr><td colspan="10" style="text-align:center;padding:20px;color:#e74c3c;">' +
                    '<i class="bi bi-exclamation-circle"></i> Failed to load tickets.</td></tr>'
                );
            }
        });
    }
});
    </script>


}
