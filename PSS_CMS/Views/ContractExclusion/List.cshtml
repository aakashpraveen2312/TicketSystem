@model IEnumerable<PSS_CMS.Models.ContractExclusion>
@using GridMvc.Html

@{ ViewData["Title"] = "Contract Exclusion List";
    ViewBag.PageTitle = "Contract Exclusion List";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-tools nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">@Session["CT_CUSTOMERNAME"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductList", "Contract")">Contract (@Session["CP_CODE"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "ContractProduct")">@Session["CT_CONTRACTREFERENCENUMBER"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <span>Contract Exclusion</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">


        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("List", "ContractExclusion", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>
    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]" />
</div>      }

            <!-- Add Button -->
            <a href="@Url.Action("Create", "ContractExclusion")" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add Exclusion
            </a>

        </div>
    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">
        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">
    <thead>
        <tr>
            <th style="width:60px;">S.No</th>
            <th>Description</th>
            <th style="width:80px;text-align:right;">Sort</th>
            <th style="width:90px;text-align:center;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
<tr>
    <td>
        <span class="serial-text">@item.SerialNumber</span>
    </td>
    <td>@item.CEX_DESCRIPTION</td>
    <td style="text-align:right;">@item.CEX_SORTORDER</td>
    <td>
        <div class="action-cell">
            <a href="@Url.Action("Edit", "ContractExclusion", new { CEX_RECID = item.CEX_RECID, CEX_PRECID = item.CEX_PRECID, CEX_DESCRIPTION = item.CEX_DESCRIPTION })"
               class="act-btn act-edit"
               title="Edit">
                <i class='bx bxs-pencil'></i>
            </a>
            <a href="@Url.Action("Delete", "ContractExclusion", new { CEX_RECID = item.CEX_RECID })"
               class="act-btn act-delete no-loader"
               title="Delete"
               onclick="return confirmDelete(this);">
                <i class='bx bxs-trash'></i>
            </a>
        </div>
    </td>
</tr>}
    </tbody>
</table> <!-- Pagination -->

                <div class="table-pagination">

                    <button id="prevBtn"
                            class="page-btn">

                        <i class="bi bi-chevron-left"></i>

                        Previous

                    </button>

                    <span id="pageInfo"
                          class="page-info">
                    </span>

                    <button id="nextBtn"
                            class="page-btn">

                        Next

                        <i class="bi bi-chevron-right"></i>

                    </button>

                </div>}
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-inbox" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No Contract Exclusions are available</span>
</div>}
    </div>

</div><!-- /page-card -->
<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <span class="act-btn act-edit"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-pencil'></i>

        </span>

        Edit

    </div>

    <div class="legend-item">

        <span class="act-btn act-delete"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-trash'></i>

        </span>

        Delete

    </div>

</div>

@section Scripts {
    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <!-- Live search filter -->
    <script>
        document.getElementById("searchPharse").addEventListener("input", function () {
            var term = this.value.toLowerCase();
            document.querySelectorAll(".grid-wrap tbody tr").forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(term) ? "" : "none";
            });
        });
    </script>
}
