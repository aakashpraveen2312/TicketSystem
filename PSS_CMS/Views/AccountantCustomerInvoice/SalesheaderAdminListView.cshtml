@model IEnumerable<PSS_CMS.Models.Salesheader>

@{
    ViewData["Title"] = "Sales Invoice";
    ViewBag.PageTitle = "Sales Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <!-- List view Css -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-receipt"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Sales Invoice</span>

    <i class="bi bi-chevron-right"></i>

    List

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">
            <!-- Search -->

            @using (Html.BeginForm(
                "",
                "",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("","")"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:60px;">
                            S.No
                        </th>

                        <th>
                            Invoice No.
                        </th>

                        <th>
                            Invoice Date
                        </th>

                        <th class="text-end">
                            Amount (₹)
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                        <th class="text-center"
                            style="width:160px;">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var status = o.SIH_STATUS ?? "";

                        var viewUrl = Url.Action(
                            "SalesheaderAdminView",
                            "AccountantCustomerInvoice",
                            new { Recid = o.SIH_RECID });

                        var processUrl = Url.Action(
                            "ProcessInvoice",
                            "AccountantCustomerInvoice",
                            new { Recid = o.SIH_RECID });

                        var unlockUrl = Url.Action(
                            "UnlockInvoice",
                            "AccountantCustomerInvoice",
                            new { Recid = o.SIH_RECID });

                        var productUrl = Url.Action(
                            "ProductAdminView",
                            "SalesInvoiceProduct",
                            new
                            {
                                SalesinvoiceRecID = o.SIH_RECID,
                                customerid = o.SIH_CURECID,
                                status = o.SIH_STATUS
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>

                                <span class="invoice-no">
                                    @o.SIH_INVOICENO
                                </span>

                            </td>

                            <td>

                                @(string.IsNullOrEmpty(o.SIH_INVOICEDATE)
                                    ? ""
                                    : Convert.ToDateTime(o.SIH_INVOICEDATE)
                                        .ToString("dd-MM-yyyy"))

                            </td>

                            <td class="text-end">

                                <span class="amount-cell">
                                    ₹ @String.Format("{0:N2}", o.SIH_INVOICEAMOUNT)
                                </span>

                            </td>

                            <td class="text-center">

                                @if (status == "P")
                                {
                                    <span class="status-badge status-processed">

                                        <i class="bi bi-lock-fill"></i>

                                        Processed

                                    </span>
                                }
                                else if (status == "U")
                                {
                                    <span class="status-badge status-unlocked">

                                        <i class="bi bi-unlock-fill"></i>

                                        Unlocked

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">

                                        <i class="bi bi-clock"></i>

                                        Pending

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- View -->

                                    <a href="@viewUrl"
                                       title="View Invoice"
                                       class="act-btn act-view">

                                        <i class='bx bx-show'></i>

                                    </a>

                                    <!-- Products -->

                                    <a href="@productUrl"
                                       title="View Products"
                                       class="act-btn act-product">

                                        <i class='bi bi-box-seam'></i>

                                    </a>

                                    <!-- Unlock -->

                                    @if (status == "P")
                                    {
                                        <a href="javascript:void(0);"
                                           onclick='confirmUnlock("@unlockUrl", @o.SIH_RECID)'
                                           title="Unlock Invoice"
                                           class="act-btn act-unlock">

                                            <i class='bx bx-lock-open'></i>

                                        </a>
                                    }

                                    <!-- Process -->

                                    @if (status != "P" && status != "U")
                                    {
                                        <a href="javascript:void(0);"
                                           onclick='confirmProcess("@processUrl")'
                                           title="Process Invoice"
                                           class="act-btn act-process">

                                            <i class='bx bx-lock'></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-receipt"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">
                    No sales invoices available
                </p>

            </div>
        }

    </div>



</div>
<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <span class="act-btn act-view"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bx-show'></i>

        </span>

        View

    </div>

    <div class="legend-item">

        <span class="act-btn act-product"
              style="width:22px;height:22px;font-size:13px">

            <i class='bi bi-box-seam'></i>

        </span>

        View Products

    </div>

    <div class="legend-item">

        <span class="act-btn act-unlock"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bx-lock-open'></i>

        </span>

        Unlock

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        // Process Invoice

        function confirmProcess(url) {

            Swal.fire({
                title: '<span style="font-size:18px">Process Invoice?</span>',
                html: '<div style="font-size:14px">Do you want to process this invoice?</div>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6c5ce7',
                cancelButtonColor: '#e17055',
                confirmButtonText: 'Yes, Process',
                cancelButtonText: 'Cancel'
            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href = url;
                }
            });
        }

        // Unlock Invoice

        function confirmUnlock(url, recid) {

            Swal.fire({
                title: '<span style="font-size:18px">Unlock Invoice</span>',
                input: 'textarea',
                inputLabel: 'Enter Unlock Reason',
                inputPlaceholder: 'Type your reason here...',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6c5ce7',
                cancelButtonColor: '#e17055',
                confirmButtonText: 'Unlock',
                cancelButtonText: 'Cancel',

                preConfirm: (reason) => {

                    if (!reason || reason.trim() === '') {

                        Swal.showValidationMessage('Reason is required!');
                    }

                    return reason;
                }

            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href =
                        url + '&reason=' +
                        encodeURIComponent(result.value);
                }
            });
        }

        // TempData Success

        @if (TempData["SuccessMessage"] != null)
        {
            <text>

            Swal.fire({
                icon: 'success',
                title: 'Success',
                text: '@TempData["SuccessMessage"]',
                timer: 2500,
                showConfirmButton: false
            });

            </text>
        }

        // TempData Error

        @if (TempData["ErrorMessage"] != null)
        {
            <text>

            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#6c5ce7'
            });

            </text>
        }

    </script>

    <script src="~/Scripts/UIPagination.js"></script>
}