@model IEnumerable<PSS_CMS.Models.User>

@{
    ViewData["Title"] = "Mapped Users";
    ViewBag.PageTitle = "Warranty Products";
    ViewBag.PageSubtitle = "Mapped Users";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var prodName = Session["prodname"] != null
        ? Session["prodname"].ToString()
        : "";
}

@section Styles {

    <!-- List view Css -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-shield-check nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "ProductMaster")">
        Warranty Products
    </a>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "ProductMaster")">
        @prodName
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Mapped Users</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm(
                "View",
                "ProductMaster",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <input type="hidden"
                       id="Recid"
                       name="Recid"
                       value="@Request["Recid"]" />

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action(
                            "View",
                            "ProductMaster",
                            new { Recid = Request["Recid"] })"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th>
                            Code
                        </th>

                        <th>
                            Name
                        </th>

                        <th>
                            Email ID
                        </th>

                        <th>
                            Mobile Number
                        </th>

                        <th class="text-center"
                            style="width:140px;">
                            Role
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        <tr>

                            <td>
                                @o.U_USERCODE
                            </td>

                            <td>
                                @o.U_USERNAME
                            </td>

                            <td>
                                @o.U_EMAILID
                            </td>

                            <td>
                                @o.U_MOBILENO
                            </td>

                            <td class="text-center">

                                <span class="role-pill">
                                    @o.U_RCODE
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-people"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">
                    No users mapped to this product
                </p>


            </div>
        }

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}