@model IEnumerable<PSS_CMS.Models.ContractServiceProduct>

@{ ViewData["Title"] = "Contract Products";
                ViewBag.PageTitle = "Contract Products";
                Layout = "~/Views/Shared/_Layout.cshtml";

                var customerName = Session["CT_CUSTOMERNAME"] != null
                    ? Session["CT_CUSTOMERNAME"].ToString()
                    : "";

                var cpCode = Session["CP_CODE"] != null
                    ? Session["CP_CODE"].ToString()
                    : "";

                var cpStatus = Session["CP_STATUS"] != null
                    ? Session["CP_STATUS"].ToString()
                    : "";

                var isUnlocked = cpStatus == "U"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-file-earmark-text nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Party</span>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("ContractList", "Contract")">
        @customerName
    </a>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("ContractProductList", "Contract")">
        Contract (@cpCode)
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Products</span>

</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm("List",
                "ContractProduct",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
<div class="search-box">

    <i class="bi bi-search"></i>

    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />

    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("List", "ContractProduct")"
   title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}

</div>            }

            @if (isUnlocked)
            {
<a href="@Url.Action("Create", "ContractProduct")"
   class="btn-add">

    <i class="bi bi-plus-lg"></i>

    Add Product

</a>            }

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>

        <tr>

            <th>
                Serial Number
            </th>

            <th>
                Product Name
            </th>

           

            <th>
                Admin Name
            </th>

            <th class="text-center">
                Free Services
            </th>

            <th class="text-right"
                style="text-align:right;">
                Invoice Amount
            </th>

            <th class="text-right"
                style="text-align:right;">
                Paid Amount
            </th>

            <th class="text-center"
                style="width:140px;">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var o in Model)
        {
            var editUrl = Url.Action("Edit", "ContractProduct", new
            {
                CSP_RECID = o.CSP_RECID,
                CSP_CRECID = o.CSP_CRECID,
                CSP_CURECID = o.CSP_CURECID,
                CSP_PRECID = o.CSP_PRECID,
                CSP_ARECID = o.CSP_ARECID
            });

            var viewUrl = Url.Action("View", "ContractProduct", new
            {
                CSP_RECID = o.CSP_RECID,
                CSP_CRECID = o.CSP_CRECID,
                CSP_CURECID = o.CSP_CURECID,
                CSP_PRECID = o.CSP_PRECID,
                CSP_ARECID = o.CSP_ARECID
            });

            var deleteUrl = Url.Action("Delete", "ContractProduct", new
            {
                CSP_RECID = o.CSP_RECID,
                CSP_CRECID = o.CSP_CRECID,
                CSP_CURECID = o.CSP_CURECID,
                CSP_PRECID = o.CSP_PRECID,
                CSP_ARECID = o.CSP_ARECID
            });

            var inclusionUrl = Url.Action("List", "ContractInclusion", new
            {
                CP_PRECID = o.CSP_PRECID,
                CSP_PRODUCTNAME = o.CSP_PRODUCTNAME
            });

            var exclusionUrl = Url.Action("List", "ContractExclusion", new
            {
                CP_PRECID = o.CSP_PRECID,
                CT_CONTRACTREFERENCENUMBER = o.CSP_PRODUCTNAME
            });

<tr>

    <td>
        <span class="product-serial">@o.CSP_PRODUCTUNIQUENUMBER</span>
    </td>

    <td>
        <span style="font-weight:600;">@o.CSP_PRODUCTNAME</span>
    </td>

   

    <td>@o.CSP_ADMINNAME</td>

    <td class="text-center">
        <span class="service-badge">@o.CSP_FREESERVICE</span>
    </td>

    <td class="amount-cell">
        @String.Format("{0:N2}", o.CSP_INVOICEAMOUNT)
    </td>

    <td class="amount-cell">
        @String.Format("{0:N2}", o.CSP_PAIDAMOUNT)
    </td>

    <td>

        <div class="action-cell">

            @if (isUnlocked)
            {<!-- Edit -->
                        <a href="@editUrl"
                           title="Edit"
                           class="act-btn act-edit">
                            <i class='bx bxs-pencil'></i>
                        </a> <!-- Delete -->
                                                                        <a href="@deleteUrl"
                                                                           data-id="@o.CSP_RECID"
                                                                           data-name="@o.CSP_PRODUCTNAME"
                                                                           title="Delete"
                                                                           class="act-btn act-delete no-loader"
                                                                           onclick="return confirmDelete(this);">
                                                                            <i class='bx bxs-trash'></i>
                                                                        </a> }
                                                                                            else
                                                                                            { <!-- View -->
                                                                                                <a href="@viewUrl"
                                                                                                   title="View"
                                                                                                   class="act-btn act-view">
                                                                                                    <i class='bx bx-show'></i>
                                                                                                </a>}

            <!-- Inclusion -->
            <a href="@inclusionUrl"
               title="Inclusion"
               class="act-btn"
               style="color:#0984e3;">
                <i class='bi bi-plus-circle-dotted'></i>
            </a>

            <!-- Exclusion -->
            <a href="@exclusionUrl"
               title="Exclusion"
               class="act-btn"
               style="color:#e17055;">
                <i class='bi bi-dash-circle-dotted'></i>
            </a>

        </div>

    </td>

</tr>}

    </tbody>

</table> <!-- Pagination -->
                                <div class="table-pagination">

                                    <button id="prevBtn"
                                            class="page-btn">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </button>

                                    <span id="pageInfo"
                                          class="page-info">
                                    </span>

                                    <button id="nextBtn"
                                            class="page-btn">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </button>

                                </div> }
                                            else
                                            {
                                <div class="text-center py-5">

                                    <i class="bi bi-box-seam"
                                       style="font-size:40px;color:var(--text-muted)"></i>

                                    <p class="mt-2 text-muted fw-semibold">
                                        No products available
                                    </p>

                                    @if (isUnlocked)
                                    {
                    <a href="@Url.Action("Create", "ContractProduct")"
                       class="btn-add mt-2 d-inline-flex">
                        <i class="bi bi-plus-lg"></i>
                        Add First Product
                    </a>                }

                                </div>}

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    @if (isUnlocked)
    {
<div class="legend-item">
    <span class="act-btn act-edit"
          style="width:22px;height:22px;font-size:13px">
        <i class='bx bxs-pencil'></i>
    </span>
    Edit
</div>

                <div class="legend-item">
                    <span class="act-btn act-delete"
                          style="width:22px;height:22px;font-size:13px">
                        <i class='bx bxs-trash'></i>
                    </span>
                    Delete
                </div> }
                            else
                            {
                <div class="legend-item">
                    <span class="act-btn act-view"
                          style="width:22px;height:22px;font-size:13px">
                        <i class='bx bx-show'></i>
                    </span>
                    View
                </div>}

    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#0984e3;">
            <i class='bi bi-plus-circle-dotted'></i>
        </span>
        Inclusion
    </div>

    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#e17055;">
            <i class='bi bi-dash-circle-dotted'></i>
        </span>
        Exclusion
    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <script src="~/Scripts/Logoutjs.js"></script>

}
