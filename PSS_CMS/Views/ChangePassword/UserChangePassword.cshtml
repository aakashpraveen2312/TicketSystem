@model PSS_CMS.Models.Changepassword

@{ ViewData["Title"] = "Change Password";
                ViewBag.PageTitle = "Change Password";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Title icon ─────────────────────────── */
        .title-icon {
            width: 28px;
            height: 28px;
            border-radius: var(--border-radius-md, 8px);
            background: #EEEDFE;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .title-icon i {
                font-size: 15px;
                color: #534AB7;
            }

        /* ── Narrow card ────────────────────────── */
        .form-card-narrow {
            max-width: 100%;
        }

        /* ── Form body ──────────────────────────── */
        .form-body {
            padding: 28px 24px 12px;
        }

        /* ── Form group ─────────────────────────── */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 18px;
        }

        /* ── Label ──────────────────────────────── */
        .form-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

            .form-label .req {
                color: #E24B4A;
                margin-left: 2px;
            }

        /* ── Password input wrapper ─────────────── */
        .pw-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        /* ── Password input ─────────────────────── */
        .form-input-pw {
            border: 1px solid var(--border-color);
            border-left: 3px solid var(--primary);
            border-radius: 10px;
            padding: 8px 40px 8px 12px;
            font-size: 13px;
            color: var(--text-dark);
            background: #fff;
            outline: none;
            font-family: inherit;
            width: 100%;
            transition: border-color .15s, box-shadow .15s;
        }

            .form-input-pw:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99,89,210,.08);
            }

            .form-input-pw.is-valid {
                border-left-color: #1D9E75;
            }

            .form-input-pw.is-invalid {
                border-left-color: #E24B4A;
            }

        /* ── Eye toggle ─────────────────────────── */
        .pw-toggle {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 16px;
            padding: 0;
            display: flex;
            align-items: center;
            transition: color .15s;
        }

            .pw-toggle:hover {
                color: var(--primary);
            }

        /* ── Match message ──────────────────────── */
        .match-msg {
            font-size: 11px;
            font-weight: 500;
            margin-top: 3px;
            min-height: 16px;
        }

        .match-ok {
            color: #1D9E75;
        }

        .match-err {
            color: #E24B4A;
        }

        /* ── Password strength bar ──────────────── */
        .strength-bar-wrap {
            height: 4px;
            border-radius: 4px;
            background: var(--border-color);
            margin-top: 6px;
            overflow: hidden;
        }

        .strength-bar {
            height: 100%;
            border-radius: 4px;
            transition: width .3s, background .3s;
            width: 0;
        }

        .strength-label {
            font-size: 10px;
            font-weight: 500;
            color: var(--text-muted);
            margin-top: 3px;
        }

        /* ── Divider ────────────────────────────── */
        .form-divider {
            height: 1px;
            background: var(--border-color);
            margin: 4px 0 20px;
        }

        /* ── Actions ────────────────────────────── */
        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 16px 24px;
            border-top: 1px solid var(--border-color);
        }

        .btn-save {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 8px 22px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-save:hover {
                background: #5a4bd1;
            }

            .btn-save:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--body-bg);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 8px 22px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }

            .btn-cancel:hover {
                background: var(--border-color);
                color: var(--text-dark);
            }

        /* ── SweetAlert ─────────────────────────── */
        .swal-btn-continue {
            background-color: #6ed3d0 !important;
            color: #fff !important;
            border-radius: 8px;
            padding: 8px 20px;
            font-weight: 600;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-key nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Change Password</span>
</div>

<!-- Main Card (narrow) -->
@using (Html.BeginForm("ChangePassword", "ChangePassword", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data" }))
{
<div class="page-card form-card-narrow">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-key"></i>
            </span>
            Change Password
        </h6>
    </div>

    <!-- Form body -->
    <div class="form-body">

        <!-- New Password -->
        <div class="form-group">
            <label class="form-label" for="Newpassword">
                New Password <span class="req">*</span>
            </label>
            <div class="pw-wrap">
                @Html.PasswordFor(m => m.U_NewPassword, new
                {
                    @class = "form-input-pw",
                    id = "Newpassword",
                    required = "required",
                    autocomplete = "new-password",
                    placeholder = "Enter new password",
                    oninput = "checkStrength(); checkMatch();"
                })
                <button type="button" class="pw-toggle" onclick="togglePw('Newpassword', 'eyeNew')" tabindex="-1">
                    <i class="bi bi-eye" id="eyeNew"></i>
                </button>
            </div>
            <!-- Strength bar -->
            <div class="strength-bar-wrap">
                <div class="strength-bar" id="strengthBar"></div>
            </div>
            <span class="strength-label" id="strengthLabel"></span>
        </div>

        <div class="form-divider"></div>

        <!-- Confirm Password -->
        <div class="form-group">
            <label class="form-label" for="confirmPassword">
                Confirm Password <span class="req">*</span>
            </label>
            <div class="pw-wrap">
                @Html.PasswordFor(m => m.U_Changepassword, new
                {
                    @class = "form-input-pw",
                    id = "confirmPassword",
                    required = "required",
                    autocomplete = "new-password",
                    placeholder = "Re-enter new password",
                    oninput = "checkMatch()"
                })
                <button type="button" class="pw-toggle" onclick="togglePw('confirmPassword', 'eyeConfirm')" tabindex="-1">
                    <i class="bi bi-eye" id="eyeConfirm"></i>
                </button>
            </div>
            <span class="match-msg" id="matchMsg"></span>
        </div>

    </div>

    <!-- Legend bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Password Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("UserDashboardCount","UserDashboard")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton" disabled>
            <i class="bi bi-check-lg"></i> Update Password
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Show / hide password ────────────────── */
        function togglePw(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon  = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.className = 'bi bi-eye-slash';
            } else {
                input.type = 'password';
                icon.className = 'bi bi-eye';
            }
        }

        /* ── Password strength ───────────────────── */
        function checkStrength() {
            var pw  = document.getElementById('Newpassword').value;
            var bar = document.getElementById('strengthBar');
            var lbl = document.getElementById('strengthLabel');
            var score = 0;

            if (pw.length >= 8)          score++;
            if (/[A-Z]/.test(pw))        score++;
            if (/[0-9]/.test(pw))        score++;
            if (/[^A-Za-z0-9]/.test(pw)) score++;

            var widths = ['0%', '30%', '55%', '80%', '100%'];
            var colors = ['', '#E24B4A', '#f0a72d', '#185FA5', '#1D9E75'];
            var labels = ['', 'Weak', 'Fair', 'Good', 'Strong'];

            bar.style.width      = widths[score];
            bar.style.background = colors[score];
            lbl.textContent      = pw.length ? labels[score] : '';
            lbl.style.color      = colors[score];
        }

        /* ── Password match ──────────────────────── */
        function checkMatch() {
            var pw1  = document.getElementById('Newpassword').value;
            var pw2  = document.getElementById('confirmPassword').value;
            var msg  = document.getElementById('matchMsg');
            var btn  = document.getElementById('savebutton');
            var inp1 = document.getElementById('Newpassword');
            var inp2 = document.getElementById('confirmPassword');

            if (pw2 === '') {
                msg.textContent = '';
                btn.disabled    = true;
                inp2.className  = 'form-input-pw';
                return;
            }

            if (pw1 === pw2) {
                msg.textContent = '✓ Passwords match';
                msg.className   = 'match-msg match-ok';
                inp2.className  = 'form-input-pw is-valid';
                btn.disabled    = false;
            } else {
                msg.textContent = '✗ Passwords do not match';
                msg.className   = 'match-msg match-err';
                inp2.className  = 'form-input-pw is-invalid';
                btn.disabled    = true;
            }
        }

        /* ── AJAX submit — processing spinner first ── */
        $(document).ready(function () {

            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we update your password.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("ChangePassword","ChangePassword")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "OK",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: { confirmButton: "swal-btn-continue" }
                                        }).then(function () {
                                            window.location.href = '@Url.Action("Index","Login")';
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    btn.prop("disabled", false);
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                btn.prop("disabled", false);
                            }
                        });
                    }
                });
            });

        });
    </script>
}
