@model PSS_CMS.Models.SalesInvoiceProducts

@{ ViewData["Title"] = "Sales Invoice Products View";
                ViewBag.PageTitle = "Sales Invoice Products View";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-box-seam nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ProductAdminView", "SalesInvoiceProduct", new { SalesinvoiceRecID = Session["SalesinvoiceRecID"], customerid = Session["customerid"], status = Session["status"] })">
        Sales Invoice Products
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>View</span>
</div>

@using (Html.BeginForm("Edit", "SalesInvoiceProduct", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{<!-- Main Card -->
                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <i class="bi bi-box-seam" style="font-size:15px;color:#3C3489;"></i>
                            </span>
                            Sales Invoice Product Details
                        </h6>
                    </div>

                    <!-- Form Body -->
                    <div class="form-body">

                        <p class="form-section-title">Product Information</p>
                        <div class="form-grid">

                            <!-- Product Dropdown -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.SIP_PRECID, new { @class = "form-label" })

                                @{ var ProductList = ViewBag.Product as IEnumerable<SelectListItem>;
                                                    var durationMap = ViewBag.ProductDurationList as Dictionary<int, int>; }

                                @if (ProductList != null && ProductList.Any())
                                {
                                    var modifiedProductList = new List<SelectListItem>(ProductList);
                                    if (modifiedProductList.Count > 1)
                                    {
                                        modifiedProductList.Insert(0, new SelectListItem { Text = "-- Select Product --", Value = "" });
                                    }

                <select id="SelectedProduct" name="SelectedProduct" class="form-input-auto" disabled>
                    @foreach (var item in modifiedProductList)
                    {
                        int duration = 0;
                        if (durationMap != null && !string.IsNullOrEmpty(item.Value))
                        {
                            int key = Convert.ToInt32(item.Value);
                            if (durationMap.ContainsKey(key)) { duration = durationMap[key]; }
                        }
<option value="@item.Value" data-duration="@duration" @(item.Selected ? "selected" : "")>
    @item.Text
</option>}
                </select> }
                                else
                                {
                <p style="font-size:13px;color:var(--text-muted);">No products available.</p>}
                                <input type="hidden" name="SelectedProduct" value="@Model.SIP_PRECID" />
                            </div>

                            <!-- Product Serial Number -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.SIP_PRODUCTSERIALNUMBER, "Product Serial No", new { @class = "form-label" })
                                @Html.EditorFor(m => m.SIP_PRODUCTSERIALNUMBER, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                            </div>

                            <!-- Service Engineer -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.SIP_ADMINRECID, "Service Engineer", new { @class = "form-label" })
                                <select id="AdminDropdown" class="form-input-auto" disabled>
                                    <option value="">-- Select Admin --</option>
                                </select>
                                @Html.HiddenFor(m => m.SIP_ADMINRECID)
                            </div>

                            <!-- Warranty Upto -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.SIP_WARRANTYUPTO, new { @class = "form-label" })
                                @Html.TextBoxFor(m => m.SIP_WARRANTYUPTO, new
                                {
                                    @class = "form-input-auto",
                                    type = "date",
                                    id = "SIP_WARRANTYUPTO",
                                    @readonly = "readonly"
                                })
                            </div>

                            <!-- Sort Order -->
                            <div class="form-group">
                                @Html.LabelFor(m => m.SIP_SORTORDER, new { @class = "form-label" })
                                @Html.EditorFor(m => m.SIP_SORTORDER, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", placeholder = "0", @readonly = "readonly" } })
                            </div>

                        </div>

                    </div>

                    <!-- Legend bar -->
                    <div class="legend-bar">
                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
                            <span>Read-only Field</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("ProductAdminView", "SalesInvoiceProduct", new { SalesinvoiceRecID = Session["SalesinvoiceRecID"], customerid = Session["customerid"], status = Session["status"] })"
                           class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>

                </div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            const selectedAdminFromEdit = '@Model.SIP_ADMINRECID';

            function setWarrantyDate() {
                var selected = $("#SelectedProduct option:selected");
                var duration = selected.attr("data-duration");
                if (!duration) return;
                duration = parseInt(duration);
                if (isNaN(duration) || duration === 0) return;
                var today = new Date();
                today.setMonth(today.getMonth() + duration);
                $("#SIP_WARRANTYUPTO").val(today.toISOString().split('T')[0]);
            }

            $("#SelectedProduct").on("change", function () {
                var precid = $(this).val();
                var cmprecid = '@Session["CompanyID"]';
                setWarrantyDate();

                $("#AdminDropdown").prop("disabled", true).empty().append('<option value="">Loading admins...</option>');

                if (!precid) {
                    $("#AdminDropdown").empty().append('<option value="">-- Select Admin --</option>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetProductAdmins", "SalesInvoiceProduct")',
                    type: 'GET',
                    data: { cmprecid: cmprecid, precid: precid },
                    success: function (res) {
                        $("#AdminDropdown").empty();
                        if (res.status === "Y" && res.data && res.data.length > 0) {
                            $("#AdminDropdown").append('<option value="">-- Select Admin --</option>').prop("disabled", false);
                            $.each(res.data, function (i, admin) {
                                var isSelected = admin.u_RECID.toString() === selectedAdminFromEdit.toString();
                                $("#AdminDropdown").append($('<option>', { value: admin.u_RECID, text: admin.u_USERNAME, selected: isSelected }));
                            });
                            if (selectedAdminFromEdit) { $("#SIP_ADMINRECID").val(selectedAdminFromEdit); }
                        } else {
                            $("#AdminDropdown").append('<option value="">No Admins mapped to this product</option>').prop("disabled", true);
                        }
                    },
                    error: function () {
                        $("#AdminDropdown").empty().append('<option value="">Error loading admins</option>').prop("disabled", true);
                    }
                });
            });

            $("#AdminDropdown").on("change", function () { $("#SIP_ADMINRECID").val($(this).val()); });

            if ($("#SelectedProduct").val()) { $("#SelectedProduct").trigger("change"); }
        });
    </script>

    <script>
        $(document).ready(function () {
            $("#editform").submit(function (event) {
                event.preventDefault();
                var submitBtn = $("#savebutton");
                submitBtn.prop("disabled", true);
                var formData = new FormData(this);
                $("body").css("pointer-events", "none");

                $.ajax({
                    url: '@Url.Action("Edit", "SalesInvoiceProduct")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we save your changes.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });
                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    confirmButtonText: "Ok",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: { confirmButton: "swal-btn-continue" },
                                    didOpen: () => { $(".swal2-container").css("pointer-events", "auto"); }
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        window.location.href = '@Url.Action("List", "SalesInvoiceProduct", new { SalesinvoiceRecID = Session["SalesinvoiceRecID"], customerid = Session["customerid"] })';
                                    } else {
                                        window.location.href = '@Url.Action("Create", "SalesInvoiceProduct")';
                                    }
                                });
                            }, 1000);
                        } else {
                            Swal.fire({ title: "Message", text: response.message, icon: "info", allowOutsideClick: false, allowEscapeKey: false });
                            resetButton();
                        }
                    },
                    error: function () {
                        Swal.fire({ title: "Error!", text: "An unexpected error occurred.", icon: "error", allowOutsideClick: false, allowEscapeKey: false });
                        resetButton();
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false).text("Submit");
                $("body").css("pointer-events", "auto");
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            $("#SelectedLocation").change(function () {
                var locationId = $(this).val();
                if (locationId) {
                    $.ajax({
                        url: '@Url.Action("LocationRef", "AccountantCustomerInvoice")',
                        type: 'GET',
                        data: { locationid: locationId },
                        success: function (result) {
                            var $dropdown = $("#LocationRefDropdown");
                            $dropdown.empty();
                            if (result && result.length > 0) {
                                $dropdown.append($("<option>").val("").text("-- Select Sales Location --"));
                                $.each(result, function (i, item) {
                                    $dropdown.append($("<option>").val(item.Value).text(item.Text));
                                });
                            } else {
                                $dropdown.append($("<option>").val("").text("No Sales Location Available"));
                            }
                        },
                        error: function (xhr, status, error) {
                            alert("Error fetching Location Ref: " + error);
                        }
                    });
                }
            });
        });
    </script>
}
