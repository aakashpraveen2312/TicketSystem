@model PSS_CMS.Models.Changepassword

@{ ViewData["Title"] = "Change Password";
                ViewBag.PageTitle = "Change Password";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Card constraint ──────────────────────────────────── */
        .pwd-card {
            max-width: 100%;
        }

        /* ── Form body ────────────────────────────────────────── */
        .form-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .form-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        /* ── Input with eye toggle ────────────────────────────── */
        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .pwd-input {
            border: 1px solid var(--border-color);
            border-left: 3px solid var(--primary);
            border-radius: 10px;
            padding: 8px 12px;
            font-size: 13px;
            color: var(--text-dark);
            background: #fff;
            outline: none;
            font-family: inherit;
            width: 100%;
            transition: border-color .15s, box-shadow .15s;
        }

            .pwd-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(108,92,231,.1);
            }

        .toggle-eye {
            position: absolute;
            right: 10px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 15px;
            padding: 0;
            display: flex;
            align-items: center;
        }

            .toggle-eye:hover {
                color: var(--primary);
            }

        /* ── Strength bar ─────────────────────────────────────── */
        .strength-bar {
            height: 4px;
            border-radius: 4px;
            margin-top: 6px;
            background: var(--border-color);
            overflow: hidden;
        }

        .strength-fill {
            height: 100%;
            border-radius: 4px;
            width: 0;
            transition: width .3s, background .3s;
        }

        .strength-text {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 4px;
            min-height: 16px;
        }

        /* ── Match message ────────────────────────────────────── */
        .match-msg {
            font-size: 11.5px;
            font-weight: 500;
            margin-top: 4px;
            min-height: 16px;
        }

        .match-ok {
            color: #00916e;
        }

        .match-err {
            color: #e74c3c;
        }

        /* ── Footer actions ───────────────────────────────────── */
        .footer-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 14px 18px;
            border-top: 1px solid var(--border-color);
        }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 20px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-submit:hover {
                background: #5a4bd1;
            }

            .btn-submit:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .btn-cancel {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f5f5f5;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 7px 20px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            text-decoration: none;
            transition: var(--transition);
        }

            .btn-cancel:hover {
                background: #ebebeb;
                color: var(--text-dark);
            }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-shield-lock nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Security</span>
    <i class="bi bi-chevron-right"></i>
    <span>Change Password</span>
</div>

<!-- Card -->
<div class="page-card pwd-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <i class="bi bi-key" style="color:var(--primary)"></i>
            Change Password
        </h6>
    </div>

    <!-- Form -->
    @using (Html.BeginForm(
        "ChangePassword",
        "ChangePassword",
        FormMethod.Post,
        new { id = "pwdForm", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
<div class="form-body">

    <!-- New Password -->
    <div class="form-group">
        <label class="form-label" for="Newpassword">New Password</label>
        <div class="input-wrap">
            @Html.PasswordFor(m => m.U_NewPassword, new
            {
                @class = "pwd-input",
                id = "Newpassword",
                placeholder = "Enter new password",
                autocomplete = "new-password",
                oninput = "checkStrength();checkMatch()"
            })
            <button type="button"
                    class="toggle-eye"
                    onclick="toggleVis('Newpassword',this)"
                    aria-label="Toggle new password visibility">
                <i class="bi bi-eye-slash"></i>
            </button>
        </div>
        <!-- Strength bar -->
        <div class="strength-bar">
            <div class="strength-fill" id="strengthFill"></div>
        </div>
        <div class="strength-text" id="strengthText"></div>
        @Html.ValidationMessageFor(m => m.U_NewPassword, "", new { @class = "text-danger" })
    </div>

    <!-- Confirm Password -->
    <div class="form-group">
        <label class="form-label" for="confirmPassword">Confirm Password</label>
        <div class="input-wrap">
            @Html.PasswordFor(m => m.U_Changepassword, new
            {
                @class = "pwd-input",
                id = "confirmPassword",
                placeholder = "Re-enter new password",
                autocomplete = "new-password",
                oninput = "checkMatch()"
            })
            <button type="button"
                    class="toggle-eye"
                    onclick="toggleVis('confirmPassword',this)"
                    aria-label="Toggle confirm password visibility">
                <i class="bi bi-eye-slash"></i>
            </button>
        </div>
        <div class="match-msg" id="matchMsg"></div>
        @Html.ValidationMessageFor(m => m.U_Changepassword, "", new { @class = "text-danger" })
    </div>

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

</div> <!-- Footer -->
                                <div class="footer-actions">
                                    <button type="button"
                                            id="saveButton"
                                            class="btn-submit"
                                            disabled
                                            onclick="submitForm()">
                                        <i class="bi bi-floppy"></i>
                                        Submit
                                    </button>
                                    <a href="@Url.Action("Dashboard", "DashBoard")" class="btn-cancel">
                                        Cancel
                                    </a>
                                </div>}

</div>

<!-- Legend -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // ── Eye toggle ─────────────────────────────────────────────
        function toggleVis(id, btn) {
            var inp  = document.getElementById(id);
            var icon = btn.querySelector('i');
            var isPass = inp.type === 'password';
            inp.type   = isPass ? 'text' : 'password';
            icon.className = isPass ? 'bi bi-eye' : 'bi bi-eye-slash';
        }

        // ── Password strength ───────────────────────────────────────
        function checkStrength() {
            var val  = document.getElementById('Newpassword').value;
            var fill = document.getElementById('strengthFill');
            var text = document.getElementById('strengthText');
            var score = 0;
            if (val.length >= 8)             score++;
            if (/[A-Z]/.test(val))           score++;
            if (/[0-9]/.test(val))           score++;
            if (/[^A-Za-z0-9]/.test(val))   score++;

            var map = {
                0: { w: '0%',   c: 'transparent', t: '' },
                1: { w: '25%',  c: '#e74c3c',      t: 'Weak' },
                2: { w: '50%',  c: '#e67e22',      t: 'Fair' },
                3: { w: '75%',  c: '#f1c40f',      t: 'Good' },
                4: { w: '100%', c: '#00b894',      t: 'Strong' }
            };
            var m = map[score];
            fill.style.width      = m.w;
            fill.style.background = m.c;
            text.textContent      = m.t ? 'Strength: ' + m.t : '';
            text.style.color      = m.c;
        }

        // ── Match check ────────────────────────────────────────────
        function checkMatch() {
            var np  = document.getElementById('Newpassword').value;
            var cp  = document.getElementById('confirmPassword').value;
            var msg = document.getElementById('matchMsg');
            var btn = document.getElementById('saveButton');

            if (!cp) {
                msg.textContent = '';
                msg.className   = 'match-msg';
                btn.disabled    = true;
                return;
            }

            if (np === cp) {
                msg.textContent = '✓ Passwords match';
                msg.className   = 'match-msg match-ok';
                btn.disabled    = false;
            } else {
                msg.textContent = '✗ Passwords do not match';
                msg.className   = 'match-msg match-err';
                btn.disabled    = true;
            }
        }

        // ── AJAX submit ────────────────────────────────────────────
        function submitForm() {
            var btn = document.getElementById('saveButton');
            btn.disabled = true;
            $('body').css('pointer-events', 'none');

            var formData = new FormData(document.getElementById('pwdForm'));

            $.ajax({
                url:         '@Url.Action("ChangePassword", "ChangePassword")',
                type:        'POST',
                data:        formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.success) {
                        Swal.fire({
                            title:           'Processing…',
                            html:            'Please wait while we save your changes.',
                            allowOutsideClick: false,
                            allowEscapeKey:  false,
                            didOpen: function () { Swal.showLoading(); }
                        });

                        setTimeout(function () {
                            Swal.fire({
                                icon:              'success',
                                title:             'Success!',
                                text:              res.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor:'#6c5ce7',
                                allowOutsideClick: false,
                                allowEscapeKey:    false
                            }).then(function (result) {
                                if (result.isConfirmed) {
                                    window.location.href = '@Url.Action("Index", "Login")';
                                }
                            });
                        }, 1000);

                    } else {
                        Swal.fire({
                            icon:  'info',
                            title: 'Message',
                            text:  res.message,
                            allowOutsideClick: false,
                            allowEscapeKey:    false
                        });
                        resetButton();
                    }
                },
                error: function () {
                    Swal.fire({
                        icon:  'error',
                        title: 'Error!',
                        text:  'An unexpected error occurred.',
                        allowOutsideClick: false,
                        allowEscapeKey:    false
                    });
                    resetButton();
                }
            });

            function resetButton() {
                btn.disabled = false;
                $('body').css('pointer-events', 'auto');
            }
        }
    </script>
}
