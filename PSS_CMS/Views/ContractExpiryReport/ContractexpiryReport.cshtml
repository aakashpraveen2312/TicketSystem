@model IEnumerable<PSS_CMS.Models.Prioritywise>

@{ ViewData["Title"] = "Contract Expiry Report";
    ViewBag.PageTitle = "Contract Expiry Report";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Status badges ──────────────────────────── */
        .status-expiring {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            background: #fff4db;
            color: #c47a00;
            font-size: 11px;
            font-weight: 600;
        }

        .status-expired {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            background: #ffeaea;
            color: #e74c3c;
            font-size: 11px;
            font-weight: 600;
        }

        .status-active {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            background: #e8faf6;
            color: #00916e;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Filter card ────────────────────────────── */
        .filter-card {
            padding: 20px 20px 4px;
            border-bottom: 1px solid var(--border-color);
            background: #fafafa;
        }

        .filter-row {
            display: flex;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
            padding-bottom: 20px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            min-width: 150px;
        }

        .filter-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* ── Pagination ─────────────────────────────── */
        .report-pagination {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 20px;
            border-top: 1px solid var(--border-color);
            justify-content: flex-end;
        }

        .page-info {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-clock-history nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Contract Expiry Report</span>
</div>

<!-- Filter Card -->
<div class="page-card" style="margin-bottom:20px;">

    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-funnel" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Filter Contracts
        </h6>
    </div>

    <form method="post" action="@Url.Action("ContractexpiryReport", "ContractExpiryReport",new {@class = "no-preloader" })" id="filterForm">
        <div class="filter-card">
            <div class="filter-row">

                <!-- From Date -->
                <div class="filter-group">
                    <label class="filter-label">From Date</label>
                    <input type="date" name="FromDate" id="fromDate" class="form-input-text"
                           style="font-size:12.5px;padding:8px 10px;" />
                </div>

                <!-- To Date -->
                <div class="filter-group">
                    <label class="filter-label">To Date</label>
                    <input type="date" name="ToDate" id="toDate" class="form-input-text"
                           style="font-size:12.5px;padding:8px 10px;" />
                </div>

                <!-- Type -->
                <div class="filter-group" style="min-width:180px;">
                    <label class="filter-label">Select Type</label>
                    <select id="comboBox" name="Type" class="form-select-input"
                            style="font-size:12.5px;padding:8px 10px;">
                        <option value="">-- Select Type --</option>
                        <option value="Today">Today</option>
                        <option value="This Week">This Week</option>
                        <option value="This Month">This Month</option>
                    </select>
                </div>

                <!-- Past Expiry -->
                <div class="filter-group">
                    <label class="filter-label">Past Expiry</label>
                    <label class="check-row" style="padding:8px 14px;">
                        <input type="checkbox"
                               class="form-check-input"
                               id="PastExpiry"
                               name="PastExpiry" />
                        <div class="check-row-label">
                            <span>Include past expired</span>
                        </div>
                    </label>
                </div>

                <!-- Buttons -->
                <div class="filter-group" style="flex-direction:row;gap:8px;align-items:flex-end;min-width:auto;">
                    <button type="submit" name="ActionType" value="Filter" class="btn-save">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <button type="submit" name="ActionType" value="PDF" class="btn-save no-preloader"
                            style="background:#e74c3c;">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                </div>

            </div>
        </div>
    </form>

</div>

<!-- Results Card -->
<div class="page-card">

    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-table" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Report Results
        </h6>
        @if (Model != null && Model.Any())
        {
<span class="custom-badge badge-active">@Model.Count() Records</span>}
    </div>

    <div class="grid-wrap">
        @if (Model != null && Model.Any())
        {
<table id="reportTable">
    <thead>
        <tr>
            <th>Customer Code</th>
            <th>Customer Name</th>
            <th>Customer Email</th>
            <th>Customer Number</th>
            <th>Expiry Date</th>
            <th style="text-align:right;">Remaining Days</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
<tr>
    <td><span class="contract-code">@item.Code</span></td>
    <td>@item.customerName</td>
    <td style="font-size:12px;color:var(--text-muted);">@item.customerEmail</td>
    <td>@item.customerMobile</td>
    <td>@item.expiryDate</td>
    <td style="text-align:right;font-weight:600;">@item.remainingDays</td>
    <td>
        @{ var statusVal = (item.Status ?? "").Trim().ToUpper();
                                var statusClass = statusVal.Contains("EXPIR") && !statusVal.Contains("ED")
                                    ? "status-expiring"
                                    : statusVal.Contains("EXPIRED")
                                        ? "status-expired"
                                        : "status-active";
                                var statusIcon = statusVal.Contains("EXPIRED") ? "bi-x-circle-fill"
                                               : statusVal.Contains("EXPIR") ? "bi-exclamation-circle-fill"
                                               : "bi-check-circle-fill"; }
        <span class="@statusClass">
            <i class="bi @statusIcon"></i>
            @item.Status
        </span>
    </td>
</tr>}
    </tbody>
</table> }
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-clock-history" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No records found</span>
    <p style="font-size:12px;margin-top:6px;">Apply a filter above to view contract expiry data.</p>
</div>}
    </div>

    @if (Model != null && Model.Any())
    {
<div class="report-pagination">
    <button id="prevBtn" class="page-btn" disabled>
        <i class="bi bi-chevron-left"></i> Previous
    </button>
    <span class="page-info" id="pageInfo"></span>
    <button id="nextBtn" class="page-btn">
        Next <i class="bi bi-chevron-right"></i>
    </button>
</div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#e8faf6;border:1px solid #9FE1CB;flex-shrink:0;"></span>
        <span>Active</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#fff4db;border:1px solid #FAC775;flex-shrink:0;"></span>
        <span>Expiring Soon</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#ffeaea;border:1px solid #f5a9a9;flex-shrink:0;"></span>
        <span>Expired</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Logoutjs.js"></script>

    <!-- Client-side pagination -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var table = document.getElementById("reportTable");
            if (!table) return;

            var rowsPerPage = 10;
            var rows = table.querySelectorAll("tbody tr");
            var totalRows = rows.length;
            var totalPages = Math.ceil(totalRows / rowsPerPage);
            var currentPage = 1;

            function showPage(page) {
                currentPage = page;
                rows.forEach(function (row, i) {
                    row.style.display =
                        (i >= (page - 1) * rowsPerPage && i < page * rowsPerPage)
                            ? "" : "none";
                });
                document.getElementById("pageInfo").innerText =
                    "Page " + currentPage + " of " + totalPages;
                document.getElementById("prevBtn").disabled = currentPage === 1;
                document.getElementById("nextBtn").disabled = currentPage === totalPages;
            }

            document.getElementById("prevBtn").addEventListener("click", function () {
                if (currentPage > 1) showPage(currentPage - 1);
            });

            document.getElementById("nextBtn").addEventListener("click", function () {
                if (currentPage < totalPages) showPage(currentPage + 1);
            });

            showPage(1);
        });
    </script>

    <!-- Past Expiry checkbox value fix -->
    <script>
        document.getElementById("filterForm").addEventListener("submit", function () {
            var cb = document.getElementById("PastExpiry");
            cb.value = cb.checked ? "checked" : "unchecked";
        });
    </script>

    <!-- TempData error message -->
    <script>
        $(document).ready(function () {
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'info',
                    title: 'Message',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#034CAE',
                    confirmButtonText: 'OK'
                });
                </text>
            }
        });
    </script>
}
