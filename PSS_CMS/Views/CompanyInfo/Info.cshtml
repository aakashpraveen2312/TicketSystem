        var form = this;
        var formData = new FormData(form);

        var saveButton = $(form).find("button[type='submit']");
        var saveButtonText = saveButton.find("#saveButtonText");

        // Disable Save button
        saveButton.prop("disabled", true);
        // Change Save -> Saving...
        saveButtonText.text("Saving...");
        $.ajax({
            url: $(form).attr("action"),
            type: "POST",
            data: formData,
            processData: false,
            contentType: false,
            dataType: "json",

            success: function (response) {

                console.log("Response:", response);

                // ==========================================
                // SUCCESS
                // ==========================================
                if (response.status === "success") {

                    Swal.fire({
                        icon: "success",
                        title: "Success!",
                        text: response.message ||
                              "Company information updated successfully.",
                        confirmButtonText: "Ok",
                        confirmButtonColor: "#6c5ce7",
                        allowOutsideClick: false,
                        allowEscapeKey: false
                    }).then(function () {

                        window.location.href =
                            '@Url.Action("Info", "CompanyInfo")';

                    });

                    return;
                }

                // ==========================================
                // INFORMATION / VALIDATION MESSAGE
                // ==========================================
                Swal.fire({
                    icon: "info",
                    title: "Information",
                    text: response.message ||
                          "Unable to update company information.",
                    confirmButtonText: "Ok",
                    confirmButtonColor: "#6c5ce7",
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });

            },

            // ==========================================
            // AJAX ERROR
            // ==========================================
            error: function (xhr) {

                console.log("AJAX Error:", xhr);
                console.log("Response:", xhr.responseText);

                var message =
                    "Something went wrong while updating company information.";

                // If controller returns JSON message
                if (xhr.responseJSON &&
                    xhr.responseJSON.message) {

                    message = xhr.responseJSON.message;
                }

                Swal.fire({
                    icon: "info",
                    title: "Information",
                    text: message,
                    confirmButtonText: "Ok",
                    confirmButtonColor: "#6c5ce7",
                    allowOutsideClick: false,
                    allowEscapeKey: false
                });

            },

            // ==========================================
            // COMPLETE
            // ==========================================
            complete: function () {

                saveButton.prop("disabled", false);

            }

        });

    });

});
    </script>

}
