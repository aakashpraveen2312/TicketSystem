@model IEnumerable<PSS_CMS.Models.Ticket>

@{ ViewData["Title"] = "Review Ticket";
    ViewBag.PageTitle = "Review Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Func<string, string> DecodeJavaScriptString = (input) =>
    {
        if (input == null) return string.Empty;
        return input.Replace("\\\"", "\"")
                    .Replace("\\'", "'")
                    .Replace("\\(", "(")
                    .Replace("\\)", ")")
                    .Replace("\\[", "[")
                    .Replace("\\]", "]")
                    .Replace("\\,", ",")
                    .Replace("\\.", ".")
                    .Replace("\\\\", "\\")
                    .Replace("\\n", "\n")
                    .Replace("\\r", "\r");
    };

    string lastStatus = Session["Status"]?.ToString();

    // Helper: detect attachment type
    Func<string, (string ft, string mime)> detectType = (b64) =>
    {
        if (string.IsNullOrEmpty(b64)) return ("bin", "application/octet-stream");
        if (b64.StartsWith("iVBORw0KGgo")) return ("png", "image/png");
        if (b64.StartsWith("/9j/")) return ("jpg", "image/jpeg");
        if (b64.StartsWith("JVBER")) return ("pdf", "application/pdf");
        if (b64.StartsWith("AAAAFGZ0eXB") ||
            b64.StartsWith("AAAAGGZ0eXBt")) return ("mp4", "video/mp4");
        if (b64.StartsWith("UEsDB"))
        {
            if (b64.Contains("word/")) return ("docx", "application/vnd.openxmlformats-officedocument.wordprocessingml.document");
            return ("xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        }
        if (b64.StartsWith("U1RB") || b64.StartsWith("R2V0")) return ("txt", "text/plain");
        if (b64.StartsWith("Q0N2")) return ("csv", "text/csv");
        return ("bin", "application/octet-stream");
    }; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Thread is a flex column of rows ── */
        .ticket-thread {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* ── Each row = 2-column grid ── */
        .ticket-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            align-items: stretch;
        }

        /* ── Card fills full height ── */
        .ticket-card {
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* ── Empty placeholder when no response ── */
        .ticket-card-empty {
            border-radius: 12px;
            border: 1.5px dashed var(--border-color);
            background: transparent;
            min-height: 80px;
        }

        /* ── Card body: fills space + scrolls if large ── */
        .ticket-card-body {
            padding: 16px;
            flex: 1;
            overflow-y: auto;
            max-height: 100px;
        }

        @@media (max-width: 640px) {
            .ticket-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History","Tickets")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>Review Ticket</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-ticket-perforated" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Ticket Thread
        </h6>
    </div>

    <!-- PDF action buttons (shown when not Submitted or Closed) -->
    @if (lastStatus != "S" && lastStatus != "C")
    {
<div class="pdf-action-row">
    <button class="btn-pdf btn-draft download-pdf" type="button">
        <i class="bi bi-file-earmark-pdf"></i> Service Invoice Draft
    </button>

    @if ((Session["Customertype"]?.ToString() ?? "") == "Contract")
    {
<button class="btn-pdf btn-contract download-contractpdf" type="button">
    <i class="bi bi-file-earmark-text"></i> Contract Service
</button> }
else
{
<button class="btn-pdf btn-warranty download-warrantypdf" type="button">
    <i class="bi bi-shield-check"></i> Warranty Service
</button>}
</div>}

    <!-- Ticket thread -->
    <div style="padding:18px;">
        <div class="ticket-thread">

            @foreach (var ticket in Model)
            {
<div class="ticket-row">

    @* ── Raised card ── *@
    <div class="ticket-card">
        <div class="ticket-card-header raised">
            <div class="ticket-meta">
                <span class="ticket-badge badge-raised">
                    <i class="bi bi-arrow-up-circle"></i> Ticket Raised
                </span>
                <span class="ticket-by">@ticket.TC_USERNAME</span>
            </div>
            <span class="ticket-date">
                <i class="bi bi-clock"></i>
                @Convert.ToDateTime(ticket.TC_TICKETDATE).ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <div class="ticket-card-body">
            <p class="comments-label">User Comments</p>
            <p class="comments-text">@Html.Raw(DecodeJavaScriptString(ticket.TC_COMMENTS))</p>

            @if (!string.IsNullOrEmpty(ticket.TC_REQUEST_ATTPREFIX))
            {
                var (ft, mime) = detectType(ticket.TC_REQUEST_ATTPREFIX);
                if (mime.StartsWith("image/"))
                {
<img src="data:@mime;base64,@ticket.TC_REQUEST_ATTPREFIX"
     alt="Ticket attachment" class="img-thumb" /> } @* ── CHANGED: was <a href="data:...;base64,...">.
    Large data: URIs on href make the browser treat the click as a
    page navigation, so the tab's progress bar spins and never
    properly resolves. Now we just store the base64/mime/filename
    as data-* attributes and let JS convert it to a Blob and
    download that instead (see downloadBase64 in Scripts section). ── *@
                        <a href="javascript:void(0);"
                           class="dl-btn download-attachment"
                           data-b64="@ticket.TC_REQUEST_ATTPREFIX"
                           data-mime="@mime"
                           data-filename="Attachment.@ft">
                            <i class="bi bi-download"></i> Download Attachment
                        </a>}
        </div>
    </div> @* ── Response card (if exists) ── *@
    @if (ticket.TC_RESPONSE_DATETIME != null)
    {
<div class="ticket-card">
    <div class="ticket-card-header responded">
        <div class="ticket-meta">
            <span class="ticket-badge badge-responded">
                <i class="bi bi-reply-all"></i> Response
            </span>
            <span class="ticket-by">@ticket.TC_ADMINNAME</span>
        </div>
        <span class="ticket-date">
            <i class="bi bi-clock"></i>
            @Convert.ToDateTime(ticket.TC_RESPONSE_DATETIME).ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>

    <div class="ticket-card-body">
        <p class="comments-label">Admin Comments</p>
        <p class="comments-text">@ticket.TC_RESPONSECOMMENTS</p>

        @if (!string.IsNullOrEmpty(ticket.TC_RESPONSE_ATTPREFIX))
        {
            var (ftr, mimer) = detectType(ticket.TC_RESPONSE_ATTPREFIX);
            if (mimer.StartsWith("image/"))
            {
<img src="data:@mimer;base64,@ticket.TC_RESPONSE_ATTPREFIX"
     alt="Response attachment" class="img-thumb" /> } @* ── CHANGED: same fix as the request attachment above ── *@
                            <a href="javascript:void(0);"
                               class="dl-btn dl-btn-green download-attachment"
                               data-b64="@ticket.TC_RESPONSE_ATTPREFIX"
                               data-mime="@mimer"
                               data-filename="Attachment.@ftr">
                                <i class="bi bi-download"></i> Download Attachment
                            </a>}
    </div>
</div>}
else
{ @* Empty placeholder keeps column 2 reserved *@
                    <div class="ticket-card-empty"></div>}


</div>      }

        </div>
        @if (lastStatus == "C" || lastStatus == "R")
        {<!-- Actions -->
                            <div class="mt-3 d-flex justify-content-end">
                                <a href="@Url.Action("Ticket_History", "Tickets")"
                                   class="res-btn res-btn-cancel">
                                    <i class="bi bi-x-lg"></i> Cancel
                                </a>
                            </div> } @* ── Client response form (partial) ── *@
        @if (lastStatus != "C" && lastStatus != "O")
        {
<div style="margin-top:20px;">
    @{ Html.RenderPartial("_ClientResponse", new PSS_CMS.Models.Ticket()); }
</div>}

    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── ADDED: Attachment download via Blob ───────────────────
           Converts a base64 string into a Blob and downloads it via
           a temporary object URL, instead of putting base64 directly
           into an <a href="data:..."> link. Large data: URIs on an
           anchor's href cause the browser to treat the click as page
           navigation, so the tab's progress/loading indicator spins
           and never resolves — even though the file itself downloads
           fine. Blob downloads don't trigger that navigation state. */
        function downloadBase64(base64Data, mime, filename) {
            try {
                var byteChars = atob(base64Data);
                var byteNumbers = new Array(byteChars.length);
                for (var i = 0; i < byteChars.length; i++) {
                    byteNumbers[i] = byteChars.charCodeAt(i);
                }
                var byteArray = new Uint8Array(byteNumbers);
                var blob = new Blob([byteArray], { type: mime });
                var blobUrl = URL.createObjectURL(blob);

                var link = document.createElement('a');
                link.href = blobUrl;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Free the memory the browser allocated for the blob
                setTimeout(function () { URL.revokeObjectURL(blobUrl); }, 1000);
            } catch (err) {
                console.error('Attachment download failed:', err);
                Swal.fire({ icon: 'error', title: 'Error', text: 'Unable to download attachment.' });
            }
        }

        // ── ADDED: delegated click handler for all Download Attachment links ──
        $(document).on('click', '.download-attachment', function (e) {
            e.preventDefault();
            var $this = $(this);
            downloadBase64($this.data('b64'), $this.data('mime'), $this.data('filename'));
        });

        /* ── Generic PDF handler ─────────────────── */
        function handlePdf(action) {
            Swal.fire({
                title: 'Generating PDF…',
                text: 'Please wait.',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: function () { Swal.showLoading(); }
            });
            $.ajax({
                url: action, type: 'POST',
                success: function (r) {
                    Swal.close();
                    if (r.status === 'success') { window.open(r.url, '_blank'); }
                    else { Swal.fire({ icon: 'info', title: 'Message', text: r.message }); }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.' });
                },
                // ── ADDED: complete runs on BOTH success and error, guaranteed ──
                // This forces any global full-page loader (from _Layout.cshtml)
                // to hide itself once this specific ajax call is done, even if
                // that loader's own ajaxStop logic gets stuck due to another
                // pending request elsewhere on the page.
                //
                // IMPORTANT: replace '#pageLoader' below with the ACTUAL id or
                // class of your spinner element. Find it via:
                //   Browser DevTools (F12) -> right-click the spinner -> Inspect
                // then copy its id="..." or class="..." here.
                complete: function () {
                    $('#pageLoader, .page-loader, .global-loader').hide(); // ADDED
                }
            });
        }

        $(document).on('click', '.download-pdf',         function (e) { e.preventDefault(); handlePdf('@Url.Action("DraftDownloadPDF","Tickets")'); });
        $(document).on('click', '.download-contractpdf', function (e) { e.preventDefault(); handlePdf('@Url.Action("ContractDownloadPDF","Tickets")'); });
        $(document).on('click', '.download-warrantypdf', function (e) { e.preventDefault(); handlePdf('@Url.Action("WarrantyDownloadPDF","Tickets")'); });

        /* ── Datetime updater ───────────────────── */
        function updateDateTime() {
            var el = document.getElementById('responseDateTime');
            if (!el) return;
            var now = new Date();
            el.innerText = now.toLocaleDateString('en-GB') + ' ' + now.toLocaleTimeString();
        }
        updateDateTime();
        setInterval(updateDateTime, 1000);

    </script>
}
