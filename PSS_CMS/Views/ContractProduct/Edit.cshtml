@model PSS_CMS.Models.ContractServiceProduct

@{ ViewData["Title"] = "Contract Product Edit";
    ViewBag.PageTitle = "Contract Product Edit";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-tools nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">@Session["CT_CUSTOMERNAME"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductList", "Contract")">Contract (@Session["CP_CODE"].ToString()</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "ContractProduct")">Products</a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-pencil-square" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Edit Contract Product
        </h6>
    </div>

    @using (Html.BeginForm("Edit", "ContractProduct", FormMethod.Post, new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
<div style="padding:24px 20px 8px;">

    <p class="form-section-title">Product Information</p>
    <div class="form-grid" style="margin-bottom:24px;">

        <!-- Product Name (read-only) -->
        <div class="form-group">
            @Html.LabelFor(m => m.CSP_PRODUCTNAME, "Product Name", new { @class = "form-label" })
            @Html.EditorFor(m => m.CSP_PRODUCTNAME, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
            @Html.HiddenFor(m => m.CSP_PRECID, new { id = "CSP_PRECID" })
        </div>

        <!-- Service Engineer (read-only) -->
        <div class="form-group">
            @Html.LabelFor(m => m.CSP_ADMINNAME, "Service Engineer", new { @class = "form-label" })
            @Html.EditorFor(m => m.CSP_ADMINNAME, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
            @Html.HiddenFor(m => m.CSP_ARECID, new { id = "CSP_ARECID" })
        </div>

        <!-- Product Serial Number -->
        <div class="form-group">
            @Html.LabelFor(m => m.CSP_PRODUCTUNIQUENUMBER, "Product Serial Number", new { @class = "form-label" })
            @Html.EditorFor(m => m.CSP_PRODUCTUNIQUENUMBER, new { htmlAttributes = new { @class = "form-input-text", autocomplete = "off" } })
        </div>

        <!-- Contract Product Amount -->
        <div class="form-group">
            @Html.LabelFor(m => m.CSP_PRODUCTAMOUNT, "Contract Product Amount", new { @class = "form-label" })
            @Html.EditorFor(m => m.CSP_PRODUCTAMOUNT, new { htmlAttributes = new { @class = "form-input-num", autocomplete = "off" } })
        </div>

        <!-- Free Services -->
        <div class="form-group">
            @Html.LabelFor(m => m.CSP_FREESERVICE, "Free Services", new { @class = "form-label" })
            @Html.EditorFor(m => m.CSP_FREESERVICE, new { htmlAttributes = new { @class = "form-input-num", autocomplete = "off" } })
        </div>

    </div>

    <!-- Actions -->
    <div class="form-actions">

        <a href="@Url.Action("List", "ContractProduct")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>
    </div>

</div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
        <span>Read-only Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
        <span>Number Field</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Logoutjs.js"></script>

    <script>
        $(document).ready(function () {

            $("#editform").submit(function (e) {
                e.preventDefault();

                $("#savebutton").prop("disabled", true);
                $("body").css("pointer-events", "none");

                $.ajax({
                    url: '@Url.Action("Edit", "ContractProduct")',
                    type: 'POST',
                    data: new FormData(this),
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we save your changes.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });

                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    confirmButtonText: "Ok",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: { confirmButton: "swal-btn-continue" },
                                    didOpen: () => {
                                        $(".swal2-container").css("pointer-events", "auto");
                                    }
                                }).then(function () {
                                    window.location.href = '@Url.Action("List", "ContractProduct")';
                                });
                            }, 1000);

                        } else {
                            Swal.fire({
                                title: "Message",
                                text: response.message,
                                icon: "info",
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            resetButton();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: "Error!",
                            text: "An unexpected error occurred.",
                            icon: "error",
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        resetButton();
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
