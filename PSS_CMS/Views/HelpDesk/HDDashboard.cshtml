@model PSS_CMS.Models.Dashborardchart
@{ ViewBag.PageTitle = "Dashboard";
    ViewBag.PageSubtitle = "Overview of your ticket system"; }
@using Newtonsoft.Json

@{ int totalTickets = (Model?.TotalTickets != null) ? (int)Model.TotalTickets : 0;
    int closedTickets = (Model?.CloseTickets != null) ? (int)Model.CloseTickets : 0; }

@section Styles {

    <!-- List View CSS -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />

    <style>
        :root {
            --primary: #6c5ce7;
            --primary-lt: #eeeaff;
            --green: #00b894;
            --green-lt: #d8f5ed;
            --amber: #f39c12;
            --amber-lt: #fff3dc;
            --slate: #636e72;
            --slate-lt: #f1f3f5;
            --bg: #f4f5f9;
            --surface: #ffffff;
            --border: #e8eaed;
            --text: #1a1d23;
            --text-sub: #6b7280;
            --text-muted: #9ca3af;
            --shadow: 0 1px 4px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
            --shadow-hover: 0 4px 20px rgba(0,0,0,.10);
            --r: 14px;
        }

        /* ── Page wrapper ───────────────────────── */
        .hd-page {
            background: var(--bg);
            border-radius: 18px;
        }

        /* ── Top bar ────────────────────────────── */
        .hd-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }

        .hd-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 12.5px;
            color: var(--text-muted);
            flex-wrap: wrap;
        }

            .hd-breadcrumb a {
                color: var(--primary);
                text-decoration: none;
                font-weight: 600;
            }

            .hd-breadcrumb span {
                color: var(--text);
                font-weight: 600;
            }

            .hd-breadcrumb i {
                font-size: 11px;
            }

        .btn-create {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 8px 18px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: background .15s;
        }

            .btn-create:hover {
                background: #5a4bd1;
            }

        /* ── Section title ──────────────────────── */
        .hd-section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            color: var(--text-muted);
            margin: 15px 0 14px;
        }

        /* ── Stat grid ──────────────────────────── */
        .hd-stat-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            align-items: stretch;
            grid-auto-rows: auto;
        }

        @@media (max-width: 600px) {
            .hd-stat-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ── Stat card ──────────────────────────── */
        .hd-stat-card {
            background: var(--surface);
            border-radius: var(--r);
            border: 1px solid var(--border);
            padding: 14px 16px 0;
            position: relative;
            cursor: pointer;
            transition: transform .25s, box-shadow .25s;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            min-height: 0;
            box-sizing: border-box;
            overflow: hidden;
        }

            .hd-stat-card:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-hover);
            }

            .hd-stat-card::before {
                content: '';
                position: absolute;
                inset: 0 0 auto 0;
                height: 4px;
                border-radius: var(--r) var(--r) 0 0;
            }

        .hd-card-total::before {
            background: var(--green);
        }

        .hd-card-closed::before {
            background: var(--amber);
        }

        /* ── Card icon ──────────────────────────── */
        .hd-stat-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

        .icon-total {
            background: var(--green-lt);
            color: var(--green);
        }

        .icon-closed {
            background: var(--amber-lt);
            color: var(--amber);
        }

        .hd-stat-label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-sub);
            margin-top: 2px;
            margin-bottom: 4px;
            padding-right: 46px;
        }

        .hd-stat-count {
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            color: var(--text);
            padding-right: 46px;
        }

        .hd-stat-sub {
            margin-top: 4px;
            font-size: 11px;
            color: var(--text-muted);
        }

        /* ── Sparkline ──────────────────────────── */
        .hd-sparkline {
            display: block;
            width: calc(100% + 32px);
            margin-left: -16px;
            height: 40px;
            min-height: 40px;
            max-height: 40px;
            margin-top: 8px;
            flex-shrink: 0;
        }

        /* ── Chart panel ────────────────────────── */
        .hd-chart-panel {
            background: var(--surface);
            border-radius: var(--r);
            border: 1px solid var(--border);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .hd-chart-header {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
        }

            .hd-chart-header span {
                display: block;
                font-size: 13.5px;
                font-weight: 700;
                color: var(--text);
            }

            .hd-chart-header small {
                font-size: 11px;
                color: var(--text-muted);
            }

        .hd-chart-body {
            padding: 16px;
        }

        /* ── 3-col chart grid ───────────────────── */
        .hd-charts-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        @@media (max-width: 1000px) {
            .hd-charts-3 {
                grid-template-columns: 1fr;
            }
        }

        /* ── 2-col chart grid ───────────────────── */
        .hd-charts-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 16px;
        }

        @@media (max-width: 900px) {
            .hd-charts-2 {
                grid-template-columns: 1fr;
            }
        }

        /* ── Full-width panel ───────────────────── */
        .hd-chart-full {
            margin-top: 16px;
        }

            .hd-chart-full .hd-chart-body {
                height: 280px;
            }

        #hd-speedometer {
            width: 100% !important;
            max-width: 320px;
            height: 220px !important;
            margin: auto;
        }
    </style>
}
<div class="hd-page">

    <!-- ── Stat cards ── -->
    <div class="hd-section-title">Overview</div>
    <div class="hd-stat-grid">

        <!-- Total -->
        <div class="hd-stat-card hd-card-total">
            <div class="hd-stat-icon icon-total"><i class="bi bi-ticket-perforated-fill"></i></div>
            <div class="hd-stat-label">Total Tickets</div>
            <div class="hd-stat-count">@totalTickets</div>
            <div class="hd-stat-sub">All time tickets</div>
            <canvas class="hd-sparkline" id="hd-spark-total"></canvas>
        </div>

        <!-- Closed -->
        <div class="hd-stat-card hd-card-closed">
            <div class="hd-stat-icon icon-closed"><i class="bi bi-archive-fill"></i></div>
            <div class="hd-stat-label">Closed Tickets</div>
            <div class="hd-stat-count">@closedTickets</div>
            <div class="hd-stat-sub">Completed tickets</div>
            <canvas class="hd-sparkline" id="hd-spark-closed"></canvas>
        </div>

    </div>

    <!-- ── Bar Charts ── -->
    <div class="hd-section-title">Ticket Trends</div>
    <div class="hd-charts-3">

        <div class="hd-chart-panel">
            <div class="hd-chart-header">
                <span>Week to Date</span>
                <small>Last 7 days including today</small>
            </div>
            <div class="hd-chart-body">
                <canvas id="hdBarChartWTD"></canvas>
            </div>
        </div>

        <div class="hd-chart-panel">
            <div class="hd-chart-header">
                <span>Month to Date</span>
                <small>Last 27 days including today</small>
            </div>
            <div class="hd-chart-body">
                <canvas id="hdBarChartMTD"></canvas>
            </div>
        </div>

        <div class="hd-chart-panel">
            <div class="hd-chart-header">
                <span>Overall Tickets</span>
                <small>All time summary</small>
            </div>
            <div class="hd-chart-body">
                <canvas id="hdBarChartAll"></canvas>
            </div>
        </div>

    </div>

    <!-- ── Product Trend ── -->
    <div class="hd-section-title">Product Trend</div>
    <div class="hd-chart-full hd-chart-panel">
        <div class="hd-chart-header">
            <span>Product Ticket Trend</span>
            <small>Monthly breakdown by product</small>
        </div>
        <div class="hd-chart-body">
            <canvas id="hdTrendChart"></canvas>
        </div>
    </div>

    <!-- ── Priority + Speedometer ── -->
    <div class="hd-section-title">Priority &amp; Completion</div>
    <div class="hd-charts-2">

        <div class="hd-chart-panel">
            <div class="hd-chart-header">
                <span>Priority-wise Stacked Tickets</span>
                <small>Total · Closed by priority</small>
            </div>
            <div class="hd-chart-body">
                <canvas id="hdPriorityChart"></canvas>
            </div>
        </div>

        <div class="hd-chart-panel">
            <div class="hd-chart-header">
                <span>Percentage of Closed Tickets</span>
                <small>Ticket resolution progress</small>
            </div>
            <div class="hd-chart-body"
                 style="display:flex;align-items:center;justify-content:center;">
                <div id="hd-speedometer"></div>
            </div>
        </div>

    </div>

</div><!-- /hd-page -->
<!-- ── Scripts ─────────────────────────────────────────── -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/raphael@2.1.4/raphael-min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/justgage@1.3.0/justgage.min.js"></script>

<script>
    /* ── Shared bar helper ───────────────────── */
    var hdBarColors = ['#00b894', '#f39c12'];
    var hdBarLabels = ['Total Tickets', 'Closed'];

    function hdMakeBar(id, data) {
        var ctx = document.getElementById(id);
        if (!ctx) return;
        new Chart(ctx.getContext('2d'), {
            type: 'bar',
            data: {
                labels: hdBarLabels,
                datasets: [{
                    data: data,
                    backgroundColor: hdBarColors,
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } },
                    y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' }, beginAtZero: true }
                }
            }
        });
    }

    hdMakeBar('hdBarChartWTD', [@(ViewBag.WeekTotalTickets  ?? 0), @(ViewBag.WeekCloseTickets  ?? 0)]);
    hdMakeBar('hdBarChartMTD', [@(ViewBag.MonthTotalTickets ?? 0), @(ViewBag.MonthCloseTickets ?? 0)]);

    document.addEventListener('DOMContentLoaded', function () {
        hdMakeBar('hdBarChartAll', [@(Model?.TotalTickets ?? 0), @(Model?.CloseTickets ?? 0)]);
    });
</script>

<script>
    /* ── Priority stacked chart ──────────────── */
    (function () {
        var labels   = @Html.Raw(ViewBag.Labels1       ?? "[]");
        var total    = @Html.Raw(ViewBag.TotalTickets1  ?? "[]");
        var closed   = @Html.Raw(ViewBag.ClosedTickets1 ?? "[]");

        new Chart(document.getElementById('hdPriorityChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Total Tickets',  data: total,  backgroundColor: '#f39c12', borderRadius: 4 },
                    { label: 'Closed Tickets', data: closed, backgroundColor: '#636e72', borderRadius: 4 }
                ]
            },
            options: {
                scales: {
                    x: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } },
                    y: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' }, beginAtZero: true }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { size: 11 }, color: '#6b7280', boxWidth: 12, padding: 14 }
                    }
                }
            }
        });
    })();
</script>

<script>
    /* ── Product trend line chart ────────────── */
    document.addEventListener('DOMContentLoaded', function () {
var rawData = @Html.Raw(
    JsonConvert.SerializeObject(
        Model?.ProductTrend
        ?? new System.Collections.Generic.List<PSS_CMS.Models.TicketTrendVM>()
    )
);
        if (!Array.isArray(rawData) || rawData.length === 0) return;

        var labels  = [...new Set(rawData.map(x => x.yearMonth))];
        var grouped = {};
        rawData.forEach(function(x) {
            if (!grouped[x.productName]) grouped[x.productName] = {};
            grouped[x.productName][x.yearMonth] = x.ticketCount;
        });

        var palette = ['#6c5ce7','#00b894','#f39c12','#e17055','#0984e3','#fd79a8','#00cec9'];
        var datasets = Object.keys(grouped).map(function(product, i) {
            return {
                label:       product,
                data:        labels.map(function(m) { return grouped[product][m] || 0; }),
                borderColor: palette[i % palette.length],
                backgroundColor: palette[i % palette.length] + '22',
                borderWidth: 2,
                tension:     0.4,
                fill:        true,
                pointRadius: 3
            };
        });

        new Chart(document.getElementById('hdTrendChart'), {
            type: 'line',
            data: { labels: labels, datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: { font: { size: 11 }, color: '#6b7280', boxWidth: 12, padding: 14 }
                    }
                },
                scales: {
                    x: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } },
                    y: { beginAtZero: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } }
                }
            }
        });
    });
</script>

<script>
    /* ── Speedometer ─────────────────────────── */
    (function () {
        var closedPct = Math.round(@((ViewBag.ClosedPercentage ?? 0)));
        var totalTix  = @((ViewBag.TotalTickets  ?? 0));
        var closedTix = @((ViewBag.ClosedTickets ?? 0));

        if (isNaN(closedPct) || closedPct < 0 || closedPct > 100) closedPct = 0;

        new JustGage({
            id: "hd-speedometer",
            value: closedPct,
            min: 0, max: 100,
            title: "Ticket Progress",
            label: closedPct + "% Closed (" + closedTix + "/" + totalTix + ")",
            gaugeWidthScale: 0.1,
            pointer: true,
            pointerOptions: { length: 0.6, strokeWidth: 0.04 },
            customSectors: [
                { color: "#e74c3c", lo: 0,  hi: 30  },
                { color: "#e6a817", lo: 31, hi: 70  },
                { color: "#1D9E75", lo: 71, hi: 100 }
            ],
            levelColors: ["#e74c3c", "#e6a817", "#1D9E75"],
            hideValue: true
        });
    })();
</script>

<script>
    /* ── Sparklines ──────────────────────────── */
    function hdDrawSparkline(id, points, color) {
        var canvas = document.getElementById(id);
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        var W = canvas.offsetWidth || canvas.parentElement.offsetWidth || 200;
        var H = 40;
        canvas.width = W; canvas.height = H;

        if (!points || points.length < 2) points = [0, 0, 0];

        var min   = Math.min.apply(null, points);
        var max   = Math.max.apply(null, points);
        var range = max - min || 1;
        var pad   = 4;
        var step  = (W - pad * 2) / (points.length - 1);

        var grad = ctx.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, color + '44');
        grad.addColorStop(1, color + '00');

        ctx.beginPath();
        ctx.moveTo(pad, H);
        points.forEach(function(v, i) {
            var x = pad + i * step;
            var y = pad + (1 - (v - min) / range) * (H - pad * 2);
            ctx.lineTo(x, y);
        });
        ctx.lineTo(pad + (points.length - 1) * step, H);
        ctx.closePath();
        ctx.fillStyle = grad;
        ctx.fill();

        ctx.beginPath();
        points.forEach(function(v, i) {
            var x = pad + i * step;
            var y = pad + (1 - (v - min) / range) * (H - pad * 2);
            if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        });
        ctx.strokeStyle = color;
        ctx.lineWidth   = 2;
        ctx.lineJoin    = 'round';
        ctx.lineCap     = 'round';
        ctx.stroke();
    }

    document.addEventListener('DOMContentLoaded', function () {
        var wTotal  = @(ViewBag.WeekTotalTickets  ?? 0);
        var mTotal  = @(ViewBag.MonthTotalTickets ?? 0);
        var aTotal  = @(Model?.TotalTickets  ?? 0);
        var wClose  = @(ViewBag.WeekCloseTickets  ?? 0);
        var mClose  = @(ViewBag.MonthCloseTickets ?? 0);
        var aClose  = @(Model?.CloseTickets  ?? 0);

        hdDrawSparkline('hd-spark-total',  [wTotal, mTotal, aTotal], '#00b894');
        hdDrawSparkline('hd-spark-closed', [wClose, mClose, aClose], '#f39c12');
    });
</script>
