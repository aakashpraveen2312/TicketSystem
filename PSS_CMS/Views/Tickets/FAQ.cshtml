@model IEnumerable<PSS_CMS.Models.Faq>

@{ ViewData["Title"] = "FAQ";
    ViewBag.PageTitle = "FAQ";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Loading screen ────────────────────────── */
        #loadingScreen {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.85);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .loader {
            width: 40px;
            height: 40px;
            border: 4px solid #EEEDFE;
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Filter select ──────────────────────────── */
        .faq-filter-select {
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 7px 12px;
            font-size: 12.5px;
            color: var(--text-dark);
            background: #fff;
            outline: none;
            font-family: inherit;
            cursor: pointer;
            height: 36px;
            min-width: 200px;
        }

            .faq-filter-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99,89,210,.08);
            }

        /* ── Accordion ──────────────────────────────── */
        .faq-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 20px;
        }

        .faq-item {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            transition: box-shadow .15s;
        }

            .faq-item.open {
                box-shadow: 0 2px 12px rgba(99,89,210,.10);
            }

        .faq-question {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            cursor: pointer;
            background: #fff;
            user-select: none;
            transition: background .12s;
        }

        .faq-item.open .faq-question {
            background: #EEEDFE;
            border-bottom: 1px solid var(--border-color);
        }

        .faq-question-text {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text-dark);
            flex: 1;
        }

        .faq-item.open .faq-question-text {
            color: var(--primary);
        }

        .faq-chevron {
            font-size: 16px;
            color: var(--text-muted);
            transition: transform .2s;
            flex-shrink: 0;
        }

        .faq-item.open .faq-chevron {
            transform: rotate(180deg);
            color: var(--primary);
        }

        .faq-answer {
            display: none;
            padding: 16px 18px;
            background: #fff;
        }

        .faq-item.open .faq-answer {
            display: block;
        }

        .faq-answer p {
            font-size: 13.5px;
            color: var(--text-dark);
            line-height: 1.75;
            text-align: justify;
            margin: 0 0 12px;
        }

        /* ── Download button ────────────────────────── */
        .faq-dl-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            background: #EEEDFE;
            color: var(--primary);
            border: 1px solid #AFA9EC;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: background .12s;
        }

            .faq-dl-btn:hover {
                background: #CECBF6;
                color: var(--primary);
            }

        .faq-no-file {
            font-size: 12px;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ── FAQ count badge ────────────────────────── */
        .faq-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 3px 10px;
            border-radius: 20px;
            background: #EEEDFE;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
        }
    </style>
}

<!-- Loading screen -->
<div id="loadingScreen"><div class="loader"></div></div>

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-question-circle nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>FAQ</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-question-circle" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Frequently Asked Questions

        </h6>

        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">

            <!-- Product filter -->
            @{ var projectTypeList = ViewBag.Product as IEnumerable<SelectListItem>;
                var defaultSelected = projectTypeList?.FirstOrDefault()?.Value ?? ""; }

            @if (projectTypeList != null && projectTypeList.Any())
            {
@Html.DropDownList("SelectedProjectType1",
         projectTypeList,
         new
         {
             @class = "filter-select",
             id = "projectTypeFilter1",
             data_default = defaultSelected
         }) }
            else
            {
<select class="faq-filter-select" id="projectTypeFilter1" disabled>
    <option>No products available</option>
</select>            }

            <!-- Search -->
            @using (Html.BeginForm("FAQ", "Tickets", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>
    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]" />
</div>            }

        </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="faq-list">

        @if (Model != null && Model.Any())
        {
foreach (var faq in Model)
{
        
    // ── Detect attachment type ──────────────
                        string fileType = "unknown";
                        string mimeType = "application/octet-stream";

                        if (!string.IsNullOrEmpty(faq.F_ATTACHEMENT))
                        {
                            var b64 = faq.F_ATTACHEMENT;
                            if (b64.StartsWith("iVBORw0KGgo")) { fileType = "png"; mimeType = "image/png"; }
                            else if (b64.StartsWith("/9j/")) { fileType = "jpg"; mimeType = "image/jpeg"; }
                            else if (b64.StartsWith("JVBER")) { fileType = "pdf"; mimeType = "application/pdf"; }
                            else if (b64.StartsWith("UEsDB"))
                            {
                                if (b64.Contains("word/")) { fileType = "docx"; mimeType = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"; }
                                else { fileType = "xlsx"; mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"; }
                            }
                            else if (b64.StartsWith("U1RB") || b64.StartsWith("R2V0")) { fileType = "txt"; mimeType = "text/plain"; }
                            else if (b64.StartsWith("Q0N2")) { fileType = "csv"; mimeType = "text/csv"; }
                        }
                        
                      

                    <div class="faq-item" id="faq-@faq.F_RECID">
                        <div class="faq-question" onclick="toggleFaq(@faq.F_RECID)">
                            <span class="faq-question-text">@faq.F_QUESTION</span>
                            <i class="bi bi-chevron-down faq-chevron"></i>
                        </div>
                        <div class="faq-answer">
                            <p>@faq.F_ANSWER</p>

                            @if (!string.IsNullOrEmpty(faq.F_ATTACHEMENT))
                            {
        <a href="data:@mimeType;base64,@faq.F_ATTACHEMENT"
           download="@(faq.F_QUESTION).@fileType"
           class="faq-dl-btn">
            <i class="bi bi-download"></i> Download Attachment
        </a> }
                            else
                            {
        <span class="faq-no-file">
            <i class="bi bi-paperclip"></i> No attachment available
        </span>}
                        </div>
                    </div>} }
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-question-circle" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No FAQs available</span>
    <p style="font-size:12px;margin-top:6px;">Try selecting a different product or clearing the search.</p>
</div>}

    </div>

</div><!-- /page-card -->

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Loading screen -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 500);
        });
    </script>

    <!-- FAQ accordion toggle -->
    <script>
        function toggleFaq(id) {
            var item = document.getElementById('faq-' + id);
            var isOpen = item.classList.contains('open');

            // Close all
            document.querySelectorAll('.faq-item.open').forEach(function (el) {
                el.classList.remove('open');
            });

            // Open clicked if it was closed
            if (!isOpen) item.classList.add('open');
        }
    </script>

    <!-- Live search filter -->
    <script>
        document.getElementById("searchPharse").addEventListener("input", function () {
            var term = this.value.toLowerCase().trim();
            document.querySelectorAll(".faq-item").forEach(function (item) {
                var text = item.querySelector(".faq-question-text").textContent.toLowerCase();
                var answer = item.querySelector(".faq-answer p")?.textContent.toLowerCase() || "";
                item.style.display = (text.includes(term) || answer.includes(term)) ? "" : "none";
            });
        });

        // Submit search on Enter
        document.getElementById("searchPharse").addEventListener("keydown", function (e) {
            if (e.key === "Enter") {
                document.getElementById("searchForm").submit();
            }
        });
    </script>

    <!-- Product filter redirect -->
    <script>
        $(document).ready(function () {
            var urlParams    = new URLSearchParams(window.location.search);
            var currentProj  = urlParams.get("projectID");
            var storedProj   = sessionStorage.getItem("selectedProjectID");

            if (storedProj) {
                $("#projectTypeFilter1").val(storedProj);
            }

            if (!currentProj) {
                var proj = storedProj || $("#projectTypeFilter1").val();
                if (proj) redirectToPage(proj);
            }

            $("#projectTypeFilter1").change(function () {
                var val = $(this).val();
                if (val) {
                    sessionStorage.setItem("selectedProjectID", val);
                    redirectToPage(val);
                }
            });

            function redirectToPage(projectId) {
                window.location.href = '@Url.Action("FAQ","Tickets")' + "?projectID=" + encodeURIComponent(projectId);
            }

            $("a, button, li").click(function () {
                localStorage.removeItem("selectedProjectId");
            });
        });
    </script>

   
}
