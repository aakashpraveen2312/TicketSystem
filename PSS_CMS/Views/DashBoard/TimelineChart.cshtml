@model PSS_CMS.Models.TimelineResponse
@using Newtonsoft.Json

@{ ViewData["Title"] = "Timeline Chart";
    ViewBag.PageTitle = "Timeline Chart";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Chart card ─────────────────────────────── */
        .chart-card {
            padding: 28px 24px 20px;
        }

        .chart-wrap {
            position: relative;
            width: 100%;
            min-height: 420px;
        }

        /* ── Legend strip ───────────────────────────── */
        .chart-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            padding: 14px 24px;
            border-top: 1px solid var(--border-color);
            background: #fafafa;
        }

        .legend-dot {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ── Status summary chips ───────────────────── */
        .status-chips {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            padding: 14px 24px;
            border-bottom: 1px solid var(--border-color);
        }

        .status-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

        .chip-created {
            background: #EEEDFE;
            color: #3C3489;
        }

        .chip-resolved {
            background: #E1F5EE;
            color: #085041;
        }

        .chip-reopen {
            background: #fff4db;
            color: #c47a00;
        }

        .chip-closed {
            background: #f5f5f5;
            color: #6b7280;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-graph-up nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History", "Tickets")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>Timeline Chart</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-graph-up" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Ticket Timeline &mdash; @Session["UserName"]
        </h6>
    </div>


    <!-- Chart -->
    <div class="chart-card">
        <div class="chart-wrap">
            <canvas id="statusChart"></canvas>
        </div>
    </div>

</div><!-- /page-card -->

@section Scripts {
  
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var statusMapping = { "Created": 1, "Resolved": 2, "ReOpen": 3, "Closed": 4 };

     var chartData = @Html.Raw(
    Newtonsoft.Json.JsonConvert.SerializeObject(
        Model?.TicketTimeline
        ?? new System.Collections.Generic.List<PSS_CMS.Models.Timeline>()
    )
);

        var labels = chartData.map(function (item) {
            var date    = new Date(item.date);
            var pad     = function (n) { return String(n).padStart(2, '0'); };
            return pad(date.getDate()) + "-" + pad(date.getMonth() + 1) + "-" + date.getFullYear()
                 + " " + pad(date.getHours()) + ":" + pad(date.getMinutes()) + ":" + pad(date.getSeconds());
        });

        labels.reverse();
        chartData.reverse();

        var statusValues = chartData.map(function (item) { return statusMapping[item.status]; });

        var borderColors = statusValues.map(function (value, index) {
            if (index === 0) return '#185FA5';
            var prev = statusValues[index - 1];
            if (prev === 3 && value === 2) return 'darkorange';
            if (prev === 4 && value === 3) return 'darkred';
            if (prev === 4 && value === 2) return '#e74c3c';
            if (prev === 2 && value === 1) return 'darkmagenta';
            if (prev === 2 && value === 3) return 'darkgreen';
            if (prev === 4 && value === 1) return 'goldenrod';
            return '#185FA5';
        });

        var ctx = document.getElementById('statusChart').getContext('2d');

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Ticket Status Timeline',
                    data: statusValues,
                    borderWidth: 2.5,
                    fill: false,
                    tension: 0.3,
                    pointRadius: 7,
                    pointHoverRadius: 9,
                    pointBackgroundColor: borderColors,
                    pointBorderColor: borderColors,
                    pointBorderWidth: 2,
                    segment: {
                        borderColor: function (ctx) {
                            return borderColors[ctx.p0DataIndex];
                        }
                    }
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#fff',
                        borderColor: '#e2e8f0',
                        borderWidth: 1,
                        titleColor: '#1a202c',
                        bodyColor: '#4a5568',
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function (tooltipItem) {
                                var index    = tooltipItem.dataIndex;
                                var status   = chartData[index].status;
                                var username = chartData[index].Username;
                                if (status === "Resolved" || status === "Closed") {
                                    return ' Status: ' + status + '  |  By: ' + username;
                                }
                                return ' Status: ' + status;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        title: {
                            display: true,
                            text: 'Date & Time',
                            font: { size: 13, weight: '600' },
                            color: '#4a5568'
                        },
                        type: 'category',
                        grid: { color: '#f1f5f9' },
                        border: { color: '#cbd5e0', width: 1.5 },
                        ticks: { font: { size: 11 }, color: '#6b7280' }
                    },
                    x: {
                        title: {
                            display: true,
                            text: 'Status',
                            font: { size: 13, weight: '600' },
                            color: '#4a5568'
                        },
                        ticks: {
                            stepSize: 1,
                            font: { size: 11 },
                            color: '#6b7280',
                            callback: function (value) {
                                return Object.keys(statusMapping).find(function (key) {
                                    return statusMapping[key] === value;
                                });
                            }
                        },
                        grid: { color: '#f1f5f9' },
                        border: { color: '#cbd5e0', width: 1.5 }
                    }
                }
            }
        });
    </script>
}
