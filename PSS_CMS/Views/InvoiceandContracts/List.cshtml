@model IEnumerable<PSS_CMS.Models.ContractInvoiceList>

@{ ViewData["Title"] = "Contracts";
                ViewBag.PageTitle = "Contracts";
                Layout = "~/Views/Shared/_Layout.cshtml";

                string searchPhrase = Request["searchPharse"] ?? "";

                var filtered = Model?.Where(x =>
                    string.IsNullOrEmpty(searchPhrase) ||
                    (x.CP_CODE != null && x.CP_CODE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
                    (x.CP_CONTRACTREF != null && x.CP_CONTRACTREF.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
                    (x.CP_CONTRACTCREATEDBY != null && x.CP_CONTRACTCREATEDBY.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
                    (x.CP_CONTRACTAPPROVEDBY != null && x.CP_CONTRACTAPPROVEDBY.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
                ).ToList(); }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-earmark-text nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Contracts</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <h3 class="page-card-title">
            <i class="bi bi-file-earmark-text"></i> Contracts
        </h3>

        <div style="display:flex; align-items:center; gap:10px;">

            @using (Html.BeginForm("ContractList", "Contract", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>

    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search code, ref or created by"
           autocomplete="off"
           value="@searchPhrase" />

    @if (!string.IsNullOrEmpty(searchPhrase))
    {
<a href="@Url.Action("ContractList", "Contract")" title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}
</div>            }

            <!-- Add -->
            @*<a href="@Url.Action("Create", "Contract")"
               class="res-btn res-btn-submit"
               style="padding:8px 15px; text-decoration:none; white-space:nowrap;">
                <i class="bi bi-plus-circle"></i>
                Create Contract
            </a>*@

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">
        @if (filtered != null && filtered.Any())
        {
<table id="contractsTable">
    <thead>
        <tr>
            <th style="width:100px;">Code</th>
            <th>Reference</th>
            <th>Created By</th>
            <th>Approved By</th>
            <th style="width:130px;">Validity</th>
            <th class="text-center">Contract Amt</th>
            <th class="text-center">Paid</th>
            <th class="text-center">Balance</th>
            <th class="text-center" style="width:100px;">Status</th>
            <th class="text-center" style="width:100px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in filtered)
        {
            var statusText = o.CP_STATUS == "P" ? "Processed"
                            : o.CP_STATUS;

            var statusClass = o.CP_STATUS == "P" ? "status-pending"
                             : o.CP_STATUS == "E" ? "badge-expired"
                             : "status-pending";

            var pdfUrl = Url.Action("ContractInvoice", "Contract", new { CP_CTURECID = o.CP_CTURECID, CP_CRECID = o.CP_CRECID, CP_RECID = o.CP_RECID });
            var InvoiceUrl = Url.Action("UserContractInvoice", "InvoiceandContracts", new { CP_CTURECID = o.CP_CTURECID, companyId = o.CP_CRECID, CIH_CONTRACTRECID = o.CP_CTRECID, invoiceAmt = o.CP_CONTRACTAMOUNT });

<tr>
    <td><span class="contract-code">@o.CP_CODE</span></td>
    <td>@o.CP_CONTRACTREF</td>
    <td>@o.CP_CONTRACTCREATEDBY</td>
    <td>@o.CP_CONTRACTAPPROVEDBY</td>
    <td style="font-size:12px;color:#6B7280;white-space:nowrap;">
        @(o.CP_FROMDATE?.ToString("dd MMM yyyy")) - @(o.CP_TODATE?.ToString("dd MMM yyyy"))
    </td>
    <td class="amount-cell text-center">₹@o.CP_CONTRACTAMOUNT.ToString("N2")</td>
    <td class="amount-cell text-center">₹@o.CP_PAIDAMOUNT.ToString("N2")</td>
    <td class="net-amount-cell text-center">₹@o.CP_BALANCEAMOUNT.ToString("N2")</td>
    <td class="text-center">
        <span class="status-badge @statusClass">@statusText</span>
    </td>
    <td>
        <div class="action-cell">

            <!-- Contract Download PDF -->
            <a href="javascript:void(0);"
               onclick="downloadPdfAjax('@pdfUrl')"
               title="Contract PDF"
               class="act-btn no-loader"
               style="color:#e74c3c;">
                <i class='bi bi-file-earmark-pdf'></i>
            </a>

            <a href="@InvoiceUrl"
               title="Invoice"
               class="act-btn"
               style="color:#6c5ce7;">
                <i class='bi bi-receipt'></i>
            </a>








            <!-- Contract Invoice Download PDF -->
            @*<a href="javascript:void(0);"
           class="act-btn act-process no-loader"
           title="Download Invoice PDF"
           onclick="generateInvoicePdf(
                                       @o.companyId,
                                       @o.CIH_RECID
                                   );">

            <i class="bx bx-download"></i>

        </a>*@





        </div>
    </td>
</tr>}
    </tbody>
</table> <!-- Pagination -->
                                <div class="table-pagination">
                                    <button id="prevBtn" class="page-btn"><i class="bi bi-chevron-left"></i> Previous</button>
                                    <span id="pageInfo" class="page-info"></span>
                                    <button id="nextBtn" class="page-btn">Next <i class="bi bi-chevron-right"></i></button>
                                </div> }
                                            else
                                            {
                                <div class="alert alert-warning text-center m-3">
                                    <b>No contracts available</b>
                                </div>}
    </div>
</div>



@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
(function () {
            var pageSize = 10;
            var table = document.getElementById("contractsTable");
            if (!table) return;

            var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));
            var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
            var currentPage = 1;

            var prevBtn = document.getElementById("prevBtn");
            var nextBtn = document.getElementById("nextBtn");
            var pageInfo = document.getElementById("pageInfo");

            function renderPage() {
                var start = (currentPage - 1) * pageSize;
                var end = start + pageSize;

                rows.forEach(function (row, idx) {
                    row.style.display = (idx >= start && idx < end) ? "" : "none";
                });

                pageInfo.textContent = "Page " + currentPage + " of " + totalPages;
                prevBtn.disabled = currentPage === 1;
                nextBtn.disabled = currentPage === totalPages;
            }

            prevBtn.addEventListener("click", function () {
                if (currentPage > 1) { currentPage--; renderPage(); }
            });

            nextBtn.addEventListener("click", function () {
                if (currentPage < totalPages) { currentPage++; renderPage(); }
            });

            renderPage();
        })();


        function downloadPdfAjax(url) {
            Swal.fire({
                title: 'Processing...',
                text: 'Your PDF is being prepared.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: url,
                type: 'POST',
                xhrFields: { responseType: 'blob' },
                success: function (data, status, xhr) {
                    Swal.close();

                    var blob = new Blob([data], { type: 'application/pdf' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);

                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    var fileName = "Invoice.pdf";
                    if (disposition && disposition.indexOf('filename=') !== -1) {
                        fileName = disposition.split('filename=')[1].replace(/"/g, '');
                    }

                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Failed to download PDF.'
                    });
                }
            });
        }

            function generateInvoicePdf(companyId, invoiceHeaderRecId) {

    Swal.fire({
        title: "Generate Invoice PDF?",
        text: "The invoice PDF will be generated and downloaded.",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Generate",
        cancelButtonText: "Cancel"
    }).then(function (result) {

        if (!result.isConfirmed) {
            return;
        }

        Swal.fire({
            title: "Generating PDF...",
            text: "Please wait.",
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: function () {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '@Url.Action("GenerateContractInvoicePdf", "SMContractInvoiceHeader")',
            type: 'GET',
            data: {
                companyId: companyId,
                InvoiceHeaderRecId: invoiceHeaderRecId
            },

            success: function (response) {

                if (response.success) {

                    Swal.fire({
                        icon: "success",
                        title: "PDF Generated Successfully",
                        text: response.message,
                        timer: 1500,
                        showConfirmButton: false
                    });

                    // Download PDF through MVC
                    setTimeout(function () {

                        var downloadUrl =
                            '@Url.Action("DownloadContractInvoicePdf", "SMContractInvoiceHeader")'
                            + '?fileUrl='
                            + encodeURIComponent(response.fileUrl);

                        window.location.href = downloadUrl;

                    }, 1000);

                }
                else {

                    Swal.fire({
                        icon: "error",
                        title: "Failed",
                        text: response.message || "PDF generation failed."
                    });

                }
            },

            error: function (xhr) {

                Swal.fire({
                    icon: "error",
                    title: "Error",
                    text: "Something went wrong while generating the PDF."
                });

            }
        });

    });
}



    </script>
}
