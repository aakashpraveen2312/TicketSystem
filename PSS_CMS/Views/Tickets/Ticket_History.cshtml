@model IEnumerable<PSS_CMS.Models.Tickethistory>
@using GridMvc.Html

@{ ViewData["Title"] = "Ticket History";
    ViewBag.PageTitle = "Ticket History";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <style>
        /* ── Loading screen ────────────────────────── */
        #loadingScreen {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.85);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .loader {
            width: 40px;
            height: 40px;
            border: 4px solid #EEEDFE;
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Filter row ────────────────────────────── */
        .filter-row {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
            background: #fafafa;
        }

            .filter-row select {
                border: 1px solid var(--border-color);
                border-radius: 10px;
                padding: 7px 10px;
                font-size: 12.5px;
                color: var(--text-dark);
                background: #fff;
                outline: none;
                font-family: inherit;
                height: 36px;
                cursor: pointer;
                min-width: 160px;
                flex: 1;
            }

                .filter-row select:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(99,89,210,.08);
                }

        /* ── Tool icon buttons ─────────────────────── */
        .tool-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: #fff;
            cursor: pointer;
            text-decoration: none;
            transition: background .12s;
            color: var(--text-dark);
            flex-shrink: 0;
        }

            .tool-btn:hover {
                background: var(--body-bg);
            }

            .tool-btn i {
                font-size: 17px;
            }

        /* ── Status badges ──────────────────────────── */
        .badge-submitted {
            background: #eef6ff;
            color: #1a73e8;
        }

        .badge-resolved {
            background: #E1F5EE;
            color: #085041;
        }

        .badge-closed {
            background: #f5f5f5;
            color: #6b7280;
        }

        .badge-reopened {
            background: #fff4db;
            color: #c47a00;
        }

        .ticket-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Date range btn ────────────────────────── */
        .daterangepicker .drp-buttons .btn {
            margin-left: 4px !important;
            font-size: 12px;
            font-weight: bold;
            padding: 4px 8px;
        }

        /* ── Reset btn ─────────────────────────────── */
        .btn-reset-filter {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 14px;
            background: var(--body-bg);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background .12s;
            white-space: nowrap;
        }

            .btn-reset-filter:hover {
                background: var(--border-color);
            }
    </style>
}

<!-- Loading screen -->
<div id="loadingScreen"><div class="loader"></div></div>

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-detailed nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Ticket History</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-ticket-detailed" style="font-size:15px;color:#3C3489;"></i>
            </span>
            My Tickets
        </h6>

        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">

            <!-- Search -->
            @using (Html.BeginForm("Ticket_History", "Tickets", FormMethod.Get, new { id = "searchForm" }))
            {
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text" id="searchPharse" name="searchPharse"
                   placeholder="Search"
                   autocomplete="off"
                   value="@Request["searchPharse"]" />
        </div>}

            <!-- Date picker -->
            <button type="button" class="tool-btn" id="daterange" title="Date Range Filter">
                <i class="bi bi-calendar3" style="color:#3C3489;"></i>
            </button>
            <form id="dateForm" method="post" action="@Url.Action("Ticket_History", "Tickets")">
                @Html.Hidden("StartDate")
                @Html.Hidden("EndDate")
            </form>

            <!-- Excel export -->
            <a href="@Url.Action("ExcelUserDownload", "Tickets")" class="tool-btn" title="Export as Excel">
                <i class="bi bi-file-earmark-excel" style="color:#1D9E75;font-size:18px;"></i>
            </a>

            <!-- PDF export -->
            <a href="@Url.Action("UserTicketsPdfDownload", "Tickets")" class="tool-btn" title="PDF Download">
                <i class="bi bi-file-earmark-pdf-fill" style="color:#e74c3c;font-size:18px;"></i>
            </a>

            <!-- Reset filters -->
            <button type="button" class="btn-reset-filter" id="resetFilters">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
            @if (Session["U_ADDONCUSTOMER"].ToString().Trim() == "Y")
            {<!-- New Ticket -->
        <a href="@Url.Action("AddonCustomerCreateTicket", "Tickets")" class="btn-add">
            <i class="bi bi-plus-lg"></i>  New Ticket
        </a> }
                                            else
                                            { <!-- New Ticket -->
        <a href="@Url.Action("Ticket", "Tickets")" class="btn-add">
            <i class="bi bi-plus-lg"></i> New Ticket
        </a>            }


        </div>
    </div>

    <!-- Filter row -->
    <div class="filter-row">

        @{ var projectTypeList = ViewBag.Product as List<SelectListItem>; }
        @if (projectTypeList != null)
        {
@Html.DropDownListFor(m => m.FirstOrDefault().SelectedProjectType,
         projectTypeList,
         "All Products",
         new { id = "projectTypeFilter", tabindex = "1" }) }
else
{
<select id="projectTypeFilter"><option value="">No Products Available</option></select>}

        @Html.DropDownListFor(m => m.FirstOrDefault().SelectedTicketType,
                      (IEnumerable<SelectListItem>)ViewBag.TicketTypes,
                      "All Ticket Types",
                      new { id = "ticketTypeFilter", tabindex = "2" })

        @Html.DropDownList("Status",
                      new List<SelectListItem>
                      {
                new SelectListItem { Text = "All Statuses", Value = "" },
                new SelectListItem { Text = "Submitted",   Value = "S" },
                new SelectListItem { Text = "Resolved",    Value = "R" },
                new SelectListItem { Text = "Closed",      Value = "C" },
                new SelectListItem { Text = "Re-Opened",   Value = "O" }
                              },
                      new { id = "statusDropdown" })

    </div>

    <!-- Table -->
    <div class="grid-wrap" id="ticketTable">
        @if (Model != null && Model.Any())
        {
<table>
    <thead>
        <tr>
            <th>Admin Name</th>
            <th>Date &amp; Time</th>
            <th>Product</th>
            <th>Subject</th>
            <th>Ticket Type</th>
            <th>Status</th>
            <th style="text-align:center;width:120px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
<tr>
    <td>@item.AdminNameDisplay</td>
    <td style="font-size:12px;color:var(--text-muted);">@item.TC_TICKETDATES</td>
    <td><span class="product-serial">@item.P_NAME</span></td>
    <td>@item.TC_SUBJECT</td>
    <td><span class="service-badge">@item.TC_TICKETTYPE</span></td>
    <td>
        @{ var st = (item.TC_STATUS ?? "").Trim();
            var stClass = st == "S" ? "badge-submitted"
                        : st == "R" ? "badge-resolved"
                        : st == "C" ? "badge-closed"
                        : st == "O" ? "badge-reopened"
                        : "badge-closed";
            var stIcon = st == "S" ? "bi-send"
                       : st == "R" ? "bi-check-circle-fill"
                       : st == "C" ? "bi-lock-fill"
                       : st == "O" ? "bi-arrow-repeat"
                       : "bi-circle"; }
        <span class="ticket-status @stClass">
            <i class="bi @stIcon"></i>
            @item.TC_STATUS_DISPLAY
        </span>
    </td>
    <td>
        <div class="action-cell">
            <!-- Timeline -->
            <a href="@Url.Action("TimelineChart", "DashBoard", new { recid3 = item.TC_RECID })"
               class="act-btn" style="color:#e74c3c;" title="Timeline History">
                <i class="bi bi-graph-up"></i>
            </a>

            @if ((item.TC_STATUS ?? "").Trim() == "S")
            {<!-- Self-close -->
                                        <button type="button"
                                                class="act-btn delete-ticket"
                                                style="color:#e6a817;border:none;background:none;cursor:pointer;"
                                                data-recid="@item.TC_RECID"
                                                data-userclosedname="@item.TC_USERNAME"
                                                title="Close Ticket">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button> }
                                    else
                                    { <!-- Review -->
                                                                <a href="@Url.Action("ReviewTickets", "Tickets", new { recid2 = item.TC_RECID, status = item.TC_STATUS, REOPENUSERNAME = item.TC_USERNAME, projectid = item.P_RECID, Customertype = item.TC_CUSTOMERTYPE, ticuserid = item.TC_URECID, prodserial = item.TC_PRODUCTSERIALNUMBER })"
                                                                   class="act-btn act-edit" title="Review Ticket">
                                                                    <i class="bi bi-chat-left-text"></i>
                                                                </a>}

            @if ((item.TC_STATUS ?? "").Trim() == "R" || (item.TC_STATUS ?? "").Trim() == "O")
            {
<a href="@Url.Action("ViewDetails", "Tickets", new { ticketRecID = item.TC_RECID })"
   class="act-btn act-view" title="View Ticket">
    <i class="bi bi-eye-fill"></i>
</a>}

            @if (Session["MaterialConsumptionFlag"]?.ToString() == "Y" && (item.TC_STATUS ?? "").Trim() == "C")
            {
<a href="#" class="act-btn download-pdf"
   style="color:#e74c3c;"
   data-id="@item.TC_RECID"
   title="Download PDF">
    <i class="bi bi-file-earmark-pdf-fill"></i>
</a>}
        </div>
    </td>
</tr>
}
    </tbody>
</table> }
else
{
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-ticket-detailed" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No ticket records available</span>
</div>}
    </div>

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <i class="bi bi-calendar3" style="font-size:12px;color:#3C3489;"></i>
        <span>Date Filter</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-graph-up" style="font-size:12px;color:#e74c3c;"></i>
        <span>Timeline</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-arrow-repeat" style="font-size:12px;color:#e6a817;"></i>
        <span>Self Close</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-chat-left-text" style="font-size:12px;color:#6c5ce7;"></i>
        <span>Review</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-eye-fill" style="font-size:12px;color:#00b894;"></i>
        <span>View</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-file-earmark-pdf-fill" style="font-size:12px;color:#e74c3c;"></i>
        <span>PDF</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment/min/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/UIPagination.js"></script>

    <!-- Loading screen -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 500);
        });
        function showLoadingScreen() { document.getElementById('loadingScreen').style.display = 'flex'; }
        function hideLoadingScreen() { document.getElementById('loadingScreen').style.display = 'none'; }
    </script>

    <!-- Filters + Date Range -->
    <script>
        $(document).ready(function () {

            // Restore from localStorage
            var savedStatus      = localStorage.getItem('ticketStatus')  || '';
            var savedProjectType = localStorage.getItem('projectType')   || '';
            var savedTicketType  = localStorage.getItem('ticketType')    || '';
            var savedStart       = localStorage.getItem('StartDate')     || '';
            var savedEnd         = localStorage.getItem('EndDate')       || '';

            if (savedStatus)      $("#statusDropdown").val(savedStatus);
            if (savedProjectType) $("#projectTypeFilter").val(savedProjectType);
            if (savedTicketType)  $("#ticketTypeFilter").val(savedTicketType);
            if (savedStart)       $('input[name="StartDate"]').val(savedStart);
            if (savedEnd)         $('input[name="EndDate"]').val(savedEnd);

            function updateTicketTable() {
                var status      = $("#statusDropdown").val();
                var projectType = $("#projectTypeFilter").val();
                var ticketType  = $("#ticketTypeFilter").val();
                var startDate   = $('input[name="StartDate"]').val();
                var endDate     = $('input[name="EndDate"]').val();

                localStorage.setItem('ticketStatus',  status);
                localStorage.setItem('projectType',   projectType);
                localStorage.setItem('ticketType',    ticketType);
                localStorage.setItem('StartDate',     startDate);
                localStorage.setItem('EndDate',       endDate);

                var url = '@Url.Action("Ticket_History", "Tickets")'
                    + "?status=" + status
                    + "&projectType=" + projectType
                    + "&ticketType=" + ticketType
                    + "&startDate=" + startDate
                    + "&endDate=" + endDate;

                showLoadingScreen();
                $.ajax({
                    url: url, type: 'GET',
                    success: function (response) {
                        hideLoadingScreen();
                        $("#ticketTable").html($(response).find("#ticketTable").html());
                    },
                    error: function () { hideLoadingScreen(); }
                });
            }

            $("#statusDropdown, #projectTypeFilter, #ticketTypeFilter").change(updateTicketTable);

            // Date range picker
            $('#daterange').daterangepicker({
                locale: { format: 'DD-MM-YYYY', cancelLabel: 'Cancel', applyLabel: 'Apply' },
                opens: 'left',
                autoApply: false,
                showDropdowns: true
            }, function (start, end) {
                $('input[name="StartDate"]').val(start.format('YYYY-MM-DD'));
                $('input[name="EndDate"]').val(end.format('YYYY-MM-DD'));
                updateTicketTable();
            });

            // Reset
            $("#resetFilters").click(function () {
                localStorage.clear();
                $("#statusDropdown, #projectTypeFilter, #ticketTypeFilter, #searchPharse").val('');
                $('input[name="StartDate"], input[name="EndDate"]').val('');
                updateTicketTable();
            });

            $("a, button, li").click(function () { localStorage.clear(); });
            $(window).on("beforeunload", function () { localStorage.clear(); });
        });
    </script>

    <!-- Self-close ticket -->
    <script>
        $(document).on("click", ".delete-ticket", function (e) {
            e.preventDefault();
            var recid2 = $(this).data("recid");
            var userclosedname = $(this).data("userclosedname");

            Swal.fire({
                title: "Processing...",
                text: "Please wait while the ticket is being closed.",
                icon: "info",
                showConfirmButton: false,
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: "/Tickets/DeleteUpdateTicket",
                type: "POST",
                data: { recid2: recid2, userclosedname: userclosedname },
                success: function (response) {
                    Swal.close();
                    if (response.success) {
                        Swal.fire({ title: "Ticket Closed!", text: response.message, icon: "success", showConfirmButton: false, timer: 2000 })
                            .then(() => { location.reload(); });
                    } else {
                        Swal.fire({ title: "Message", text: response.message, icon: "info", showConfirmButton: false, timer: 2000 });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ title: "Error!", text: "Something went wrong. Try again.", icon: "error", showConfirmButton: false, timer: 2000 });
                }
            });
        });
    </script>

    <!-- PDF download -->
    <script>
        $(document).on('click', '.download-pdf', function (e) {
            e.preventDefault();
            var trecid = $(this).data('id');

            Swal.fire({ title: 'Processing PDF...', text: 'Please wait.', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            $.ajax({
                url: '@Url.Action("DownloadPDF", "PDF")',
                type: 'POST',
                data: { TRECID: trecid },
                success: function (response) {
                    Swal.close();
                    if (response.status === "success") {
                        window.open(response.url, '_blank');
                    } else {
                        Swal.fire({ icon: 'info', title: 'Message', text: response.message });
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.' });
                }
            });
        });
    </script>


}
