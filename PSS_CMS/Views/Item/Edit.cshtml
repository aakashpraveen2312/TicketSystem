@model PSS_CMS.Models.Items

@{ ViewData["Title"] = "Edit Item";
                ViewBag.PageTitle = "Edit Item";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-box nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    @if (Session["ItemgroupName"] != null)
    {
<a href="@Url.Action("List","ItemGroup")">Item Group (@Session["ItemgroupName"].ToString())</a>
                <i class="bi bi-chevron-right"></i>}
    @if (Session["ItemCatName"] != null)
    {
<a href="@Url.Action("List","ItemCategory", new { IGRECID = Session["IGRECID"] })">Item Category (@Session["ItemCatName"].ToString())</a>
                <i class="bi bi-chevron-right"></i>}
    Item
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Edit", "Item", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
@Html.HiddenFor(m => m.I_HSNRECID)

                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span class="title-icon">
                                <i class="bi bi-box"></i>
                            </span>
                            Edit Item
                        </h6>
                    </div>

                    <!-- Form body -->
                    <div class="form-body">

                        <!-- ── Basic Info ─────────────────────── -->
                        <p class="form-section-title">Item Information</p>

                        <div class="form-grid">

                            <!-- Code (readonly) -->
                            <div class="form-group">
                                <label class="form-label" for="I_CODE">
                                    @Html.DisplayNameFor(m => m.I_CODE)
                                </label>
                                @Html.TextBoxFor(m => m.I_CODE, new
                                {
                                    @class = "form-input-auto",
                                    autocomplete = "off",
                                    placeholder = "Auto Code",
                                    @readonly = "readonly"
                                })
                                <span class="auto-badge"><i class="bi bi-lock"></i> Read-only — system generated</span>
                            </div>

                            <!-- Description -->
                            <div class="form-group">
                                <label class="form-label" for="I_DESCRIPTION">
                                    @Html.DisplayNameFor(m => m.I_DESCRIPTION)
                                    <span class="req">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.I_DESCRIPTION, new
                                {
                                    @class = "form-input-text",
                                    autocomplete = "off",
                                    oninput = "Netamount()",
                                    type = "text",
                                    placeholder = "Enter item description"
                                })
                                @Html.ValidationMessageFor(m => m.I_DESCRIPTION, "", new { @class = "text-danger", style = "font-size:11px" })
                            </div>

                            <!-- UOM -->
                            <div class="form-group">
                                <label class="form-label" for="I_CUOM">
                                    @Html.DisplayNameFor(m => m.I_CUOM)
                                </label>
                                @Html.DropDownListFor(
                                         m => m.I_CUOM,
                                         new SelectList(new List<string>
                                         {
                            "Pieces", "Kilograms", "Grams", "Litre",
                            "Milli litre", "Meter", "Centimeter",
                            "Milli meter", "Box", "Packet", "Set", "NOS"
                         }),
                                         "-- Select UOM --",
                                         new { @class = "form-select", autocomplete = "off" }
                                     )
                            </div>

                            <!-- Sort Order -->
                            <div class="form-group">
                                <label class="form-label" for="I_SORTORDER">
                                    @Html.DisplayNameFor(m => m.I_SORTORDER)
                                </label>
                                @Html.TextBoxFor(m => m.I_SORTORDER, new
                           {
                               @class = "form-input-num",
                               autocomplete = "off",
                               type = "number",
                               placeholder = "0"
                           })
                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <!-- ── Pricing & Tax ───────────────────── -->

                        <div class="form-grid">

                            <!-- Price -->
                            <div class="form-group">
                                <label class="form-label" for="I_PRICE">
                                    @Html.DisplayNameFor(m => m.I_PRICE)
                                    <span class="req">*</span>
                                </label>
                                @Html.TextBoxFor(m => m.I_PRICE, new
                           {
                               @class = "form-input-num",
                               autocomplete = "off",
                               type = "number",
                               oninput = "Netamount()",
                               placeholder = "0"
                           })
                            </div>

                            <!-- Quantity -->
                            <div class="form-group">
                                <label class="form-label" for="I_SMQUANTITY">
                                    @Html.DisplayNameFor(m => m.I_SMQUANTITY)
                                </label>
                                @Html.TextBoxFor(m => m.I_SMQUANTITY, new
                           {
                               @class = "form-input-num",
                               autocomplete = "off",
                               oninput = "Netamount()",
                               type = "number"
                           })
                            </div>

                            <!-- SGST -->
                            <div class="form-group">
                                <label class="form-label" for="I_SGST">
                                    @Html.DisplayNameFor(m => m.I_SGST)
                                </label>
                                @Html.TextBoxFor(m => m.I_SGST, "{0:0.00}", new
                                {
                                    @class = "form-input-auto",
                                    autocomplete = "off",
                                    oninput = "formatPrice(this)",
                                    placeholder = "0.00"
                                })
                                <span class="auto-badge"><i class="bi bi-lock"></i> From HSN master</span>
                            </div>

                            <!-- CGST -->
                            <div class="form-group">
                                <label class="form-label" for="I_CGST">
                                    @Html.DisplayNameFor(m => m.I_CGST)
                                </label>
                                @Html.TextBoxFor(m => m.I_CGST, new
                                {
                                    @class = "form-input-auto",
                                    autocomplete = "off",
                                    type = "text"
                                })
                                <span class="auto-badge"><i class="bi bi-lock"></i> From HSN master</span>
                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <!-- ── Amount Summary ───────────────── -->

                        <div class="form-grid">
                            <div class="amount-summary">

                                <div class="amount-item">
                                    <span class="amount-label">
                                        <i class="bi bi-calculator"></i>
                                        @Html.DisplayNameFor(m => m.I_SMTOTALAMOUNT)
                                    </span>
                                    @Html.TextBoxFor(m => m.I_SMTOTALAMOUNT, new
                                    {
                                        @class = "form-input-calc",
                                        autocomplete = "off",
                                        @readonly = "readonly",
                                        placeholder = "0.00"
                                    })
                                </div>

                                <div class="amount-item">
                                    <span class="amount-label">
                                        <i class="bi bi-currency-rupee"></i>
                                        @Html.DisplayNameFor(m => m.I_SMNETAMOUNT)
                                    </span>
                                    @Html.TextBoxFor(m => m.I_SMNETAMOUNT, new
                                    {
                                        @class = "form-input-calc",
                                        autocomplete = "off",
                                        type = "text",
                                        @readonly = "readonly"
                                    })
                                </div>

                            </div>
                        </div>

                    </div>

                    <!-- Legend bar — matches list view style -->
                    <div class="legend-bar">

                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
                            <span>Read-only Field</span>
                        </div>

                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
                            <span>Text Field</span>
                        </div>

                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
                            <span>Number Field</span>
                        </div>

                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#BA7517;flex-shrink:0;"></span>
                            <span>Calculated Field</span>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("List","Item")"
                           class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                        <button type="submit"
                                class="btn-save"
                                id="savebutton">
                            <i class="bi bi-floppy"></i> Update
                        </button>
                    </div>

                </div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Net Amount Calculation ───────────────── */
        function Netamount() {
            var price    = parseFloat($('#I_PRICE').val()) || 0;
            var quantity = parseFloat($('#I_SMQUANTITY').val()) || 0;
            var sgst     = parseFloat($('#I_SGST').val()) || 0;
            var cgst     = parseFloat($('#I_CGST').val()) || 0;

            var baseAmount = price * quantity;
            var sgstAmount = baseAmount * (sgst / 100);
            var cgstAmount = baseAmount * (cgst / 100);

            $('#I_SMTOTALAMOUNT').val(baseAmount.toFixed(2));
            $('#I_SMNETAMOUNT').val((baseAmount + sgstAmount + cgstAmount).toFixed(2));
        }

        /* Run on page load with existing values */
        window.addEventListener("load", function () { Netamount(); });

        /* ── Decimal formatter ───────────────────── */
        function formatPrice(input) {
            var digits = input.value.replace(/\D/g, '');
            if (digits.length === 0)      { input.value = "0.00"; return; }
            else if (digits.length === 1) { input.value = "0.0" + digits; }
            else if (digits.length === 2) { input.value = "0." + digits; }
            else {
                input.value = parseInt(digits.slice(0, -2), 10) + "." + digits.slice(-2);
            }
        }

        /* ── Item Group → Category cascade ──────── */
        $(document).ready(function () {

            $('#itemGroupDropdown').on('change', function () {
                var grecid = $(this).val();
                if (grecid) {
                    $.ajax({
                        url: '@Url.Action("ItemGroupCategoryCombo","MaterialConsumption")',
                        type: 'GET',
                        data: { Grouprecid: grecid },
                        success: function (data) {
                            var dd = $('#itemCategoryDropdown').empty();
                            dd.append('<option value="">Select an Item Category</option>');
                            $.each(data, function (i, item) {
                                dd.append($('<option>', { value: item.IC_RECID, text: item.IC_DESCRIPTION }));
                            });
                        },
                        error: function () { alert('Error loading categories.'); }
                    });
                } else {
                    $('#itemCategoryDropdown').empty().append('<option value="">Select an Item Category</option>');
                }
            });

            /* ── Category → Item cascade ─────────── */
            var materials = [];

            $('#itemCategoryDropdown').on('change', function () {
                var categoryRecId    = $(this).val();
                var materialDropdown = $('#MaterialDropdown').empty();
                materials = [];

                if (!categoryRecId) {
                    materialDropdown.append('<option value="">Select Item Category first</option>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ItemCombo","MaterialConsumption")',
                    type: 'GET',
                    data: { Categoryrecid: categoryRecId },
                    success: function (data) {
                        if (data && data.length > 0) {
                            materialDropdown.append('<option value="">Select an Item</option>');
                            materials = data;
                            $.each(data, function (i, item) {
                                materialDropdown.append($('<option>', { value: item.I_RECID, text: item.I_DESCRIPTION }));
                            });
                        } else {
                            materialDropdown.append('<option disabled>No items available</option>');
                        }
                    },
                    error: function () {
                        materialDropdown.append('<option disabled>Error loading items</option>');
                    }
                });
            });

            /* ── AJAX submit — processing spinner shows FIRST ── */
            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Edit","Item")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "Ok",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue"
                                            }
                                        }).then(function () {
                                            window.location.href = '@Url.Action("List","Item")';
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
            }
        });
    </script>
}
