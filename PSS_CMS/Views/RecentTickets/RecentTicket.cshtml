@model IEnumerable<PSS_CMS.Models.Recenttickets>

@{ ViewData["Title"] = "Tickets";
    ViewBag.PageTitle = "Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
    <style>
        /* ── Preloader ──────────────────────────────── */
        #ticketLoader {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.85);
            z-index: 99999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .ticket-spinner {
            position: relative;
            width: 64px;
            height: 64px;
        }

            .ticket-spinner::before,
            .ticket-spinner::after {
                content: '';
                position: absolute;
                inset: 0;
                border-radius: 50%;
            }

            .ticket-spinner::before {
                border: 4px solid #EEEDFE;
            }

            .ticket-spinner::after {
                border: 4px solid transparent;
                border-top-color: var(--primary);
                border-right-color: var(--primary);
                animation: tspin .8s linear infinite;
            }

        .ticket-icon {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: var(--primary);
        }

        @@keyframes tspin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Filter selects ─────────────────────────── */
        .filter-select {
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 7px 12px;
            font-size: 12.5px;
            color: var(--text-dark);
            background: #fff;
            outline: none;
            font-family: inherit;
            cursor: pointer;
            height: 36px;
            min-width: 170px;
            flex: 1;
        }

            .filter-select:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(99,89,210,.08);
            }

        /* ── Filter strip ───────────────────────────── */
        .filter-strip {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border-color);
            background: #fafafa;
        }

        /* ── Wide table ─────────────────────────────── */
        .tickets-table {
            width: 100%;
            min-width: 1300px;
            table-layout: fixed;
            border-collapse: collapse;
        }

            .tickets-table th,
            .tickets-table td {
                padding: 11px 12px;
                vertical-align: middle;
                word-wrap: break-word;
                overflow-wrap: break-word;
                white-space: normal;
            }

                .tickets-table th:nth-child(1), .tickets-table td:nth-child(1) {
                    width: 140px;
                }

                .tickets-table th:nth-child(2), .tickets-table td:nth-child(2) {
                    width: 130px;
                }

                .tickets-table th:nth-child(3), .tickets-table td:nth-child(3) {
                    width: 180px;
                }

                .tickets-table th:nth-child(4), .tickets-table td:nth-child(4) {
                    width: 200px;
                }

                .tickets-table th:nth-child(5), .tickets-table td:nth-child(5) {
                    width: 100px;
                }

                .tickets-table th:nth-child(6), .tickets-table td:nth-child(6) {
                    width: 130px;
                }

                .tickets-table th:nth-child(7), .tickets-table td:nth-child(7) {
                    width: 120px;
                }

                .tickets-table th:nth-child(8), .tickets-table td:nth-child(8) {
                    width: 100px;
                    text-align: center;
                }

                .tickets-table th:nth-child(9), .tickets-table td:nth-child(9) {
                    width: 130px;
                }

                .tickets-table th:last-child, .tickets-table td:last-child {
                    width: 130px;
                    text-align: center;
                }

        .grid-wrap {
            overflow-x: auto;
        }

        /* ── Action icons ───────────────────────────── */
        .act {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            font-size: 16px;
            text-decoration: none;
            cursor: pointer;
            border-radius: 6px;
            transition: background .12s;
        }

            .act:hover {
                background: var(--body-bg);
            }

        .act-assign i {
            color: #185FA5;
        }

        .act-review i {
            color: #534AB7;
        }

        .act-cart i {
            color: #1D9E75;
        }

        .act-service i {
            color: #185FA5;
        }

        .act-pdf i {
            color: #E24B4A;
        }

        .act-pick i {
            color: #BA7517;
        }

        .picked-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            color: #085041;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Status badges ──────────────────────────── */
        .ts-submitted {
            background: #eef6ff;
            color: #1a73e8;
        }

        .ts-resolved {
            background: #E1F5EE;
            color: #085041;
        }

        .ts-closed {
            background: #f5f5f5;
            color: #6b7280;
        }

        .ts-reopened {
            background: #fff4db;
            color: #c47a00;
        }

        .t-status {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Priority badges ────────────────────────── */
        .pri-normal {
            background: #f5f5f5;
            color: #6b7280;
        }

        .pri-urgent {
            background: #fff4db;
            color: #c47a00;
        }

        .pri-critical {
            background: #ffeaea;
            color: #e74c3c;
        }

        .pri-emergency {
            background: #EEEDFE;
            color: #3C3489;
        }

        .t-priority {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Tool icon button ───────────────────────── */
        .tool-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: #fff;
            cursor: pointer;
            text-decoration: none;
            transition: background .12s;
            color: var(--text-dark);
            flex-shrink: 0;
        }

            .tool-btn:hover {
                background: var(--body-bg);
            }

            .tool-btn i {
                font-size: 17px;
            }

        /* ── Reset button ───────────────────────────── */
        .btn-reset {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 14px;
            background: var(--body-bg);
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            font-family: inherit;
            transition: background .12s;
            white-space: nowrap;
        }

            .btn-reset:hover {
                background: var(--border-color);
            }

        /* daterangepicker fix */
        .daterangepicker .drp-buttons .btn {
            margin-left: 4px !important;
            font-size: 12px;
            font-weight: bold;
            padding: 4px 8px;
        }
    </style>
}

@{ bool isManager = Session["UserRole"]?.ToString() == "Manager";
