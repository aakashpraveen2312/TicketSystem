@model PSS_CMS.Models.Contract

@{ ViewData["Title"] = "Create Contract";
                ViewBag.PageTitle = "Create Contract";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-file-text nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">Party</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractList", "Contract")">
        @(Session["CT_CUSTOMERNAME"] != null ? Session["CT_CUSTOMERNAME"].ToString() : "")
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>Contract</span>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

@using (Html.BeginForm("CreateContractProduct", "Contract", FormMethod.Post,
    new { id = "createform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-plus-circle" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Create Contract
        </h6>
    </div>

    <!-- Form Body -->
    <div class="form-body">

        <!-- Section: Basic Info -->


        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label">
                  Code
                </label>
                @Html.EditorFor(m => m.CP_CODE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "Auto-Code"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-arrow-repeat"></i> Auto-generated
                </span>
            </div>

            <!-- Contract Reference Number -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTREFERENCENUMBER)
                </label>
                @Html.EditorFor(m => m.CT_CONTRACTREFERENCENUMBER, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off"
                    }
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Section: Contract Period -->

        <div class="form-grid">

            <!-- From Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_FROMDATE)
                    <span class="req">*</span>
                </label>
                @Html.EditorFor(m => m.CT_FROMDATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off",
                        type = "date"
                    }
                })
            </div>

            <!-- To Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_TODATE)
                    <span class="req">*</span>
                </label>
                @Html.EditorFor(m => m.CT_TODATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off",
                        type = "date"
                    }
                })
            </div>

            <!-- Contract Amount -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTAMOUNT)
                </label>
                @Html.EditorFor(m => m.CT_CONTRACTAMOUNT, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-auto",
                        autocomplete = "off",
                        inputmode = "decimal",
                        @readonly = "readonly",
                        oninput = "this.value=this.value.replace(/[^0-9.]/g,'').replace(/(\\..*)\\./g,'$1')"
                    }
                })
                <span class="auto-badge">
                    <i class="bi bi-calculator"></i> Auto-calculated
                </span>
            </div>
            <!-- Created By -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTCREATEDBY)
                </label>
                @Html.EditorFor(m => m.CT_CONTRACTCREATEDBY, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off"
                    }
                })
            </div>
        </div>

        <div class="form-divider"></div>

        <!-- Section: Authorization -->


        <div class="form-grid">

            <!-- Approved By -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTAPPROVEDBY)
                </label>
                @Html.EditorFor(m => m.CT_CONTRACTAPPROVEDBY, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off"
                    }
                })
            </div>

            <!-- Approved Date -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_CONTRACTAPPROVEDDATE)
                </label>
                @Html.EditorFor(m => m.CT_CONTRACTAPPROVEDDATE, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-text",
                        autocomplete = "off",
                        type = "date"
                    }
                })
            </div>
            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label">
                    @Html.DisplayNameFor(m => m.CT_SORTORDER)
                </label>
                @Html.EditorFor(m => m.CT_SORTORDER, new
                {
                    htmlAttributes = new
                    {
                        @class = "form-input-num",
                        autocomplete = "off",
                        type = "text",
                        inputmode = "numeric",
                        oninput = "this.value=this.value.replace(/[^0-9]/g,'')",
                        placeholder = "0"
                    }
                })
            </div>
        </div>

        <div class="form-divider"></div>

        <!-- Section: Settings -->
        <p class="form-section-title">Settings</p>

        <div class="form-grid" style="margin-top:8px;">

            <!-- Disable -->
            <label class="check-row" for="newUserCheckbox">
                @Html.CheckBoxFor(m => m.CPDISABLE, new
                {
                    @class = "form-check-input",
                    id = "newUserCheckbox"
                })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.CPDISABLE)</span>
                    <small>Hide this contract from active listings</small>
                </div>
            </label>

        </div>

    </div>

    <!-- Legend Bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("ContractProductList", "Contract")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        /* ── AJAX submit with processing spinner first ── */
        $(document).ready(function () {
            $("#createform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);
                $("body").css("pointer-events", "none");

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("CreateContractProduct", "Contract")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton: "swal-btn-back"
                                            },
                                            didOpen: function () {
                                                $(".swal2-container").css("pointer-events", "auto");
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) {
                                                location.reload();
                                            } else {
                                                window.location.href = '@Url.Action("ContractProductList", "Contract")';
                                            }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>

    <script>
        /* ── Admin dropdown loader ── */
        $(document).ready(function () {

            function loadAdmins() {
                var precid   = $("#SelectedProduct").val();
                var cmprecid = '@Session["CompanyID"]';

                $("#AdminDropdown")
                    .prop("disabled", true)
                    .empty()
                    .append('<option value="">Loading admins...</option>');

                if (!precid) {
                    $("#AdminDropdown")
                        .empty()
                        .append('<option value="">-- Select Admin --</option>');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetProductAdmins", "AccountantCustomerInvoice")',
                    type: "GET",
                    data: { cmprecid: cmprecid, precid: precid },
                    success: function (res) {
                        $("#AdminDropdown").empty();
                        if (res.status === "Y" && res.data && res.data.length > 0) {
                            $("#AdminDropdown")
                                .append('<option value="">-- Select Admin --</option>')
                                .prop("disabled", false);
                            $.each(res.data, function (i, admin) {
                                $("#AdminDropdown").append(
                                    '<option value="' + admin.u_RECID + '">' + admin.u_USERNAME + '</option>'
                                );
                            });
                        } else {
                            $("#AdminDropdown")
                                .append('<option value="">No Admins mapped to this product</option>')
                                .prop("disabled", true);
                        }
                    },
                    error: function () {
                        $("#AdminDropdown")
                            .empty()
                            .append('<option value="">Error loading admins</option>')
                            .prop("disabled", true);
                    }
                });
            }

            loadAdmins();

            $("#SelectedProduct").on("change", function () {
                loadAdmins();
            });

            $("#AdminDropdown").on("change", function () {
                $("#CU_ADMINRECID").val($(this).val());
            });

            /* ── Party auto-fill ── */
            $("#SelectedParty").on("change", function () {
                var selected = $(this).find(":selected");
                $("#CT_EMAIL").val(selected.data("email"));
                $("#CT_MOBILE").val(selected.data("mobile"));
                $("#CT_ADDRESS").val(selected.data("address"));
            });
        });
    </script>
}
