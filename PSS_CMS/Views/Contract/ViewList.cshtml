@model IEnumerable<PSS_CMS.Models.Viewlist>

@{
    ViewData["Title"] = "View List";
    ViewBag.PageTitle = "View List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var type = Request["type"];

    var productName = Session["P_NAME"] != null
        ? Session["P_NAME"].ToString()
        : "";

    var titleText = type == "IN"
        ? "Inclusions"
        : "Exclusions";

    string searchPhrase = Request["searchPhrase"] ?? "";

    var filtered = Model?.Where(m =>
        string.IsNullOrEmpty(searchPhrase) ||
        (type == "IN"
            ? (m.IN_DESCRIPTION != null && m.IN_DESCRIPTION.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
            : (m.EX_DESCRIPTION != null && m.EX_DESCRIPTION.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0))
    ).ToList() ?? new List<PSS_CMS.Models.Viewlist>();
}

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-shield-check"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("CustomerList", "Contract")">
        Warranty Products
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>
        @productName
    </span>

    <i class="bi bi-chevron-right"></i>

    <span>
        @titleText
    </span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->

            <form action="" method="get" id="searchForm">

                <!-- Preserve type so it isn't lost when the search form submits -->
                <input type="hidden" name="type" value="@type" />

                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPhrase"
                           name="searchPhrase"
                           placeholder="Search"
                           autocomplete="off"
                           value="@searchPhrase"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(searchPhrase))
                    {
                        <a href="javascript:void(0);" title="Clear" onclick="clearSearch()">
                            <i class="bi bi-x-circle text-muted"></i>
                        </a>
                    }

                </div>
            </form>

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (filtered != null && filtered.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:80px;">

                            S.No

                        </th>

                        <th>

                            @(type == "IN"
                                ? "Inclusions"
                                : "Exclusions")

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in filtered)
                    {
                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>

                                @if (type == "IN")
                                {
                                    <div class="d-flex align-items-center gap-2">

                                        <span class="mini-badge text-success">
                                            <i class="bi bi-check-circle-fill"></i>
                                        </span>

                                        <span>
                                            @o.IN_DESCRIPTION
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">

                                        <span class="mini-badge text-danger">
                                            <i class="bi bi-x-circle-fill"></i>
                                        </span>

                                        <span>
                                            @o.EX_DESCRIPTION
                                        </span>

                                    </div>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                @if (type == "IN")
                {
                    <i class="bi bi-plus-circle"
                       style="font-size:40px;color:var(--text-muted)">
                    </i>

                    <p class="mt-2 text-muted fw-semibold">
                        @(!string.IsNullOrEmpty(searchPhrase) ? "No matching inclusions found." : "No Inclusions Available")
                    </p>
                }
                else
                {
                    <i class="bi bi-dash-circle"
                       style="font-size:40px;color:var(--text-muted)">
                    </i>

                    <p class="mt-2 text-muted fw-semibold">
                        @(!string.IsNullOrEmpty(searchPhrase) ? "No matching exclusions found." : "No Exclusions Available")
                    </p>
                }

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    @if (type == "IN")
    {
        <div class="legend-item">
            <span class="mini-badge text-success">
                <i class="bi bi-check-circle-fill"></i>
            </span>
            Inclusion
        </div>
    }
    else
    {
        <div class="legend-item">
            <span class="mini-badge text-danger">
                <i class="bi bi-x-circle-fill"></i>
            </span>
            Exclusion
        </div>
    }

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <script>
        function clearSearch() {
            document.getElementById('searchPhrase').value = '';
            document.getElementById('searchForm').submit();
        }
    </script>

}