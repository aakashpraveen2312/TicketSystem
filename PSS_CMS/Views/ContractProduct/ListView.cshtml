@model IEnumerable<PSS_CMS.Models.ContractServiceProduct>

@{
    ViewData["Title"] = "Contract Products";
    ViewBag.PageTitle = "Contract Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <link href="~/Content/UIListView.css"
          rel="stylesheet" />

}

<!-- Breadcrumb -->

<div class="page-breadcrumb">
    <i class="bi bi-file-earmark-text"></i>

    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ContractProductListView", "Contract")">

        CONTRACT (@Session["CP_CODE"].ToString().ToUpper())

    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Products</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <h6 class="page-card-title">

            <i class="bi bi-box-seam"
               style="color:var(--primary)">
            </i>

            Contract Product List

        </h6>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th>
                            Product Serial Number
                        </th>

                        <th>
                            Product Name
                        </th>

                        <th class="text-end">
                            Product Amount
                        </th>

                        <th>
                            Admin Name
                        </th>

                        <th class="text-center">
                            Free Services
                        </th>

                        <th class="text-end">
                            Invoice Amount
                        </th>

                        <th class="text-end">
                            Paid Amount
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        <tr>

                            <td>

                                <span class="product-serial">

                                    @o.CSP_PRODUCTUNIQUENUMBER

                                </span>

                            </td>

                            <td>
                                @o.CSP_PRODUCTNAME
                            </td>

                            <td class="text-end">

                                <span class="amount-cell">

                                    ₹ @String.Format("{0:N2}", o.CSP_PRODUCTAMOUNT)

                                </span>

                            </td>

                            <td>
                                @o.CSP_ADMINNAME
                            </td>

                            <td class="text-center">

                                <span class="service-badge">

                                    @o.CSP_FREESERVICE

                                </span>

                            </td>

                            <td class="text-end">

                                <span class="amount-cell">

                                    ₹ @String.Format("{0:N2}", o.CSP_INVOICEAMOUNT)

                                </span>

                            </td>

                            <td class="text-end">

                                <span class="amount-cell">

                                    ₹ @String.Format("{0:N2}", o.CSP_PAIDAMOUNT)

                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">

                    No Contract Products Available

                </p>

            </div>
        }

    </div>

</div>



@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}