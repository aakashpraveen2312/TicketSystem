@model PSS_CMS.Models.HSNMaster

@{ ViewData["Title"] = "Create HSN Master";
                ViewBag.PageTitle = "Create HSN Master";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-tag nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    @if (Session["HSNC_CATEGORYNAME"] != null)
    {
<a href="@Url.Action("List","HSNCategory")">HSN Category (@Session["HSNC_CATEGORYNAME"].ToString())</a>
                <i class="bi bi-chevron-right"></i>}
    <a href="@Url.Action("List","HSNMaster")">HSN Master</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List","HSNMaster")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Create", "HSNMaster", FormMethod.Post,
    new { id = "createform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-receipt"></i>
            </span>
            Create HSN Master
        </h6>
    </div>

    <!-- Form body -->
    <div class="form-body">

        <p class="form-section-title">HSN Information</p>

        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label" for="HM_CODE">
                    @Html.DisplayNameFor(m => m.HM_CODE)
                    <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.HM_CODE, new
                {
                    @class = "form-input-text",
                    tabindex = "1",
                    autocomplete = "off",
                    placeholder = "Enter HSN code"
                })
                @Html.ValidationMessageFor(m => m.HM_CODE, "", new { @class = "text-danger", style = "font-size:11px" })
            </div>

            <!-- Description -->
            <div class="form-group">
                <label class="form-label" for="HM_DESCRIPTION">
                    @Html.DisplayNameFor(m => m.HM_DESCRIPTION)
                    <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.HM_DESCRIPTION, new
                {
                    @class = "form-input-text",
                    tabindex = "2",
                    autocomplete = "off",
                    placeholder = "Enter description"
                })
                @Html.ValidationMessageFor(m => m.HM_DESCRIPTION, "", new { @class = "text-danger", style = "font-size:11px" })
            </div>

        </div>

        <div class="form-divider"></div>
       
        <div class="form-grid">

            <!-- CGST -->
            <div class="form-group">
                <label class="form-label" for="HM_CGST">
                    @Html.DisplayNameFor(m => m.HM_CGST)
                </label>
                @Html.TextBoxFor(m => m.HM_CGST, new
                {
                    @class = "form-input-num",
                    id = "HM_CGST",
                    tabindex = "3",
                    type = "number",
                    placeholder = "0.00",
                    oninput = "calculateGST()",
                    min = "0",
                    autocomplete = "off"
                })
            </div>

            <!-- SGST -->
            <div class="form-group">
                <label class="form-label" for="HM_SGST">
                    @Html.DisplayNameFor(m => m.HM_SGST)
                </label>
                @Html.TextBoxFor(m => m.HM_SGST, new
           {
               @class = "form-input-num",
               id = "HM_SGST",
               tabindex = "4",
               type = "number",
               placeholder = "0.00",
               oninput = "calculateGST()",
               min = "0",
               autocomplete = "off"
           })
            </div>

            <!-- IGST -->
            <div class="form-group">
                <label class="form-label" for="HM_IGST">
                    @Html.DisplayNameFor(m => m.HM_IGST)
                </label>
                @Html.TextBoxFor(m => m.HM_IGST, new
           {
               @class = "form-input-num",
               id = "HM_IGST",
               tabindex = "5",
               type = "number",
               placeholder = "0.00",
               min = "0",
               autocomplete = "off"
           })
            </div>
            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label" for="HM_SORTORDER">
                    @Html.DisplayNameFor(m => m.HM_SORTORDER)
                </label>
                @Html.TextBoxFor(m => m.HM_SORTORDER, new
           {
               @class = "form-input-num",
               id = "HM_SORTORDER",
               tabindex = "6",
               type = "number",
               placeholder = "0",
               min = "0",
               autocomplete = "off"
           })
            </div>

        </div>

        <div class="form-divider"></div>
        <p class="form-section-title">SETTINGS</p>

        <div class="form-grid">
            <!-- Disable checkbox -->
                <label class="check-row" for="IsDisabled">
                    @Html.CheckBoxFor(m => m.IsDisabled,
                             new { @class = "form-check-input", id = "IsDisabled", tabindex = "7" })
                    <div class="check-row-label">
                        <span>@Html.DisplayNameFor(m => m.IsDisabled)</span>
                        <small>Hide this entry from active listings</small>
                    </div>
                </label>
        </div>

    </div>

    <!-- Legend bar — matches list view style -->
    <div class="legend-bar">

        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text Field</span>
        </div>

        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>

    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("List","HSNMaster")"
           class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit"
                class="btn-save"
                id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── GST total calculator ─────────────────── */
        function calculateGST() {
            var cgst = parseFloat(document.getElementById("HM_CGST").value) || 0;
            var sgst = parseFloat(document.getElementById("HM_SGST").value) || 0;
            document.getElementById("gstTotal").textContent = (cgst + sgst).toFixed(2) + " %";
        }

        $(document).ready(function () {

            /* ── AJAX submit — processing spinner shows FIRST ── */
            $("#createform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                // ① Show Processing spinner first, fire AJAX inside didOpen
                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Create","HSNMaster")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton:  "swal-btn-back"
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) {
                                                location.reload();
                                            } else {
                                                window.location.href = '@Url.Action("List","HSNMaster")';
                                            }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
            }
        });
    </script>
}
