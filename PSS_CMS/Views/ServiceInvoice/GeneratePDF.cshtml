@model PSS_CMS.Models.ServiceInvoiceData
@{ ViewData["Title"] = "Invoice Draft";
    ViewBag.PageTitle = "Invoice Draft";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Custom Tabs ───────────────────────────── */
        .inv-tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid var(--border-color);
            padding: 0 20px;
            background: #fafafa;
        }

        .inv-tab-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 13px 18px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            transition: color .18s, border-color .18s;
            white-space: nowrap;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: inherit;
        }

            .inv-tab-link i {
                font-size: 15px;
            }

            .inv-tab-link.active {
                color: var(--primary);
                border-bottom-color: var(--primary);
            }

            .inv-tab-link:hover:not(.active) {
                color: var(--text-dark);
            }

        /* ── Tab Panes ─────────────────────────────── */
        .tab-body {
            padding: 24px 20px 8px;
        }

        .inv-pane {
            display: none;
        }

            .inv-pane.show {
                display: block;
            }

        /* ── Form Section Title ────────────────────── */
        .form-section-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .6px;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border-color);
        }

        /* ── Form Grids ────────────────────────────── */
        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-grid-3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 18px;
        }

        @@media (max-width: 640px) {
            .form-grid, .form-grid-3 {
                grid-template-columns: 1fr;
            }
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

        /* ── Labels ────────────────────────────────── */
        .form-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* ── Auto / Readonly Input ─────────────────── */
        .form-input-auto {
            border: 1px solid var(--border-color);
            border-left: 3px solid #adb5bd;
            border-radius: 10px;
            padding: 8px 12px;
            font-size: 13px;
            color: var(--text-muted);
            background: var(--body-bg);
            outline: none;
            font-family: inherit;
            width: 100%;
            cursor: not-allowed;
        }

        /* ── Textarea (readonly) ───────────────────── */
        .form-textarea {
            border: 1px solid var(--border-color);
            border-left: 3px solid #adb5bd;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 13px;
            color: var(--text-muted);
            background: var(--body-bg);
            outline: none;
            font-family: inherit;
            width: 100%;
            resize: vertical;
            min-height: 110px;
            line-height: 1.6;
            cursor: not-allowed;
        }

        /* ── Divider ───────────────────────────────── */
        .form-divider {
            margin: 20px 0;
            border-color: var(--border-color);
        }

        /* ── Sub Heading ───────────────────────────── */
        .sub-heading {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

            .sub-heading i {
                font-size: 15px;
                color: var(--primary);
            }

        .nb-heading i {
            color: #e74c3c;
        }

        /* ── Grid Wrap / Tables ────────────────────── */
        .grid-wrap {
            overflow-x: auto;
            margin-bottom: 24px;
        }

            .grid-wrap table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .grid-wrap table th {
                    background: #fafafa;
                    font-size: 11.5px;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                    color: var(--text-muted);
                    font-weight: 600;
                    padding: 11px 14px;
                    border-bottom: 1px solid var(--border-color);
                    white-space: nowrap;
                }

                .grid-wrap table td {
                    padding: 11px 14px;
                    color: var(--text-dark);
                    border-bottom: 1px solid #f3f3f3;
                    vertical-align: middle;
                }

                .grid-wrap table tbody tr:last-child td {
                    border-bottom: 1px solid #f3f3f3 !important;
                }

                .grid-wrap table tr:hover td {
                    background: #fafbff;
                }

        .td-right {
            text-align: right;
        }

        /* ── Amount Cells ──────────────────────────── */
        .amount-cell {
            font-weight: 600;
            color: var(--text-dark);
            text-align: right;
        }

        .net-amount-cell {
            font-weight: 700;
            color: #1D9E75;
            text-align: right;
        }

        /* ── Pane footer actions ───────────────────── */
        .pane-actions {
            display: flex;
            justify-content: flex-end;
            padding: 16px 0 4px;
            border-top: 1px solid var(--border-color);
            margin-top: 16px;
        }

        .pane-actions-full {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 0 4px;
            border-top: 1px solid var(--border-color);
            margin-top: 16px;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* ── Inline amount summary ─────────────────── */
        .inline-amounts {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .inline-amount-item {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .inline-amount-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .inline-amount-value {
            font-size: 16px;
            font-weight: 700;
        }

        .inline-divider {
            width: 1px;
            height: 36px;
            background: var(--border-color);
            flex-shrink: 0;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-house-door-fill"></i>
    <span>Service Invoice</span>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Index","ServiceInvoice")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Invoice Draft</span>
</div>

<!-- Page Card -->
<div class="page-card">

    <!-- Card Header -->
    <div class="page-card-header">
        <span style="font-size:12px;color:var(--text-muted);">
            Preview &amp; generate the service invoice below
        </span>
    </div>

    @using (Html.BeginForm("GenerateInvoice", "ServiceInvoice", FormMethod.Post,
        new { @class = "no-preloader" }))
    {<!-- Custom Tabs -->
                <div class="inv-tabs">
                    <button type="button" class="inv-tab-link active" data-target="pane-info">
                        <i class="bi bi-info-circle"></i> Invoice Info
                    </button>
                    <button type="button" class="inv-tab-link" data-target="pane-materials">
                        <i class="bi bi-box-seam"></i> Materials &amp; Services
                    </button>
                </div> <!-- Tab Body -->
                                                <div class="tab-body">

                                                    <!-- ── Pane: Invoice Info ─────────────────── -->
                                                    <div class="inv-pane show" id="pane-info">

                                                        <p class="form-section-title">Basic Invoice Information</p>
                                                        <div class="form-grid-3" style="margin-bottom:18px;">
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().InvoiceNumber, new { @class = "form-label" })
                                                                @Html.TextBoxFor(m => m.BillableMaterials.FirstOrDefault().InvoiceNumber,
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().InvoiceDate, new { @class = "form-label" })
                                                                @Html.TextBox("InvoiceDate",
                                                                         string.IsNullOrEmpty(Model.BillableMaterials.FirstOrDefault()?.InvoiceDate)
                                                                             ? ""
                                                                             : DateTime.Parse(Model.BillableMaterials.FirstOrDefault().InvoiceDate).ToString("dd/MM/yyyy"),
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().TicketRaisedDate, new { @class = "form-label" })
                                                                @Html.TextBox("TicketRaisedDate",
                                                                         string.IsNullOrEmpty(Model.BillableMaterials.FirstOrDefault()?.TicketRaisedDate)
                                                                             ? ""
                                                                             : DateTime.Parse(Model.BillableMaterials.FirstOrDefault().TicketRaisedDate).ToString("dd/MM/yyyy"),
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                        </div>

                                                        <hr class="form-divider" />

                                                        <p class="form-section-title">Customer Details</p>
                                                        <div class="form-grid" style="margin-bottom:18px;">
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().CustomerName, new { @class = "form-label" })
                                                                @Html.TextBoxFor(m => m.BillableMaterials.FirstOrDefault().CustomerName,
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().CustomerAddress, new { @class = "form-label" })
                                                                @Html.TextBoxFor(m => m.BillableMaterials.FirstOrDefault().CustomerAddress,
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                        </div>

                                                        <hr class="form-divider" />

                                                        <p class="form-section-title">Product &amp; Warranty</p>
                                                        <div class="form-grid" style="margin-bottom:18px;">
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().ProductName, new { @class = "form-label" })
                                                                @Html.TextBoxFor(m => m.BillableMaterials.FirstOrDefault().ProductName,
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().WarrantyUpto, new { @class = "form-label" })
                                                                @Html.TextBox("WarrantyUpto",
                                                                         string.IsNullOrEmpty(Model.BillableMaterials.FirstOrDefault()?.WarrantyUpto)
                                                                             ? ""
                                                                             : DateTime.Parse(Model.BillableMaterials.FirstOrDefault().WarrantyUpto).ToString("dd/MM/yyyy"),
                                                                         new { @class = "form-input-auto", @readonly = "readonly" })
                                                            </div>
                                                        </div>

                                                        <hr class="form-divider" />

                                                        <p class="form-section-title">Comments / Remarks</p>
                                                        <div class="form-grid" style="margin-bottom:8px;">
                                                            <div class="form-group">
                                                                @Html.LabelFor(m => m.BillableMaterials.FirstOrDefault().Comments, new { @class = "form-label" })
                                                                @Html.TextAreaFor(m => m.BillableMaterials.FirstOrDefault().Comments,
                                                                         new { @class = "form-textarea", @readonly = "readonly" })
                                                            </div>
                                                            <div></div>
                                                        </div>

                                                        <!-- Next button -->
                                                        <div class="pane-actions">
                                                            <button type="button" class="btn-save" id="btn-next-info">
                                                                <i class="bi-arrow-right-circle"></i> Next
                                                            </button>
                                                        </div>

                                                    </div>

                                                    <!-- ── Pane: Materials & Services ─────────── -->
                                                    <div class="inv-pane" id="pane-materials">

                                                        <div class="sub-heading">
                                                            <i class="bi bi-check-circle-fill"></i>
                                                            Billable Materials &amp; Services
                                                        </div>
                                                        <div class="grid-wrap">
                                                            <table>
                                                                <thead>
                                                                    <tr>
                                                                        <th>Material Name</th>
                                                                        <th class="td-right">Qty</th>
                                                                        <th class="td-right">Price</th>
                                                                        <th class="td-right">Discount (%)</th>
                                                                        <th class="td-right">Amount</th>
                                                                        <th class="td-right">CGST (%)</th>
                                                                        <th class="td-right">SGST (%)</th>
                                                                        <th class="td-right">Net Amount</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Model.BillableMaterials)
                                                                    {
                                                    <tr>
                                                        <td>@item.MaterialName</td>
                                                        <td class="td-right">@item.Quantity</td>
                                                        <td class="amount-cell">@String.Format("{0:N2}", item.Price)</td>
                                                        <td class="td-right">@String.Format("{0:N2}", item.Discount)</td>
                                                        <td class="amount-cell">@String.Format("{0:N2}", item.Amount)</td>
                                                        <td class="td-right">@String.Format("{0:N2}", item.CGST)</td>
                                                        <td class="td-right">@String.Format("{0:N2}", item.SGST)</td>
                                                        <td class="net-amount-cell">@String.Format("{0:N2}", item.NetAmount)</td>
                                                    </tr>}
                                                                </tbody>
                                                            </table>
                                                        </div>

                                                        <hr class="form-divider" />

                                                        <div class="sub-heading nb-heading">
                                                            <i class="bi bi-x-circle-fill"></i>
                                                            Non-Billable Materials &amp; Services
                                                        </div>
                                                        <div class="grid-wrap">
                                                            <table>
                                                                <thead>
                                                                    <tr>
                                                                        <th>Material Name</th>
                                                                        <th class="td-right">Qty</th>
                                                                        <th class="td-right">Price</th>
                                                                        <th class="td-right">Net Amount</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var item in Model.NonBillableMaterials)
                                                                    {
                                                    <tr>
                                                        <td>@item.MaterialName</td>
                                                        <td class="td-right">@item.Quantity</td>
                                                        <td class="amount-cell">@String.Format("{0:N2}", item.Price)</td>
                                                        <td class="net-amount-cell">@String.Format("{0:N2}", item.NetAmount)</td>
                                                    </tr>}
                                                                </tbody>
                                                            </table>
                                                        </div>

                                                        <!-- Actions: amounts left, buttons right -->
                                                        <div class="pane-actions-full">

                                                            <!-- Left: Amount Summary -->
                                                            <div class="inline-amounts">
                                                                <div class="inline-amount-item">
                                                                    <span class="inline-amount-label" style="color:#BA7517;">
                                                                        <i class="bi bi-receipt" style="margin-right:3px;"></i> Total (Before Tax)
                                                                    </span>
                                                                    <span class="inline-amount-value" style="color:#633806;">
                                                                        &#8377; @String.Format("{0:N2}", Model.BillableMaterials.Sum(x => x.Amount))
                                                                    </span>
                                                                </div>
                                                                <div class="inline-divider"></div>
                                                                <div class="inline-amount-item">
                                                                    <span class="inline-amount-label" style="color:#1D9E75;">
                                                                        <i class="bi bi-check2-all" style="margin-right:3px;"></i> Net Amount (After Tax)
                                                                    </span>
                                                                    <span class="inline-amount-value" style="color:#085041;">
                                                                        &#8377; @String.Format("{0:N2}", Model.BillableMaterials.Sum(x => x.NetAmount))
                                                                    </span>
                                                                </div>
                                                            </div>

                                                            <!-- Right: Buttons -->
                                                            <div style="display:flex; gap:8px;">
                                                                <button type="button" class="btn-cancel"
                                                                        onclick="window.location.href='@Url.Action("RecentTicket","RecentTickets")'">
                                                                    <i class="bi bi-x-lg"></i> Cancel
                                                                </button>
                                                                <button type="submit" class="btn-save">
                                                                    <i class="bi bi-file-earmark-pdf-fill"></i> Generate
                                                                </button>
                                                            </div>

                                                        </div>

                                                    </div>

                                                </div><!-- /tab-body -->}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
        <span>Read-only</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#BA7517;flex-shrink:0;"></span>
        <span>Calculated Field</span>
    </div>
</div>

@section Scripts {
    <script>
        // ── Tab Switching ──────────────────────────────
        function switchTab(targetId) {
            document.querySelectorAll('.inv-tab-link').forEach(function (b) {
                b.classList.remove('active');
            });
            document.querySelectorAll('.inv-pane').forEach(function (p) {
                p.classList.remove('show');
            });
            document.querySelector('[data-target="' + targetId + '"]').classList.add('active');
            document.getElementById(targetId).classList.add('show');
        }

        document.querySelectorAll('.inv-tab-link').forEach(function (btn) {
            btn.addEventListener('click', function () {
                switchTab(btn.dataset.target);
            });
        });

        // ── Next Button on Invoice Info ────────────────
        document.getElementById('btn-next-info').addEventListener('click', function () {
            switchTab('pane-materials');
        });
    </script>
}
