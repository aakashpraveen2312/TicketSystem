@model IEnumerable<PSS_CMS.Models.HSNMaster>

@{
    ViewData["Title"] = "HSN Master";
    ViewBag.PageTitle = "HSN Master";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <!-- List View CSS -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-grid-3x3"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "HSNCategory")"
       class="text-decoration-none">

        HSN Category (@Session["HSNC_CATEGORYNAME"])

    </a>

    <i class="bi bi-chevron-right"></i>

    <span>HSN Master</span>

    <i class="bi bi-chevron-right"></i>

    <span>List</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->

            @using (Html.BeginForm(
                "List",
                "HSNMaster",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("List","HSNMaster")"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

            <!-- Add -->

            <a href="@Url.Action("Create", "HSNMaster")"
               class="btn-add">

                <i class="bi bi-plus-lg"></i>

                Add HSN

            </a>

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:70px;">
                            S.No
                        </th>

                        <th style="width:180px;">
                            Code
                        </th>

                        <th>
                            Description
                        </th>

                        <th class="text-center"
                            style="width:120px;">
                            CGST (%)
                        </th>

                        <th class="text-center"
                            style="width:120px;">
                            SGST (%)
                        </th>

                        <th class="text-center"
                            style="width:90px;">
                            Sort
                        </th>

                        <th class="text-center"
                            style="width:150px;">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var editUrl = Url.Action(
                            "Edit",
                            "HSNMaster",
                            new
                            {
                                RECID = o.HM_RECID,
                                HM_CODE = o.HM_CODE,
                                HM_Name = o.HM_DESCRIPTION
                            });

                        var deleteUrl = Url.Action(
                            "Delete",
                            "HSNMaster",
                            new
                            {
                                RECID = o.HM_RECID
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>
                                @o.HM_CODE
                            </td>

                            <td>
                                @o.HM_DESCRIPTION
                            </td>

                            <td class="text-center">
                                @o.HM_CGST
                            </td>

                            <td class="text-center">
                                @o.HM_SGST
                            </td>

                            <td class="text-center">
                                @o.HM_SORTORDER
                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- Edit -->

                                    <a href="@editUrl"
                                       title="Edit"
                                       class="act-btn act-edit">

                                        <i class='bx bxs-pencil'></i>

                                    </a>

                                    <!-- Delete -->

                                    <a href="@deleteUrl"
                                       title="Delete"
                                       class="act-btn act-delete no-loader"
                                       onclick="return confirmDelete(this);">

                                        <i class='bx bxs-trash'></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-inbox"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">
                    No HSN Master available
                </p>

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <i class='bx bxs-pencil'
           style='color:#6c5ce7;font-size:16px'></i>

        <span>Edit</span>

    </div>

    <div class="legend-item">

        <i class='bx bxs-trash'
           style='color:#e74c3c;font-size:16px'></i>

        <span>Delete</span>

    </div>

</div>

@section Scripts {

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}