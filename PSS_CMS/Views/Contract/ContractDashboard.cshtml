@model PSS_CMS.Models.Contract
@using GridMvc.Html

@{ ViewBag.PageTitle = "Dashboard";
    ViewBag.PageSubtitle = "Overview of your ticket system"; }

@section Styles {
    <link href="@Url.Content("~/Content/Gridmvc.css")" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/gridmvc.min.js")"></script>
    <script src="https://cdn.jsdelivr.net/npm/justgage@1.3.0/justgage.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/raphael@2.1.4/raphael-min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/Script.js"></script>

    <style>
        /* ══════════════════════════════════════
           VARIABLES
        ══════════════════════════════════════ */
        :root {
            --blue: #0984e3;
            --blue-light: #dfe6f7;
            --green: #00b894;
            --green-light: #d8f5ed;
            --amber: #f39c12;
            --amber-light: #fff3dc;
            --red: #e17055;
            --red-light: #fde8e4;
            --purple: #6c5ce7;
            --purple-light: #eeeaff;
            --slate: #636e72;
            --slate-light: #f1f3f5;
            --bg: #f4f5f9;
            --surface: #ffffff;
            --border: #e8eaed;
            --text: #1a1d23;
            --text-sub: #6b7280;
            --text-muted: #9ca3af;
            --shadow: 0 1px 4px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
            --shadow-hover: 0 6px 24px rgba(0,0,0,.11);
            --r: 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background: var(--bg) !important;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        /* ══════════════════════════════════════
           CONTENT AREA WRAPPER
        ══════════════════════════════════════ */
        .acc-wrap {
            padding: 20px 24px 32px;
        }

        /* ══════════════════════════════════════
           PAGE HEADER
        ══════════════════════════════════════ */
        .acc-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 20px;
        }

            .acc-header h2 {
                font-size: 20px;
                font-weight: 800;
                color: var(--text);
                margin: 0;
            }

            .acc-header p {
                font-size: 12px;
                color: var(--text-muted);
                margin: 2px 0 0;
            }

        .acc-date-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 12px;
            font-size: 12px;
            font-weight: 500;
            color: var(--text);
            box-shadow: var(--shadow);
        }

        /* ══════════════════════════════════════
           SECTION LABEL
        ══════════════════════════════════════ */
        .acc-sec {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.1px;
            color: var(--text-muted);
            margin: 20px 0 10px;
        }

        /* ══════════════════════════════════════
           STAT CARDS — top row
        ══════════════════════════════════════ */
        .stat-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
        }

        @@media (max-width: 900px) {
            .stat-row {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 580px) {
            .stat-row {
                grid-template-columns: 1fr;
            }
        }

        .stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 18px 20px 0 20px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            transition: box-shadow .2s, transform .2s;
            min-height: 110px;
        }

            .stat-card:hover {
                box-shadow: var(--shadow-hover);
                transform: translateY(-2px);
            }

            /* coloured top stripe */
            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                border-radius: var(--r) var(--r) 0 0;
            }

        .sc-blue::before {
            background: var(--blue);
        }

        .sc-green::before {
            background: var(--green);
        }

        .sc-amber::before {
            background: var(--amber);
        }

        .sc-red::before {
            background: var(--red);
        }

        .sc-purple::before {
            background: var(--purple);
        }

        .sc-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 6px;
        }

        .sc-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-sub);
        }

        .sc-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            flex-shrink: 0;
        }

        .si-blue {
            background: var(--blue-light);
            color: var(--blue);
        }

        .si-green {
            background: var(--green-light);
            color: var(--green);
        }

        .si-amber {
            background: var(--amber-light);
            color: var(--amber);
        }

        .si-red {
            background: var(--red-light);
            color: var(--red);
        }

        .si-purple {
            background: var(--purple-light);
            color: var(--purple);
        }

        .si-slate {
            background: var(--slate-light);
            color: var(--slate);
        }

        .sc-value {
            font-size: 28px;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
            letter-spacing: -1px;
        }

        .sc-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 3px;
            margin-bottom: 8px;
        }

        .sc-currency {
            font-size: 15px;
            font-weight: 700;
            vertical-align: super;
            margin-right: 2px;
        }

        /* sparkline */
        .sc-spark {
            display: block;
            width: 100%;
            height: 44px;
        }

        /* ══════════════════════════════════════
           CONTRACT COUNT PILLS (2-col)
        ══════════════════════════════════════ */
        .pill-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        @@media (max-width: 580px) {
            .pill-row {
                grid-template-columns: 1fr;
            }
        }

        .mini-pill {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 15px 18px 0 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            transition: box-shadow .2s, transform .2s;
            min-height: 80px;
        }

            .mini-pill:hover {
                box-shadow: var(--shadow-hover);
                transform: translateY(-2px);
            }

        .pill-green {
            background: #f0fdf8;
            border-color: #c3edd8;
        }

        .pill-red {
            background: #fff5f3;
            border-color: #fad4cb;
        }

        .pill-spark {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 48px;
        }

        .mp-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .mp-text {
            position: relative;
            z-index: 1;
            margin-bottom: 12px;
        }

        .mp-lbl {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-sub);
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .mp-val {
            font-size: 26px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.1;
        }

        /* ══════════════════════════════════════
           CHART + GAUGE ROW
        ══════════════════════════════════════ */
        .chart-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        @@media (max-width: 860px) {
            .chart-row {
                grid-template-columns: 1fr;
            }
        }

        .chart-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .cc-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 14px 16px 12px;
            border-bottom: 1px solid var(--border);
        }

        .cc-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .cc-sub {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }

        .cc-body {
            padding: 16px;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* ══════════════════════════════════════
           SUMMARY TABLE CARD
        ══════════════════════════════════════ */
        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

            .summary-card table {
                margin: 0;
            }

            .summary-card thead th {
                background: #f8f9fc;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .7px;
                color: var(--text-muted);
                border-bottom: 1px solid var(--border);
                padding: 10px 16px;
            }

            .summary-card tbody td {
                font-size: 13px;
                padding: 11px 16px;
                border-bottom: 1px solid #f4f5f7;
                color: var(--text);
            }

            .summary-card tbody tr:last-child td {
                border-bottom: none;
            }

            .summary-card tbody tr:hover td {
                background: #f8f9fc;
            }

        .badge-green {
            background: var(--green-light);
            color: var(--green);
            font-size: 11px;
            padding: 3px 9px;
            border-radius: 20px;
            font-weight: 700;
        }

        .badge-amber {
            background: var(--amber-light);
            color: var(--amber);
            font-size: 11px;
            padding: 3px 9px;
            border-radius: 20px;
            font-weight: 700;
        }

        .badge-red {
            background: var(--red-light);
            color: var(--red);
            font-size: 11px;
            padding: 3px 9px;
            border-radius: 20px;
            font-weight: 700;
        }

        /* ══════════════════════════════════════
           ANIMATED COUNTER
        ══════════════════════════════════════ */
        .anim-num {
            display: inline-block;
        }

        /* Remove default card styles */
        .card {
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            background: transparent !important;
        }
    </style>

}


<div class="db-wrap">

    <!-- ════════════════════════════════════
            DASHBOARD CONTENT
       ════════════════════════════════════ -->
   

    <!-- ══ FINANCIAL STAT CARDS ══ -->
    <div class="acc-sec">Financial Summary</div>
    <div class="stat-row">

        <!-- Total Contract Amount -->
        <div class="stat-card sc-blue">
            <div class="sc-top">
                <span class="sc-label">Total Contract Amount</span>
                <div class="sc-icon si-blue"><i class="bi bi-file-earmark-text-fill"></i></div>
            </div>
            <div class="sc-value">
                <span class="sc-currency">₹</span><span class="anim-num" data-target="@ViewBag.TotalContractAmount1">0</span>
            </div>
            <div class="sc-sub">All active contracts</div>
           
        </div>

        <!-- Total Paid Amount -->
        <div class="stat-card sc-green">
            <div class="sc-top">
                <span class="sc-label">Total Paid Amount</span>
                <div class="sc-icon si-green"><i class="bi bi-check-circle-fill"></i></div>
            </div>
            <div class="sc-value">
                <span class="sc-currency">₹</span><span class="anim-num" data-target="@ViewBag.TotalPaidAmount1">0</span>
            </div>
            <div class="sc-sub">Collected to date</div>
           
        </div>

        <!-- Pending Amount -->
        <div class="stat-card sc-amber">
            <div class="sc-top">
                <span class="sc-label">Pending Amount</span>
                <div class="sc-icon si-amber"><i class="bi bi-hourglass-split"></i></div>
            </div>
            <div class="sc-value">
                <span class="sc-currency">₹</span><span class="anim-num" data-target="@ViewBag.PendingAmount1">0</span>
            </div>
            <div class="sc-sub">Outstanding balance</div>
           
        </div>

    </div><!-- /stat-row -->
    <!-- ══ CONTRACT STATUS PILLS ══ -->
    <div class="acc-sec">Contract Status</div>
    <div class="pill-row">

        <!-- Expired -->
        <div class="mini-pill pill-red">
            <div class="mp-icon si-red"><i class="bi bi-x-circle-fill" style="color:var(--red)"></i></div>
            <div class="mp-text">
                <div class="mp-lbl">Expired Contracts</div>
                <div class="mp-val anim-num" data-target="@ViewBag.ExpiredContracts">0</div>
            </div>
            
        </div>

        <!-- Yet to Expire -->
        <div class="mini-pill pill-green">
            <div class="mp-icon si-green"><i class="bi bi-clock-history" style="color:var(--green)"></i></div>
            <div class="mp-text">
                <div class="mp-lbl">Yet to Expire</div>
                <div class="mp-val anim-num" data-target="@ViewBag.YetToExpireContracts">0</div>
            </div>
           
        </div>

    </div><!-- /pill-row -->
    <!-- ══ CHART + SUMMARY ROW ══ -->
    <div class="acc-sec">Payment Analytics</div>
    <div class="chart-row">

        <!-- Doughnut Chart -->
        <div class="chart-card">
            <div class="cc-head">
                <div>
                    <div class="cc-title">Payment Progress</div>
                    <div class="cc-sub">Paid vs Pending breakdown</div>
                </div>
            </div>
            <div class="cc-body">
                <canvas id="paymentPieChart" style="max-width:300px; max-height:300px;"></canvas>
            </div>
        </div>

        <!-- Summary breakdown table -->
        <div class="chart-card">
            <div class="cc-head">
                <div>
                    <div class="cc-title">Financial Breakdown</div>
                    <div class="cc-sub">Contract amounts at a glance</div>
                </div>
            </div>
            <div style="padding:0;">
                <div class="summary-card" style="border:none; border-radius:0; box-shadow:none;">
                    <table class="table mb-0">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>Amount / Count</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><i class="bi bi-file-earmark-text me-2" style="color:var(--blue)"></i>Total Contract</td>
                                <td><strong>₹ @ViewBag.TotalContractAmount1.00</strong></td>
                                <td><span class="badge-green">Active</span></td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-check-circle me-2" style="color:var(--green)"></i>Total Paid</td>
                                <td><strong>₹ @ViewBag.TotalPaidAmount1.00</strong></td>
                                <td><span class="badge-green">Collected</span></td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-hourglass me-2" style="color:var(--amber)"></i>Pending</td>
                                <td><strong>₹ @ViewBag.PendingAmount1.00</strong></td>
                                <td><span class="badge-amber">Pending</span></td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-x-circle me-2" style="color:var(--red)"></i>Expired Contracts</td>
                                <td><strong>@ViewBag.ExpiredContracts</strong></td>
                                <td><span class="badge-red">Expired</span></td>
                            </tr>
                            <tr>
                                <td><i class="bi bi-clock-history me-2" style="color:var(--green)"></i>Yet to Expire</td>
                                <td><strong>@ViewBag.YetToExpireContracts</strong></td>
                                <td><span class="badge-green">Active</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div><!-- /chart-row -->


</div><!-- /db-wrap -->


@section Scripts {
    <script>
/* ── Date label ── */
    document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('accDateLabel');
        if (el) el.textContent = new Date().toLocaleDateString('en-GB', { year:'numeric', month:'short', day:'numeric' });

        /* ── Animated counters ── */
        document.querySelectorAll('.anim-num').forEach(function (el) {
            var target = parseFloat(el.getAttribute('data-target')) || 0;
            var start  = 0;
            var inc    = target / (900 / (1000 / 60));
            function tick() {
                start += inc;
                if (start >= target) { el.textContent = Math.round(target).toLocaleString('en-IN'); return; }
                el.textContent = Math.round(start).toLocaleString('en-IN');
                requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
        });
    });

    /* ── Doughnut chart ── */
    const ctx = document.getElementById('paymentPieChart').getContext('2d');
    new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: ['Paid', 'Pending'],
            datasets: [{
                data: [@ViewBag.TotalPaidAmount, @ViewBag.PendingAmount],
                backgroundColor: ['#00b894', '#f39c12'],
                hoverBackgroundColor: ['#00cba7', '#f5ab35'],
                borderWidth: 3,
                borderColor: '#ffffff'
            }]
        },
        options: {
            cutout: '72%',
            animation: { duration: 1000, easing: 'easeOutQuart' },
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        usePointStyle: true,
                        pointStyle: 'circle',
                        padding: 20,
                        font: { family: "'Plus Jakarta Sans', sans-serif", size: 13 }
                    }
                },
                tooltip: {
                    callbacks: {
                        label: function (ctx) {
                            return ctx.label + ': ₹ ' + ctx.parsed.toLocaleString('en-IN');
                        }
                    }
                }
            }
        }
    });

    </script>
}
