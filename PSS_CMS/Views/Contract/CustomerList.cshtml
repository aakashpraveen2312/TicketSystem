@model IEnumerable<PSS_CMS.Models.ProductMaster>

@{ ViewData["Title"] = "Warranty Products";
    ViewBag.PageTitle = "Warranty Products";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string searchPhrase = Request["searchPharse"] ?? "";

    var filtered = Model?.Where(m =>
        string.IsNullOrEmpty(searchPhrase) ||
        (m.P_CODE != null && m.P_CODE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (m.P_NAME != null && m.P_NAME.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
    ).ToList(); }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-shield-check nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Warranty Products</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header: search LEFT, title RIGHT-anchored -->
    <div class="page-card-header">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <!-- Search -->
            @using (Html.BeginForm("", "", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>
    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@searchPhrase"
           onkeyup="autoSubmitSearch(this)" />
    @if (!string.IsNullOrEmpty(searchPhrase))
    {
<a href="@Url.Action("","")" title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}
</div>      }
        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
    <table class="table align-middle mb-0 tickets-table">

        <thead>
            <tr>
                <th class="text-center" style="width:60px;">S.No</th>
                <th>Code</th>
                <th>Product Name</th>
                <th class="text-center" style="width:180px;">Warranty (Months)</th>
                <th class="text-center" style="width:70px;">Sort</th>
                <th class="text-center" style="width:120px;">Comprehensive</th>
                <th class="text-center" style="width:160px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var o in Model)
            {

                var inclusionUrl = Url.Action("ViewList", "Contract",
                    new { P_RECID = o.P_RECID, P_NAME = o.P_NAME, type = "IN" });

                var exclusionUrl = Url.Action("ViewList", "Contract",
                    new { P_RECID = o.P_RECID, P_NAME = o.P_NAME, type = "EX" });

                var salesUrl = Url.Action("ProductInvoiceList", "AccountantCustomerInvoice",
                    new { productid = o.P_RECID });

        <tr>
            <td class="text-center serial-text">@o.SerialNumber</td>
            <td><span class="code-pill">@o.P_CODE</span></td>
            <td>@o.P_NAME</td>
            <td class="text-center">
                <span class="dur-badge">
                    <i class="bi bi-clock"></i> @o.P_DURATION
                </span>
            </td>
            <td class="text-center" style="color:var(--text-muted);font-size:12px;">@o.P_SORTORDER</td>
            <td class="text-center">
                <input type="checkbox"
                       @(o.P_Comprehensivewarranty ? "checked" : "")
                       disabled
                       style="accent-color:var(--primary);width:14px;height:14px;" />
            </td>
            <td>
                <div class="action-cell">

                    <!-- Inclusion -->
                    <a href="@inclusionUrl"
                       class="act-btn"
                       title="Inclusion">
                        <i class="bi bi-plus-circle" style="color:#00b894"></i>
                    </a>

                    <!-- Exclusion -->
                    <a href="@exclusionUrl"
                       class="act-btn"
                       title="Exclusion">
                        <i class="bi bi-dash-circle" style="color:#e17055"></i>
                    </a>

                    <!-- Sales Invoice -->
                    <a href="@salesUrl"
                       class="act-btn"
                       title="Sales Invoice">
                        <i class="bx bx-list-ul" style="color:#185FA5"></i>
                    </a>

                </div>
            </td>
        </tr>}
        </tbody>

    </table> <!-- Pagination -->

                    <div class="table-pagination">

                        <button id="prevBtn"
                                class="page-btn">

                            <i class="bi bi-chevron-left"></i>

                            Previous

                        </button>

                        <span id="pageInfo"
                              class="page-info">
                        </span>

                        <button id="nextBtn"
                                class="page-btn">

                            Next

                            <i class="bi bi-chevron-right"></i>

                        </button>

                    </div> }
                else
                {
    <div class="text-center py-5">
        <i class="bi bi-inbox" style="font-size:40px;color:var(--text-muted)"></i>
        <p class="mt-2 text-muted fw-semibold">No warranty products available</p>
    </div>}

    </div>

</div>

<!-- Legend bar -->
<div class="legend-bar">

    <div class="legend-item">
        <i class="bi bi-plus-circle" style="color:#00b894;font-size:14px"></i>
        <span>Inclusion</span>
    </div>

    <div class="legend-item">
        <i class="bi bi-dash-circle" style="color:#e17055;font-size:14px"></i>
        <span>Exclusion</span>
    </div>

    <div class="legend-item">
        <i class="bx bx-list-ul" style="color:#185FA5;font-size:16px"></i>
        <span>Sales Invoice</span>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>
    <script>
        /* Prevent disabled pagination links from navigating */
        document.querySelectorAll('.page-btn.disabled').forEach(function (el) {
            el.addEventListener('click', function (e) { e.preventDefault(); });
        });
    </script>
}
