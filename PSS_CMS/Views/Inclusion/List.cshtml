@model IEnumerable<PSS_CMS.Models.Inclusion>

@{
    ViewData["Title"] = "Inclusion";
    ViewBag.PageTitle = "Inclusion";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var pName = Session["P_NAME"] != null
        ? Session["P_NAME"].ToString()
        : "";

    var pRecid = Request["P_RECID"];
}

@section Styles {

    <!-- List view Css -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-shield-check nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "ProductMaster")">
        Warranty Products
    </a>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "ProductMaster")">
        @pName
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Inclusion</span>

</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm("List",
                "Inclusion",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("List","Inclusion")"
                           title="Clear">
                            <i class="bi bi-x-circle text-muted"></i>
                        </a>
                    }

                </div>
            }

            <a href="@Url.Action("Create", "Inclusion")"
               class="btn-add">

                <i class="bi bi-plus-lg"></i>

                Add Inclusion

            </a>

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:70px;">
                            S.No
                        </th>

                        <th>
                            Description
                        </th>

                        <th class="text-center"
                            style="width:80px;">
                            Sort
                        </th>

                        <th class="text-center"
                            style="width:100px;">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var editUrl = Url.Action(
                            "Edit",
                            "Inclusion",
                            new
                            {
                                IN_RECID = o.IN_RECID,
                                IN_PRECID = o.IN_PRECID,
                                IN_DESCRIPTION = o.IN_DESCRIPTION
                            });

                        var deleteUrl = Url.Action(
                            "Delete",
                            "Inclusion",
                            new
                            {
                                IN_RECID = o.IN_RECID
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>
                                @o.IN_DESCRIPTION
                            </td>

                            <td class="text-center">
                                @o.IN_SORTORDER
                            </td>

                            <td>

                                <div class="action-cell">

                                    <a href="@editUrl"
                                       title="Edit"
                                       class="act-btn act-edit">

                                        <i class='bx bxs-pencil'></i>

                                    </a>

                                    <a href="@deleteUrl"
                                       data-id="@o.IN_RECID"
                                       data-name="@o.IN_DESCRIPTION"
                                       title="Delete"
                                       class="act-btn act-delete no-loader"
                                       onclick="return confirmDelete(this);">

                                        <i class='bx bxs-trash'></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-plus-circle"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">
                    No inclusions available
                </p>

                <a href="@Url.Action("Create","Inclusion")"
                   class="btn-add mt-2 d-inline-flex">

                    <i class="bi bi-plus-lg"></i>

                    Add First Inclusion

                </a>

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <span class="act-btn act-edit"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-pencil'></i>

        </span>

        Edit

    </div>

    <div class="legend-item">

        <span class="act-btn act-delete"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-trash'></i>

        </span>

        Delete

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}