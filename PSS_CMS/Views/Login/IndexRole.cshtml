@model PSS_CMS.Models.Login
@{ Layout = null;
                var successMessage = TempData["SuccessMessage"];
                var errorMessage = TempData["ErrorMessage"]; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TICKET SYSTEM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link href="~/Content/UILogin.css" rel="stylesheet" />
    <style>
        #loginLoader {
    position: fixed;
    inset: 0;
    background: rgba(255, 255, 255, 0.92);
    display: none;                        /* hidden by default */
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 1rem;
    z-index: 9999;
    backdrop-filter: blur(4px);
    animation: loaderFadeIn .25s ease both;
}

#loginLoader.active {
    display: flex;
}

/* Spinner — identical to .loader */
#loginLoader .loader {
    width: 44px;
    height: 44px;
    border: 4px solid var(--purple-lt);
    border-top-color: var(--purple);
    border-radius: 50%;
    animation: spin .8s linear infinite;
}

/* "Signing in…" label below spinner */
#loginLoader .loader-text {
    font-family: 'Nunito', sans-serif;
    font-size: .88rem;
    font-weight: 700;
    color: var(--purple);
    letter-spacing: .4px;
    animation: loaderTextPulse 1.4s ease-in-out infinite;
}

/* Dot trail */
#loginLoader .loader-dots span {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--purple);
    margin: 0 3px;
    animation: dotBounce .9s ease-in-out infinite;
}

#loginLoader .loader-dots span:nth-child(2) { animation-delay: .18s; }
#loginLoader .loader-dots span:nth-child(3) { animation-delay: .36s; }

/* ── Keyframes ── */
@@keyframes spin {
    to { transform: rotate(360deg); }
}

@@keyframes loaderFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

@@keyframes loaderTextPulse {
    0%, 100% { opacity: .6; }
    50%       { opacity: 1; }
}

@@keyframes dotBounce {
    0%, 80%, 100% { transform: translateY(0);   opacity: .4; }
    40%           { transform: translateY(-8px); opacity: 1;  }
}

        @@keyframes floatScene {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-12px)
            }
        }

        @@keyframes cardBob0 {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-10px)
            }
        }

        @@keyframes cardBob1 {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-8px)
            }
        }

        @@keyframes cardBob2 {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-12px)
            }
        }

        @@keyframes sparkPulse {
            0%, 100% {
                transform: scale(1);
                opacity: .65
            }

            50% {
                transform: scale(1.4);
                opacity: 1
            }
        }

        @@keyframes monitorPulse {
            0%, 100% {
                opacity: 1
            }

            50% {
                opacity: 0.82
            }
        }

        @@keyframes agentBob {
            0%, 100% {
                transform: translateY(0)
            }

            50% {
                transform: translateY(-5px)
            }
        }

        @@keyframes headsetGlow {
            0%, 100% {
                opacity: 0.65
            }

            50% {
                opacity: 1
            }
        }

        @@keyframes rotateGear {
            from {
                transform: rotate(0deg)
            }

            to {
                transform: rotate(360deg)
            }
        }

        @@keyframes dotBlink {
            0%, 100% {
                opacity: 0.35
            }

            50% {
                opacity: 1
            }
        }

        .scene {
            animation: floatScene 5s ease-in-out infinite;
            transform-origin: 340px 280px;
        }

        .card0 {
            animation: cardBob0 4s ease-in-out infinite;
            transform-origin: 70px 80px;
        }

        .card1 {
            animation: cardBob1 4s ease-in-out infinite 1.2s;
            transform-origin: 78px 135px;
        }

        .card2 {
            animation: cardBob2 4.5s ease-in-out infinite 2.1s;
            transform-origin: 530px 65px;
        }

        .sparkle {
            animation: sparkPulse 2s ease-in-out infinite;
            transform-origin: 530px 28px;
        }

        .monitor-screen {
            animation: monitorPulse 3s ease-in-out infinite;
        }

        .agent1-body {
            animation: agentBob 3s ease-in-out infinite;
            transform-origin: 118px 255px;
        }

        .agent2-body {
            animation: agentBob 3.4s ease-in-out infinite 0.8s;
            transform-origin: 470px 230px;
        }

        .headset1 {
            animation: headsetGlow 2.5s ease-in-out infinite;
        }

        .headset2 {
            animation: headsetGlow 2.5s ease-in-out infinite 1.2s;
        }

        .gear {
            animation: rotateGear 10s linear infinite;
            transform-origin: 592px 96px;
        }

        .status-dot {
            animation: dotBlink 2s ease-in-out infinite;
        }
    </style>

</head>
