@model PSS_CMS.Models.CompanyInfo

@{ ViewData["Title"] = "Company Info";
                ViewBag.PageTitle = "Company Info";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Layout ───────────────────────────────────────────── */
        .form-body  { padding: 22px; }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        @@media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
        }

        .col-full { grid-column: 1 / -1; }

        /* ── Form Group ───────────────────────────────────────── */
        .form-group { display: flex; flex-direction: column; gap: 5px; }

        .form-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .field-readonly {
            width: 100%;
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 9px;
            padding: 8px 12px;
            font-size: 13px;
            font-family: inherit;
            color: var(--text-muted);
            outline: none;
            cursor: default;
        }

        /* ── Read-only badge ──────────────────────────────────── */
        .readonly-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #f3f0ff;
            color: #5a4bd1;
            font-size: 10.5px;
            font-weight: 600;
            padding: 1px 8px;
            border-radius: 20px;
            margin-left: 6px;
            vertical-align: middle;
        }

        /* ── Logo Section ─────────────────────────────────────── */
        .logo-section {
            padding: 22px;
            border-top: 1px solid var(--border-color);
        }

        .logo-inner {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
            align-items: start;
        }

        @@media (max-width: 768px) {
            .logo-inner { grid-template-columns: 1fr; }
        }

        .logo-preview-label,
        .upload-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: 6px;
            display: block;
        }

        .logo-preview-box {
            width: 100%;
            height: 130px;
            border-radius: 10px;
            border: 1.5px dashed var(--border-color);
            background: var(--body-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .logo-preview-box img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }

        .logo-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: var(--text-muted);
            font-size: 12px;
        }

            .logo-placeholder i { font-size: 28px; }

        /* Custom file input */
        .file-input-wrap {
            border: 1px solid var(--border-color);
            border-radius: 9px;
            background: var(--body-bg);
            padding: 8px 12px;
            font-size: 12.5px;
            color: var(--text-muted);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: border-color .15s;
        }

            .file-input-wrap:hover { border-color: var(--primary); }
            .file-input-wrap i { color: var(--primary); font-size: 16px; }

        .upload-hint {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 6px;
        }

        /* ── Footer Actions ───────────────────────────────────── */
        .footer-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 14px 18px;
            border-top: 1px solid var(--border-color);
        }

        .btn-update {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 7px 20px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: var(--transition);
        }

            .btn-update:hover { background: #5a4bd1; }

            .btn-update:disabled {
                opacity: .6;
                cursor: not-allowed;
            }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-buildings nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Security</span>
    <i class="bi bi-chevron-right"></i>
    <span>Company Info</span>
</div>

<!-- Company Info Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <i class="bi bi-buildings nav-icon" style="color:var(--primary)"></i>
            Company Information
            <span class="readonly-badge">
                <i class="bi bi-lock" style="font-size:10px"></i>
                Read Only
            </span>
        </h6>
    </div>

    <!-- Read-only Fields -->
    <div class="form-body">
        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label">
                    @Html.LabelFor(m => m.C_CODE)
                </label>
                @Html.EditorFor(m => m.C_CODE, new
                {
                    htmlAttributes = new
                    {
                        @class = "field-readonly",
                        @readonly = "readonly",
                        autocomplete = "off"
                    }
                })
                @Html.ValidationMessageFor(m => m.C_CODE, "", new { @class = "text-danger" })
            </div>

            <!-- Name -->
            <div class="form-group">
                <label class="form-label">
                    @Html.LabelFor(m => m.C_NAME)
                </label>
                @Html.EditorFor(m => m.C_NAME, new
                {
                    htmlAttributes = new
                    {
                        @class = "field-readonly",
                        @readonly = "readonly",
                        autocomplete = "off"
                    }
                })
                @Html.ValidationMessageFor(m => m.C_NAME, "", new { @class = "text-danger" })
            </div>

            <!-- Email -->
            <div class="form-group">
                <label class="form-label">
                    @Html.LabelFor(m => m.C_EMAILID)
                </label>
                @Html.EditorFor(m => m.C_EMAILID, new
                {
                    htmlAttributes = new
                    {
                        @class = "field-readonly",
                        @readonly = "readonly",
                        autocomplete = "off"
                    }
                })
            </div>

            <!-- Phone -->
            <div class="form-group">
                <label class="form-label">
                    @Html.LabelFor(m => m.C_PHONE)
                </label>
                @Html.EditorFor(m => m.C_PHONE, new
                {
                    htmlAttributes = new
                    {
                        @class = "field-readonly",
                        @readonly = "readonly",
                        autocomplete = "off"
                    }
                })
            </div>

            <!-- Address — full width -->
            <div class="form-group col-full">
                <label class="form-label">
                    @Html.LabelFor(m => m.C_ADDRESS)
                </label>
                @Html.EditorFor(m => m.C_ADDRESS, new
                {
                    htmlAttributes = new
                    {
                        @class = "field-readonly",
                        @readonly = "readonly",
                        autocomplete = "off"
                    }
                })
            </div>

        </div>
    </div>

    <!-- Logo Upload (its own form) -->
    @using (Html.BeginForm(
        "UpdateLogo",
        "CompanyInfo",
        FormMethod.Post,
        new { id = "logoForm", enctype = "multipart/form-data" }))
    {
<div class="logo-section">
    <div class="logo-inner">

        <!-- Preview -->
        <div>
            <span class="logo-preview-label">Logo Preview</span>
            <div class="logo-preview-box">
                @if (!string.IsNullOrEmpty(Model.C_LOGO))
                {
                    var src = string.IsNullOrEmpty(ViewBag.GstImageBase64 as string)
                        ? (Model.C_LOGO.Contains("data:image/")
                            ? Model.C_LOGO
                            : (Model.C_LOGO.StartsWith("/") || Model.C_LOGO.StartsWith("iVBORw0KGgo")
                                ? "data:image/png;base64,"
                                : "data:image/jpeg;base64,") + Model.C_LOGO)
                        : "data:image/png;base64," + ViewBag.imageGst;

<img id="logoPreview"
     src="@src"
     alt="Company Logo"
     style="max-width:100%;max-height:100%;object-fit:contain;" /> }
                else
                {
<div class="logo-placeholder">
    <i class="bi bi-image" aria-hidden="true"></i>
    <span>No logo uploaded</span>
</div>
                    <img id="logoPreview" src="" alt="Company Logo" style="display:none;max-width:100%;max-height:100%;object-fit:contain;" />}
            </div>
        </div>

        <!-- Upload -->
        <div>
            <span class="upload-label">Upload New Logo</span>

            <div class="file-input-wrap"
                 onclick="document.getElementById('C_LOGO').click()"
                 role="button"
                 tabindex="0"
                 aria-label="Choose logo image">
                <i class="bi bi-upload" aria-hidden="true"></i>
                <span id="fileNameLabel">Choose image file…</span>
            </div>

            <input type="file"
                   id="C_LOGO"
                   name="C_LOGO"
                   accept="image/*"
                   style="display:none"
                   onchange="handleFileChange(this)" />

            <input type="hidden"
                   name="ExistingGstImage"
                   value="@ViewBag.imageGst" />

            <p class="upload-hint">
                Accepted formats: PNG, JPG, JPEG &nbsp;·&nbsp; Max 2 MB
            </p>
        </div>

    </div>
</div> <!-- Footer -->
                                <div class="footer-actions">
                                    <button type="button"
                                            id="saveButton"
                                            class="btn-update"
                                            onclick="submitLogo()">
                                        <i class="bi bi-floppy"></i>
                                        Update Logo
                                    </button>
                                </div>}

</div>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

<!-- Legend -->
<div class="legend-bar">
    <div class="legend-item">
        <i class="bi bi-lock" style="color:#6c5ce7;font-size:14px"></i>
        <span>Read Only Fields</span>
    </div>
    <div class="legend-item">
        <i class="bi bi-upload" style="color:#00b894;font-size:14px"></i>
        <span>Logo Upload</span>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // ── File picker ────────────────────────────────────────────
        function handleFileChange(input) {
            if (!input.files || !input.files[0]) return;

            var file  = input.files[0];
            document.getElementById('fileNameLabel').textContent = file.name;

            var reader = new FileReader();
            reader.onload = function (e) {
                var img = document.getElementById('logoPreview');
                img.src          = e.target.result;
                img.style.display = 'block';

                var ph = document.querySelector('.logo-placeholder');
                if (ph) ph.style.display = 'none';
            };
            reader.readAsDataURL(file);
        }

        // ── AJAX submit ────────────────────────────────────────────
        function submitLogo() {
            var btn = document.getElementById('saveButton');
            btn.disabled = true;

            $('body').css('pointer-events', 'none');

            var formData = new FormData(document.getElementById('logoForm'));

            $.ajax({
                url:         '@Url.Action("UpdateLogo", "CompanyInfo")',
                type:        'POST',
                data:        formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.status === 'success') {
                        Swal.fire({
                            title:           'Processing…',
                            html:            'Please wait while we save your changes.',
                            allowOutsideClick: false,
                            allowEscapeKey:  false,
                            didOpen: function () { Swal.showLoading(); }
                        });

                        setTimeout(function () {
                            Swal.fire({
                                icon:              'success',
                                title:             'Success!',
                                text:              res.message,
                                confirmButtonText: 'OK',
                                confirmButtonColor:'#6c5ce7',
                                allowOutsideClick: false,
                                allowEscapeKey:    false
                            }).then(function () {
                                window.location.href = '@Url.Action("Info", "CompanyInfo")';
                            });
                        }, 1000);

                    } else {
                        Swal.fire({
                            icon:  'info',
                            title: 'Message',
                            text:  res.message,
                            allowOutsideClick: false,
                            allowEscapeKey:    false
                        });
                        resetButton();
                    }
                },
                error: function () {
                    Swal.fire({
                        icon:  'error',
                        title: 'Error!',
                        text:  'An unexpected error occurred.',
                        allowOutsideClick: false,
                        allowEscapeKey:    false
                    });
                    resetButton();
                }
            });

            function resetButton() {
                btn.disabled = false;
                $('body').css('pointer-events', 'auto');
            }
        }
    </script>
}
