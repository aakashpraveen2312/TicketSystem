@model PSS_CMS.Models.PaymentUpdate

@{ ViewData["Title"] = "Update Payment";
                ViewBag.PageTitle = "Update Payment";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-credit-card nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Index", "ServiceInvoice")">Service Invoice</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("ServiceInvoicePaymentList", "ServiceInvoice")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Update Payment</span>
</div>

@using (Html.BeginForm("UpdatePayment", "ServiceInvoice", FormMethod.Post,
    new { id = "paymentform", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-credit-card" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Update Payment
        </h6>
    </div>

    <!-- Form Body -->
    <div class="form-body">

        <!-- Invoice Info -->

        <div class="form-grid">

            <div class="form-group">
                @Html.LabelFor(m => m.TC_ReferenceNo, new { @class = "form-label" })
                @Html.EditorFor(m => m.TC_ReferenceNo, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TC_InvoiceNumber, new { @class = "form-label" })
                @Html.EditorFor(m => m.TC_InvoiceNumber, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Payment Details -->
        <div class="form-grid">

            <div class="form-group">
                <div style="display:flex; align-items:center; gap:2px;">
                    @Html.LabelFor(m => m.TC_ModeOfPayment, new { @class = "form-label", style = "margin-bottom:0;" })
                    <span class="req" style="color:#E24B4A; font-size:11px; font-weight:600;">*</span>
                </div>
                @Html.DropDownListFor(m => m.TC_ModeOfPayment,
                              new List<SelectListItem>
                              {
                            new SelectListItem { Text = "Select Payment Mode", Value = "" },
                            new SelectListItem { Text = "Cash", Value = "Cash" },
                            new SelectListItem { Text = "UPI", Value = "UPI" }
                              },
                              new { @class = "form-select" })
            </div>

            <div class="form-group">
                <div style="display:flex; align-items:center; gap:2px;">
                    @Html.LabelFor(m => m.TC_ModeOfPayment, new { @class = "form-label", style = "margin-bottom:0;" })
                    <span class="req" style="color:#E24B4A; font-size:11px; font-weight:600;">*</span>
                </div>
                @Html.EditorFor(m => m.TC_DateOfPayment, new { htmlAttributes = new { @class = "form-input-text", autocomplete = "off", type = "date" } })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- Amount Summary -->
        <div class="form-grid">

            <div class="form-group">
                @Html.LabelFor(m => m.SINP_SOFARPAID, "So Far Paid", new { @class = "form-label" })
                @Html.EditorFor(m => m.SINP_SOFARPAID, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly", id = "Sorfarpaid" } })
            
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TC_TotalAmount, new { @class = "form-label" })
                @Html.EditorFor(m => m.TC_TotalAmount, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly", id = "TotalAmount" } })
           
            </div>

            <div class="form-group">
                <div style="display:flex; align-items:center; gap:2px;">
                    @Html.LabelFor(m => m.TC_ModeOfPayment, new { @class = "form-label", style = "margin-bottom:0;" })
                    <span class="req" style="color:#E24B4A; font-size:11px; font-weight:600;">*</span>
                </div>
                @Html.EditorFor(m => m.TC_PaidAmount, new { htmlAttributes = new { @class = "form-input-num", autocomplete = "off", id = "PaidAmount", placeholder = "0.00" } })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TC_BalanceAmount, new { @class = "form-label" })
                @Html.EditorFor(m => m.TC_BalanceAmount, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", id = "BalanceAmount", @readonly = "readonly" } })
      
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TC_PaymentStatus, new { @class = "form-label" })
                @Html.EditorFor(m => m.TC_PaymentStatus, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", id = "PaymentStatus", @readonly = "readonly" } })
                <span class="auto-badge"><i class="bi bi-info-circle"></i> Auto-updated</span>
            </div>

        </div>

    </div>

    <!-- Legend -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("ServiceInvoicePaymentList", "ServiceInvoice")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Update Payment
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            function updatePaymentStatus() {
                var total = parseFloat($("#TotalAmount").val()) || 0;
                var sofar = parseFloat($("#Sorfarpaid").val()) || 0;
                var paid = parseFloat($("#PaidAmount").val()) || 0;
                var totalPaid = sofar + paid;
                var balance = Math.max(total - totalPaid, 0);

                $("#BalanceAmount").val(balance.toFixed(2));

                var statusText = "";
                var statusColor = "var(--text-dark)";

                if (totalPaid > 0) {
                    if (totalPaid >= total) {
                        statusText = "FULLY PAID";
                        statusColor = "#1D9E75";
                    } else {
                        statusText = "PARTIALLY PAID";
                        statusColor = "#e67e22";
                    }
                }

                $("#PaymentStatus").val(statusText).css("color", statusColor);
            }

            $("#PaidAmount").on("input", function () {
                var total = parseFloat($("#TotalAmount").val()) || 0;
                var sofar = parseFloat($("#Sorfarpaid").val()) || 0;
                var paid = parseFloat($(this).val()) || 0;

                if ((sofar + paid) > total) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Invalid Amount',
                        text: 'Total paid cannot exceed Total Amount.',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        $(this).val((total - sofar).toFixed(2));
                        updatePaymentStatus();
                    });
                    return;
                }
                updatePaymentStatus();
            });

            // Initial calculation on page load
            updatePaymentStatus();
        });
    </script>

    <script>
        $(document).ready(function () {
            $("#paymentform").on("submit", function (event) {
                event.preventDefault();

                var submitBtn = $("#savebutton");
                submitBtn.prop("disabled", true);
                var formData = new FormData(this);
                $("body").css("pointer-events", "none");

                $.ajax({
                    url: '@Url.Action("UpdatePayment", "ServiceInvoice")',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we update your payment details.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });
                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    confirmButtonText: "Back to List",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: { confirmButton: "swal-btn-continue" },
                                    didOpen: () => { $(".swal2-container").css("pointer-events", "auto"); }
                                }).then(() => {
                                    window.location.href = '@Url.Action("ServiceInvoicePaymentList", "ServiceInvoice")';
                                });
                            }, 1000);
                        } else {
                            Swal.fire({ title: "Message", text: response.message, icon: "info", allowOutsideClick: false, allowEscapeKey: false });
                            resetForm();
                        }
                    },
                    error: function () {
                        Swal.fire({ title: "Error!", text: "An unexpected error occurred while updating payment.", icon: "error", allowOutsideClick: false, allowEscapeKey: false });
                        resetForm();
                    }
                });
            });

            function resetForm() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
