@section Scripts {
    <script>
/* ══════════════════════════════════════════════════════════════
   DATA FROM CONTROLLER  (matches your JSON + ViewBag mapping)
   ViewBag.CalendarTickets  — per-day JSON array
   ViewBag.UpcomingTickets  — upcoming deadlines JSON array
   ViewBag.EngineerWorkload — engineer list JSON array
══════════════════════════════════════════════════════════════ */
var CALENDAR_DATA  = @Html.Raw(ViewBag.CalendarTickets  ?? "[]");
var UPCOMING_DATA  = @Html.Raw(ViewBag.UpcomingTickets  ?? "[]");
var ENGINEER_DATA  = @Html.Raw(ViewBag.EngineerWorkload ?? "[]");

/* ── helpers ── */
var MONTHS = ['January','February','March','April','May','June',
              'July','August','September','October','November','December'];
var DAYS   = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
function pad(n){ return n < 10 ? '0'+n : ''+n; }
function dateKey(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); }

/* ── date label ── */
document.getElementById('dashDateLabel').textContent =
    new Date().toLocaleDateString('en-GB',{year:'numeric',month:'short',day:'numeric'});

/* ── animated counters ── */
document.querySelectorAll('.anim-num').forEach(function(el){
    var target = parseInt(el.getAttribute('data-target'))||0;
    var start=0, inc=target/(900/(1000/60));
    (function tick(){
        start+=inc;
        if(start>=target){ el.textContent=target; return; }
        el.textContent=Math.floor(start);
        requestAnimationFrame(tick);
    })();
});

/* ── build date index from CalendarTickets ── */
var dataIndex = {};
CALENDAR_DATA.forEach(function(d){ dataIndex[d.date] = d; });

/* ══════════════════════════════════════
   CALENDAR STATE
══════════════════════════════════════ */
var today       = new Date();
var curYear     = today.getFullYear();
var curMonth    = today.getMonth();
var selectedKey = null;

/* ── render calendar ── */
function renderCalendar(){
    document.getElementById('calTitle').textContent = MONTHS[curMonth]+' '+curYear;
    var grid = document.getElementById('calGrid');
    grid.innerHTML = '';

    var firstDow    = new Date(curYear, curMonth, 1).getDay();
    var daysInMonth = new Date(curYear, curMonth+1, 0).getDate();
    var prevDays    = new Date(curYear, curMonth, 0).getDate();

    for(var i=firstDow-1; i>=0; i--)
        grid.appendChild(makeCell(prevDays-i, curYear, curMonth-1, true));

    for(var d=1; d<=daysInMonth; d++)
        grid.appendChild(makeCell(d, curYear, curMonth, false));

    var rem = (firstDow+daysInMonth)%7;
    if(rem) for(var n=1; n<=7-rem; n++)
        grid.appendChild(makeCell(n, curYear, curMonth+1, true));
}

function makeCell(day, yr, mo, other){
    var dt  = new Date(yr, mo, day);
    var key = dateKey(dt);
    var isToday   = key === dateKey(today);
    var isSel     = key === selectedKey;
    var isWeekend = dt.getDay()===0 || dt.getDay()===6;
    var data      = dataIndex[key];

    var cell = document.createElement('div');
    cell.className = 'cal-cell'
        +(other    ? ' other'   : '')
        +(isToday  ? ' today'   : '')
        +(isSel    ? ' selected': '')
        +(isWeekend? ' weekend' : '');

    /* date circle */
    var wrap = document.createElement('div'); wrap.className='c-date-wrap';
    var dateEl = document.createElement('div'); dateEl.className='c-date'; dateEl.textContent=dt.getDate();
    wrap.appendChild(dateEl); cell.appendChild(wrap);

    if(data){
        var total=(data.open||0)+(data.assigned||0)+(data.resolved||0)+(data.overdue||0);
        if(total>0){
            var badge=document.createElement('div'); badge.className='c-count'; badge.textContent=total; cell.appendChild(badge);
        }
        var dots=document.createElement('div'); dots.className='c-dots';
        function addDots(n,cls){ for(var i=0;i<Math.min(n,4);i++){ var d=document.createElement('div'); d.className='c-dot '+cls; dots.appendChild(d); } }
        addDots(data.open,'d-open');
        addDots(data.assigned,'d-assigned');
        addDots(data.resolved,'d-resolved');
        
        cell.appendChild(dots);
    }

    cell.addEventListener('click', function(){ selectDay(key, dt, data); });
    return cell;
}

/* ── select day → update right panel ── */
var STATUS_CFG = {
    'Open':     {cls:'tib-open',     dot:'d-open'},
    'Assigned': {cls:'tib-assigned', dot:'d-assigned'},
    'Resolved': {cls:'tib-resolved', dot:'d-resolved'}
};

function selectDay(key, dateObj, data){
    selectedKey = key;
    renderCalendar();

    document.getElementById('detailMonth').textContent   = MONTHS[dateObj.getMonth()]+' '+dateObj.getFullYear();
    document.getElementById('detailDay').textContent     = dateObj.getDate();
    document.getElementById('detailDayName').textContent = DAYS[dateObj.getDay()];

    var d = data || {open:0, assigned:0, resolved:0, tickets:[]};
    document.getElementById('detailOpen').textContent     = d.open     || 0;
    document.getElementById('detailAssigned').textContent = d.assigned || 0;
    document.getElementById('detailResolved').textContent = d.resolved || 0;

    var list = document.getElementById('dayTicketList');
    list.innerHTML = '';
    var tickets = d.tickets || [];

    if(!tickets.length){
        list.innerHTML='<div class="empty-state"><i class="bi bi-check2-circle"></i><p>No tickets on this date</p></div>';
        return;
    }

    tickets.forEach(function(t){
        var cfg = STATUS_CFG[t.status] || STATUS_CFG['Open'];
        var item = document.createElement('div');
        item.className = 'ticket-item';
        item.innerHTML =
            '<div class="ti-dot '+cfg.dot+'"></div>'+
            '<div class="ti-body">'+
              '<div class="ti-id">'+(t.id||'')+'</div>'+
              '<div class="ti-title">'+(t.title||'')+'</div>'+
              '<div class="ti-meta"><i class="bi bi-person me-1"></i>'+(t.engineer||'Unassigned')+'</div>'+
            '</div>'+
            '<span class="ti-badge '+cfg.cls+'">'+(t.status||'')+'</span>';
        list.appendChild(item);
    });
}

/* ── nav buttons ── */
document.getElementById('prevMonth').addEventListener('click',function(){
    curMonth--; if(curMonth<0){curMonth=11;curYear--;} renderCalendar();
});
document.getElementById('nextMonth').addEventListener('click',function(){
    curMonth++; if(curMonth>11){curMonth=0;curYear++;} renderCalendar();
});
document.getElementById('todayBtn').addEventListener('click',function(){
    curYear=today.getFullYear(); curMonth=today.getMonth();
    renderCalendar();
    selectDay(dateKey(today), today, dataIndex[dateKey(today)]);
});


/* ── initial render & auto-select today ── */
renderCalendar();
selectDay(dateKey(today), today, dataIndex[dateKey(today)]);
    </script>
}
