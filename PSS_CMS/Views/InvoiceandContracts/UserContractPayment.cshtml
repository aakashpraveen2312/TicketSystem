
@model IEnumerable<PSS_CMS.Models.ContractInvoicePayment>

@{ ViewData["Title"] = "Invoice Payments";
    ViewBag.PageTitle = "Invoice Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string searchPhrase = Request["searchPharse"] ?? "";

    var filtered = Model?.Where(x =>
        string.IsNullOrEmpty(searchPhrase) ||
        (x.CIP_REFERENCENO != null && x.CIP_REFERENCENO.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (x.CIP_PAYMENTMODE != null && x.CIP_PAYMENTMODE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (x.CIP_STATUS != null && x.CIP_STATUS.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
    ).ToList();

    decimal grandTotal = filtered != null ? filtered.Sum(x => x.CIP_PREVIOUSLYPAIDAMOUNT) : 0; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

@{ bool isFullyPaid = Model != null &&
                                     Model.Any(x =>
                                         !string.IsNullOrEmpty(x.CIP_STATUS) &&
                                         x.CIP_STATUS.Equals(
                                             "Fully Paid",
                                             StringComparison.OrdinalIgnoreCase
                                         )
                                     ); }

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-cash-coin nav-icon"></i>

    <a href="@Url.Action("List", "SMContractInvoiceHeader" ,new { companyId =  Session["companyId"] , CIH_CONTRACTRECID = Session["CIH_CONTRACTRECID"]})">Invoice History</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "ContractPayment" ,new { CIP_CIHRECID = Session["CIP_CIHRECID"],
                   companyId =  Session["companyId"],PaymentAmount =  Session["PaymentAmount"]})">Payment History</a>
    <i class="bi bi-chevron-right"></i>
    <span>Payments</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <h3 class="page-card-title">
            <i class="bi bi-cash-coin"></i> Invoice Payments
        </h3>

        <div style="display:flex; align-items:center; gap:10px;">

            @using (Html.BeginForm("Payments", "SMContractInvoicePayment", FormMethod.Get, new { id = "searchForm" }))
            {
                <div class="search-box">
                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search reference, mode or status"
                           autocomplete="off"
                           value="@searchPhrase" />

                    @if (!string.IsNullOrEmpty(searchPhrase))
                    {
                        <a href="@Url.Action("Payments", "SMContractInvoicePayment")" title="Clear">
                            <i class="bi bi-x-circle text-muted"></i>
                        </a>}
                </div>}

            @if (!isFullyPaid)
            {
                @*<a href="@Url.Action("Create", "ContractPayment")"
                   class="res-btn res-btn-submit"
                   style="padding:8px 15px; text-decoration:none; white-space:nowrap;">

                    <i class="bi bi-plus-circle"></i>
                    Add Payment

                </a>*@
                
                
                }

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap">
        @if (filtered != null && filtered.Any())
        {
            <table id="paymentsTable">
                <thead>
                    <tr>
                        <th style="width:70px;">S.No</th>
                        <th>Payment Date</th>
                        <th class="text-center">Paid Amount</th>
                        <th>Mode</th>
                        <th>Reference No.</th>
                        <th>Remarks</th>
                        <th class="text-center" style="width:110px;">Status</th>
                        @if (!isFullyPaid)
                        {
                            <th class="text-center" style="width:100px;">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{ int sno = 1; }
                    @foreach (var o in filtered)
                    {
                        string statusClass = "status-pending";

                        if (!string.IsNullOrEmpty(o.CIP_STATUS))
                        {
                            string status = o.CIP_STATUS.ToLower();

                            if (status == "success" ||
                              status == "completed" ||
                              status == "paid" ||
                              status == "fully paid")
                            {
                                statusClass = "status-processed";
                            }
                            else if (status == "partially paid")
                            {
                                statusClass = "status-unlocked";
                            }
                            else if (status == "failed" || status == "rejected")
                            {
                                statusClass = "badge-expired";
                            }
                            else
                            {
                                statusClass = "status-pending";
                            }
                        }

                        var editUrl = Url.Action("Edit", "ContractPayment", new { RecordId = o.CIP_RECID, companyId = o.CIP_COMPANYRECID });

                        <tr>
                            <td class="text-center">@sno</td>
                            <td>@o.CIP_PAYMENTDATE.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td class="amount-cell text-center">₹@o.CIP_PREVIOUSLYPAIDAMOUNT.ToString("N2")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(o.CIP_PAYMENTMODE))
                                {
                                    <span class="type-badge type-service">@o.CIP_PAYMENTMODE</span>}
                            </td>
                            <td><span class="inv-code">@o.CIP_REFERENCENO</span></td>
                            <td style="font-size:12.5px;color:#6B7280;">@o.CIP_REMARKS</td>
                            <td class="text-center">
                                <span class="status-badge @statusClass">@o.CIP_STATUS</span>
                            </td>
                            <td>
                                <div class="action-cell">

                                    <!-- Download Receipt -->
                                    <a href="@Url.Action(
                                        "DownloadSMContractInvoicePaymentReceipt",
                                        "ContractPayment",
                                        new
                                        {
                                            companyId = o.CIP_COMPANYRECID,
                                            RecordId = o.CIP_RECID
                                        })"
                                       class="act-btn download-receipt no-loader"
                                       title="Download Payment Receipt">

                                        <i class="bi bi-file-earmark-pdf-fill"></i>

                                    </a>

                                    @{
                                        bool paymentFullyPaid =
!string.IsNullOrEmpty(o.CIP_STATUS) &&
                                                    new[]
                                                    {
                                        "Fully Paid",
                                        "Partially Paid"
                                }.Contains(
                                                    o.CIP_STATUS,
                                                    StringComparer.OrdinalIgnoreCase
                                                    );
                                    }

                                    @if (!paymentFullyPaid)
                                    {
                                        <!-- Delete -->
                                        <a href="javascript:void(0);"
                                           class="act-btn act-delete no-loader"
                                           title="Delete"
                                           data-name="@o.CIP_REFERENCENO"
                                           data-paymentid="@o.CIP_RECID"
                                           data-companyid="@o.CIP_COMPANYRECID"
                                           onclick="return confirmDelete(this);">
                                            <i class="bx bxs-trash"></i>

                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                        sno++;
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="2" style="text-align:right; font-weight:700; padding:11px 14px;">Total Paid</td>
                        <td class="net-amount-cell text-center">₹@grandTotal.ToString("N2")</td>
                        <td colspan="5"></td>
                    </tr>
                </tfoot>
            </table> <!-- Pagination -->
            <div class="table-pagination">
                <button id="prevBtn" class="page-btn"><i class="bi bi-chevron-left"></i> Previous</button>
                <span id="pageInfo" class="page-info"></span>
                <button id="nextBtn" class="page-btn">Next <i class="bi bi-chevron-right"></i></button>
            </div> }
        else
        {
            <div class="alert alert-warning text-center m-3">
                <b>No payments available</b>
            </div>}
    </div>
</div>

<!-- Legend -->
<div class="legend-bar">
    <div class="legend-item"><span class="status-badge status-processed">Completed</span></div>
    <div class="legend-item"><span class="status-badge status-pending">Pending</span></div>
    <div class="legend-item"><span class="status-badge badge-expired">Failed</span></div>
    <div class="legend-item">
        <span class="act-btn act-edit" style="width:22px;height:22px;font-size:13px"><i class='bx bxs-pencil'></i></span>
        Edit
    </div>
    <div class="legend-item">
        <span class="act-btn act-delete" style="width:22px;height:22px;font-size:13px"><i class='bx bxs-trash'></i></span>
        Delete
    </div>
</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
(function () {
            var pageSize = 10;
            var table = document.getElementById("paymentsTable");
            if (!table) return;

            var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));
            var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));
            var currentPage = 1;

            var prevBtn = document.getElementById("prevBtn");
            var nextBtn = document.getElementById("nextBtn");
            var pageInfo = document.getElementById("pageInfo");

            function renderPage() {
                var start = (currentPage - 1) * pageSize;
                var end = start + pageSize;

                rows.forEach(function (row, idx) {
                    row.style.display = (idx >= start && idx < end) ? "" : "none";
                });

                pageInfo.textContent = "Page " + currentPage + " of " + totalPages;
                prevBtn.disabled = currentPage === 1;
                nextBtn.disabled = currentPage === totalPages;
            }

            prevBtn.addEventListener("click", function () {
                if (currentPage > 1) { currentPage--; renderPage(); }
            });

            nextBtn.addEventListener("click", function () {
                if (currentPage < totalPages) { currentPage++; renderPage(); }
            });

            renderPage();
        })();

        // ── Delete confirmation ──
        function confirmDelete(el) {

    var name = el.getAttribute("data-name") || "this payment";

    var paymentRecId =
        el.getAttribute("data-paymentid");

    var companyId =
        el.getAttribute("data-companyid");


    // ==============================
    // DELETE CONFIRMATION
    // ==============================

    Swal.fire({

        title: "Delete this payment?",

        text: name +
            " will be removed. This action cannot be undone.",

        icon: "warning",

        showCancelButton: true,

        confirmButtonText:
            '<i class="bx bxs-trash"></i> Delete',

        cancelButtonText:
            '<i class="bx bx-x"></i> Cancel',

        confirmButtonColor: "#e74c3c",

        cancelButtonColor: "#6b7280",

        reverseButtons: true,

        allowOutsideClick: false

    }).then(function (result) {

        if (result.isConfirmed) {

            // ==============================
            // SHOW LOADING
            // ==============================

            Swal.fire({

                title: "Deleting...",

                text: "Please wait",

                allowOutsideClick: false,

                allowEscapeKey: false,

                didOpen: function () {

                    Swal.showLoading();

                }

            });


            // ==============================
            // AJAX DELETE
            // ==============================

            $.ajax({

                url: '@Url.Action("Delete", "ContractPayment")',

                type: "POST",

                data: {

                    PaymentRecId: paymentRecId,

                    companyId: companyId

                },


                // ==============================
                // SUCCESS RESPONSE
                // ==============================

                success: function (response) {

                    if (response.success) {

                        Swal.fire({

                            icon: "success",

                            title: "Deleted!",

                            text:
                                response.message ||
                                "Payment deleted successfully.",

                            confirmButtonText: "OK",

                            allowOutsideClick: false

                        }).then(function () {

                            // Reload the current page
                            window.location.reload();

                        });

                    }
                    else {

                        Swal.fire({

                            icon: "error",

                            title: "Delete Failed!",

                            text:
                                response.message ||
                                "Payment could not be deleted.",

                            confirmButtonText: "OK"

                        });

                    }

                },


                // ==============================
                // AJAX ERROR
                // ==============================

                error: function () {

                    Swal.fire({

                        icon: "error",

                        title: "Error!",

                        text:
                            "Something went wrong while deleting the payment.",

                        confirmButtonText: "OK"

                    });

                }

            });

        }

    });


    return false;

}






    </script>


}
