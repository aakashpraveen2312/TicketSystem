@{ ViewBag.Title = "Contract & Warranty";
    ViewBag.PageTitle = "Contract & Warranty"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Tabs ───────────────────────────────── */
        .cw-tabs {
            display: flex;
            gap: 4px;
            border-bottom: 2px solid var(--border-color);
            padding: 0 20px;
            flex-wrap: wrap;
        }

        .cw-tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 11px 20px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            cursor: pointer;
            font-family: inherit;
            transition: color .15s, border-color .15s;
        }

            .cw-tab-btn:hover {
                color: var(--primary);
            }

            .cw-tab-btn.active {
                color: var(--primary);
                border-bottom-color: var(--primary);
                font-weight: 600;
            }

        .cw-tab-pane {
            display: none;
        }

            .cw-tab-pane.active {
                display: block;
            }

        /* ── Table area ─────────────────────────── */
        .tab-body {
            padding: 20px;
        }

        /* ── Amount cell ────────────────────────── */
        .amount-cell {
            font-weight: 700;
            color: #1D9E75;
            text-align: right;
        }

        /* ── Warranty status badge ──────────────── */
        .warranty-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .warranty-active {
            background: #E1F5EE;
            color: #085041;
        }

        .warranty-expired {
            background: #FEF2F2;
            color: #991B1B;
        }

        .warranty-soon {
            background: #FAEEDA;
            color: #633806;
        }

        /* ── Code pill ──────────────────────────── */
        .code-pill {
            display: inline-flex;
            padding: 2px 9px;
            background: #EEEDFE;
            color: #3C3489;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 600;
        }

        /* ── Inv code ───────────────────────────── */
        .inv-code {
            font-weight: 600;
            color: var(--primary);
            font-size: 12.5px;
        }

        /* ── Loading spinner ────────────────────── */
        .tab-loading {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 40px 20px;
            color: var(--text-muted);
            font-size: 13px;
        }

        .mini-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid var(--border-color);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
            flex-shrink: 0;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Empty state ────────────────────────── */
        .tab-empty {
            text-align: center;
            padding: 48px 20px;
        }

            .tab-empty i {
                font-size: 40px;
                color: var(--text-muted);
                display: block;
                margin-bottom: 8px;
            }

            .tab-empty p {
                font-size: 13px;
                font-weight: 500;
                color: var(--text-muted);
            }

        /* ── Counter badge on tab ────────────────── */
        .tab-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            border-radius: 20px;
            background: var(--primary);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-shield-check" style="color:var(--primary)"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Contract &amp; Warranty</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;
                         display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-file-earmark-text" style="font-size:14px;color:var(--primary)"></i>
            </span>
            Contract &amp; Invoice
        </h6>
    </div>

    <!-- Tabs -->
    <div class="cw-tabs">
        <button class="cw-tab-btn active" onclick="switchTab('invoice', this)">
            <i class="bi bi-receipt"></i>
            Invoice
            <span class="tab-count" id="invoiceCount">0</span>
        </button>
        <button class="cw-tab-btn " onclick="switchTab('contract', this)">
            <i class="bi bi-file-earmark-check"></i>
            Contract
            <span class="tab-count" id="contractCount">0</span>
        </button>

    </div>

    <!-- ══ INVOICE TAB ══ -->
    <div class="cw-tab-pane active" id="tab-invoice">

        <div class="tab-body">
            <div id="invoiceContent">
                <div class="tab-loading">
                    <div class="mini-spinner"></div> Loading invoices…
                </div>
            </div>
        </div>

    </div>

    <!-- ══ CONTRACT TAB ══ -->
    <div class="cw-tab-pane " id="tab-contract">

        <div class="tab-body">
            <div id="contractContent">
                <div class="tab-loading">
                    <div class="mini-spinner"></div> Loading contracts…
                </div>
            </div>
        </div>

    </div>



</div>



@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

    /* ── Tab switcher ─────────────────────────── */
    function switchTab(name, btn) {
        document.querySelectorAll('.cw-tab-pane').forEach(function (p) {
            p.classList.remove('active');
        });

        document.querySelectorAll('.cw-tab-btn').forEach(function (b) {
            b.classList.remove('active');
        });

        document.getElementById('tab-' + name).classList.add('active');
        btn.classList.add('active');
    }

    /* ── Helpers ──────────────────────────────── */
    function formatDate(ds) {
        if (!ds) return "";

        if (typeof ds === "string" && ds.indexOf("/Date(") > -1) {
            ds = parseInt(ds.replace(/[^0-9]/g, ""));
        }

        let d = new Date(ds);

        if (isNaN(d.getTime())) return "";

        return ("0" + d.getDate()).slice(-2) + "-" +
            ("0" + (d.getMonth() + 1)).slice(-2) + "-" +
            d.getFullYear();
    }

    function formatAmount(val) {
        return Number(val || 0).toLocaleString('en-IN', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function warrantyBadge(dateStr) {
        if (!dateStr) return '';

        var d = new Date(dateStr);
        var now = new Date();
        now.setHours(0, 0, 0, 0);

        var diff = Math.ceil((d - now) / (1000 * 60 * 60 * 24));

        if (diff < 0) {
            return '<span class="warranty-badge warranty-expired"><i class="bi bi-x-circle"></i> Expired</span>';
        }

        if (diff <= 90) {
            return '<span class="warranty-badge warranty-soon"><i class="bi bi-clock"></i> Expiring Soon</span>';
        }

        return '<span class="warranty-badge warranty-active"><i class="bi bi-check-circle"></i> Active</span>';
    }

    /* ── Render CONTRACT table ────────────────── */
    function renderContracts(data) {

        if (!data || data.length === 0) {

            document.getElementById('contractContent').innerHTML =
                '<div class="tab-empty">' +
                '<i class="bi bi-inbox"></i>' +
                '<p>No contracts available</p>' +
                '</div>';

            document.getElementById('contractCount').textContent = '0';
            return;
        }

        document.getElementById('contractCount').textContent = data.length;

        var rows = data.map(function (c, i) {

            return '<tr class="contract-row" data-contractid="' + c.CP_RECID + '" style="cursor:pointer;">' +
                '<td class="text-center serial-text">' + (i + 1) + '</td>' +
                '<td><span class="inv-code">' + (c.CP_CODE || '—') + '</span></td>' +
               
                '<td>' + formatDate(c.CU_WARRANTYUPTO) + '</td>' +
                '<td class="amount-cell">₹ ' + formatAmount(c.CP_CONTRACTAMOUNT) + '</td>' +
                
                '</tr>';

        }).join('');

        document.getElementById('contractContent').innerHTML =
            '<div class="table-responsive">' +
            '<table class="table align-middle mb-0">' +
            '<thead>' +
            '<tr>' +
            '<th class="text-center" style="width:55px;">S.No</th>' +
            '<th >Contract Code</th>' +
            
        '<th style="width:300px;">Warranty Upto</th>' +
        '<th class="text-end" style="width:300px;">Contract Amount</th>' +
            
            '</tr>' +
            '</thead>' +
            '<tbody>' + rows + '</tbody>' +
            '</table>' +
            '</div>';
    }

    /* ── Render INVOICE table ─────────────────── */
    function renderInvoices(data) {

        if (!data || data.length === 0) {

            document.getElementById('invoiceContent').innerHTML =
                '<div class="tab-empty">' +
                '<i class="bi bi-inbox"></i>' +
                '<p>No invoices available</p>' +
                '</div>';

            document.getElementById('invoiceCount').textContent = '0';
            return;
        }

        document.getElementById('invoiceCount').textContent = data.length;

        var rows = data.map(function (inv, i) {

            return '<tr class="invoice-row" data-invoiceid="' + inv.SIH_RECID + '" style="cursor:pointer;">' +
                '<td class="text-center serial-text">' + (i + 1) + '</td>' +
                '<td><span class="inv-code">' + (inv.SIH_INVOICENO || '—') + '</span></td>' +
                '<td>' + formatDate(inv.SIH_INVOICEDATE) + '</td>' +
                '<td class="amount-cell text-end">₹ ' + formatAmount(inv.SIH_INVOICEAMOUNT) + '</td>' +
                '</tr>';

        }).join('');

        document.getElementById('invoiceContent').innerHTML =
            '<div class="table-responsive">' +
            '<table class="table align-middle mb-0">' +
            '<thead>' +
            '<tr>' +
            '<th class="text-center" style="width:55px;">S.No</th>' +
            '<th>Invoice Number</th>' +
            '<th style="width:300px;">Invoice Date</th>' +
            '<th class="text-end" style="width:300px;">Amount</th>' +
            '</tr>' +
            '</thead>' +
            '<tbody>' + rows + '</tbody>' +
            '</table>' +
            '</div>';
    }

        /* ── Load products by contract ────────────── */
        function loadProductsByContract(contractRecId) {
            // The controller already sets Session["contractRecId"] when called.
            // Just call it to set the session, then redirect.
            $.ajax({
                url: '/Tickets/ComboBoxProductNewticket',
                type: 'GET',
                data: { contractRecId: contractRecId },
                success: function () {
                    // Session is now set — redirect to ticket page

                        window.location.href = '/Tickets/Ticket?contractRecId=' + contractRecId;  
                },
                error: function () {
                    Swal.fire('Error', 'Failed to load products', 'error');
                }
            });
        }

        /* ── Load products by invoice ─────────────── */
        function loadProductsByInvoice(invoiceRecId) {
            $.ajax({
                url: '/Tickets/ComboBoxProductNewticket',
                type: 'GET',
                data: { invoiceRecId: invoiceRecId },
                success: function () {
                    window.location.href = '/Tickets/Ticket?invoiceRecId=' + invoiceRecId;
                },
                error: function () {
                    Swal.fire('Error', 'Failed to load products from invoice', 'error');
                }
            });
        }

    /* ── Page Load ────────────────────────────── */
    $(document).ready(function () {

        /* Contract row click */
        $(document).on('click', '.contract-row', function () {

            let contractRecId = $(this).data('contractid');

            loadProductsByContract(contractRecId);

           
        });

        /* Invoice row click */
        $(document).on('click', '.invoice-row', function () {

            let invoiceRecId = $(this).data('invoiceid');

            loadProductsByInvoice(invoiceRecId);

           
        });

        /* Load Contracts */
        $.ajax({
            url: '@Url.Action("GetContractsModal","Tickets")',
            type: 'GET',
            success: function (res) {

                if (res.Status === 'Y') {
                    renderContracts(res.Data);
                }
                else {
                    renderContracts([]);
                }
            },
            error: function () {

                document.getElementById('contractContent').innerHTML =
                    '<div class="tab-empty">' +
                    '<i class="bi bi-exclamation-triangle" style="color:#E24B4A;"></i>' +
                    '<p>Failed to load contracts</p>' +
                    '</div>';
            }
        });

        /* Load Invoices */
        $.ajax({
            url: '@Url.Action("GetSalesInvoiceModal","Tickets")',
            type: 'GET',
            success: function (res) {

                if (res.Status === 'Y') {
                    renderInvoices(res.Data);
                }
                else {
                    renderInvoices([]);
                }
            },
            error: function () {

                document.getElementById('invoiceContent').innerHTML =
                    '<div class="tab-empty">' +
                    '<i class="bi bi-exclamation-triangle" style="color:#E24B4A;"></i>' +
                    '<p>Failed to load invoices</p>' +
                    '</div>';
            }
        });

    });

    </script>
}
