@model PSS_CMS.Models.Ticket

<style>
    /* ── Rating Modal ───────────────────────── */
    .rating-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 1050;
        display: none;
        align-items: center;
        justify-content: center;
    }

        .rating-overlay.show {
            display: flex;
        }

    .rating-box {
        background: #fff;
        border-radius: 16px;
        width: 100%;
        max-width: 400px;
        padding: 32px 28px 24px;
        box-shadow: 0 8px 40px rgba(0,0,0,.18);
        text-align: center;
        margin: 16px;
    }

    .rating-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 4px;
    }

    .rating-sub {
        font-size: 13px;
        color: var(--text-muted);
        margin-bottom: 24px;
    }

    .star-row {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 24px;
    }

    .star {
        font-size: 34px;
        cursor: pointer;
        color: #ddd;
        transition: color .2s, transform .15s;
        line-height: 1;
    }

        .star:hover,
        .star.selected {
            color: #ffb400;
            transform: scale(1.25);
        }
</style>

@using (Html.BeginForm("ClientResponseTicket", "Tickets", FormMethod.Post, new { id = "ticketForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
@Html.AntiForgeryToken()

                <div style="padding:0 0 8px;">

                    
                    <div class="form-grid" style="margin-bottom:20px;">

                        <!-- Status -->
                        <div class="form-group">
                            @Html.LabelFor(m => m.Combo, "Status", new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Combo,
                                     new SelectList(new List<string> { "Re-open", "Close" }),
                                     "-- Select Status --",
                                     new { @class = "form-select-input", id = "statusDropdown", required = "required" })
                        </div>

                    </div>

                    <!-- Comments -->
                    <div class="form-group" style="margin-bottom:16px;">
                        @Html.LabelFor(m => m.TC_COMMENTS, "User Comments", new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.TC_COMMENTS, new
                        {
                            @class = "form-textarea",
                            placeholder = "Please enter your comments here....",
                            rows = "6",
                            required = "required"
                        })
                    </div>

                    <!-- Attachment -->
                    <div class="form-group" style="margin-bottom:20px;">
                        <label class="form-label">Attachments</label>
                        <div class="file-upload-wrap">
                            <div class="file-upload-icon">
                                <i class="bi bi-paperclip"></i>
                            </div>
                            <div class="file-upload-text">
                                <span id="fileNameDisplay">Choose file to attach</span>
                                <small>Supported: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv, .mp4</small>
                            </div>
                            <label class="btn-browse" for="myfile">
                                <i class="bi bi-folder2-open"></i> Browse
                            </label>
                            <input type="file" id="myfile" name="myfile" class="file-input-hidden"
                                   accept=".pdf,.xlsx,.jpeg,.png,.jpg,.docx,.csv,.mp4"
                                   onchange="validateFile()" />
                        </div>
                        <small id="fileError" style="color:#E24B4A;margin-top:4px;display:none;">
                            This file format is not supported. Allowed: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv, .mp4
                        </small>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <button type="button" class="btn-cancel"
                                onclick="window.location.href='@Url.Action("Ticket_History","Tickets")'">
                            <i class="bi bi-x-lg"></i> Cancel
                        </button>
                        <button type="submit" id="submitBtn" class="btn-save">
                            <i class="bi bi-send"></i> Submit
                        </button>

                    </div>

                </div>}

<!-- ── Rating Modal ── -->
<div id="ratingModal" class="rating-overlay">
    <div class="rating-box">
        <p class="rating-title">Rate Us!</p>
        <p class="rating-sub">How was your experience with us?</p>

        <div class="star-row" id="starRating">
            <span class="star" data-value="1">★</span>
            <span class="star" data-value="2">★</span>
            <span class="star" data-value="3">★</span>
            <span class="star" data-value="4">★</span>
            <span class="star" data-value="5">★</span>
        </div>

        <div style="display:flex;justify-content:center;gap:10px;">
            <button id="submitRatingBtn" class="btn-save" style="padding:8px 24px;">
                <i class="bi bi-star-fill"></i> Submit Rating
            </button>
            <button type="button" class="btn-cancel" id="skipRatingBtn" style="padding:8px 18px;">
                Skip
            </button>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/Formatcheck.js"></script>

<script>
    // Show selected filename
    document.getElementById("myfile").addEventListener("change", function () {
        var name = this.files.length ? this.files[0].name : "Choose file to attach";
        document.getElementById("fileNameDisplay").textContent = name;
    });

    $(document).ready(function () {

        let selectedRating = 0;

        // ── Form submission ────────────────────────
        $("#ticketForm").submit(function (e) {
            e.preventDefault();

            var submitBtn = $("#submitBtn");
            submitBtn.prop("disabled", true).html('<i class="bi bi-hourglass-split"></i> Submitting...');

            Swal.fire({
                title: "Submitting your ticket...",
                text: "Please wait",
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("ClientResponseTicket","Tickets")',
                type: "POST",
                data: new FormData(this),
                processData: false,
                contentType: false,
                success: function (response) {
                    Swal.close();

                    if (response.status === "Y") {
                        var isClose = $("#statusDropdown").val() === "Close";

                        Swal.fire({
                            title: "Success!",
                            text: response.message,
                            icon: "success",
                            showCancelButton: isClose,
                            confirmButtonText: "OK",
                            cancelButtonText: "Rate Us"
                        }).then(function (result) {
                            if (result.isConfirmed) {
                                window.location.href = '@Url.Action("Ticket_History","Tickets")';
                            } else if (result.dismiss === Swal.DismissReason.cancel && isClose) {
                                showRatingModal();
                            }
                        });

                    } else {
                        Swal.fire({ title: "Error!", text: response.message, icon: "error" });
                        submitBtn.prop("disabled", false).html('<i class="bi bi-send"></i> Submit');
                    }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ title: "Error!", text: "Something went wrong. Please try again.", icon: "error" });
                    submitBtn.prop("disabled", false).html('<i class="bi bi-send"></i> Submit');
                }
            });
        });

        // ── Rating modal ───────────────────────────
        function showRatingModal() {
            $("#ratingModal").addClass("show");
        }

        $("#skipRatingBtn").click(function () {
            $("#ratingModal").removeClass("show");
            window.location.href = '@Url.Action("Ticket_History","Tickets")';
        });

        $(".star").click(function () {
            selectedRating = $(this).data("value");
            $(".star").each(function () {
                $(this).toggleClass("selected", $(this).data("value") <= selectedRating);
            });
        });

        $("#submitRatingBtn").click(function () {
            if (selectedRating === 0) {
                Swal.fire({ icon: "warning", title: "Please select a rating", timer: 1500, showConfirmButton: false });
                return;
            }

            $.post('/Tickets/SaveRating', { rating: selectedRating });
            $("#ratingModal").removeClass("show");

            Swal.fire({ icon: "success", title: "Thanks for your feedback!", confirmButtonText: "Close" })
                .then(function () {
                    window.location.href = '@Url.Action("Ticket_History","Tickets")';
                });
        });
    });
</script>
