@model IEnumerable<PSS_CMS.Models.Usergroup>

@{ ViewData["Title"] = "User Group";
                ViewBag.PageTitle = "User Group";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Title Icon ─────────────────────────────────────── */
        .title-icon {
            width: 28px;
            height: 28px;
            border-radius: var(--border-radius-md, 8px);
            background: #E6F1FB;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .title-icon i {
                font-size: 15px;
                color: #185FA5;
            }

        /* ── Role Pills ─────────────────────────────────────── */
        .role-pill {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .role-sa {
            background: #EEEDFE;
            color: #3C3489;
        }

        .role-admin {
            background: #E1F5EE;
            color: #085041;
        }

        .role-hd {
            background: #E6F1FB;
            color: #0C447C;
        }

        .role-user {
            background: #FAEEDA;
            color: #633806;
        }

        .role-def {
            background: #f5f5f5;
            color: #6b7280;
        }

        /* ── Description text ───────────────────────────────── */
        .desc-text {
            color: var(--text-muted);
            font-size: 12.5px;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-people nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>User Group</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">


        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("List", "UserGroup", FormMethod.Get, new { id = "searchForm" }))
            {
        <div class="search-box">
            <i class="bi bi-search"></i>
            <input type="text"
                   id="searchPharse"
                   name="searchPharse"
                   placeholder="Search"
                   autocomplete="off"
                   value="@Request["searchPharse"]"
                   onkeyup="autoSubmitSearch(this)" />
            @if (!string.IsNullOrEmpty(Request["searchPharse"]))
            {
        <a href="@Url.Action("List","UserGroup")" title="Clear">
            <i class="bi bi-x-circle text-muted"></i>
        </a>}
        </div>      }

        </div>
    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>
        <tr>
            <th style="width:180px;">Role</th>
            <th>Description</th>
            <th class="text-center" style="width:90px;">Sort</th>
            <th class="text-center" style="width:110px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var o in Model)
        {
            var editUrl = Url.Action("Edit", "UserGroup",
                new { Recid = o.R_RECID, Name = o.R_NAME });

            var userUrl = Url.Action("List", "UserLogin",
                new { R_CODE = o.R_CODE, Recid = o.R_RECID, Role = o.R_NAME });

            /* Determine pill class from role name */
            string roleLower = (o.R_NAME ?? "").ToLower();
            string pillClass = "role-def";
            if (roleLower.Contains("super") || roleLower.Contains("sa"))
            {
                pillClass = "role-sa";
            }
            else if (roleLower.Contains("admin"))
            {
                pillClass = "role-admin";
            }
            else if (roleLower.Contains("help") || roleLower.Contains("desk"))
            {
                pillClass = "role-hd";
            }
            else if (roleLower == "user")
            {
                pillClass = "role-user";
            }

<tr>

    <td>
        <span class="role-pill @pillClass">@o.R_NAME</span>
    </td>

    <td class="desc-text">
        @o.R_ROLEDESCRIPTION
    </td>

    <td class="text-center">
        @o.R_SORTORDER
    </td>

    <td>
        <div class="action-cell">

            <!-- Edit -->
            <a href="@editUrl"
               class="act-btn act-edit"
               title="Edit">
                <i class="bx bxs-pencil"></i>
            </a>

            <!-- Users -->
            <a href="@userUrl"
               class="act-btn"
               title="Users">
                <i class="bx bx-user" style="color:#0984e3"></i>
            </a>

        </div>
    </td>

</tr>}
    </tbody>

</table> <!-- Pagination -->
                                <div class="table-pagination">

                                    <button id="prevBtn" class="page-btn">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </button>

                                    <span id="pageInfo" class="page-info"></span>

                                    <button id="nextBtn" class="page-btn">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </button>

                                </div> }
                                            else
                                            {
                                <div class="text-center py-5">
                                    <i class="bi bi-inbox" style="font-size:40px;color:var(--text-muted)"></i>
                                    <p class="mt-2 text-muted fw-semibold">No user groups available</p>
                                </div>}

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    <div class="legend-item">
        <i class="bx bxs-pencil" style="color:#6c5ce7;font-size:16px"></i>
        <span>Edit</span>
    </div>

    <div class="legend-item">
        <i class="bx bx-user" style="color:#0984e3;font-size:16px"></i>
        <span>User</span>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Scripts/UIPagination.js"></script>
}
