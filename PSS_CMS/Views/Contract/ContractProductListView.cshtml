@model IEnumerable<PSS_CMS.Models.Contract>

@{
    ViewData["Title"] = "Contracts";
    ViewBag.PageTitle = "Contracts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <link href="~/Content/UIListView.css"
          rel="stylesheet" />
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-file-earmark-text"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Contracts</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">
            <!-- Search -->

            @using (Html.BeginForm(
                "",
                "",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("","")"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:70px;">

                            S.No

                        </th>

                        <th>
                            Code
                        </th>

                        <th>
                            From Date
                        </th>

                        <th>
                            To Date
                        </th>

                     

                        <th>
                            Approved Date
                        </th>

                        <th class="text-end">
                            Contract Amount
                        </th>

                        <th class="text-center"
                            style="width:80px;">

                            Sort

                        </th>

                        <th class="text-center"
                            style="width:180px;">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var productUrl = Url.Action(
                            "ListView",
                            "ContractProduct",
                            new
                            {
                                ContractRecid = o.CP_RECID,
                                CP_CODE = o.CP_CODE,
                                CP_STATUS = o.CP_STATUS,
                                CustomerRecid = o.CP_CTURECID
                            });

                        var viewUrl = Url.Action(
                            "ViewContractProductSA",
                            "Contract",
                            new
                            {
                                CP_RECID = o.CP_RECID,
                                ProductName = o.CP_PRODUCTNAME,
                                CT_CPRECID = o.CP_CTRECID,
                                CP_CTURECID = o.CP_CTURECID,
                                CP_USERTYPE = o.CP_USERTYPE,
                                CP_PAIDAMOUNT = o.CP_PAIDAMOUNT,
                                CP_TOTALAMOUNT = o.CP_TOTALAMOUNT,
                                CP_BALANACEAMOUNT = o.CP_BALANACEAMOUNT
                            });

                        var unlockUrl = Url.Action(
                            "UnlockContract",
                            "AccountantCustomerInvoice",
                            new
                            {
                                Recid = o.CP_RECID
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>

                                <span class="contract-code">

                                    @o.CP_CODE

                                </span>

                            </td>

                            <td>
                                @o.FORMATTEDCPFROMDATE
                            </td>

                            <td>
                                @o.FORMATTEDCPTODATE
                            </td>

                          

                            <td>
                                @o.FORMATTEDCONTRACTAPPROVEDDATE
                            </td>

                            <td class="text-end">

                                <span class="amount-cell">

                                    ₹ @String.Format("{0:N2}", o.CP_CONTRACTAMOUNT)

                                </span>

                            </td>

                            <td class="text-center">
                                @o.CP_SORT
                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- View -->

                                    <a href="@viewUrl"
                                       title="View"
                                       class="act-btn">

                                        <i class='bx bx-show'
                                           style="color:#00b894">
                                        </i>

                                    </a>

                                    <!-- Products -->

                                    <a href="@productUrl"
                                       title="Products"
                                       class="act-btn">

                                        <i class='bi bi-bag-check'
                                           style="color:#6c5ce7">
                                        </i>

                                    </a>

                                    <!-- Unlock -->

                                    @if (o.CP_STATUS == "P")
                                    {
                                        <a href="javascript:void(0);"
                                           onclick="confirmUnlock('@unlockUrl', @o.CP_RECID)"
                                           title="Unlock"
                                           class="act-btn">

                                            <i class='bx bx-lock-open'
                                               style="color:#e74c3c">
                                            </i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-file-earmark-text"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">

                    No Contracts Available

                </p>

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <i class='bx bx-show'
           style='color:#00b894;font-size:16px'>
        </i>

        <span>View</span>

    </div>

    <div class="legend-item">

        <i class='bi bi-bag-check'
           style='color:#6c5ce7;font-size:15px'>
        </i>

        <span>Products</span>

    </div>

    <div class="legend-item">

        <i class='bx bx-lock-open'
           style='color:#e74c3c;font-size:16px'>
        </i>

        <span>Unlock</span>

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <script>

        function confirmUnlock(url, recid) {

            Swal.fire({
                title: 'Unlock Contract',
                input: 'textarea',
                inputLabel: 'Enter Unlock Reason',
                inputPlaceholder: 'Type your reason here...',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#6c5ce7',
                cancelButtonColor: '#e17055',
                confirmButtonText: 'Unlock',
                cancelButtonText: 'Cancel',

                preConfirm: (reason) => {

                    if (!reason || reason.trim() === '') {

                        Swal.showValidationMessage('Reason is required!');

                    }

                    return reason;
                }

            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href =
                        url + "&reason=" + encodeURIComponent(result.value);

                }

            });

        }

    </script>

}