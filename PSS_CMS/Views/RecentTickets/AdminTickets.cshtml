@model IEnumerable<PSS_CMS.Models.Admintickets>
@using GridMvc.Html

@{ ViewData["Title"] = "Verify Tickets";
    ViewBag.PageTitle = "Verify Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Func<string, string> DecodeJavaScriptString = (input) =>
    {
        if (input == null) return string.Empty;
        return input.Replace("\\\"", "\"")
                    .Replace("\\'", "'")
                    .Replace("\\(", "(")
                    .Replace("\\)", ")")
                    .Replace("\\[", "[")
                    .Replace("\\]", "]")
                    .Replace("\\,", ",")
                    .Replace("\\.", ".")
                    .Replace("\\\\", "\\")
                    .Replace("\\n", "\n")
                    .Replace("\\r", "\r");
    };

    string lastStatus = Session["STATUS"]?.ToString(); }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Thread is a flex column of rows ── */
        .ticket-thread {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* ── Each row = 2-column grid ── */
        .ticket-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            align-items: stretch;
        }

        /* ── Card fills full height ── */
        .ticket-card {
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* ── Empty placeholder when no response ── */
        .ticket-card-empty {
            border-radius: 12px;
            border: 1.5px dashed var(--border-color);
            background: transparent;
            min-height: 80px;
        }

        /* ── Card body: fills space + scrolls if large ── */
        .ticket-card-body {
            padding: 16px;
            flex: 1;
            overflow-y: auto;
            max-height: 100px;
        }

        @@media (max-width: 640px) {
            .ticket-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    <span>Verify Ticket</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-ticket-perforated" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Ticket Thread
        </h6>
    </div>

    <!-- PDF action buttons (shown when not Closed/Resolved) -->
    @if (lastStatus != "C" && lastStatus != "R")
    {
<div class="pdf-action-row">
    <button class="btn-pdf btn-draft download-pdf">
        <i class="bi bi-file-earmark-pdf"></i> Draft PDF
    </button>
    @if ((Session["Customertype"]?.ToString() ?? "") != "Addon User")
    {
        if ((Session["Customertype"]?.ToString() ?? "") == "Contract")
        {
<button class="btn-pdf btn-contract download-contractpdf">
    <i class="bi bi-file-earmark-text"></i> Contract Service
</button> }
else
{
<button class="btn-pdf btn-warranty download-warrantypdf">
    <i class="bi bi-shield-check"></i> Warranty Service
</button>}
    }

</div>}

    <!-- Ticket thread -->
    <div style="padding:18px;">
        <div class="ticket-thread">

            @foreach (var item in Model)
            {
<div class="ticket-row">

    @* ── Ticket Raised card (always left) ── *@
    <div class="ticket-card">

        <div class="ticket-card-header raised">
            <div class="ticket-meta">
                <span class="ticket-badge badge-raised">
                    <i class="bi bi-arrow-up-circle"></i> Ticket Raised
                </span>
                <span class="ticket-by">@item.TC_USERNAME</span>
            </div>
            <span class="ticket-date">
                <i class="bi bi-clock"></i>
                @Convert.ToDateTime(item.TC_TICKETDATE).ToString("dd/MM/yyyy HH:mm")
            </span>
        </div>

        <div class="ticket-card-body">
            <p class="comments-label">User Comments</p>
            <p class="comments-text">@Html.Raw(DecodeJavaScriptString(item.TC_COMMENTS))</p>

            @* Request attachment *@
            @if (!string.IsNullOrEmpty(item.TC_REQUEST_ATTPREFIX))
            {
                string b64 = item.TC_REQUEST_ATTPREFIX;
                string ft = "bin";
                string mime = "application/octet-stream";

                if (b64.StartsWith("iVBORw0KGgo")) { ft = "png"; mime = "image/png"; }
                else if (b64.StartsWith("/9j/")) { ft = "jpg"; mime = "image/jpeg"; }
                else if (b64.StartsWith("AAAAFGZ0eXB") ||
                         b64.StartsWith("AAAAGGZ0eXBt")) { ft = "mp4"; mime = "video/mp4"; }
                else if (b64.StartsWith("JVBER")) { ft = "pdf"; mime = "application/pdf"; }
                else if (b64.StartsWith("UEsDB"))
                {
                    ft = "xlsx"; mime = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                    if (b64.Contains("word/")) { ft = "docx"; mime = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"; }
                }
                else if (b64.StartsWith("U1RB") || b64.StartsWith("R2V0")) { ft = "txt"; mime = "text/plain"; }
                else if (b64.StartsWith("Q0N2")) { ft = "csv"; mime = "text/csv"; }

                if (mime.StartsWith("image/"))
                {
<img src="data:@mime;base64,@item.TC_REQUEST_ATTPREFIX"
     alt="Ticket attachment"
     class="img-thumb" /> }
                    else
                    {
<a href="data:@mime;base64,@item.TC_REQUEST_ATTPREFIX"
   download="Attachment.@ft"
   class="dl-btn">
    <i class="bi bi-download"></i> Download Attachment
</a>}
                }
        </div>
    </div>

    @* ── Response card (right) or empty placeholder ── *@
    @if (!string.IsNullOrEmpty(item.TC_RESPONSECOMMENTS))
    {
        using (Html.BeginForm("AdminResponseTicket", "RecentTickets", FormMethod.Post, new { enctype = "multipart/form-data", @class = "no-preloader" }))
        {
@Html.AntiForgeryToken()
                        @Html.Hidden("TicketId", item.TC_ID)

                                                <div class="ticket-card">

                                                    <div class="ticket-card-header responded">
                                                        <div class="ticket-meta">
                                                            <span class="ticket-badge badge-responded">
                                                                <i class="bi bi-reply-all"></i> Response
                                                            </span>
                                                            <span class="ticket-by">@item.TC_ADMINNAME</span>
                                                        </div>
                                                        <span class="ticket-date">
                                                            <i class="bi bi-clock"></i>
                                                            @Convert.ToDateTime(item.TC_TICKETDATE).ToString("dd/MM/yyyy HH:mm")
                                                        </span>
                                                    </div>

                                                    <div class="ticket-card-body">
                                                        <p class="comments-label">Admin Comments</p>
                                                        <p class="comments-text">@item.TC_RESPONSECOMMENTS</p>

                                                        @* Response attachment *@
                                                        @if (!string.IsNullOrEmpty(item.TC_RESPONSE_ATTPREFIX))
                                                        {
                                                            string b64r = item.TC_RESPONSE_ATTPREFIX;
                                                            string ftr = "bin";
                                                            string mimer = "application/octet-stream";

                                                            if (b64r.StartsWith("iVBORw0KGgo")) { ftr = "png"; mimer = "image/png"; }
                                                            else if (b64r.StartsWith("/9j/")) { ftr = "jpg"; mimer = "image/jpeg"; }
                                                            else if (b64r.StartsWith("AAAAFGZ0eXB") ||
                                                                     b64r.StartsWith("AAAAGGZ0eXBt")) { ftr = "mp4"; mimer = "video/mp4"; }
                                                            else if (b64r.StartsWith("JVBER")) { ftr = "pdf"; mimer = "application/pdf"; }
                                                            else if (b64r.StartsWith("UEsDB"))
                                                            {
                                                                ftr = "xlsx"; mimer = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                                                                if (b64r.Contains("word/")) { ftr = "docx"; mimer = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"; }
                                                            }
                                                            else if (b64r.StartsWith("U1RB") || b64r.StartsWith("R2V0")) { ftr = "txt"; mimer = "text/plain"; }
                                                            else if (b64r.StartsWith("Q0N2")) { ftr = "csv"; mimer = "text/csv"; }

                                                            if (mimer.StartsWith("image/"))
                                                            {
                                <div>
                                    <img src="data:@mimer;base64,@item.TC_RESPONSE_ATTPREFIX"
                                         alt="Response attachment"
                                         class="img-thumb"
                                         id="respImg_@item.TC_RECID" />
                                </div>
                                                                <a href="data:@mimer;base64,@item.TC_RESPONSE_ATTPREFIX"
                                                                   download="Attachment.@ftr"
                                                                   class="dl-btn dl-btn-green" style="margin-top:8px;">
                                                                    <i class="bi bi-download"></i> Download Image
                                                                </a> }
                                                                                            else
                                                                                            {
                                                                <a href="data:@mimer;base64,@item.TC_RESPONSE_ATTPREFIX"
                                                                   download="Attachment.@ftr"
                                                                   class="dl-btn dl-btn-green">
                                                                    <i class="bi bi-download"></i> Download Attachment
                                                                </a>}
                                                                                        }
                                                    </div>

                                                </div> }
                                                                }
                                                                else
                                                                { @* Empty placeholder keeps column 2 reserved *@
                                                                                    <div class="ticket-card-empty"></div>}

</div>            }

        </div>

        @if (lastStatus == "C" || lastStatus == "R")
        {<!-- Actions -->
                <div class="mt-3 d-flex justify-content-end">
                    <a href="@Url.Action("RecentTicket", "RecentTickets")"
                       class="res-btn res-btn-cancel">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div> } @* ── Admin response form (partial) ── *@
        @if (lastStatus != "C" && lastStatus != "R")
        {
<div style="margin-top:20px;">
    @{ Html.RenderPartial("_AdminResponse", new PSS_CMS.Models.Admintickets()); }
</div>}

    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Generic PDF handler ─────────────────── */
        function handlePdf(action) {
            Swal.fire({
                title: 'Generating PDF…',
                text: 'Please wait.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });
            $.ajax({
                url: action, type: 'POST',
                success: function (r) {
                    Swal.close();
                    if (r.status === 'success') { window.open(r.url, '_blank'); }
                    else { Swal.fire({ icon: 'info', title: 'Message', text: r.message }); }
                },
                error: function () {
                    Swal.close();
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.' });
                }
            });
        }

        $(document).on('click', '.download-pdf',         function (e) { e.preventDefault(); handlePdf('@Url.Action("DraftDownloadPDF","RecentTickets")'); });
        $(document).on('click', '.download-contractpdf', function (e) { e.preventDefault(); handlePdf('@Url.Action("ContractDownloadPDF","RecentTickets")'); });
        $(document).on('click', '.download-warrantypdf', function (e) { e.preventDefault(); handlePdf('@Url.Action("WarrantyDownloadPDF","RecentTickets")'); });

        /* ── Datetime updater ───────────────────── */
        function updateDateTime() {
            var el = document.getElementById('responseDateTime');
            if (!el) return;
            var now  = new Date();
            el.innerText = now.toLocaleDateString('en-GB') + ' ' + now.toLocaleTimeString();
        }
        updateDateTime();
        setInterval(updateDateTime, 1000);

    </script>
}
