@model PSS_CMS.Models.Tickets
@using CaptchaMvc.HtmlHelpers

@{ ViewData["Title"] = "New Ticket";
    ViewBag.PageTitle = "New Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Loading screen ────────────────────────── */
        #loadingScreen {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.85);
            z-index: 9999;
            display: none;
            align-items: center;
            justify-content: center;
        }

        .loader {
            width: 40px;
            height: 40px;
            border: 4px solid #EEEDFE;
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Terms checkbox row ────────────────────── */
        .terms-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            background: var(--body-bg);
        }

            .terms-row input[type=checkbox] {
                width: 16px;
                height: 16px;
                accent-color: var(--primary);
                flex-shrink: 0;
            }

            .terms-row label {
                font-size: 12.5px;
                color: var(--text-dark);
                margin: 0;
                cursor: pointer;
            }

        .label-gray {
            color: var(--text-muted) !important;
        }

        /* ── File error ────────────────────────────── */
        #fileError {
            font-size: 11px;
            color: #E24B4A;
            margin-top: 4px;
            display: none;
        }
        /* ── Captcha size override ────────────── */
        #captchaContainer img,
        #captchaContainer canvas,
        .captcha-image img {
            width: 160px !important;
            height: 44px !important;
            border-radius: 8px;
            object-fit: cover;
        }

        #captchaContainer input[type="text"],
        .captcha-input {
            width: 160px !important;
            padding: 7px 10px !important;
            font-size: 13px !important;
            height: 36px !important;
        }

        #captchaContainer table,
        #captchaContainer tr,
        #captchaContainer td {
            width: auto !important;
            border: none !important;
            padding: 4px 0 !important;
            background: transparent !important;
        }

        #captchaContainer {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-width: 320px;
        }
    </style>
}

<!-- Loading screen -->
<div id="loadingScreen"><div class="loader"></div></div>

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-detailed nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History", "HelpDesk")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>New Ticket</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-ticket-detailed" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Raise New Ticket
        </h6>
    </div>

    @using (Html.BeginForm("Ticket", "HelpDesk", FormMethod.Post, new { id = "myForm", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
@Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.P_SERIALNUMBER, new { id = "serialNumber" })
                                @Html.HiddenFor(m => m.CustomerType, new { id = "customertype" })

                                                <div style="padding:24px 20px 8px;">

                                                    <!-- ── Section 1: Ticket Info ── -->
                                                    <p class="form-section-title">Ticket Information</p>
                                                    <div class="form-grid" style="margin-bottom:24px;">

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_Date, "Date", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_Date, new { @class = "form-input-text", id = "date", type = "datetime-local", required = "required", tabindex = "1" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.SelectedProjectType, "Product", new { @class = "form-label" })
                                                            @if (Model.TicketCombo2.TicketTypes2 != null)
                                                            {
                                            @Html.DropDownListFor(m => m.SelectedProjectType,
                                                     Model.TicketCombo2.TicketTypes2,
                                                     "Select Product",
                                                     new { @class = "form-select-input", onchange = "loadMaterials(this.value)", tabindex = "2" }) }
                                                            else
                                                            {
                                            @Html.DropDownListFor(m => m.SelectedProjectType,
                                                     Model.TicketCombo2.TicketTypes2,
                                                     "No Products available",
                                                     new { @class = "form-select-input" })}
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_SUBJECT, "Subject", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_SUBJECT, new { @class = "form-input-text", id = "sub", tabindex = "3" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_CUSTOMER, "Customer", new { @class = "form-label" })
                                                            @Html.DropDownList("SelectedCustomer",
                                                                     new List<SelectListItem> { new SelectListItem { Text = "No Product is selected", Value = "", Selected = true } },
                                                                     new { @class = "form-select-input", id = "CustomerDropdown" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_PRIORITYTYPE, "Priority Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.TC_PRIORITYTYPE,
                                                                     new SelectList(new List<string> { "Normal", "Urgent", "Critical", "Emergency" }),
                                                                     "Select Priority Type",
                                                                     new { @class = "form-select-input prioritystyle", tabindex = "4" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.SelectedTicketType, "Ticket Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.SelectedTicketType,
                                                                     Model.TicketCombo.TicketTypes,
                                                                     "Select Ticket Type",
                                                                     new { @class = "form-select-input", tabindex = "6" })
                                                        </div>

                                                    </div>

                                                    <!-- ── Section 2: Warranty Info ── -->
                                                    <p class="form-section-title">Warranty Details</p>
                                                    <div class="form-grid" style="margin-bottom:24px;">

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_WARRANTYUPTO, "Warranty Upto", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_WARRANTYUPTO, new { @class = "form-input-auto", id = "warranty", @readonly = "readonly", tabindex = "5" })
                                                        </div>

                                                        <div class="form-group" id="freeCallsContainer">
                                                            @Html.LabelFor(m => m.CU_WARRANTYFREECALLS, "Free Services", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.CU_WARRANTYFREECALLS, new { @class = "form-input-auto", id = "warrantyfreecalls", @readonly = "readonly", tabindex = "7" })
                                                        </div>

                                                    </div>

                                                    <!-- ── Section 3: Comments & Attachments ── -->
                                                    <p class="form-section-title">Comments &amp; Attachments</p>
                                                    <div style="margin-bottom:24px;">

                                                        <div class="form-group" style="margin-bottom:16px;">
                                                            @Html.LabelFor(m => m.TC_COMMENTS, "User Comments", new { @class = "form-label" })
                                                            @Html.TextAreaFor(m => m.TC_COMMENTS, new
                                                            {
                                                                @class = "form-textarea",
                                                                placeholder = "Please enter your comments here....",
                                                                rows = "6",
                                                                tabindex = "8"
                                                            })
                                                        </div>

                                                        <div class="form-group" style="margin-bottom:16px;">
                                                            <label class="form-label">Attachments</label>
                                                            <div class="file-upload-wrap">
                                                                <div class="file-upload-icon">
                                                                    <i class="bi bi-paperclip"></i>
                                                                </div>
                                                                <div class="file-upload-text">
                                                                    <span id="fileNameDisplay">Choose file to attach</span>
                                                                    <small>Supported: .pdf, .xlsx, .jpeg, .png, .jpg, .csv, .mp4</small>
                                                                </div>
                                                                <label class="btn-browse" for="myfile">
                                                                    <i class="bi bi-folder2-open"></i> Browse
                                                                </label>
                                                                <input type="file" id="myfile" name="myfile" class="file-input-hidden"
                                                                       tabindex="6"
                                                                       accept=".pdf,.xlsx,.jpeg,.png,.jpg,.csv,.mp4"
                                                                       onchange="validateFile()" />
                                                            </div>
                                                            <small id="fileError">This file format is not supported. Allowed: .pdf, .xlsx, .jpeg, .png, .jpg, .csv, .mp4</small>
                                                        </div>

                                                        <!-- Captcha -->
                                                        <div class="form-group" style="margin-bottom:16px;" id="captchaContainer">
                                                            @Html.Partial("_CaptchaPartial")
                                                        </div>

                                                        <!-- Terms -->
                                                        <div class="terms-row" style="margin-bottom:8px;">
                                                            @Html.CheckBoxFor(m => m.paidservice, new { id = "termsCheckbox" })
                                                            <label for="termsCheckbox" id="termsLabel">
                                                                I agree to proceed with this service as a paid request
                                                            </label>
                                                        </div>

                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="form-actions">
                                                        <button type="button" class="btn-cancel"
                                                                onclick="window.location.href='@Url.Action("Ticket_History","HelpDesk")'"
                                                                tabindex="10">
                                                            <i class="bi bi-x-lg"></i> Cancel
                                                        </button>
                                                        <button type="submit" class="btn-save" id="submitBtn" tabindex="9">
                                                            <i class="bi bi-send"></i> Submit
                                                        </button>

                                                    </div>

                                                </div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
        <span>Read-only Field</span>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Logoutjs.js"></script>
    <script src="~/Scripts/Formatcheck.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Loading screen -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 500);
        });
    </script>

    <!-- Set current datetime -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dt = document.getElementById("date");
            var now = new Date();
            var pad = function (n) { return String(n).padStart(2, "0"); };
            dt.value = now.getFullYear() + "-" + pad(now.getMonth() + 1) + "-" +
                pad(now.getDate()) + "T" + pad(now.getHours()) + ":" + pad(now.getMinutes());
        });
    </script>

    <!-- File name display -->
    <script>
        document.getElementById("myfile").addEventListener("change", function () {
            var name = this.files.length ? this.files[0].name : "Choose file to attach";
            document.getElementById("fileNameDisplay").textContent = name;
        });
    </script>

    <!-- Captcha refresh -->
    <script>
        function refreshCaptcha() {
            $.ajax({
                url: '@Url.Action("RefreshCaptcha","Tickets")',
                type: 'GET',
                success: function (data) {
                    $('#captchaContainer').html(data);
                    $('input[name="CaptchaInputText"]').val('');
                },
                error: function () { alert('Failed to refresh captcha'); }
            });
        }
    </script>

    <!-- Load customers by product -->
    <script>
        function loadMaterials(selectedRecId) {
            $.ajax({
                url: '@Url.Action("ComboProductTicketNew","HelpDesk")',
                type: 'GET',
                data: { Recid: selectedRecId },
                success: function (response) {
                    var $dd = $('#CustomerDropdown').empty();
                    $('#warranty').val('');
                    $('#warrantyfreecalls').val('');

                    if (response.error) {
                        $dd.append($('<option>', { value: '', text: 'Error: ' + response.error }));
                        return;
                    }

                    if (response.length > 0) {
                        $dd.append($('<option>', { value: '', text: '-- Select Customer --' }));
                        $.each(response, function (i, item) {
                            $dd.append($('<option>', {
                                value: item.Value,
                                text: item.Text,
                                'data-warranty': item.WarrantyUpto,
                                'data-warrantyfreecalls': item.WarrantyFreeCalls,
                                'data-serial': item.ProductSerial,
                                'data-type': item.Type
                            }));
                        });
                    } else {
                        $dd.append($('<option>', { value: '', text: 'No customer available' }));
                    }
                },
                error: function () {
                    $('#CustomerDropdown').empty()
                        .append($('<option>', { value: '', text: 'Error loading customers' }));
                }
            });
        }
    </script>

    <!-- Customer change → fill warranty + checkbox logic -->
    <script>
        $(document).ready(function () {

            $(document).on('change', '#CustomerDropdown', function () {
                var sel = $(this).find('option:selected');
                var isContract = sel.text().includes("Contract");
                var warrantyUpto = sel.data('warranty');
                var freeCalls = parseInt(sel.data('warrantyfreecalls')) || 0;
                var disableCheckbox = true;

                $('#serialNumber').val(sel.data('serial') || '');
                $('#customertype').val(sel.data('type') || '');

                if (warrantyUpto) {
                    var d = new Date(warrantyUpto);
                    var fmt = ("0" + d.getDate()).slice(-2) + "-" +
                        ("0" + (d.getMonth() + 1)).slice(-2) + "-" + d.getFullYear();
                    $('#warranty').val(fmt);
                    $('#warrantyfreecalls').val(freeCalls);

                    var today = new Date(); today.setHours(0, 0, 0, 0);
                    d.setHours(0, 0, 0, 0);

                    if (isContract) {
                        disableCheckbox = (d >= today && freeCalls > 0);
                    } else {
                        disableCheckbox = d >= today;
                    }
                } else {
                    $('#warranty').val('');
                    disableCheckbox = false;
                }

                $('#termsCheckbox').prop('checked', false).prop('disabled', disableCheckbox);
                $('#termsLabel').toggleClass('label-gray', disableCheckbox);
                isContract ? $('#freeCallsContainer').show() : $('#freeCallsContainer').hide();
            });

            // Submit validation
            $('#submitBtn').on('click', function (e) {
                var warrantyStr = $('#warranty').val();
                var isChecked = $('#termsCheckbox').is(':checked');
                var isContract = $('#CustomerDropdown option:selected').text().includes("Contract");
                var freeCalls = parseInt($('#warrantyfreecalls').val()) || 0;

                if (warrantyStr) {
                    var p = warrantyStr.split('-');
                    var wDate = new Date(p[2], p[1] - 1, p[0]);
                    var today = new Date(); today.setHours(0, 0, 0, 0);

                    var isPaid = isContract
                        ? (wDate < today || (wDate >= today && freeCalls === 0))
                        : wDate < today;

                    if (isPaid && !isChecked) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: isContract ? 'Paid Service' : 'Warranty Expired',
                            text: 'Please agree to proceed with this service as a paid request.'
                        });
                    }
                }
            });
        });
    </script>

    <!-- Form submit with fetch -->
    <script>
        document.getElementById("myForm").addEventListener("submit", function (event) {
            event.preventDefault();

            var form = this;
            var formData = new FormData(form);
            var submitBtn = document.getElementById("submitBtn");
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="bi bi-hourglass-split"></i> Submitting...';

            Swal.fire({
                title: "Processing...",
                html: "Please wait while we save your changes.",
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: function () { Swal.showLoading(); }
            });

            fetch(form.action, { method: form.method, body: formData })
                .then(function (response) {
                    if (!response.ok) throw new Error("Server error");
                    return response.json();
                })
                .then(function (data) {
                    if (data.status === "error") {
                        Swal.fire({
                            title: "Message",
                            text: data.Message,
                            icon: "info",
                            confirmButtonText: "OK"
                        }).then(refreshCaptcha);
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="bi bi-send"></i> Submit';
                    } else {
                        Swal.fire({
                            title: "",
                            html: '<p style="font-size:15px;"><b>Ticket raised successfully.<br/>Admin will reach you soon.</b></p>'
                                + '<div style="display:flex;justify-content:center;gap:15px;margin-top:20px;">'
                                + '<button id="confirmBtn" class="swal2-confirm swal2-styled" style="background:#6ed3d0;">Back to List</button>'
                                + '<button id="cancelBtn"  class="swal2-cancel  swal2-styled" style="background:#f0a72d;">New Ticket</button>'
                                + '</div>',
                            showConfirmButton: false,
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            didOpen: function () {
                                document.getElementById("confirmBtn").addEventListener("click", function () {
                                    window.location.href = '/HelpDesk/Ticket_History';
                                });
                                document.getElementById("cancelBtn").addEventListener("click", function () {
                                    window.location.href = '/HelpDesk/Ticket';
                                });
                            }
                        });
                    }
                })
                .catch(function () {
                    Swal.fire({ title: "Error", text: "Something went wrong. Please try again.", icon: "error" });
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-send"></i> Submit';
                });
        });
    </script>

    <!-- Back button prevention -->
    <script>
        function preventBack() { window.history.forward(); }
        setTimeout("preventBack()", 0);
    </script>
}
