@model PSS_CMS.Models.Salesheader

@{ ViewData["Title"] = "Sales Invoice Create";
    ViewBag.PageTitle = "Sales Invoice Create";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var cuCtrecid = Session["RECID"]?.ToString();
    var contractName = Session["ContractName"]?.ToString();
    var ctPrecid = Session["CT_PRECID"]?.ToString();
    var contractAmount = Session["ContractAmount"]?.ToString(); }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Custom Tabs ───────────────────────────── */
        .inv-tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid var(--border-color);
            padding: 0 20px;
            background: #fafafa;
           
        }

        .inv-tab-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 13px 18px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            margin-bottom: -2px;
            transition: color .18s, border-color .18s;
            white-space: nowrap;
            cursor: pointer;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
            font-family: inherit;
        }

            .inv-tab-link i {
                font-size: 15px;
            }

            .inv-tab-link.active {
                color: var(--primary);
                border-bottom-color: var(--primary);
            }

            .inv-tab-link:hover:not(.active) {
                color: var(--text-dark);
            }

            .inv-tab-link:disabled {
                opacity: .45;
                cursor: not-allowed;
                pointer-events: none;
            }

        /* ── Tab Panes ─────────────────────────────── */
        .tab-body {
            padding: 24px 20px 8px;
        }

        .inv-pane {
            display: none;
        }

            .inv-pane.show {
                display: block;
            }

        /* ── Contact columns ───────────────────────── */
        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
        }

        @@media (max-width: 900px) {
            .contact-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 600px) {
            .contact-grid {
                grid-template-columns: 1fr;
            }
        }

        .contact-panel {
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
        }

        .contact-panel-header {
            background: var(--primary);
            color: #fff;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .contact-panel-body {
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        /* ── Pane footer actions ───────────────────── */
        .pane-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            padding: 16px 0 4px;
            border-top: 1px solid var(--border-color);
            margin-top: 20px;
        }

        /* ── Verify badge on button ────────────────── */
        #btnVerifyCustomer.verified {
            background: #1D9E75;
        }

            #btnVerifyCustomer.verified:hover {
                background: #157a5a;
            }
    </style>
}

