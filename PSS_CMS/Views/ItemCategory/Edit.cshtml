@model PSS_CMS.Models.ItemCategory

@{
    ViewData["Title"] = "Edit Item Category";
    ViewBag.PageTitle = "Edit Item Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        .hsn-table tbody tr.hsn-row:hover td {
            background: #E1F5EE;
            cursor: pointer;
            font-weight:800;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-layers nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    @if (Session["ItemgroupName"] != null)
    {
        <a href="@Url.Action("List","Group")">Item Group (@Session["ItemgroupName"].ToString())</a>
        <i class="bi bi-chevron-right"></i>
    }
    <a href="@Url.Action("List","ItemCategory")">Item Category</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List","ItemCategory")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Edit", "ItemCategory", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
    <div class="page-card">

        <!-- Header -->
        <div class="page-card-header">
            <h6 class="page-card-title">
                <span class="title-icon">
                    <i class="bi bi-layers"></i>
                </span>
                Edit Item Category
            </h6>
        </div>

        <!-- Form body -->
        <div class="form-body">

            <p class="form-section-title">Category Information</p>

            <div class="form-grid">

                <!-- Code (readonly) -->
                <div class="form-group">
                    <label class="form-label" for="IC_CODE">
                        @Html.DisplayNameFor(m => m.IC_CODE)
                    </label>
                    @Html.TextBoxFor(m => m.IC_CODE, new
                    {
                        @class = "form-input-auto",
                        id = "IC_CODE",
                        tabindex = "1",
                        @readonly = "readonly",
                        placeholder = "Auto-Code"
                    })
                    <span class="auto-badge">
                        <i class="bi bi-lock"></i> Read-only — system generated
                    </span>
                </div>

                <!-- HSN Code with picker -->
                <div class="form-group">
                    <label class="form-label" for="hsncode">
                        @Html.DisplayNameFor(m => m.IC_HSNCODE)
                        <span class="req">*</span>
                    </label>
                    <div class="hsn-input-wrap">
                        @Html.TextBoxFor(m => m.IC_HSNCODE, new
                        {
                            @class = "form-input-text",
                            id = "hsncode",
                            tabindex = "2",
                            @readonly = "readonly",
                            placeholder = "Select from HSN list"
                        })
                        <button type="button"
                                class="btn-hsn-pick"
                                id="openModalBtn"
                                tabindex="3"
                                title="Browse HSN codes">
                            <i class="bi bi-journal-text"></i>
                        </button>
                    </div>
                </div>

                <!-- Description -->
                <div class="form-group">
                    <label class="form-label" for="hsndes">
                        @Html.DisplayNameFor(m => m.IC_DESCRIPTION)
                        <span class="req">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.IC_DESCRIPTION, new
                    {
                        @class = "form-input-text",
                        id = "hsndes",
                        tabindex = "4",
                        autocomplete = "off",
                        placeholder = "Enter description"
                    })
                    @Html.ValidationMessageFor(m => m.IC_DESCRIPTION, "", new { @class = "text-danger", style = "font-size:11px" })
                </div>

                <!-- Sort Order -->
                <div class="form-group">
                    <label class="form-label" for="IC_SORTORDER">
                        @Html.DisplayNameFor(m => m.IC_SORTORDER)
                    </label>
                    @Html.TextBoxFor(m => m.IC_SORTORDER, new
                    {
                        @class = "form-input-num",
                        id = "IC_SORTORDER",
                        tabindex = "5",
                        type = "text",
                        min = "0",
                        placeholder = "0",
                        autocomplete = "off"
                    })
                </div>

            </div>

            <div class="form-divider"></div>
            <p class="form-section-title">Settings</p>

            <div class="form-grid">

                <!-- Disable checkbox -->
                <label class="check-row" for="IsDisabled">
                    @Html.CheckBoxFor(m => m.IsDisabled,
                        new { @class = "form-check-input", id = "IsDisabled", tabindex = "6" })
                    <div class="check-row-label">
                        <span>@Html.DisplayNameFor(m => m.IsDisabled)</span>
                        <small>Hide this category from active listings</small>
                    </div>
                </label>

            </div>

        </div>

        <!-- Legend bar -->
        <div class="legend-bar">

            <div class="legend-item">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
                <span>Read-only Field</span>
            </div>

            <div class="legend-item">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
                <span>Text Field</span>
            </div>

            <div class="legend-item">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
                <span>Number Field</span>
            </div>

        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a href="@Url.Action("List","ItemCategory")"
               class="btn-cancel">
                <i class="bi bi-x-lg"></i> Cancel
            </a>
            <button type="submit"
                    class="btn-save"
                    id="savebutton"
                    tabindex="7">
                <i class="bi bi-floppy"></i> Update
            </button>
        </div>

    </div>
}

<!-- ── HSN Modal ──────────────────────────────────── -->
<div class="hsn-modal-overlay" id="hsnModal" role="dialog" aria-modal="true" aria-labelledby="hsnModalTitle">

    <div class="hsn-modal-box">

        <!-- Header -->
        <div class="hsn-modal-header">
            <div class="hsn-modal-title">
                <i class="bi bi-journal-text"></i>
                <span id="hsnModalTitle">Select HSN Code</span>
            </div>
            <button class="hsn-modal-close" id="closeHsnModal" title="Close" type="button">
                <i class="bi bi-x-lg text-dark"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="hsn-modal-body">
            <p style="font-size:12px;color:var(--text-muted);margin-bottom:12px;">
                Select the appropriate HSN code from the list below.
            </p>
            <div style="overflow-x:auto;">
                <table class="hsn-table" id="optionsTable">
                    <thead>
                        <tr>
                            <th>HSN Code</th>
                            <th>Description</th>
                            <th class="text-center">CGST (%)</th>
                            <th class="text-center">SGST (%)</th>
                            
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Populated via AJAX -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer -->
        <div class="hsn-modal-footer">
            <button type="button" class="btn-save" id="closeHsnModalFooter">
                <i class="bi bi-x-lg"></i> Close
            </button>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>

    <script>

        /* ── HSN Modal open / close ──────────────── */
        var isSelected = false;

        function openHsnModal() {
            document.getElementById("hsnModal").classList.add("show");

            $.ajax({
                url: '@Url.Action("GetApiData","ItemCategory")',
                type: "GET",
                success: function (response) {
                    var tbody = $("#optionsTable tbody").empty();

                    if (response.Data && Array.isArray(response.Data)) {
                        response.Data.forEach(function (item) {
                            tbody.append(
                                '<tr class="hsn-row" ' +
                                'data-hsnrecid="' + item.HM_RECID + '" ' +
                                'data-hsncode="' + item.HM_CODE + '" ' +
                                'data-hsndes="' + item.HM_DESCRIPTION + '" ' +
                                'data-hsncgst="' + item.HM_CGST + '" ' +
                                'data-hsnsgst="' + item.HM_SGST + '">' +
                                '<td>' + item.HM_CODE + '</td>' +
                                '<td>' + item.HM_DESCRIPTION + '</td>' +
                                '<td style="text-align:right;">' + (item.HM_CGST ? parseFloat(item.HM_CGST).toFixed(2) : "0.00") + '</td>' +
                                '<td style="text-align:right;">' + (item.HM_SGST ? parseFloat(item.HM_SGST).toFixed(2) : "0.00") + '</td>' +
                                '</tr>'
                            );
                        });
                    }
                },
                error: function () {
                    console.error("Failed to load HSN data.");
                }
            });
        }

        function closeHsnModal() {
            document.getElementById("hsnModal").classList.remove("show");
            if (!isSelected) {
                $("#optionsTable tbody").empty();
            }
            isSelected = false;
        }

        document.getElementById("openModalBtn").addEventListener("click", openHsnModal);
        document.getElementById("closeHsnModal").addEventListener("click", closeHsnModal);
        document.getElementById("closeHsnModalFooter").addEventListener("click", closeHsnModal);

        // Close on overlay click
        document.getElementById("hsnModal").addEventListener("click", function (e) {
            if (e.target === this) closeHsnModal();
        });

        /* ── HSN row select ─────────────────────── */
        $(document).on("click", ".hsn-row", function () {
            var HM_RECID = $(this).data("hsnrecid");
            var HM_CODE = $(this).data("hsncode");
            var HM_DESCRIPTION = $(this).data("hsndes");
            var HM_CGST = $(this).data("hsncgst");
            var HM_SGST = $(this).data("hsnsgst");

            $("#hsnrecid").val(HM_RECID);
            $("#hsncode").val(HM_CODE);
            $("#hsndes").val(HM_DESCRIPTION);
            $("#hsncgst").val(HM_CGST);
            $("#hsnsgst").val(HM_SGST);

            isSelected = true;
            closeHsnModal();

            Swal.fire({
                title: "HSN Selected",
                text: '"' + HM_DESCRIPTION + '" has been selected.',
                icon: "success",
                confirmButtonText: "OK"
            });
        });

        /* ── AJAX submit — processing spinner shows FIRST ── */
        $(document).ready(function () {

            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Edit","ItemCategory")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "Ok",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue"
                                            }
                                        }).then(function () {
                                            window.location.href = '@Url.Action("List","ItemCategory")';
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
            }
        });
    </script>
}