@model PSS_CMS.Models.DashboardUser

@{ ViewData["Title"] = "Dashboard";
    ViewBag.PageTitle = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        :root {
            --purple:       #6c5ce7;
            --purple-light: #eeeaff;
            --amber:        #f39c12;
            --amber-light:  #fff3dc;
            --green:        #00b894;
            --green-light:  #d8f5ed;
            --slate:        #636e72;
            --slate-light:  #f1f3f5;
            --bg:           #f4f5f9;
            --surface:      #ffffff;
            --border:       #e8eaed;
            --text:         #1a1d23;
            --text-sub:     #6b7280;
            --text-muted:   #9ca3af;
            --shadow:       0 1px 4px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
            --shadow-hover: 0 4px 20px rgba(0,0,0,.10);
            --r:            14px;
        }

        .page-card { background: var(--bg); padding: 22px; border-radius: 18px; }

        /* ── Stat grid ───────────────────────────── */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            align-items: stretch;   /* equal height */
            grid-auto-rows: auto;   /* row sizes to content, no phantom space */
        }
        @@media (max-width: 1100px) { .stat-grid { grid-template-columns: 1fr 1fr; } }
        @@media (max-width:  600px) { .stat-grid { grid-template-columns: 1fr; } }

        /* ── Card shell ──────────────────────────── */
        .stat-card {
            background: var(--surface);
            border-radius: var(--r);
            border: 1px solid var(--border);
            padding: 12px 14px 0;
            position: relative;
            cursor: pointer;
            transition: transform .25s, box-shadow .25s;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            min-height: 0;          /* prevent grid blowout */
            box-sizing: border-box;
            overflow: hidden;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }

        /* top accent stripe */
        .stat-card::before {
            content: '';
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            border-radius: var(--r) var(--r) 0 0;
        }
        .stat-total::before    { background: var(--purple); }
        .stat-open::before     { background: var(--amber);  }
        .stat-resolved::before { background: var(--green);  }
        .stat-closed::before   { background: var(--slate);  }

        /* ── Icon ────────────────────────────────── */
        .stat-icon {
            width: 34px; height: 34px; border-radius: 8px;
            position: absolute; top: 12px; right: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px; flex-shrink: 0;
        }
        .total-icon    { background: var(--purple-light); color: var(--purple); }
        .open-icon     { background: var(--amber-light);  color: var(--amber);  }
        .resolved-icon { background: var(--green-light);  color: var(--green);  }
        .closed-icon   { background: var(--slate-light);  color: var(--slate);  }

        /* ── Label ───────────────────────────────── */
        .stat-label {
            font-size: 12px; font-weight: 700; color: var(--text-sub);
            margin-top: 2px; margin-bottom: 4px;
            padding-right: 48px;
        }

        /* ── Big count ───────────────────────────── */
        .stat-count {
            font-size: 32px; font-weight: 800; line-height: 1;
            color: var(--text); padding-right: 48px;
        }

        /* ── Sub line ────────────────────────────── */
        .stat-sub {
            margin-top: 4px; font-size: 11px;
            color: var(--text-muted);
        }

        /* ── Open inline breakdown ───────────────── */
        .open-inline {
            display: flex; gap: 16px;
            margin-top: 4px;
        }
        .open-inline-item { display: flex; flex-direction: column; gap: 2px; cursor: pointer; }
        .open-inline-item small {
            font-size: 10px; font-weight: 700;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: .4px;
        }
        .open-inline-item strong { font-size: 17px; font-weight: 800; }
        .oi-current  strong { color: var(--text); }
        .oi-week     strong { color: var(--purple); }
        .oi-month    strong { color: var(--amber); }

        /* ── Sparkline canvas ────────────────────── */
        .stat-sparkline {
            display: block;
            width: calc(100% + 36px);   /* bleed to card edges */
            margin-left: -18px;
            height: 40px;
            min-height: 40px;
            max-height: 40px;
            margin-top: 8px;           /* always pinned to bottom */
            flex-shrink: 0;
        }

        /* ── Section title ───────────────────────── */
        .section-title {
            font-size: 11px; text-transform: uppercase;
            letter-spacing: 1px; font-weight: 700;
            color: var(--text-muted); margin: 24px 0 14px;
        }

        /* ── Chart panels ────────────────────────── */
        .charts-section {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
        }
        @@media (max-width: 1000px) { .charts-section { grid-template-columns: 1fr; } }

        .charts-bottom {
            margin-top: 18px;
            display: grid; grid-template-columns: 1fr 1fr; gap: 18px;
        }
        @@media (max-width: 900px) { .charts-bottom { grid-template-columns: 1fr; } }

        .chart-panel {
            background: var(--surface); border-radius: var(--r);
            border: 1px solid var(--border); overflow: hidden; box-shadow: var(--shadow);
        }
        .chart-panel-header { padding: 14px 16px; border-bottom: 1px solid var(--border); }
        .chart-panel-header span { display: block; font-size: 14px; font-weight: 700; color: var(--text); }
        .chart-panel-header small { font-size: 11px; color: var(--text-muted); }
        .chart-panel-body { padding: 16px; }

        #speedometer { width: 100% !important; max-width: 320px; height: 220px !important; margin: auto; }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-speedometer2 nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History","Tickets")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>Dashboard</span>
</div>

<!-- Main Card -->
<div class="page-card">
    <div class="d-flex justify-content-end mb-3">
        @if (Session["U_ADDONCUSTOMER"].ToString().Trim() == "Y")
        {<!-- New Ticket -->
        <a href="@Url.Action("AddonCustomerCreateTicket", "Tickets")" class="btn-add">
            <i class="bi bi-plus-lg"></i>  New Ticket
        </a> }
                        else
                        { <!-- New Ticket -->
    <a href="@Url.Action("ContractAndWarranty", "Tickets")" class="btn-add">
        <i class="bi bi-plus-lg"></i> New Ticket
    </a>}
    </div>
    
    @{ int totalTickets = (int)(Model?.TotalTickets ?? 0);
        int openTickets = (int)(Model?.OpenTickets ?? 0);
        int resolvedTickets = (int)(Model?.ResolvedTickets ?? 0);
        int closedTickets = (int)(Model?.CloseTickets ?? 0);
        int openDate = (int)(Model?.OpenDate ?? 0);
        int openLastMonth = (int)(Model?.OpenLastMonth ?? 0);
        int openLastWeek = (int)(Model?.OpenLastweek ?? 0); }

    <!-- ── Stat cards ── -->
    <div class="stat-grid">

        <!-- TOTAL -->
        <div class="stat-card stat-total"
             onclick="window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="TotalTickets"})'">
            <div class="stat-icon total-icon"><i class="bi bi-ticket-perforated-fill"></i></div>
            <div class="stat-label">Total Tickets</div>
            <div class="stat-count">@totalTickets</div>
            <div class="stat-sub">All time tickets</div>
            <canvas class="stat-sparkline" id="spark-total"></canvas>
        </div>

        <!-- OPEN -->
        <div class="stat-card stat-open"
             onclick="window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="OpenTickets"})'">
            <div class="stat-icon open-icon"><i class="bi bi-folder2-open"></i></div>
            <div class="stat-label">Open &amp; New Tickets (@openTickets)</div>
            <div class="open-inline">
                <div class="open-inline-item oi-current"
                     onclick="event.stopPropagation();window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="OpenDate"})'">
                    <small>Current</small>
                    <strong>@openDate</strong>
                </div>
                <div class="open-inline-item oi-week"
                     onclick="event.stopPropagation();window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="OpenLastweek"})'">
                    <small>&gt;1 Week</small>
                    <strong>@openLastWeek</strong>
                </div>
                <div class="open-inline-item oi-month"
                     onclick="event.stopPropagation();window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="OpenLastMonth"})'">
                    <small>&gt;1 Month</small>
                    <strong>@openLastMonth</strong>
                </div>
            </div>
            <canvas class="stat-sparkline" id="spark-open"></canvas>
        </div>

        <!-- RESOLVED -->
        <div class="stat-card stat-resolved"
             onclick="window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="ResolvedTickets"})'">
            <div class="stat-icon resolved-icon"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-label">Resolved Tickets</div>
            <div class="stat-count">@resolvedTickets</div>
            <div class="stat-sub">All time resolved</div>
            <canvas class="stat-sparkline" id="spark-resolved"></canvas>
        </div>

        <!-- CLOSED -->
        <div class="stat-card stat-closed"
             onclick="window.location.href='@Url.Action("DashboardListTotalTicketUser","UserDashboard",new{status="CloseTickets"})'">
            <div class="stat-icon closed-icon"><i class="bi bi-archive-fill"></i></div>
            <div class="stat-label">Closed Tickets</div>
            <div class="stat-count">@closedTickets</div>
            <div class="stat-sub">All time closed</div>
            <canvas class="stat-sparkline" id="spark-closed"></canvas>
        </div>

    </div>
    <div class="section-title">Ticket Trends</div>

    <!-- ── Bar Charts row ── -->
    <div class="charts-section">
        <div class="chart-panel">
            <div class="chart-panel-header">
                <span>Week to Date</span>
                <small>Last 7 days including today</small>
            </div>
            <div class="chart-panel-body">
                <canvas id="ticketBarChartWTD"></canvas>
            </div>
        </div>
        <div class="chart-panel">
            <div class="chart-panel-header">
                <span>Month to Date</span>
                <small>Last 27 days including today</small>
            </div>
            <div class="chart-panel-body">
                <canvas id="ticketBarChartMTD"></canvas>
            </div>
        </div>
        <div class="chart-panel">
            <div class="chart-panel-header">
                <span>Overall Tickets</span>
                <small>All time summary</small>
            </div>
            <div class="chart-panel-body">
                <canvas id="ticketBarChart"></canvas>
            </div>
        </div>
    </div>

    <div class="section-title">Priority & Completion</div>

    <!-- ── Bottom row ── -->
    <div class="charts-bottom">
        <div class="chart-panel">
            <div class="chart-panel-header">
                <span>Priority-wise Stacked Tickets</span>
                <small>Open · Resolved · Closed by priority</small>
            </div>
            <div class="chart-panel-body">
                <canvas id="ticketChart"></canvas>
            </div>
        </div>
        <div class="chart-panel">
            <div class="chart-panel-header">
                <span>Percentage of Closed Tickets</span>
                <small>Ticket resolution progress</small>
            </div>
            <div class="chart-panel-body" style="display:flex;align-items:center;justify-content:center;">
                <div id="speedometer"></div>
            </div>
        </div>
    </div>

</div><!-- /page-card -->

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/raphael@2.1.4/raphael-min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/justgage@1.3.0/justgage.min.js"></script>

    <script>
        /* ── Bar charts ─────────────────────────── */
        var barColors = ['#6c63ff', '#e6a817', '#1D9E75', '#6b7280'];
        var barLabels = ['Total', 'Open', 'Resolved', 'Closed'];

        function makeBar(id, data) {
            var ctx = document.getElementById(id);
            if (!ctx) return;
            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: barLabels,
                    datasets: [{
                        data: data,
                        backgroundColor: barColors,
                        borderRadius: 6,
                        borderSkipped: false
                    }]
                },
                options: {
                    plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } },
                        y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' }, beginAtZero: true }
                    }
                }
            });
        }

        makeBar('ticketBarChartWTD', [
            @(ViewBag.WeekTotalTickets    ?? 0),
            @(ViewBag.WeekOpenTickets     ?? 0),
            @(ViewBag.WeekResolvedTickets ?? 0),
            @(ViewBag.WeekCloseTickets    ?? 0)
        ]);

        makeBar('ticketBarChartMTD', [
            @(ViewBag.MonthTotalTickets    ?? 0),
            @(ViewBag.MonthOpenTickets     ?? 0),
            @(ViewBag.MonthResolvedTickets ?? 0),
            @(ViewBag.MonthCloseTickets    ?? 0)
        ]);

        document.addEventListener('DOMContentLoaded', function () {
            makeBar('ticketBarChart', [
                @(Model?.TotalTickets    ?? 0),
                @(Model?.OpenTickets     ?? 0),
                @(Model?.ResolvedTickets ?? 0),
                @(Model?.CloseTickets    ?? 0)
            ]);
        });
    </script>

    <script>
        /* ── Priority stacked chart ─────────────── */
        (function () {
            var labels   = @Html.Raw(ViewBag.Labels1         ?? "[]");
            var open     = @Html.Raw(ViewBag.OpenTickets1     ?? "[]");
            var resolved = @Html.Raw(ViewBag.ResolvedTickets1 ?? "[]");
            var closed   = @Html.Raw(ViewBag.ClosedTickets1   ?? "[]");

            new Chart(document.getElementById('ticketChart'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Open',     data: open,     backgroundColor: '#e6a817', borderRadius: 4 },
                        { label: 'Resolved', data: resolved, backgroundColor: '#1D9E75', borderRadius: 4 },
                        { label: 'Closed',   data: closed,   backgroundColor: '#6b7280', borderRadius: 4 }
                    ]
                },
                options: {
                    scales: {
                        x: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' } },
                        y: { stacked: true, grid: { color: '#f1f5f9' }, ticks: { font: { size: 11 }, color: '#6b7280' }, beginAtZero: true }
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: { size: 11 }, color: '#6b7280', boxWidth: 12, padding: 16 }
                        }
                    }
                }
            });
        })();
    </script>

    <script>
        /* ── Speedometer ────────────────────────── */
        (function () {
            var closedPct = Math.round(@((ViewBag.ClosedPercentage ?? 0)));
            var totalTix  = @((ViewBag.TotalTickets  ?? 0));
            var closedTix = @((ViewBag.ClosedTickets ?? 0));

            if (isNaN(closedPct) || closedPct < 0 || closedPct > 100) closedPct = 0;

            new JustGage({
                id: "speedometer",
                value: closedPct,
                min: 0,
                max: 100,
                title: "Ticket Progress",
                label: `${closedPct}% Closed\n(${closedTix}/${totalTix})`,
                labelFontColor: "#1a1d23",
                gaugeWidthScale: 0.1,
                pointer: true,
                pointerOptions: { length: 0.6, strokeWidth: 0.04 },
                customSectors: [
                    { color: "#e74c3c", lo: 0,  hi: 30  },
                    { color: "#e6a817", lo: 31, hi: 70  },
                    { color: "#1D9E75", lo: 71, hi: 100 }
                ],
                levelColors: ["#e74c3c", "#e6a817", "#1D9E75"],
                hideValue: true
            });
        })();

    </script>


    <script>
        /* ── Sparklines on stat cards ───────────── */
        function drawSparkline(id, points, color) {
            var canvas = document.getElementById(id);
            if (!canvas) return;
            var ctx = canvas.getContext('2d');
            var W = canvas.offsetWidth  || canvas.parentElement.offsetWidth;
            var H = canvas.offsetHeight || 54;
            canvas.width  = W;
            canvas.height = H;

            if (!points || points.length < 2) {
                // flat line when no real data
                points = [0, 0, 0, 0, 0, 0, 0];
            }

            var min = Math.min.apply(null, points);
            var max = Math.max.apply(null, points);
            var range = max - min || 1;
            var pad = 6;
            var step = (W - pad * 2) / (points.length - 1);

            var grad = ctx.createLinearGradient(0, 0, 0, H);
            grad.addColorStop(0, color + '33');
            grad.addColorStop(1, color + '00');

            // fill
            ctx.beginPath();
            ctx.moveTo(pad, H);
            points.forEach(function(v, i) {
                var x = pad + i * step;
                var y = pad + (1 - (v - min) / range) * (H - pad * 2);
                if (i === 0) ctx.lineTo(x, y); else ctx.lineTo(x, y);
            });
            ctx.lineTo(pad + (points.length - 1) * step, H);
            ctx.closePath();
            ctx.fillStyle = grad;
            ctx.fill();

            // line
            ctx.beginPath();
            points.forEach(function(v, i) {
                var x = pad + i * step;
                var y = pad + (1 - (v - min) / range) * (H - pad * 2);
                if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
            });
            ctx.strokeStyle = color;
            ctx.lineWidth   = 2;
            ctx.lineJoin    = 'round';
            ctx.lineCap     = 'round';
            ctx.stroke();
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Use week-to-date data as sparkline points (Total, Open, Resolved, Closed trend)
            var wTotal    = @(ViewBag.WeekTotalTickets    ?? 0);
            var wOpen     = @(ViewBag.WeekOpenTickets     ?? 0);
            var wResolved = @(ViewBag.WeekResolvedTickets ?? 0);
            var wClosed   = @(ViewBag.WeekCloseTickets    ?? 0);
            var mTotal    = @(ViewBag.MonthTotalTickets    ?? 0);
            var mOpen     = @(ViewBag.MonthOpenTickets     ?? 0);
            var mResolved = @(ViewBag.MonthResolvedTickets ?? 0);
            var mClosed   = @(ViewBag.MonthCloseTickets    ?? 0);
            var allTotal    = @(Model?.TotalTickets    ?? 0);
            var allOpen     = @(Model?.OpenTickets     ?? 0);
            var allResolved = @(Model?.ResolvedTickets ?? 0);
            var allClosed   = @(Model?.CloseTickets    ?? 0);

            drawSparkline('spark-total',    [wTotal,    mTotal,    allTotal],    '#6c5ce7');
            drawSparkline('spark-open',     [wOpen,     mOpen,     allOpen],     '#f39c12');
            drawSparkline('spark-resolved', [wResolved, mResolved, allResolved], '#00b894');
            drawSparkline('spark-closed',   [wClosed,   mClosed,   allClosed],   '#636e72');
        });
    </script>

    @if (!string.IsNullOrEmpty(Convert.ToString(TempData["SuccessMessage"])))
    {
<script>
            Swal.fire({
                icon: 'info',
                text: '@Html.Raw(HttpUtility.JavaScriptStringEncode(TempData["SuccessMessage"].ToString()))',
                showConfirmButton: true,
                confirmButtonText: 'Continue'
            });
</script>}
}
