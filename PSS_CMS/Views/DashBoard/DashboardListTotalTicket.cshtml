@model IEnumerable<PSS_CMS.Models.DashBoardList>
@{ ViewData["Title"] = "Contracts";
    ViewBag.PageTitle = "Contracts";
    Layout = "~/Views/Shared/_Layout.cshtml"; }
<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script> @*Bootstrap Icons and Boxicons and Fontawesome link*@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css' rel='stylesheet'>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="~/Scripts/Script.js"></script>

</head>

<body>

    <div class="content" style="overflow-x:hidden!important;">

        <div class="page-breadcrumb" style="margin-top:14px">
            <a href="@Url.Action("Dashboard", "Dashboard")">@Session["Name"].ToString().ToUpper()</a>
            <i class="bi bi-chevron-right"></i>
            <span>LIST</span>
        </div>

        <div class="page-card mt-2" id="ticketTable1">
            <div class="page-card-header">
                <h3 class="page-card-title"><i class="bi bi-ticket-detailed"></i> Tickets</h3>

                @using (Html.BeginForm("DashboardListTotalTicket", "Dashboard", FormMethod.Get, new { id = "searchForm" }))
                {
    <input type="hidden" name="status" value="@Session["Name"]" />
                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="text" id="searchPharse" name="searchPharse" placeholder="Search" autocomplete="off" value="@Request["searchPharse"]" onchange="document.getElementById('searchForm').submit();" />
                    </div>}
            </div>

            <div class="grid-wrap">
                @if (Model != null && Model.Any())
                {
    <table>
        <thead>
            <tr>
                <th>User Name</th>
                <th>Date &amp; Time</th>
                <th>Product</th>
                <th>Comments</th>
                <th>Priority</th>
                <th>Ticket Type</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
<tr>
    <td>@item.TC_USERNAME</td>
    <td>@item.TC_TICKETDATES</td>
    <td>@item.P_NAME</td>
    <td>@item.TC_COMMENTS</td>
    <td>@item.TC_PRIORITYTYPE</td>
    <td>@item.TC_TICKETTYPE</td>
    <td>
        @{ var statusText = item.TC_STATUS_DISPLAY?.ToString() ?? "";
            var statusClass = "status-pending";
            if (statusText.IndexOf("process", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                statusClass = "status-processed";
            }
            else if (statusText.IndexOf("unlock", StringComparison.OrdinalIgnoreCase) >= 0)
            {
                statusClass = "status-unlocked";
            } }
        <span class="status-badge @statusClass">@statusText</span>
    </td>
</tr>}
        </tbody>
    </table> }
else
{
<div class="alert alert-warning text-center m-3">
    <b>No Ticket's are available</b>
</div>}
            </div>
        </div>

        <div class="legend-bar">
            <div class="legend-item"><span class="status-badge status-processed">Processed</span></div>
            <div class="legend-item"><span class="status-badge status-unlocked">Unlocked</span></div>
            <div class="legend-item"><span class="status-badge status-pending">Pending</span></div>
        </div>
    </div>

    <div class="offcanvas offcanvas-bottom" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel" style="height: 150px;">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title text-align-center" id="offcanvasBottomLabel"></h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column justify-content-center align-items-center">
            <h4>Are you sure you want to log out?</h4>
        </div>
        <div class="offcanvas-footer d-flex justify-content-center">
            <input type="button" class="btncolorsubmit me-3" id="confirmLogoutBtn" value="Confirm" tabindex="1">
            <input type="button" class="btncolorcancel" data-bs-dismiss="offcanvas" value="Cancel" tabindex="2">
        </div>
    </div>
    <div id="preloader2"></div>
    <!-- LogOut JS -->
    <script src="~/Scripts/Logoutjs.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById("logoutLink")?.addEventListener("click", function () {
            Swal.fire({
                title: "Are you sure you want to log out?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Confirm",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#28a745",
                cancelButtonColor: "#dc3545",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Logout", "Login")';
                }
            });
        });
    </script>

    <script src="~/Scripts/Fordelete.js"></script>
</body>
</html>
