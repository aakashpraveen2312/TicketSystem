@model IEnumerable<PSS_CMS.Models.Contract>

@{ ViewData["Title"] = "Contracts";
                ViewBag.PageTitle = "Contracts";
                Layout = "~/Views/Shared/_Layout.cshtml";

                var customerName = Session["CT_CUSTOMERNAME"] != null
                    ? Session["CT_CUSTOMERNAME"].ToString()
                    : ""; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-file-earmark-text nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Party</span>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("ContractList", "Contract")">
        @customerName
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Contracts</span>

</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm("ContractProductList",
                "Contract",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
<div class="search-box">

    <i class="bi bi-search"></i>

    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />

    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("ContractProductList", "Contract")"
   title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}

</div>            }

            <a href="@Url.Action("CreateContractProduct", "Contract")"
               class="btn-add">

                <i class="bi bi-plus-lg"></i>

                Add Contract

            </a>

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>

        <tr>

            <th class="text-center"
                style="width:60px;">
                S.No
            </th>

            <th>
                Code
            </th>

            <th class="text-center">
                From Date
            </th>

            <th class="text-center">
                To Date
            </th>

            <th>
                Created By
            </th>

            <th class="text-center">
                Approved Date
            </th>

            <th class="text-right"
                style="text-align:right;">
                Amount
            </th>

            <th class="text-center"
                style="width:60px;">
                Sort
            </th>

            <th class="text-center"
                style="width:160px;">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var o in Model)
        {
            var isProcessed = o.CP_STATUS == "P";

            var editUrl = Url.Action("EditContractProduct", "Contract", new
            {
                CP_RECID = o.CP_RECID,
                ProductName = o.CP_PRODUCTNAME,
                CT_CPRECID = o.CP_CTRECID,
                CP_CTURECID = o.CP_CTURECID,
                CP_USERTYPE = o.CP_USERTYPE,
                CP_PAIDAMOUNT = o.CP_PAIDAMOUNT,
                CP_TOTALAMOUNT = o.CP_TOTALAMOUNT,
                CP_BALANACEAMOUNT = o.CP_BALANACEAMOUNT
            });

            var viewUrl = Url.Action("ViewContractProduct", "Contract", new
            {
                CP_RECID = o.CP_RECID,
                ProductName = o.CP_PRODUCTNAME,
                CT_CPRECID = o.CP_CTRECID,
                CP_CTURECID = o.CP_CTURECID,
                CP_USERTYPE = o.CP_USERTYPE,
                CP_PAIDAMOUNT = o.CP_PAIDAMOUNT,
                CP_TOTALAMOUNT = o.CP_TOTALAMOUNT,
                CP_BALANACEAMOUNT = o.CP_BALANACEAMOUNT
            });

            var deleteUrl = Url.Action("DeleteContractProduct", "Contract", new
            {
                CP_RECID = o.CP_RECID,
                CP_PRECID = o.CP_PRECID,
                CP_CTURECID = o.CP_CTURECID,
                CP_ADMINRECID = o.CP_ADMINRECID
            });

            var processUrl = Url.Action("ContractProcessStatus", "Contract", new { Recid = o.CP_RECID });
            var productsUrl = Url.Action("List", "ContractProduct", new { ContractRecid = o.CP_RECID, CP_CODE = o.CP_CODE, CP_STATUS = o.CP_STATUS });
            var UserUrl = Url.Action("ContractUserList", "Contract", new { userid = o.CP_RECID});
            var pdfUrl = Url.Action("ContractInvoice", "Contract", new { CP_CTURECID = o.CP_CTURECID, CP_CRECID = o.CP_CRECID });

<tr>

    <td class="text-center">
        <span class="serial-text">@o.SerialNumber</span>
    </td>

    <td>
        <span class="contract-code">@o.CP_CODE</span>
    </td>

    <td class="text-center">
        <span class="date-cell">@o.FORMATTEDCPFROMDATE</span>
    </td>

    <td class="text-center">
        <span class="date-cell">@o.FORMATTEDCPTODATE</span>
    </td>

    <td>@o.CP_CONTRACTCREATEDBY</td>

    <td class="text-center">
        <span class="date-cell">@o.FORMATTEDCONTRACTAPPROVEDDATE</span>
    </td>

    <td class="amount-cell">
        @String.Format("{0:N2}", o.CP_CONTRACTAMOUNT)
    </td>

    <td class="text-center">@o.CP_SORT</td>

    <td>

        <div class="action-cell">

            @if (isProcessed)
            {<!-- View -->
                <a href="@viewUrl"
                   title="View"
                   class="act-btn act-view">
                    <i class='bx bx-show'></i>
                </a> }
            else
            { <!-- Edit -->
                <a href="@editUrl"
                   title="Edit"
                   class="act-btn act-edit">
                    <i class='bx bxs-pencil'></i>
                </a> <!-- Process -->
                <a href="javascript:void(0);"
                   onclick="confirmProcess('@processUrl')"
                   title="Process"
                   class="act-btn no-loader"
                   style="color:#00b894;">
                    <i class='bx bx-check-circle'></i>
                </a> <!-- Delete -->
                <a href="@deleteUrl"
                   data-id="@o.CP_RECID"
                   data-name="@o.CP_CODE"
                   title="Delete"
                   class="act-btn act-delete no-loader"
                   onclick="return confirmDelete(this);">
                    <i class='bx bxs-trash'></i>
                </a>}

            <!-- Products -->
            <a href="@productsUrl"
               title="Products"
               class="act-btn"
               style="color:#6c5ce7;">
                <i class='bi bi-bag-check'></i>
            </a>

            <!-- User -->
            <a href="@UserUrl"
               title="User"
               class="act-btn"
               style="color:#6c5ce7;">
                <i class="bi bi-person-circle"></i>
            </a>



            <!-- Download PDF -->
            <a href="javascript:void(0);"
               onclick="downloadPdfAjax('@pdfUrl')"
               title="Download PDF"
               class="act-btn no-loader"
               style="color:#e74c3c;">
                <i class='bi bi-file-earmark-pdf'></i>
            </a>

        </div>

    </td>

</tr>}

    </tbody>

</table> <!-- Pagination -->
                                <div class="table-pagination">

                                    <button id="prevBtn"
                                            class="page-btn">
                                        <i class="bi bi-chevron-left"></i>
                                        Previous
                                    </button>

                                    <span id="pageInfo"
                                          class="page-info">
                                    </span>

                                    <button id="nextBtn"
                                            class="page-btn">
                                        Next
                                        <i class="bi bi-chevron-right"></i>
                                    </button>

                                </div> }
                                            else
                                            {
                                <div class="text-center py-5">

                                    <i class="bi bi-file-earmark-text"
                                       style="font-size:40px;color:var(--text-muted)"></i>

                                    <p class="mt-2 text-muted fw-semibold">
                                        No contracts available
                                    </p>

                                   

                                </div>}

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    <div class="legend-item">
        <span class="act-btn act-edit"
              style="width:22px;height:22px;font-size:13px">
            <i class='bx bxs-pencil'></i>
        </span>
        Edit
    </div>

    <div class="legend-item">
        <span class="act-btn act-view"
              style="width:22px;height:22px;font-size:13px">
            <i class='bx bx-show'></i>
        </span>
        View
    </div>

    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#00b894;">
            <i class='bx bx-check-circle'></i>
        </span>
        Process
    </div>

    <div class="legend-item">
        <span class="act-btn act-delete"
              style="width:22px;height:22px;font-size:13px">
            <i class='bx bxs-trash'></i>
        </span>
        Delete
    </div>

    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#6c5ce7;">
            <i class='bi bi-bag-check'></i>
        </span>
        Products
    </div>

    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#6c5ce7;">
            <i class='bi bi-person-circle'></i>
        </span>
        User
    </div>


    <div class="legend-item">
        <span class="act-btn"
              style="width:22px;height:22px;font-size:13px;color:#e74c3c;">
            <i class='bi bi-file-earmark-pdf'></i>
        </span>
        Download PDF
    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

    <script src="~/Scripts/Logoutjs.js"></script>

    <script>
        function confirmProcess(url) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you want to process this contract?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Process it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }

        function downloadPdfAjax(url) {
            Swal.fire({
                title: 'Processing...',
                text: 'Your PDF is being prepared.',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: url,
                type: 'POST',
                xhrFields: { responseType: 'blob' },
                success: function (data, status, xhr) {
                    Swal.close();

                    var blob = new Blob([data], { type: 'application/pdf' });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);

                    var disposition = xhr.getResponseHeader('Content-Disposition');
                    var fileName = "Invoice.pdf";
                    if (disposition && disposition.indexOf('filename=') !== -1) {
                        fileName = disposition.split('filename=')[1].replace(/"/g, '');
                    }

                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Failed to download PDF.'
                    });
                }
            });
        }
    </script>

}
