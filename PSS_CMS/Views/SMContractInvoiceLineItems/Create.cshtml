
@model PSS_CMS.Models.ContractInvoiceLineItems

@{ ViewData["Title"] = "Create Invoice";
    ViewBag.PageTitle = "Create Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <link href="~/Content/SweetalertCSS.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-receipt nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "SMContractInvoiceHeader",new { companyId=  Session["companyId"],CIH_CONTRACTRECID = Session["CIH_CONTRACTRECID"] })">Contract Invoice </a>
    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "SMContractInvoiceLineItems",new { companyId = Session["CompanyID"] ,CIL_CIHRECID = Session["CIL_CIHRECID"],Status =  Session["Status"]})">Contract Invoice </a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

@using (Html.BeginForm("Create", "SMContractInvoiceLineItems", FormMethod.Post, new { id = "createform", @class = "no-preloader" }))
{
    @Html.AntiForgeryToken()

    <div class="page-card">

        <!-- Header -->
        <div class="page-card-header">
            <h6 class="page-card-title">
                <span class="title-icon">
                    <i class="bi bi-plus-circle"></i>
                </span>
                Create Invoice
            </h6>
        </div>

        <!-- Form Body -->
        <div class="form-body">


            <div class="form-divider"></div>

            <!-- Line Item -->
            <p class="form-section-title">Line Item Details</p>

            <div class="form-grid">

                <!-- Description -->
                <div class="form-group full">
                    <label class="form-label">
                        @Html.DisplayNameFor(m => m.CIL_DESCRIPTION)
                        <span class="req">*</span>
                    </label>

                    @Html.TextAreaFor(m => m.CIL_DESCRIPTION, new
                    {
                        @class = "form-textarea",
                        placeholder = "Enter line item description",
                        rows = 4
                    })

                </div>

                <!-- Price -->
                <div class="form-group">
                    <label class="form-label">
                        @Html.DisplayNameFor(m => m.CIL_PRICE)
                        <span class="req">*</span>
                    </label>

                    @Html.TextBoxFor(m => m.CIL_PRICE, new
                    {
                        @class = "form-input-num",
                        type = "number",
                        step = "0.01",
                        min = "0",
                        placeholder = "0.00"
                    })

                </div>

            </div>

        </div>

        <!-- Legend -->
        <div class="legend-bar">

            <div class="legend-item">
                <span class="field-dot dot-text"></span>
                <span>Text Field</span>
            </div>

            <div class="legend-item">
                <span class="field-dot dot-num"></span>
                <span>Number Field</span>
            </div>

        </div>

        <!-- Actions -->
        <div class="form-actions">
            <a href="@Url.Action("List", "SMContractInvoiceLineItems",new { companyId = Session["CompanyID"] ,CIL_CIHRECID = Session["CIL_CIHRECID"],Status =  Session["Status"]})" class="btn-cancel">
                <i class="bi bi-x-lg"></i> Cancel
            </a>
            <button type="submit" class="btn-save" id="savebutton">
                <i class="bi bi-floppy"></i> Save
            </button>
        </div>

    </div>}

<!-- Toast Container -->
<div class="toast-container position-fixed top-0 end-0 p-3">

    <!-- Success Toast -->
    <div id="successToast"
         class="toast align-items-center text-bg-success border-0"
         role="alert">

        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i>
                <span id="successToastMessage"></span>
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>
        </div>

    </div>

    <!-- Error Toast -->
    <div id="errorToast"
         class="toast align-items-center text-bg-danger border-0"
         role="alert">

        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-x-circle-fill me-2"></i>
                <span id="errorToastMessage"></span>
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>
        </div>

    </div>

</div>
@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

            $("#createform").submit(function (e) {

                e.preventDefault();

                var form = $(this);

                $("#savebutton")
                    .prop("disabled", true)
                    .html('<i class="bi bi-hourglass-split"></i> Saving...');


                $.ajax({

                    url: form.attr("action"),

                    type: "POST",

                    data: form.serialize(),

                    success: function (response) {

                        if (response.success) {

                            Swal.fire({

                                icon: 'success',

                                title: 'Success!',

                                text: response.message || 'Inserted Successfully',

                                showCancelButton: true,

                                confirmButtonText:
                                    '<i class="bi bi-plus-circle"></i> Continue',

                                cancelButtonText:
                                    '<i class="bi bi-arrow-left"></i> Back to List',

                                reverseButtons: false,

                                allowOutsideClick: false,

                                allowEscapeKey: false,

                                customClass: {

                                    popup: 'success-popup',

                                    confirmButton: 'continue-btn',

                                    cancelButton: 'back-btn'

                                }

                            }).then((result) => {

                                if (result.isConfirmed) {

                                    // CONTINUE
                                    // Clear the form

                                    $("#createform")[0].reset();

                                    $("#savebutton")
                                        .prop("disabled", false)
                                        .html('<i class="bi bi-floppy"></i> Save');

                                }
                                @*else {

                                    // BACK TO LIST
                                    window.location.href =
                                        '@Url.Action("List", "SMContractInvoiceLineItems")'
                                        + '?CIL_CIHRECID=@Session["CIH_RECID"]'
                                        + '&Status=@Session["Status"]';
                                }*@
                                else {
                                    // BACK TO LIST
                                    window.location.href =
                                        '@Url.Action("List", "SMContractInvoiceLineItems")'
                                        + '?CIL_CIHRECID=' + response.cihRecId
                                        + '&Status=' + response.Status;
}
                            });

                        }
                        else {

                            Swal.fire({

                                icon: 'error',

                                title: 'Error!',

                                text: response.message ||
                                    'Something went wrong.',

                                confirmButtonText: 'OK'

                            });

                            $("#savebutton")
                                .prop("disabled", false)
                                .html('<i class="bi bi-floppy"></i> Save');

                        }

                    },

                    error: function () {

                        Swal.fire({

                            icon: 'error',

                            title: 'Error!',

                            text: 'Something went wrong. Please try again.',

                            confirmButtonText: 'OK'

                        });

                        $("#savebutton")
                            .prop("disabled", false)
                            .html('<i class="bi bi-floppy"></i> Save');

                    }

                });

            });

        });

    </script>

}
