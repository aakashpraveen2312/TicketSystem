@model IEnumerable<PSS_CMS.Models.ItemGroup>

@{
    ViewData["Title"] = "Item Group";
    ViewBag.PageTitle = "Item Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <!-- List View CSS -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-cart3"></i>

    <i class="bi bi-chevron-right"></i>

    <span>Item Group</span>

    <i class="bi bi-chevron-right"></i>

    <span>List</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

       

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->

            @using (Html.BeginForm(
                "List",
                "ItemGroup",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("List","ItemGroup")"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:70px;">
                            S.No
                        </th>

                        <th style="width:180px;">
                            Code
                        </th>

                        <th>
                            Description
                        </th>

                        <th class="text-center"
                            style="width:90px;">
                            Sort
                        </th>

                        <th class="text-center"
                            style="width:140px;">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var itemCategoryUrl = Url.Action(
                            "List",
                            "ItemCategory",
                            new
                            {
                                IGRECID = o.IG_RECID,
                                companyId = o.IG_CRECID,
                                Itemgroupname = o.IG_DESCRIPTION.ToUpper()
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>
                                @o.IG_CODE
                            </td>

                            <td>
                                @o.IG_DESCRIPTION
                            </td>

                            <td class="text-center">
                                @o.IG_SORTORDER
                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- Item Category -->

                                    <a href="@itemCategoryUrl"
                                       title="Item Category"
                                       class="act-btn">

                                        <i class='bx bx-collection'
                                           style="color:#0984e3"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-inbox"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">
                    No Item Groups available
                </p>

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <i class='bx bx-collection'
           style='color:#0984e3;font-size:16px'></i>

        <span>Item Category</span>

    </div>

</div>

@section Scripts {

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}