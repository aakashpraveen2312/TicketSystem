@model PSS_CMS.Models.ProductMaster

@{ ViewData["Title"] = "Edit Product";
                ViewBag.PageTitle = "Edit Product";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-shield-check nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List","ProductMaster")">Warranty Products</a>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List","ProductMaster")">List</a>
    <i class="bi bi-chevron-right"></i>
    @if (Session["ProductName"] != null)
    {
<a href="@Url.Action("List","ProductMaster")">@Session["ProductName"].ToString()</a>
                <i class="bi bi-chevron-right"></i>}
    <span>Edit</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Edit", "ProductMaster", FormMethod.Post,
    new { id = "editform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-shield-check"></i>
            </span>
            Edit Warranty Product
        </h6>
    </div>

    <!-- Form body -->
    <div class="form-body">

        <p class="form-section-title">Product Information</p>

        <div class="form-grid">

            <!-- Code -->
            <div class="form-group">
                <label class="form-label" for="P_CODE">
                    @Html.DisplayNameFor(m => m.P_CODE)
                    <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.P_CODE, new
                {
                    @class = "form-input-text",
                    autocomplete = "off",
                    placeholder = "e.g. WP-001"
                })
                @Html.ValidationMessageFor(m => m.P_CODE, "", new { @class = "text-danger", style = "font-size:11px" })
            </div>

            <!-- Name -->
            <div class="form-group">
                <label class="form-label" for="P_NAME">
                    @Html.DisplayNameFor(m => m.P_NAME)
                    <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.P_NAME, new
                {
                    @class = "form-input-text",
                    autocomplete = "off",
                    placeholder = "e.g. Air Conditioner Unit"
                })
                @Html.ValidationMessageFor(m => m.P_NAME, "", new { @class = "text-danger", style = "font-size:11px" })
            </div>

            <!-- Duration -->
            <div class="form-group">
                <label class="form-label" for="P_DURATION">
                    @Html.DisplayNameFor(m => m.P_DURATION)
                    <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.P_DURATION, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    placeholder = "e.g. 24",
                    type = "number",
                    min = "0"
                })
                @Html.ValidationMessageFor(m => m.P_DURATION, "", new { @class = "text-danger", style = "font-size:11px" })
            </div>

            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label" for="P_SORTORDER">
                    @Html.DisplayNameFor(m => m.P_SORTORDER)
                </label>
                @Html.TextBoxFor(m => m.P_SORTORDER, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    placeholder = "0",
                    type = "number",
                    min = "0"
                })
            </div>

        </div>

        <div class="form-divider"></div>
        <p class="form-section-title">Settings</p>

        <div class="form-grid">

            <!-- Comprehensive Warranty checkbox -->
            <label class="check-row" for="P_Comprehensivewarranty">
                @Html.CheckBoxFor(m => m.P_Comprehensivewarranty,
                         new { @class = "form-check-input", id = "P_Comprehensivewarranty" })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.P_Comprehensivewarranty)</span>
                    <small>Enable full coverage warranty</small>
                </div>
            </label>

            <!-- Disable Product checkbox -->
            <label class="check-row" for="P_ProductDisable">
                @Html.CheckBoxFor(m => m.P_ProductDisable,
                         new { @class = "form-check-input", id = "P_ProductDisable" })
                <div class="check-row-label">
                    <span>@Html.DisplayNameFor(m => m.P_ProductDisable)</span>
                    <small>Hide product from active listings</small>
                </div>
            </label>

        </div>

    </div>

    <!-- Legend bar — matches list view style -->
    <div class="legend-bar">

        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text Field</span>
        </div>

        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>


    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("List","ProductMaster", new { CompanyRecID = Session["CompanyID"] })"
           class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit"
                class="btn-save"
                id="savebutton">
            <i class="bi bi-floppy"></i> Update
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {

            /* ── AJAX form submit with processing popup first ── */
            $("#editform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                // ① Show Processing FIRST — fire AJAX inside didOpen
                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Edit","ProductMaster")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    // ② Small delay so spinner is visible, then show success
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            confirmButtonText: "Ok",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue"
                                            }
                                        }).then(function (result) {
                                            window.location.href = '@Url.Action("List","ProductMaster", new { CompanyRecID = Session["CompanyID"] })';
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
            }
        });
    </script>
}
