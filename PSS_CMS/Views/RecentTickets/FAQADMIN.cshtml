@model IEnumerable<PSS_CMS.Models.Faq>

@{ Func<string, string> DecodeJavaScriptString = (input) =>
                {
                    if (input == null) return string.Empty;
                    return input.Replace("\\\"", "\"")
                                .Replace("\\'", "'")
                                .Replace("\\(", "(")
                                .Replace("\\)", ")")
                                .Replace("\\[", "[")
                                .Replace("\\]", "]")
                                .Replace("\\,", ",")
                                .Replace("\\.", ".")
                                .Replace("\\\\", "\\")
                                .Replace("\\n", "\n")
                                .Replace("\\r", "\r");
                };

                ViewData["Title"] = "FAQ";
                ViewBag.PageTitle = "FAQ";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-book nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    Knowledge Base
    <i class="bi bi-chevron-right"></i>
    <span>FAQ</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-question-circle"></i>
            </span>
            Frequently Asked Questions
        </h6>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <!-- Product Filter -->
            @{ var projectTypeList = ViewBag.Product as IEnumerable<SelectListItem>; }
            @if (projectTypeList != null && projectTypeList.Any())
            {
@Html.DropDownList(
         "SelectedProjectType1",
         projectTypeList,
         new
         {
             @class = "filter-select",
             id = "projectTypeFilter1"
         }) }

            <!-- Search -->
            @using (Html.BeginForm("FAQADMIN", "RecentTickets", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>
    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />
    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("FAQADMIN","RecentTickets")" title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}
</div>      }

            <!-- New FAQ -->
            <a href="@Url.Action("FAQADMINPOST","RecentTickets")"
               class="btn-add">
                <i class="bi bi-plus-lg"></i>
                New FAQ
            </a>

        </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="faq-body">

        @if (Model != null && Model.Any())
        {
<p class="faq-count">@Model.Count() question@(Model.Count() != 1 ? "s" : "")</p> foreach (var faq in Model)
{
    string editUrl = Url.Action("Edit", "RecentTickets", new { F_RECID = faq.F_RECID, F_PRECID = faq.F_PRECID });
    string deleteUrl = Url.Action("Delete", "RecentTickets", new { F_RECID = faq.F_RECID });

    /* Attachment detection */
    string base64 = faq.F_ATTACHEMENT ?? "";
    string fileType = "bin", mimeType = "application/octet-stream";
    bool hasFile = !string.IsNullOrEmpty(base64);

    if (hasFile)
    {
        if (base64.StartsWith("iVBORw0KGgo")) { fileType = "png"; mimeType = "image/png"; }
        else if (base64.StartsWith("/9j/")) { fileType = "jpg"; mimeType = "image/jpeg"; }
        else if (base64.StartsWith("JVBER")) { fileType = "pdf"; mimeType = "application/pdf"; }
        else if (base64.StartsWith("UEsDB"))
        {
            fileType = "xlsx";
            mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            if (base64.Contains("word/")) { fileType = "docx"; mimeType = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"; }
        }
        else if (base64.StartsWith("U1RB") || base64.StartsWith("R2V0")) { fileType = "txt"; mimeType = "text/plain"; }
        else if (base64.StartsWith("Q0N2")) { fileType = "csv"; mimeType = "text/csv"; }
    }

<div class="faq-item" id="faq-@faq.F_RECID">

    <div class="faq-question"
         onclick="toggleFaq(@faq.F_RECID)"
         role="button"
         aria-expanded="false"
         aria-controls="faq-ans-@faq.F_RECID">

        <span class="faq-q-text">
            @Html.Raw(DecodeJavaScriptString(faq.F_QUESTION ?? string.Empty))
        </span>

        <i class="bi bi-chevron-down faq-chevron"></i>

    </div>

    <div class="faq-answer" id="faq-ans-@faq.F_RECID">

        <p>@Html.Raw(DecodeJavaScriptString(faq.F_ANSWER))</p>

        <div class="faq-footer">

            <!-- Attachment -->
            @if (hasFile)
            {
<a href="data:@mimeType;base64,@faq.F_ATTACHEMENT"
   download="@(faq.F_QUESTION).@fileType"
   class="dl-btn">
    <i class="bi bi-download"></i>
    Download
</a> }
else
{
<span class="no-file">No attachment</span>}

            <!-- Actions -->
            <div class="faq-act-btns">

                <a href="@editUrl"
                   class="act-btn act-edit"
                   title="Edit">
                    <i class="bx bxs-pencil"></i>
                </a>

                <a href="@deleteUrl"
                   class="act-btn act-delete no-loader"
                   title="Delete"
                   onclick="return confirmDelete(this);"
                   data-name="@faq.F_QUESTION">
                    <i class="bx bxs-trash"></i>
                </a>

            </div>

        </div>

    </div>

</div> }
}
else
{
<div class="faq-empty">
    <i class="bi bi-inbox"></i>
    <p>No FAQs available</p>
</div>}

    </div>
    <!-- Legend -->
    <div class="legend-bar">

        <div class="legend-item">
            <i class='bx bxs-pencil' style='color:#6c5ce7;font-size:16px'></i>
            <span>Edit</span>
        </div>

        <div class="legend-item">
            <i class='bx bxs-trash' style='color:#e74c3c;font-size:16px'></i>
            <span>Delete</span>
        </div>

        <div class="legend-item">
            <i class='bi bi-download' style='color:#BA7517;font-size:14px'></i>
            <span>Download Attachment</span>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Fordelete.js"></script>
    <script src="~/Scripts/Script.js"></script>

    <script>
        /* ── Accordion toggle ─────────────────────── */
        function toggleFaq(id) {
            var el = document.getElementById('faq-' + id);
            el.classList.toggle('open');
        }

        /* ── Product filter redirect ──────────────── */
        $(document).ready(function () {
            var urlParams = new URLSearchParams(window.location.search);
            var currentProjectId = urlParams.get("projectID");
            var storedProjectId  = sessionStorage.getItem("selectedProjectID");

            if (storedProjectId) {
                $("#projectTypeFilter1").val(storedProjectId);
            }

            if (!currentProjectId) {
                if (storedProjectId)   redirectToPage(storedProjectId);
                else {
                    var first = $("#projectTypeFilter1").val();
                    if (first) redirectToPage(first);
                }
            }

            $("#projectTypeFilter1").change(function () {
                var val = $(this).val();
                if (val) {
                    sessionStorage.setItem("selectedProjectID", val);
                    redirectToPage(val);
                }
            });

            function redirectToPage(projectId) {
                window.location.href = '@Url.Action("FAQADMIN","RecentTickets")' +
                    "?projectID=" + encodeURIComponent(projectId);
            }
        });
    </script>
}
