@model IEnumerable<PSS_CMS.Models.WhitePaper>

@{ ViewData["Title"] = "White Papers";
                ViewBag.PageTitle = "White Papers";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Title icon ─────────────────────────── */
        .title-icon {
            width: 28px;
            height: 28px;
            border-radius: var(--border-radius-md, 8px);
            background: #EEEDFE;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .title-icon i {
                font-size: 15px;
                color: #3C3489;
            }

        /* ── Product filter ─────────────────────── */
        .filter-select {
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 7px 12px;
            font-size: 13px;
            color: var(--text-dark);
            background: var(--body-bg);
            outline: none;
            font-family: inherit;
            cursor: pointer;
            min-width: 170px;
        }

        /* ── New White Paper button ─────────────── */
        .btn-new-wp {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            white-space: nowrap;
            text-decoration: none;
            transition: background .15s;
        }

            .btn-new-wp:hover {
                background: #5a4bd1;
                color: #fff;
            }

        /* ── Card grid ──────────────────────────── */
        .wp-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 14px;
            padding: 16px 18px 20px;
        }

        /* ── Individual whitepaper card ─────────── */
        .wp-card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            transition: border-color .15s, box-shadow .15s;
        }

            .wp-card:hover {
                border-color: var(--primary);
                box-shadow: 0 2px 10px rgba(99,89,210,.08);
            }

        /* ── Card top row ───────────────────────── */
        .wp-top {
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .wp-icon-wrap {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            background: #EEEDFE;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

            .wp-icon-wrap i {
                font-size: 18px;
                color: #534AB7;
            }

        .wp-title {
            font-size: 13.5px;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.4;
            word-break: break-word;
        }

        /* ── Description ────────────────────────── */
        .wp-desc {
            font-size: 12.5px;
            color: var(--text-muted);
            line-height: 1.65;
            word-break: break-word;
            flex: 1;
        }

        /* ── Card footer ────────────────────────── */
        .wp-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 10px;
            border-top: 1px solid var(--border-color);
            flex-wrap: wrap;
            gap: 6px;
        }

        /* ── Download button ────────────────────── */
        .dl-btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            background: #EEEDFE;
            color: #3C3489;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            border: 1px solid #AFA9EC;
            transition: background .12s;
        }

            .dl-btn:hover {
                background: #CECBF6;
                color: #26215C;
            }

        .no-file {
            font-size: 12px;
            color: var(--text-muted);
            font-style: italic;
        }

        /* ── Action buttons ─────────────────────── */
        .wp-act-btns {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* ── Count label ────────────────────────── */
        .wp-count {
            font-size: 12px;
            color: var(--text-muted);
            padding: 14px 18px 0;
        }

        /* ── Empty state ────────────────────────── */
        .wp-empty {
            text-align: center;
            padding: 48px 20px;
        }

            .wp-empty i {
                font-size: 38px;
                color: var(--text-muted);
            }

            .wp-empty p {
                margin-top: 8px;
                font-size: 13px;
                color: var(--text-muted);
                font-weight: 600;
            }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-journals nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    Knowledge Base
    <i class="bi bi-chevron-right"></i>
    <span>White Papers</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <h6 class="page-card-title">
            <span class="title-icon">
                <i class="bi bi-file-earmark-text"></i>
            </span>
            White Papers
        </h6>

        <div class="d-flex align-items-center gap-2 flex-wrap">

            <!-- Product Filter -->
            @{ var projectTypeList = ViewBag.Product as IEnumerable<SelectListItem>;
                            var defaultSelectedValue = projectTypeList?.FirstOrDefault()?.Value ?? ""; }
            @if (projectTypeList != null && projectTypeList.Any())
            {
@Html.DropDownList(
         "SelectedProjectType2",
         projectTypeList,
         new
         {
             @class = "filter-select",
             id = "projectTypeFilter2",
             data_default = defaultSelectedValue
         }) }
            else
            {
@Html.DropDownList(
         "SelectedProjectType2",
         projectTypeList,
         "No products available",
         new
         {
             @class = "filter-select",
             id = "projectTypeFilter2",
             data_default = defaultSelectedValue
         })            }

            <!-- Search -->
            @using (Html.BeginForm("Whitepaper", "KnowledgeBased", FormMethod.Get, new { id = "searchForm" }))
            {
<div class="search-box">
    <i class="bi bi-search"></i>
    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />
    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("Whitepaper","KnowledgeBased")" title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}
</div>            }

            <!-- New White Paper -->
            <a href="@Url.Action("WhitepaperPost","KnowledgeBased")"
               class="btn-new-wp">
                <i class="bi bi-plus-lg"></i>
                New White Paper
            </a>

        </div>
    </div>

    <!-- Cards -->
    @if (Model != null && Model.Any(w => w.WP_DISABLE == "N"))
    {
        var activeItems = Model.Where(w => w.WP_DISABLE == "N").ToList();

<p class="wp-count">
    @activeItems.Count document@(activeItems.Count != 1 ? "s" : "")
</p>

                <div class="wp-grid">

                    @foreach (var wp in activeItems)
                    {
                        string editUrl = Url.Action("Edit", "KnowledgeBased", new { WP_RECID = wp.WP_RECID, WP_PROJECTID = wp.WP_PROJECTID, WP_USERID = wp.WP_USERID, wP_PRECID = wp.wP_PRECID });
                        string deleteUrl = Url.Action("Delete", "KnowledgeBased", new { WP_RECID = wp.WP_RECID });

                        /* Attachment type detection */
                        string base64 = wp.WP_ATTACHEMENT ?? "";
                        string fileType = "bin";
                        string mimeType = "application/octet-stream";
                        bool hasFile = !string.IsNullOrEmpty(base64);

                        if (hasFile)
                        {
                            if (base64.StartsWith("iVBORw0KGgo")) { fileType = "png"; mimeType = "image/png"; }
                            else if (base64.StartsWith("/9j/")) { fileType = "jpg"; mimeType = "image/jpeg"; }
                            else if (base64.StartsWith("JVBER")) { fileType = "pdf"; mimeType = "application/pdf"; }
                            else if (base64.StartsWith("UEsDB"))
                            {
                                if (base64.Contains("xl/")) { fileType = "xlsx"; mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"; }
                                else if (base64.Contains("word/")) { fileType = "docx"; mimeType = "application/vnd.openxmlformats-officedocument.wordprocessingml.document"; }
                            }
                            else if (base64.StartsWith("U1RB") || base64.StartsWith("R2V0")) { fileType = "txt"; mimeType = "text/plain"; }
                            else if (base64.StartsWith("Q0N2")) { fileType = "csv"; mimeType = "text/csv"; }
                        }

    <div class="wp-card">

        <!-- Title row -->
        <div class="wp-top">
            <div class="wp-icon-wrap">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <span class="wp-title">@wp.WP_TITLE</span>
        </div>

        <!-- Description -->
        <p class="wp-desc">@wp.WP_Description</p>

        <!-- Footer -->
        <div class="wp-footer">

            @if (hasFile)
            {
<a href="data:@mimeType;base64,@wp.WP_ATTACHEMENT"
   download="@(wp.WP_TITLE).@fileType"
   class="dl-btn">
    <i class="bi bi-download"></i>
    Download
</a> }
                    else
                    {
<span class="no-file">No attachment</span>}

            <div class="wp-act-btns">

                <!-- Edit -->
                <a href="@editUrl"
                   class="act-btn act-edit"
                   title="Edit">
                    <i class="bx bxs-pencil"></i>
                </a>

                <!-- Delete -->
                <a href="@deleteUrl"
                   class="act-btn act-delete no-loader"
                   title="Delete"
                   onclick="return confirmDelete(this);"
                   data-name="@wp.WP_TITLE">
                    <i class="bx bxs-trash"></i>
                </a>

            </div>

        </div>

    </div>}

                </div> }
                            else
                            {
                <div class="wp-empty">
                    <i class="bi bi-inbox"></i>
                    <p>No white papers available</p>
                </div>}

</div>

<!-- Legend -->
<div class="legend-bar">

    <div class="legend-item">
        <i class="bx bxs-pencil" style="color:#6c5ce7;font-size:16px"></i>
        <span>Edit</span>
    </div>

    <div class="legend-item">
        <i class="bx bxs-trash" style="color:#e74c3c;font-size:16px"></i>
        <span>Delete</span>
    </div>

    <div class="legend-item">
        <i class="bi bi-download" style="color:#3C3489;font-size:14px"></i>
        <span>Download Attachment</span>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Fordelete.js"></script>
    <script src="~/Scripts/Script.js"></script>

    <script>
        $(document).ready(function () {

            /* ── Search on keyup ──────────────────── */
            $('#searchPharse').on('keyup', function () {
                $('#searchForm').submit();
            });

            /* ── Product filter redirect ──────────── */
            var urlParams        = new URLSearchParams(window.location.search);
            var currentProjectId = urlParams.get("projectID");
            var storedProjectId  = sessionStorage.getItem("selectedProjectID");

            if (storedProjectId) {
                $("#projectTypeFilter2").val(storedProjectId);
            }

            if (!currentProjectId) {
                if (storedProjectId) {
                    redirectToPage(storedProjectId);
                } else {
                    var first = $("#projectTypeFilter2").val();
                    if (first) redirectToPage(first);
                }
            }

            $("#projectTypeFilter2").change(function () {
                var val = $(this).val();
                if (val) {
                    sessionStorage.setItem("selectedProjectID", val);
                    redirectToPage(val);
                }
            });

            function redirectToPage(projectId) {
                window.location.href = '@Url.Action("Whitepaper","KnowledgeBased")' +
                    "?projectID=" + encodeURIComponent(projectId);
            }

            /* ── Clear session on nav away ────────── */
            $(document).on("click", "a, button, li", function () {
                var targetUrl = $(this).attr("href");
                if (targetUrl && !targetUrl.includes("Whitepaper")) {
                    sessionStorage.removeItem("selectedProjectID");
                }
            });
        });
    </script>
}
