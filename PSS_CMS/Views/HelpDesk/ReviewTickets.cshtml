@model IEnumerable<PSS_CMS.Models.Ticket>

@{ ViewData["Title"] = "Review Tickets";
    ViewBag.PageTitle = "Review Tickets";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper: decode escaped JS strings in comments
    Func<string, string> DecodeJS = (input) =>
    {
        if (input == null) return string.Empty;
        return input.Replace("\\\"", "\"").Replace("\\'", "'")
                    .Replace("\\(", "(").Replace("\\)", ")")
                    .Replace("\\[", "[").Replace("\\]", "]")
                    .Replace("\\,", ",").Replace("\\.", ".")
                    .Replace("\\\\", "\\").Replace("\\n", "\n")
                    .Replace("\\r", "\r");
    };

    // Helper: detect base64 mime type + extension
    Func<string, (string mime, string ext)> DetectType = (b64) =>
    {
        if (string.IsNullOrEmpty(b64)) return ("application/octet-stream", "bin");
        if (b64.StartsWith("iVBORw0KGgo")) return ("image/png", "png");
        if (b64.StartsWith("/9j/")) return ("image/jpeg", "jpg");
        if (b64.StartsWith("JVBER")) return ("application/pdf", "pdf");
        if (b64.StartsWith("UEsDB"))
        {
            if (b64.Contains("word/"))
                return ("application/vnd.openxmlformats-officedocument.wordprocessingml.document", "docx");
            return ("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "xlsx");
        }
        if (b64.StartsWith("U1RB") || b64.StartsWith("R2V0")) return ("text/plain", "txt");
        if (b64.StartsWith("Q0N2")) return ("text/csv", "csv");
        if (b64.StartsWith("AAAAFGZ0eXB") || b64.StartsWith("AAAAGGZ0eXBt"))
            return ("video/mp4", "mp4");
        return ("application/octet-stream", "unknown");
    }; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>

        /* ── Thread is a flex column of rows ── */
        .ticket-thread {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* ── Each row = 2-column grid ── */
        .ticket-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            align-items: stretch;
        }

        /* ── Card fills full height ── */
        .ticket-card {
            background: var(--body-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        /* ── Empty placeholder when no response ── */
        .ticket-card-empty {
            border-radius: 12px;
            border: 1.5px dashed var(--border-color);
            background: transparent;
            min-height: 80px;
        }

        /* ── Card body: fills space + scrolls if large ── */
        .ticket-card-body {
            padding: 16px;
            flex: 1;
            overflow-y: auto;
            max-height: 100px;
        }

        @@media (max-width: 640px) {
            .ticket-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- Loading screen -->
<div id="loadingScreen"><div class="loader"></div></div>

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-detailed nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History", "HelpDesk")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>Review Tickets</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-chat-left-text" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Ticket Thread
        </h6>
    </div>

    <!-- Thread -->
    <div class="ticket-thread">

        @foreach (var ticket in Model)
        {

            var reqType = DetectType(ticket.TC_REQUEST_ATTPREFIX);
            var resType = DetectType(ticket.TC_RESPONSE_ATTPREFIX);<!-- ── Raised ── -->
                            <div class="ticket-row">

                                <div class="ticket-card">
                                    <div class="ticket-card-header raised">
                                        <div class="ticket-header-meta">
                                            <span class="ticket-badge badge-raised">
                                                <i class="bi bi-send-fill"></i> Ticket Raised
                                            </span>
                                            <span class="ticket-by">By: @ticket.TC_USERNAME</span>
                                        </div>
                                        <span class="ticket-date">
                                            <i class="bi bi-clock"></i>
                                            @Convert.ToDateTime(ticket.TC_TICKETDATE).ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </div>
                                    <div class="ticket-card-body">
                                        <div class="comments-label">User Comments</div>
                                        <p class="comments-text">@Html.Raw(DecodeJS(ticket.TC_COMMENTS))</p>

                                        @if (!string.IsNullOrEmpty(ticket.TC_REQUEST_ATTPREFIX))
                                        {
                        <div class="attachment-wrap">
                            @if (reqType.mime.StartsWith("image/"))
                            {
        <img src="data:@reqType.mime;base64,@ticket.TC_REQUEST_ATTPREFIX"
             alt="Attachment"
             class="img-thumb"
             onclick="openLightbox('lb-req-@ticket.TC_RECID')" />

                                <div class="img-overlay" id="lb-req-@ticket.TC_RECID">
                                    <span class="overlay-close" onclick="closeLightbox('lb-req-@ticket.TC_RECID')">&times;</span>
                                    <img src="data:@reqType.mime;base64,@ticket.TC_REQUEST_ATTPREFIX" alt="Preview" />
                                </div> }
                            else
                            {
        <a href="data:@reqType.mime;base64,@ticket.TC_REQUEST_ATTPREFIX"
           download="Attachment.@reqType.ext"
           class="dl-btn">
            <i class="bi bi-download"></i> Download Attachment (.@reqType.ext)
        </a>}
                        </div>}
                                    </div>
                                </div> <!-- ── Response ── -->

                                @if (ticket.TC_RESPONSE_DATETIME != null)
                                {
                <div class="ticket-card">
                    <div class="ticket-card-header responded">
                        <div class="ticket-header-meta">
                            <span class="ticket-badge badge-responded">
                                <i class="bi bi-reply-fill"></i> Response
                            </span>
                            <span class="ticket-by">By: @ticket.TC_ADMINNAME</span>
                        </div>
                        <span class="ticket-date">
                            <i class="bi bi-clock"></i>
                            @Convert.ToDateTime(ticket.TC_RESPONSE_DATETIME).ToString("dd/MM/yyyy HH:mm:ss")
                        </span>
                    </div>
                    <div class="ticket-card-body">
                        <div class="comments-label">Admin Comments</div>
                        <p class="comments-text">@ticket.TC_RESPONSECOMMENTS</p>

                        @if (!string.IsNullOrEmpty(ticket.TC_RESPONSE_ATTPREFIX))
                        {
    <div class="attachment-wrap">
        @if (resType.mime.StartsWith("image/"))
        {
<img src="data:@resType.mime;base64,@ticket.TC_RESPONSE_ATTPREFIX"
     alt="Response Attachment"
     class="img-thumb"
     onclick="openLightbox('lb-res-@ticket.TC_RECID')" />

                            <div class="img-overlay" id="lb-res-@ticket.TC_RECID">
                                <span class="overlay-close" onclick="closeLightbox('lb-res-@ticket.TC_RECID')">&times;</span>
                                <img src="data:@resType.mime;base64,@ticket.TC_RESPONSE_ATTPREFIX" alt="Preview" />
                            </div> }
                        else
                        {
<a href="data:@resType.mime;base64,@ticket.TC_RESPONSE_ATTPREFIX"
   download="Response.@resType.ext"
   class="dl-btn dl-btn-green">
    <i class="bi bi-download"></i> Download Response (.@resType.ext)
</a>}
    </div>}
                    </div>
                </div> }


            else
            { @* Empty placeholder keeps column 2 reserved *@
                                <div class="ticket-card-empty"></div>}
                            </div>}





    </div>

    <!-- /ticket-thread -->
    <!-- ── Response form (only if not closed/re-opened) ── -->
    @{ var lastStatus = Session["Status"]?.ToString(); }
    @if (lastStatus != "C" && lastStatus != "O")
    {
<div style="border-top:1px solid var(--border-color);margin:0 20px 20px;padding-top:20px;">
    @{ Html.RenderPartial("_HelpDeskResponse", new PSS_CMS.Models.Ticket()); }
</div>}

</div><!-- /page-card -->

@section Scripts {
    <script src="~/Scripts/Logoutjs.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Loading screen -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 500);
        });
    </script>

    <!-- Lightbox -->
    <script>
        function openLightbox(id) {
            var el = document.getElementById(id);
            if (el) el.classList.add('show');
        }
        function closeLightbox(id) {
            var el = document.getElementById(id);
            if (el) el.classList.remove('show');
        }
        // Close on backdrop click
        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('img-overlay')) {
                e.target.classList.remove('show');
            }
        });
    </script>

    <!-- Back button prevention -->
    <script>
        function preventBack() { window.history.forward(); }
        setTimeout("preventBack()", 0);
    </script>
}
