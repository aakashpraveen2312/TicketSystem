@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ── Tab Switching ──────────────────────────────
        var isCustomerVerified = false;

        function switchTab(targetId) {
            // Guard: statutory & contacts require verification
            if ((targetId === 'pane-statutory' || targetId === 'pane-contacts') && !isCustomerVerified) {
                Swal.fire({
                    icon: "warning",
                    title: "Verification Required",
                    text: "Please verify the customer email or mobile to continue."
                });
                return;
            }

            document.querySelectorAll('.inv-tab-link').forEach(function (b) {
                b.classList.remove('active');
            });
            document.querySelectorAll('.inv-pane').forEach(function (p) {
                p.classList.remove('show');
            });
            document.querySelector('[data-target="' + targetId + '"]').classList.add('active');
            document.getElementById(targetId).classList.add('show');
        }

        // Tab button clicks
        document.querySelectorAll('.inv-tab-link').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (!btn.disabled) {
                    switchTab(btn.dataset.target);
                }
            });
        });

        // Enable statutory & contacts tabs after verification
        function enableProtectedTabs() {
            document.getElementById('tab-btn-statutory').disabled = false;
            document.getElementById('tab-btn-contacts').disabled = false;
        }

        // ── Number-only key guard ──────────────────────
        function isNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            return !(charCode < 48 || charCode > 57);
        }

        document.getElementById("CU_MOBILENO").addEventListener("input", function () {
            this.value = this.value.replace(/\D/g, '').slice(0, 10);
        });

        // ── Location Type → Location Ref AJAX ─────────
        $(document).ready(function () {

            $("#SelectedLocation").change(function () {
                var locationId = $(this).val();
                if (!locationId) return;

                $.ajax({
                    url: '@Url.Action("LocationRef", "AccountantCustomerInvoice")',
                    type: 'GET',
                    data: { locationid: locationId },
                    success: function (result) {
                        var $dd = $("#LocationRefDropdown");
                        $dd.empty();
                        if (result && result.length > 0) {
                            $dd.append($("<option>").val("").text("-- Select Sales Location --"));
                            $.each(result, function (i, item) {
                                $dd.append($("<option>").val(item.Value).text(item.Text));
                            });
                        } else {
                            $dd.append($("<option>").val("").text("No Sales Location Available"));
                        }
                    },
                    error: function (xhr, status, error) {
                        Swal.fire({ icon: "error", title: "Error", text: "Error fetching Location Ref: " + error });
                    }
                });
            });

            // ── Verify & Continue ──────────────────────
            $(document).on("click", "#btnVerifyCustomer", function () {

                // Already verified → just move to next tab
                if (isCustomerVerified) {
                    switchTab('pane-statutory');
                    return;
                }

                var email  = $("#CU_EMAIL").val().trim();
                var mobile = $("#CU_MOBILENO").val().trim();

                if (email === "" && mobile === "") {
                    Swal.fire({ icon: "warning", title: "Missing Info", text: "Please enter an Email or Mobile Number." });
                    return;
                }

                if (mobile !== "" && !/^[0-9]{10}$/.test(mobile)) {
                    Swal.fire({ icon: "warning", title: "Invalid Mobile", text: "Please enter a valid 10-digit mobile number." });
                    return;
                }

                $("#btnVerifyCustomer").prop("disabled", true);

                $.ajax({
                    url: '/AccountantCustomerInvoice/GetCustomerByEmailFrom',
                    type: 'GET',
                    data: { email: email, mobile: mobile },
                    success: function (res) {

                        var status = res.status || res.Status;
                        var data   = res.data   || res.Data;

                        isCustomerVerified = true;
                        enableProtectedTabs();

                        // Update button to indicate verified state
                        $("#btnVerifyCustomer")
                            .addClass("verified")
                            .html('<i class="bi bi-check-circle"></i> Next');

                        if (status === "Y") {
                            // Populate all fields from existing customer
                            $("#CU_NAME").val(data.CU_NAME);
                            $("#CU_EMAIL").val(data.CU_EMAIL);
                            $("#CU_MOBILENO").val(data.CU_MOBILENO);
                            $("#CU_ADDRESS").val(data.CU_ADDRESS);
                            $("#CU_GST").val(data.CU_GST);
                            $("#CU_PANNUMBER").val(data.CU_PANNUMBER);
                            $("#CU_TANNUMBER").val(data.CU_TANNUMBER);
                            $("#CU_CONTACTPERSONNAME1").val(data.CU_CONTACTPERSONNAME1);
                            $("#CU_CONTACTPERSONEMAILID1").val(data.CU_CONTACTPERSONEMAILID1);
                            $("#CU_CONTACTPERSONMOBILE1").val(data.CU_CONTACTPERSONMOBILE1);
                            $("#CU_CONTACTPERSONDESIGINATION1").val(data.CU_CONTACTPERSONDESIGINATION1);
                            $("#CU_CONTACTACCESS1_BOOL").prop("checked", (data.CU_CONTACTACCESS1 || "").trim() === "Y");
                            $("#CU_CONTACTPERSONNAME2").val(data.CU_CONTACTPERSONNAME2);
                            $("#CU_CONTACTPERSONEMAILID2").val(data.CU_CONTACTPERSONEMAILID2);
                            $("#CU_CONTACTPERSONMOBILE2").val(data.CU_CONTACTPERSONMOBILE2);
                            $("#CU_CONTACTPERSONDESIGINATION2").val(data.CU_CONTACTPERSONDESIGINATION2);
                            $("#CU_CONTACTACCESS2_BOOL").prop("checked", (data.CU_CONTACTACCESS2 || "").trim() === "Y");
                            $("#CU_CONTACTPERSONNAME3").val(data.CU_CONTACTPERSONNAME3);
                            $("#CU_CONTACTPERSONEMAILID3").val(data.CU_CONTACTPERSONEMAILID3);
                            $("#CU_CONTACTPERSONMOBILE3").val(data.CU_CONTACTPERSONMOBILE3);
                            $("#CU_CONTACTPERSONDESIGINATION3").val(data.CU_CONTACTPERSONDESIGINATION3);
                            $("#CU_CONTACTACCESS3_BOOL").prop("checked", (data.CU_CONTACTACCESS3 || "").trim() === "Y");
                            $("#HiddenCustomerRecid").val(data.CU_RECID);

                            Swal.fire({ icon: "success", title: "Customer Found", text: "Existing customer details loaded." });
                        } else {
                            // Clear dependent fields for new customer
                            $("#HiddenCustomerRecid").val(0);
                            $("#CU_NAME,#CU_ADDRESS,#CU_GST,#CU_PANNUMBER,#CU_TANNUMBER").val("");
                            $("#CU_CONTACTPERSONNAME1,#CU_CONTACTPERSONEMAILID1,#CU_CONTACTPERSONMOBILE1,#CU_CONTACTPERSONDESIGINATION1").val("");
                            $("#CU_CONTACTACCESS1_BOOL").prop("checked", false);
                            $("#CU_CONTACTPERSONNAME2,#CU_CONTACTPERSONEMAILID2,#CU_CONTACTPERSONMOBILE2,#CU_CONTACTPERSONDESIGINATION2").val("");
                            $("#CU_CONTACTACCESS2_BOOL").prop("checked", false);
                            $("#CU_CONTACTPERSONNAME3,#CU_CONTACTPERSONEMAILID3,#CU_CONTACTPERSONMOBILE3,#CU_CONTACTPERSONDESIGINATION3").val("");
                            $("#CU_CONTACTACCESS3_BOOL").prop("checked", false);

                            Swal.fire({ icon: "info", title: "New Customer", text: "No existing customer found. Please fill in the details." });
                        }
                    },
                    error: function () {
                        Swal.fire({ icon: "error", title: "Error", text: "Error verifying customer. Please try again." });
                    },
                    complete: function () {
                        $("#btnVerifyCustomer").prop("disabled", false);
                    }
                });
            });

            // ── Form Submit ────────────────────────────
            $("#createform").submit(function (e) {
                e.preventDefault();

                var submitBtn = $("#savebutton");
                submitBtn.prop("disabled", true);
                $("body").css("pointer-events", "none");

                var formData = new FormData(this);

                $.ajax({
                    url: '@Url.Action("SalesheaderCreate", "AccountantCustomerInvoice")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we save your changes.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });

                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    showCancelButton: true,
                                    confirmButtonText: "Continue",
                                    cancelButtonText: "Back to List",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: {
                                        confirmButton: "swal-btn-continue",
                                        cancelButton: "swal-btn-back"
                                    },
                                    didOpen: () => {
                                        $(".swal2-container").css("pointer-events", "auto");
                                    }
                                }).then((result) => {
                                    if (result.isConfirmed) {
                                        location.reload();
                                    } else {
                                        window.location.href = '@Url.Action("SalesheaderList", "AccountantCustomerInvoice", new { CU_CTRECID = Session["RECID"], Name = Session["ContractName"], CT_PRECID = Session["CT_PRECID"], CT_CONTRACTAMOUNT = Session["ContractAmount"] })';
                                    }
                                });
                            }, 1000);

                        } else {
                            Swal.fire({
                                title: "Message",
                                text: response.message,
                                icon: "info",
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            resetButton();
                        }
                    },
                    error: function () {
                        Swal.fire({
                            title: "Error!",
                            text: "An unexpected error occurred.",
                            icon: "error",
                            allowOutsideClick: false,
                            allowEscapeKey: false
                        });
                        resetButton();
                    }
                });
            });

            function resetButton() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
