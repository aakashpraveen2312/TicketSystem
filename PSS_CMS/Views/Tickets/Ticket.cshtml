@model PSS_CMS.Models.Tickets
@using CaptchaMvc.HtmlHelpers

@{ ViewData["Title"] = "New Ticket";
    ViewBag.PageTitle = "New Ticket";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Loading screen ────────────────────────── */
        #loadingScreen {
            position: fixed;
            inset: 0;
            background: rgba(255,255,255,.85);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader {
            width: 40px;
            height: 40px;
            border: 4px solid #EEEDFE;
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }

        @@keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── Service selector buttons ──────────────── */
        .service-btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .service-btn {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            font-family: inherit;
            transition: opacity .15s;
        }

        .service-btn-contract {
            background: #EEEDFE;
            color: var(--primary);
            border: 1px solid #AFA9EC;
        }

            .service-btn-contract:hover {
                background: #CECBF6;
            }

        .service-btn-warranty {
            background: #E1F5EE;
            color: #085041;
            border: 1px solid #9FE1CB;
        }

            .service-btn-warranty:hover {
                background: #B2E8D6;
            }

        /* ── Custom modal ──────────────────────────── */
        .custom-modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1050;
            align-items: center;
            justify-content: center;
        }

            .custom-modal.open {
                display: flex;
            }

        .custom-modal-content {
            background: #fff;
            border-radius: 14px;
            width: 100%;
            max-width: 680px;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 8px 40px rgba(0,0,0,.18);
            overflow: hidden;
            margin: 16px;
        }

        .custom-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
            font-weight: 700;
            color: var(--text-dark);
        }

        .close-btn {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: var(--body-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 18px;
            color: var(--text-muted);
            line-height: 1;
        }

            .close-btn:hover {
                background: var(--border-color);
            }

        .custom-modal-body {
            padding: 14px 18px;
            overflow-y: auto;
            flex: 1;
        }

            .custom-modal-body table {
                width: 100%;
                border-collapse: collapse;
                font-size: 13px;
            }

                .custom-modal-body table th {
                    background: var(--body-bg);
                    font-size: 11px;
                    text-transform: uppercase;
                    letter-spacing: .5px;
                    color: var(--text-muted);
                    font-weight: 600;
                    padding: 9px 12px;
                    border-bottom: 1px solid var(--border-color);
                }

                .custom-modal-body table td {
                    padding: 10px 12px;
                    border-bottom: 1px solid #f3f3f3;
                    color: var(--text-dark);
                }

                .custom-modal-body table tr:hover td {
                    background: #fafbff;
                    cursor: pointer;
                }

        /* ── Terms checkbox row ────────────────────── */
        .terms-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            background: var(--body-bg);
        }

            .terms-row input[type=checkbox] {
                width: 16px;
                height: 16px;
                accent-color: var(--primary);
                flex-shrink: 0;
            }

            .terms-row label {
                font-size: 12.5px;
                color: var(--text-dark);
                margin: 0;
                cursor: pointer;
            }

        .label-gray {
            color: var(--text-muted) !important;
        }

        /* ── File upload ───────────────────────────── */
        #fileError {
            font-size: 11px;
            color: #E24B4A;
            margin-top: 4px;
            display: none;
        }
        /* ── Captcha size override ────────────── */
        #captchaContainer img,
        #captchaContainer canvas,
        .captcha-image img {
            width: 160px !important;
            height: 44px !important;
            border-radius: 8px;
            object-fit: cover;
        }

        #captchaContainer input[type="text"],
        .captcha-input {
            width: 160px !important;
            padding: 7px 10px !important;
            font-size: 13px !important;
            height: 36px !important;
        }

        #captchaContainer table,
        #captchaContainer tr,
        #captchaContainer td {
            width: auto !important;
            border: none !important;
            padding: 4px 0 !important;
            background: transparent !important;
        }

        #captchaContainer {
            display: flex;
            flex-direction: column;
            gap: 6px;
            max-width: 320px;
        }
    </style>
}


<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-detailed nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("Ticket_History", "Tickets")">Ticket History</a>
    <i class="bi bi-chevron-right"></i>
    <span>New Ticket</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-ticket-detailed" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Raise New Ticket
        </h6>

      
    </div>

    @using (Html.BeginForm("Ticket", "Tickets", FormMethod.Post, new { id = "myForm", enctype = "multipart/form-data", @class = "no-preloader" }))
    {
@Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.P_SERIALNUMBER, new { id = "SerialNo" })
                                @Html.HiddenFor(m => m.CustomerType, new { id = "CustomerType" })

                                                <div style="padding:24px 20px 8px;">

                                                    <!-- ── Section 1: Ticket Info ── -->
                                                    <p class="form-section-title">Ticket Information</p>
                                                    <div class="form-grid" style="margin-bottom:24px;">

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_Date, "Date", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_Date, new { @class = "form-input-text", id = "date", type = "datetime-local", required = "required", tabindex = "1" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.SelectedProjectType, "Product", new { @class = "form-label" })
                                                            @if (Model.TicketCombo2.TicketTypes2 != null)
                                                            {
                                            @Html.DropDownListFor(m => m.SelectedProjectType,
                                                     Model.TicketCombo2.TicketTypes2,
                                                     "Select Product",
                                                     new { @class = "form-select-input", onchange = "loadMaterials(this)", tabindex = "2" }) }
                                                            else
                                                            {
                                            @Html.DropDownListFor(m => m.SelectedProjectType,
                                                     Model.TicketCombo2.TicketTypes2,
                                                     "No Products available",
                                                     new { @class = "form-select-input" })}
                                                            @Html.DropDownList("SelectedCustomer",
                                                                     new List<SelectListItem> { new SelectListItem { Text = "No Product is selected", Value = "", Selected = true } },
                                                                     new { @class = "form-select-input d-none", id = "CustomerDropdown" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_SUBJECT, "Subject", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_SUBJECT, new { @class = "form-input-text", id = "sub", tabindex = "3",placeholder="Enter your subject..." })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.TC_PRIORITYTYPE, "Priority Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.TC_PRIORITYTYPE,
                                                                     new SelectList(new List<string> { "Normal", "Urgent", "Critical", "Emergency" }),
                                                                     "Select Priority Type",
                                                                     new { @class = "form-select-input prioritystyle", tabindex = "4" })
                                                        </div>

                                                        <div class="form-group">
                                                            @Html.LabelFor(m => m.SelectedTicketType, "Ticket Type", new { @class = "form-label" })
                                                            @Html.DropDownListFor(m => m.SelectedTicketType,
                                                                     Model.TicketCombo.TicketTypes,
                                                                     "Select Ticket Type",
                                                                     new { @class = "form-select-input", tabindex = "6" })
                                                        </div>

                                                    </div>

                                                    <!-- ── Section 2: Warranty Info ── -->
                                                    <p class="form-section-title">Warranty / Contract Details</p>
                                                    <div class="form-grid" style="margin-bottom:24px;" id="warrantySection">

                                                        <div class="form-group" id="productSection">
                                                            @Html.LabelFor(m => m.LatestPaymentDueDate, "Product Warranty Upto", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.LatestPaymentDueDate, new { @class = "form-input-auto", id = "latestwarranty", @readonly = "readonly", tabindex = "5" })
                                                        </div>

                                                        <div class="form-group" id="contractSection">
                                                            @Html.LabelFor(m => m.TC_WARRANTYUPTO, "Contract Warranty Upto", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.TC_WARRANTYUPTO, new { @class = "form-input-auto", id = "warranty", @readonly = "readonly", tabindex = "5" })
                                                        </div>

                                                        <div class="form-group" id="freeServiceSection">
                                                            @Html.LabelFor(m => m.CU_WARRANTYFREECALLS, "Free Services", new { @class = "form-label" })
                                                            @Html.TextBoxFor(m => m.CU_WARRANTYFREECALLS, new { @class = "form-input-auto", id = "warrantyfreecalls", @readonly = "readonly", tabindex = "7" })
                                                        </div>

                                                    </div>

                                                    <!-- ── Section 3: Comments & Attachments ── -->
                                                    <p class="form-section-title">Comments & Attachments</p>
                                                    <div style="margin-bottom:24px;">

                                                        <div class="form-group" style="margin-bottom:16px;">
                                                            @Html.LabelFor(m => m.TC_COMMENTS, "User Comments", new { @class = "form-label" })
                                                            @Html.TextAreaFor(m => m.TC_COMMENTS, new
                                                            {
                                                                @class = "form-textarea",
                                                                placeholder = "Please enter your comments here....",
                                                                rows = "6",
                                                                tabindex = "8"
                                                            })
                                                        </div>

                                                        <div class="form-group" style="margin-bottom:16px;">
                                                            <label class="form-label">Attachments</label>
                                                            <div class="file-upload-wrap">
                                                                <div class="file-upload-icon">
                                                                    <i class="bi bi-paperclip"></i>
                                                                </div>
                                                                <div class="file-upload-text">
                                                                    <span>Choose file to attach</span>
                                                                    <small>Supported: .pdf, .xlsx, .jpeg, .png, .jpg, .csv, .mp4</small>
                                                                </div>
                                                                <label class="btn-browse" for="myfile">
                                                                    <i class="bi bi-folder2-open"></i> Browse
                                                                </label>
                                                                <input type="file" id="myfile" name="myfile" class="file-input-hidden"
                                                                       tabindex="6"
                                                                       accept=".pdf,.xlsx,.jpeg,.png,.jpg,.csv,.mp4"
                                                                       onchange="validateFile()" />
                                                            </div>
                                                            <small id="fileError">This file format is not supported. Allowed: .pdf, .xlsx, .txt, .jpeg, .png, .jpg, .csv, .mp4</small>
                                                        </div>

                                                        <!-- Captcha -->
                                                        <div class="form-group" style="margin-bottom:16px;" id="captchaContainer">
                                                            @Html.Partial("_CaptchaPartial")
                                                        </div>

                                                        <!-- Terms checkbox -->
                                                        <div class="terms-row" style="margin-bottom:8px;">
                                                            @Html.CheckBoxFor(m => m.paidservice, new { id = "termsCheckbox" })
                                                            <label for="termsCheckbox" id="termsLabel">
                                                                Add a Service Request with Payment
                                                            </label>
                                                        </div>

                                                    </div>

                                                    <!-- Actions -->
                                                    <div class="form-actions">
                                                        <button type="button" class="btn-cancel"
                                                                onclick="window.location.href='@Url.Action("Ticket_History","Tickets")'"
                                                                tabindex="10">
                                                            <i class="bi bi-x-lg"></i> Cancel
                                                        </button>
                                                        <button type="submit" class="btn-save" id="submitBtn" tabindex="9">
                                                            <i class="bi bi-send"></i> Submit
                                                        </button>

                                                    </div>

                                                </div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
        <span>Read-only Field</span>
    </div>
</div>


@section Scripts {
  
    <script src="~/Scripts/Formatcheck.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Loading screen control -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 500);
        });
    </script>

    <!-- Set current datetime on load -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var dateTextbox = document.getElementById("date");
            var now = new Date();
            var pad = function (n) { return String(n).padStart(2, "0"); };
            dateTextbox.value = now.getFullYear() + "-" + pad(now.getMonth() + 1) + "-" +
                pad(now.getDate()) + "T" + pad(now.getHours()) + ":" + pad(now.getMinutes());
        });
    </script>

    <!-- File name display on browse -->
    <script>
        document.getElementById("myfile").addEventListener("change", function () {
            var fileName = this.files.length ? this.files[0].name : "";
            var textEl = document.querySelector(".file-upload-text span");
            if (textEl) textEl.textContent = fileName || "Choose file to attach";
        });
    </script>

    <!-- Captcha refresh -->
    <script>
        function refreshCaptcha() {
            $.ajax({
                url: '@Url.Action("RefreshCaptcha", "Tickets")',
                type: 'GET',
                success: function (data) {
                    $('#captchaContainer').html(data);
                    $('input[name="CaptchaInputText"]').val('');
                },
                error: function () { alert('Failed to refresh captcha'); }
            });
        }
    </script>

    <!-- Form submit with fetch -->
    <script>
        document.getElementById("myForm").addEventListener("submit", function (event) {
            event.preventDefault();

            var form = this;
            var formData = new FormData(form);
            var submitButton = document.getElementById("submitBtn");
            submitButton.disabled = true;

            Swal.fire({
                title: "Processing...",
                html: "Please wait while we save your changes.",
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => { Swal.showLoading(); }
            });

            fetch(form.action, { method: form.method, body: formData })
                .then(function (response) {
                    if (!response.ok) throw new Error("Server error");
                    return response.json();
                })
                .then(function (data) {
                    if (!data || data.status === "error") {
                        Swal.fire({
                            title: "Message",
                            text: data?.Message || "Something went wrong",
                            icon: "info",
                            confirmButtonText: "OK"
                        }).then(refreshCaptcha);
                        submitButton.disabled = false;
                        return;
                    }

                    if (data.status === "success") {
                        Swal.fire({
                            title: "",
                            html: `<p style="font-size:15px;"><b>Ticket raised successfully.<br/>Admin will reach you soon</b></p>
                                       <div style="display:flex;justify-content:center;gap:15px;margin-top:20px;">
                                           <button id="confirmBtn" class="swal2-confirm swal2-styled" style="background:#6ed3d0;">Back to List</button>
                                           <button id="cancelBtn" class="swal2-cancel swal2-styled" style="background:#f0a72d;">New Ticket</button>
                                       </div>`,
                            showConfirmButton: false,
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            didOpen: () => {
                                document.getElementById("confirmBtn").addEventListener("click", function () {
                                    window.location.href = '/Tickets/Ticket_History';
                                });
                                document.getElementById("cancelBtn").addEventListener("click", function () {
                                    window.location.href = '/Tickets/Ticket';
                                });
                            }
                        });
                        return;
                    }

                    Swal.fire({ title: "Unexpected Response", text: "Unknown response from server", icon: "warning" });
                    submitButton.disabled = false;
                })
                .catch(function () {
                    Swal.fire({ title: "Message", text: "Something went wrong while submitting the form.", icon: "info" });
                    submitButton.disabled = false;
                });
        });
    </script>

    <!-- Warranty / checkbox logic -->
    <script>
        function loadMaterials(element) {

            console.log("element",element);

            let selectedRecId = element.value;

            let selectedText = $(element).find(':selected').text();

            let serialNo = selectedText.split(' - ').pop().trim();

            console.log(serialNo);

            console.log("selectedRecId", selectedRecId);
            console.log("serialNo", serialNo);

            $('#SerialNo').val(serialNo);

            $.ajax({
                url: '@Url.Action("ComboProductTicketNew", "Tickets")',
                type: 'GET',
                data: { Recid: selectedRecId, SerialNo: serialNo },
                success: function (response) {
                    $('#CustomerDropdown').empty();
                    $('#warranty').val('');
                    $('#latestwarranty').val('');
                    $('#warrantyfreecalls').val('');
                    $('#termsCheckbox').prop('checked', false).prop('disabled', true);

                    if (response.error) { Swal.fire('Error', response.error, 'error'); return; }

                    if (response.length > 0) {
                        const item = response[0];

                        $('#CustomerDropdown').append($('<option>', { value: item.Value, text: item.Text, selected: true }));

                        if (item.WarrantyUpto) {
                            const d = new Date(item.WarrantyUpto);
                            $('#warranty').val(("0" + d.getDate()).slice(-2) + "-" + ("0" + (d.getMonth() + 1)).slice(-2) + "-" + d.getFullYear());
                        }
                        if (item.ProductUpto) {
                            const d2 = new Date(item.ProductUpto);
                            $('#latestwarranty').val(("0" + d2.getDate()).slice(-2) + "-" + ("0" + (d2.getMonth() + 1)).slice(-2) + "-" + d2.getFullYear());
                        }

                        $('#warrantyfreecalls').val(item.WarrantyFreeCalls);
                        $('#CustomerType').val(item.CustomerType);
                        updateCheckboxState();
                        toggleWarrantyFields();
                    }
                },
                error: function () { Swal.fire('Error', 'Failed to load customers.', 'error'); }
            });
        }

        function updateCheckboxState() {
            const wStr = $('#warranty').val();
            const lwStr = $('#latestwarranty').val();
            const freeCalls = parseInt($('#warrantyfreecalls').val(), 10) || 0;
            const today = new Date(); today.setHours(0,0,0,0);

            function parseDate(s) {
                if (!s) return null;
                const p = s.split('-');
                return new Date(p[2], p[1] - 1, p[0]);
            }

            const wd = parseDate(wStr);
            const lwd = parseDate(lwStr);
            const custExp = wd && wd < today;
            const prodExp = lwd && lwd < today;

            if (wStr && freeCalls === 0) {
                $('#termsCheckbox').prop('disabled', false);
                $('#termsLabel').removeClass('label-gray');
                return;
            }
            if (custExp || prodExp) {
                $('#termsCheckbox').prop('disabled', false);
                $('#termsLabel').removeClass('label-gray');
            } else {
                $('#termsCheckbox').prop('disabled', true).prop('checked', false);
                $('#termsLabel').addClass('label-gray');
            }
        }

        $('#submitBtn').on('click', function (e) {
            const wStr = $('#warranty').val();
            const lwStr = $('#latestwarranty').val();
            const isChecked = $('#termsCheckbox').is(':checked');
            const freeCalls = parseInt($('#warrantyfreecalls').val(), 10) || 0;
            const today = new Date(); today.setHours(0,0,0,0);

            function parseDate(s) {
                if (!s) return null;
                const p = s.split('-');
                return new Date(p[2], p[1] - 1, p[0]);
            }

            const wd = parseDate(wStr);
            const lwd = parseDate(lwStr);
            const custExp = wd && wd < today;
            const prodExp = lwd && lwd < today;

            if (wStr && freeCalls === 0) {
                if (!isChecked) {
                    e.preventDefault();
                    Swal.fire({ icon: 'warning', title: 'Free Service Over', text: 'Your free service is over. Please check the Add a Service Request with Payment to continue.' });
                }
                return;
            }

            if (!custExp && !prodExp) return;

            if ((custExp || prodExp) && !isChecked) {
                e.preventDefault();
                let msg = custExp && prodExp
                    ? 'Both contract and product warranties have expired.'
                    : custExp
                        ? 'Contract warranty has expired.'
                        : 'Product warranty has expired.';
                Swal.fire({ icon: 'warning', title: 'Warranty Expired', text: msg + ' Please check the Add a Service Request with Payment to continue.', confirmButtonColor: '#d33' });
            }
        });

        $(document).ready(function () {
            updateCheckboxState();
            if (typeof toggleWarrantyFields === "function") toggleWarrantyFields();
        });
    </script>

}
