@model PSS_CMS.Models.Forgotpassword
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password – Ticket System</title>
    <link href="~/assets/img/bexlogo_wob.png" rel="icon">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --purple:    #6c5ce7;
            --purple-lt: #ede9ff;
            --purple-dk: #4f46c8;
            --teal:      #0d9488;
            --teal-lt:   #e0f7f5;
            --text-dark: #1a2340;
            --text-mid:  #5a6480;
            --text-muted:#9ba8c0;
            --border:    #e2e8f5;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'Nunito', sans-serif;
            background: #dce8f5;
        }

        /* ── LOADING SCREEN ── */
        #loadingScreen {
            position: fixed;
            inset: 0;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity .4s ease;
        }

        .loader {
            width: 40px;
            height: 40px;
            border: 4px solid var(--purple-lt);
            border-top-color: var(--purple);
            border-radius: 50%;
            animation: spin .8s linear infinite;
        }

        /* ── PAGE WRAP ── */
        .page-wrap {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            height: 100%;
            max-height: 620px;
            background: #fff;
            overflow: hidden;
            box-shadow: 0 16px 50px rgba(108,92,231,.16);
            display: flex;
            animation: cardReveal .7s .1s cubic-bezier(.22,1,.36,1) both;
        }

        /* ════ LEFT PANEL ════ */
        .left-panel {
            flex: 2.2;
            background: linear-gradient(150deg, #a78bfa 0%, #818cf8 28%, #6c5ce7 55%, #4f46c8 80%, #3b60d4 100%);
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            gap: .8rem;
        }

        /* Dot grid */
        .left-panel::before {
            content: '';
            position: absolute;
            top: 28px; right: 28px;
            width: 130px; height: 130px;
            background-image: radial-gradient(circle, rgba(255,255,255,.35) 1.5px, transparent 1.5px);
            background-size: 13px 13px;
            border-radius: 6px;
            animation: dotPulse 4s ease-in-out infinite;
        }

        /* Blob bottom-left */
        .left-panel::after {
            content: '';
            position: absolute;
            bottom: -30px; left: -45px;
            width: 280px; height: 200px;
            background: rgba(13,148,136,.30);
            border-radius: 50% 60% 40% 70% / 60% 40% 70% 50%;
            animation: blobMorph 8s ease-in-out infinite;
        }

        .blob2 {
            position: absolute;
            top: -40px; left: -30px;
            width: 200px; height: 170px;
            background: rgba(255,255,255,.08);
            border-radius: 60% 40% 70% 30% / 40% 60% 30% 70%;
            animation: blobMorph2 10s ease-in-out infinite;
            pointer-events: none;
        }

        .blob3 {
            position: absolute;
            bottom: 40px; right: -50px;
            width: 160px; height: 140px;
            background: rgba(59,96,212,.25);
            border-radius: 40% 60% 50% 70% / 60% 40% 70% 30%;
            animation: blobMorph 12s ease-in-out infinite reverse;
            pointer-events: none;
        }

        .scene-label {
            position: relative;
            z-index: 2;
            font-size: 1rem;
            font-weight: 800;
            color: rgba(255,255,255,.95);
            letter-spacing: .8px;
            text-align: center;
            text-transform: uppercase;
            padding: 0 1rem;
            text-shadow: 0 2px 12px rgba(0,0,0,.2);
            animation: fadeUp .7s .4s both;
        }

        .scene-label::after {
            content: '';
            display: block;
            width: 40px; height: 3px;
            background: rgba(255,255,255,.6);
            border-radius: 2px;
            margin: 6px auto 0;
            animation: lineExpand 3s ease-in-out infinite;
        }

        .illus-wrap {
            position: relative;
            z-index: 2;
            width: 92%;
            max-width: 420px;
            animation: floatScene 5s ease-in-out infinite, fadeUp .8s .3s both;
            filter: drop-shadow(0 20px 40px rgba(0,0,0,.18));
        }

        .illus-wrap svg { width: 100%; height: auto; display: block; }

        /* ════ RIGHT PANEL ════ */
        .right-panel {
            flex: 1.25;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 3rem;
            background: #fff;
            min-width: 340px;
        }

        /* ── Logo ── */
        .brand-logo {
            width: 66px; height: 66px;
            object-fit: contain;
            margin-bottom: .6rem;
            animation: logoBounce 3s ease-in-out infinite, fadeUp .6s .5s both;
        }

        /* ── Titles ── */
        .right-panel h1 {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-dark);
            letter-spacing: .5px;
            margin-bottom: .18rem;
            text-align: center;
            animation: fadeUp .6s .55s both;
        }

        .subtitle {
            font-size: .78rem;
            color: var(--text-muted);
            margin-bottom: 1.6rem;
            text-align: center;
            max-width: 280px;
            line-height: 1.5;
            animation: fadeUp .6s .6s both;
        }

        /* ── Steps indicator ── */
        .otp-steps {
            display: flex;
            align-items: center;
            gap: 0;
            width: 100%;
            max-width: 320px;
            margin-bottom: 1.6rem;
            animation: fadeUp .6s .65s both;
        }

        .otp-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            font-size: .65rem;
            font-weight: 700;
            color: var(--text-muted);
        }

        .otp-step.active { color: var(--purple); }

        .otp-step-dot {
            width: 26px; height: 26px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; font-weight: 700;
            border: 2px solid var(--border);
            background: #fff;
            color: var(--text-muted);
        }

        .otp-step.active .otp-step-dot {
            background: var(--purple);
            border-color: var(--purple);
            color: #fff;
            animation: pulseRing 2s 1s ease-out infinite;
        }

        .otp-step-line {
            flex: 1;
            height: 2px;
            background: var(--border);
            margin: 0 6px;
            margin-bottom: 18px;
        }

        /* ── Form ── */
        #createform {
            width: 100%;
            max-width: 340px;
            animation: fadeUp .6s .7s both;
        }

        .field-group {
            width: 100%;
            margin-bottom: 1rem;
        }

        .field-group label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: .73rem;
            font-weight: 700;
            color: var(--text-mid);
            margin-bottom: .32rem;
            letter-spacing: .2px;
            transition: color .2s;
        }

        .field-group label i { font-size: 14px; color: var(--text-muted); transition: color .2s, transform .25s cubic-bezier(.34,1.56,.64,1); }

        .field-group:focus-within label     { color: var(--purple); }
        .field-group:focus-within label i   { color: var(--purple); transform: scale(1.2); }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrap .ico {
            position: absolute;
            left: 12px;
            color: var(--text-muted);
            display: flex;
            pointer-events: none;
            font-size: 15px;
            transition: color .2s;
        }

        .field-group:focus-within .ico { color: var(--purple); }

        .input-wrap input {
            width: 100%;
            height: 50px;
            padding: 0 2.4rem 0 2.6rem;
            border: 1.5px solid var(--border);
            border-radius: 11px;
            font-family: 'Nunito', sans-serif;
            font-size: .88rem;
            color: var(--text-dark);
            background: #f8faff;
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s, transform .15s;
        }

        .input-wrap input::placeholder { color: var(--text-muted); }

        .input-wrap input:focus {
            border-color: var(--purple);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(108,92,231,.10);
            transform: translateY(-1px);
        }

        .text-danger { font-size: .7rem; color: #ef4444; margin-top: 3px; display: block; }

        /* ── Info box ── */
        .info-box {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            background: #f0fdf9;
            border: 1px solid #99f6e4;
            border-radius: 10px;
            padding: .75rem 1rem;
            margin-bottom: 1.1rem;
            font-size: .73rem;
            color: #0f766e;
            line-height: 1.5;
            animation: fadeUp .5s .75s both;
        }

        .info-box i { font-size: 16px; color: var(--teal); flex-shrink: 0; margin-top: 1px; }

        /* ── Buttons ── */
        .btn-row {
            display: flex;
            gap: .65rem;
            width: 100%;
        }

        .btn-submit {
            flex: 1;
            height: 48px;
            border: none;
            border-radius: 11px;
            background: linear-gradient(90deg, var(--purple) 0%, #818cf8 100%);
            color: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            letter-spacing: .3px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            position: relative;
            overflow: hidden;
            transition: transform .2s, box-shadow .2s, opacity .18s;
            box-shadow: 0 6px 20px rgba(108,92,231,.28);
        }

        .btn-submit::after {
            content: '';
            position: absolute;
            top: 0; left: -80%;
            width: 60%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transform: skewX(-20deg);
        }

        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(108,92,231,.38); }
        .btn-submit:hover::after { animation: btnShine .65s ease forwards; }
        .btn-submit:active { transform: scale(.97); }
        .btn-submit i { font-size: 16px; }

        .btn-cancel {
            height: 48px;
            padding: 0 1.2rem;
            border: 1.5px solid var(--border);
            border-radius: 11px;
            background: #fff;
            color: var(--text-mid);
            font-family: 'Nunito', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: border-color .2s, background .2s, color .2s, transform .15s;
        }

        .btn-cancel:hover { border-color: var(--purple); color: var(--purple); background: var(--purple-lt); transform: translateY(-1px); }
        .btn-cancel:active { transform: scale(.97); }
        .btn-cancel i { font-size: 15px; }

        /* ── Back to login ── */
        .back-link {
            margin-top: 1.1rem;
            font-size: .72rem;
            color: var(--text-muted);
            text-align: center;
            animation: fadeUp .5s .85s both;
        }

        .back-link a {
            color: var(--purple);
            font-weight: 700;
            text-decoration: none;
        }

       

        /* ══════════════════════════════
           KEYFRAMES
        ══════════════════════════════ */
        @@keyframes spin        { to { transform: rotate(360deg); } }
        @@keyframes cardReveal  { from { opacity: 0; transform: scale(.97); } to { opacity: 1; transform: scale(1); } }
        @@keyframes fadeUp      { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        @@keyframes floatScene  { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
        @@keyframes logoBounce  { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
        @@keyframes blobMorph   { 0%,100% { border-radius: 50% 60% 40% 70% / 60% 40% 70% 50%; } 33% { border-radius: 70% 40% 60% 50% / 40% 70% 30% 60%; } 66% { border-radius: 40% 70% 50% 60% / 70% 30% 60% 40%; } }
        @@keyframes blobMorph2  { 0%,100% { border-radius: 60% 40% 70% 30% / 40% 60% 30% 70%; } 50% { border-radius: 30% 70% 40% 60% / 60% 40% 70% 30%; } }
        @@keyframes dotPulse    { 0%,100% { opacity: .8; transform: scale(1); } 50% { opacity: 1; transform: scale(1.05); } }
        @@keyframes lineExpand  { 0%,100% { width: 40px; opacity: .6; } 50% { width: 70px; opacity: 1; } }
        @@keyframes pulseRing   { 0% { box-shadow: 0 0 0 0 rgba(108,92,231,.4); } 70% { box-shadow: 0 0 0 8px rgba(108,92,231,0); } 100% { box-shadow: 0 0 0 0 rgba(108,92,231,0); } }
        @@keyframes btnShine    { 0% { left: -80%; } 100% { left: 130%; } }

        /* SVG element animations */
        .anim-float  { animation: floatScene 5s ease-in-out infinite; }
        .anim-float2 { animation: floatScene 4.5s 1s ease-in-out infinite; }
        .anim-float3 { animation: floatScene 5.5s .5s ease-in-out infinite; }
        .anim-pulse  { animation: dotPulse 2.5s ease-in-out infinite; }
        .anim-spin   { animation: spin 10s linear infinite; transform-origin: center; transform-box: fill-box; }

        /* Mobile */
        @@media (max-width: 700px) {
            html, body { overflow: auto; }
            .page-wrap  { height: auto; padding: 1rem; align-items: flex-start; }
            .login-card { flex-direction: column; max-height: none; height: auto; border-radius: 18px; }
            .left-panel { min-height: 220px; justify-content: flex-end; }
            .right-panel { padding: 1.8rem 1.5rem; min-width: unset; }
        }
    </style>
</head>
<body>

    <div id="loadingScreen"><div class="loader"></div></div>

    <div class="page-wrap">
        <div class="login-card">

            <!-- ════ LEFT PANEL ════ -->
            <div class="left-panel">
                <div class="blob2"></div>
                <div class="blob3"></div>

                <div class="scene-label">Password Recovery</div>

                <div class="illus-wrap">
                    <svg viewBox="0 0 460 320" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">

                        <!-- ── Floating envelope card (main focal point) ── -->
                        <g class="anim-float" style="transform-origin:230px 160px">
                            <!-- Card shadow -->
                            <ellipse cx="230" cy="230" rx="110" ry="12" fill="rgba(0,0,0,.12)" />
                            <!-- Card body -->
                            <rect x="100" y="90" width="260" height="170" rx="18" fill="rgba(255,255,255,.95)" />
                            <!-- Card header bar -->
                            <rect x="100" y="90" width="260" height="44" rx="18" fill="#6c5ce7" />
                            <rect x="100" y="115" width="260" height="19" fill="#6c5ce7" />
                            <!-- Envelope icon area -->
                            <rect x="148" y="150" width="164" height="86" rx="10" fill="#f0f2ff" />
                            <!-- Envelope flap -->
                            <path d="M148 150 L230 205 L312 150 Z" fill="#dbeafe" />
                            <!-- Envelope body lines -->
                            <line x1="148" y1="236" x2="192" y2="195" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round" />
                            <line x1="312" y1="236" x2="268" y2="195" stroke="#c4b5fd" stroke-width="2" stroke-linecap="round" />
                            <!-- @@ symbol -->
                            <circle cx="230" cy="192" r="16" fill="#fff" />
                            <text x="230" y="198" text-anchor="middle" font-size="16" fill="#6c5ce7" font-family="sans-serif" font-weight="700">@@</text>
                        </g>

                        <!-- ── Lock icon top-right of card ── -->
                        <g class="anim-float2" style="transform-origin:290px 112px">
                            <circle cx="290" cy="112" r="14" fill="rgba(255,255,255,.90)" />
                            <rect x="284" y="113" width="12" height="9" rx="2" fill="#6c5ce7" />
                            <path d="M285 113 Q285 107 290 107 Q295 107 295 113" fill="none" stroke="#6c5ce7" stroke-width="2" stroke-linecap="round" />
                            <circle cx="290" cy="117" r="2" fill="#fff" />
                        </g>

                        <!-- ── Status badge: Email sent ── -->
                        <g class="anim-float3" style="transform-origin:70px 95px">
                            <rect x="10" y="70" width="130" height="46" rx="11" fill="rgba(255,255,255,.94)" />
                            <rect x="18" y="80" width="42" height="13" rx="6" fill="#e0f7f5" />
                            <text x="39" y="90" text-anchor="middle" font-size="7.5" fill="#0d9488" font-family="sans-serif" font-weight="700">Sent</text>
                            <rect x="64" y="80" width="48" height="13" rx="6" fill="#ede9ff" />
                            <text x="88" y="90" text-anchor="middle" font-size="7.5" fill="#6c5ce7" font-family="sans-serif" font-weight="700">OTP Ready</text>
                            <text x="75" y="109" text-anchor="middle" font-size="7.5" fill="#64748b" font-family="sans-serif">Check your inbox</text>
                        </g>

                        <!-- ── Floating OTP code card ── -->
                        <g class="anim-float2" style="transform-origin:380px 100px; animation-delay:1.5s">
                            <rect x="332" y="62" width="120" height="70" rx="11" fill="rgba(255,255,255,.93)" />
                            <rect x="342" y="73" width="60" height="6" rx="3" fill="#c4b5fd" />
                            <text x="392" y="102" text-anchor="middle" font-size="20" fill="#6c5ce7" font-family="monospace" font-weight="800" letter-spacing="4">● ● ●</text>
                            <rect x="342" y="118" width="38" height="9" rx="4" fill="#dcfce7" />
                            <text x="361" y="126" text-anchor="middle" font-size="6.5" fill="#22c55e" font-family="sans-serif" font-weight="700">Expires 10min</text>
                        </g>

                        <!-- ── Shield checkmark badge ── -->
                        <g class="anim-float" style="transform-origin:52px 220px; animation-delay:.8s">
                            <rect x="10" y="198" width="84" height="46" rx="10" fill="rgba(255,255,255,.88)" />
                            <circle cx="30" cy="221" r="12" fill="#e0f7f5" />
                            <text x="30" y="226" text-anchor="middle" font-size="13" fill="#0d9488" font-family="sans-serif">🛡</text>
                            <rect x="50" y="211" width="38" height="5" rx="2.5" fill="#c4b5fd" />
                            <rect x="50" y="221" width="28" height="5" rx="2.5" fill="#e2e8f0" />
                        </g>

                        <!-- ── Sparkle stars ── -->
                        <g class="anim-pulse" style="transform-origin:46px 42px">
                            <circle cx="46" cy="42" r="12" fill="rgba(255,255,255,.28)" />
                            <text x="46" y="48" text-anchor="middle" font-size="13" fill="#fde68a">✦</text>
                        </g>
                        <g class="anim-pulse" style="transform-origin:418px 190px; animation-delay:.9s">
                            <circle cx="418" cy="190" r="9" fill="rgba(255,255,255,.22)" />
                            <text x="418" y="195" text-anchor="middle" font-size="10" fill="#fde68a">✦</text>
                        </g>
                        <g class="anim-pulse" style="transform-origin:400px 42px; animation-delay:1.4s">
                            <circle cx="400" cy="42" r="6" fill="rgba(255,255,255,.18)" />
                            <text x="400" y="47" text-anchor="middle" font-size="8" fill="#fde68a">✦</text>
                        </g>

                        <!-- ── Gear (bottom right) ── -->
                        <g class="anim-spin" style="transform-origin:424px 270px">
                            <circle cx="424" cy="270" r="18" fill="none" stroke="rgba(255,255,255,.35)" stroke-width="4" />
                            <circle cx="424" cy="270" r="7" fill="rgba(255,255,255,.35)" />
                            <line x1="424" y1="247" x2="424" y2="252" stroke="rgba(255,255,255,.35)" stroke-width="5" stroke-linecap="round" />
                            <line x1="424" y1="288" x2="424" y2="293" stroke="rgba(255,255,255,.35)" stroke-width="5" stroke-linecap="round" />
                            <line x1="401" y1="270" x2="406" y2="270" stroke="rgba(255,255,255,.35)" stroke-width="5" stroke-linecap="round" />
                            <line x1="442" y1="270" x2="447" y2="270" stroke="rgba(255,255,255,.35)" stroke-width="5" stroke-linecap="round" />
                        </g>

                        <!-- ── Magnifier (bottom left) ── -->
                        <g style="opacity:.5">
                            <circle cx="46" cy="290" r="20" fill="none" stroke="rgba(255,255,255,.42)" stroke-width="5" />
                            <line x1="62" y1="306" x2="76" y2="320" stroke="rgba(255,255,255,.42)" stroke-width="5" stroke-linecap="round" />
                        </g>

                        <!-- ── Decorative dots row ── -->
                        <circle cx="200" cy="38" r="4" fill="rgba(255,255,255,.35)" class="anim-pulse" />
                        <circle cx="218" cy="28" r="3" fill="rgba(255,255,255,.28)" class="anim-pulse" style="animation-delay:.4s" />
                        <circle cx="236" cy="36" r="2.5" fill="rgba(255,255,255,.22)" class="anim-pulse" style="animation-delay:.8s" />

                    </svg>
                </div>
            </div>

            <!-- ════ RIGHT PANEL ════ -->
            <div class="right-panel">

                @*<img src="~/assets/img/bexlogo_wob(bgremoved.png"
                     alt="BeyondEXS Logo" class="brand-logo"
                     onerror="this.style.display='none';document.getElementById('svgLogo').style.display='block'">*@

                <svg id="svgLogo" style="display:none" class="brand-logo"
                     viewBox="0 0 68 68" xmlns="http://www.w3.org/2000/svg" aria-label="BeyondEXS logo">
                    <circle cx="34" cy="34" r="32" fill="#ede9ff" />
                    <circle cx="34" cy="34" r="22" fill="none" stroke="#0d9488" stroke-width="3" />
                    <ellipse cx="34" cy="34" rx="11" ry="22" fill="none" stroke="#0d9488" stroke-width="2.5" />
                    <line x1="12" y1="34" x2="56" y2="34" stroke="#0d9488" stroke-width="2.5" />
                    <text x="29" y="42" font-size="18" font-weight="800" fill="#6c5ce7" font-family="sans-serif">B</text>
                    <path d="M44 18 L38 30 L43 30 L37 46 L48 30 L42 30 Z" fill="#f97316" />
                </svg>

                <h1>Forgot Password</h1>
                <p class="subtitle">Enter your registered email address and we'll send you a one-time password.</p>

                <!-- Step indicator -->
                <!--<div class="otp-steps">
                    <div class="otp-step active">
                        <div class="otp-step-dot">1</div>
                        <span>Email</span>
                    </div>
                    <div class="otp-step-line"></div>
                    <div class="otp-step">
                        <div class="otp-step-dot">2</div>
                        <span>Verify OTP</span>
                    </div>

                </div>-->

                <!-- Info box -->
                <div class="info-box">
                    <i class="bi bi-info-circle-fill"></i>
                    <span>A 6-digit OTP will be sent to your email. It expires in <strong>10 minutes</strong>. Check your spam folder if not received.</span>
                </div>

                @using (Html.BeginForm("Forgotpassword", "Forgotpassword", FormMethod.Post, new { id = "createform" }))
                {
    @Html.AntiForgeryToken()

                    <div class="field-group">
                        @Html.LabelFor(m => m.EmailId, htmlAttributes: new { @class = "" })
                        <label for="email"><i class="bi bi-envelope"></i> Email Address</label>
                        <div class="input-wrap">
                            <i class="ico bi bi-envelope"></i>
                            @Html.EditorFor(m => m.EmailId, new { htmlAttributes = new { @class = "", autocomplete = "off", placeholder = "Enter your registered email", id = "email", type = "email" } })
                        </div>
                        @Html.ValidationMessageFor(m => m.EmailId, "", new { @class = "text-danger" })
                    </div>

                                    <div class="btn-row">
                                        <button type="submit" class="btn-submit" id="savebutton">
                                            <i class="bi bi-send"></i>
                                            Send OTP
                                        </button>
                                        <button type="button" class="btn-cancel" onclick="window.location.href='@Url.Action("Index", "Login")'">
                                            <i class="bi bi-arrow-left"></i>
                                            Cancel
                                        </button>
                                    </div>

                                                    @Html.ValidationSummary(true, "", new { @class = "text-danger mt-1" })}

                <p class="back-link">
                    Remember your password? <a href="@Url.Action("Index","Login")">Back to Login</a>
                </p>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Loading screen
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                var ls = document.getElementById('loadingScreen');
                ls.style.opacity = '0';
                setTimeout(function () { ls.style.display = 'none'; }, 400);
            }, 450);
        });

        // Form submit
        $(document).ready(function () {
            $('#createform').submit(function (event) {
                event.preventDefault();

                var btn = $('#savebutton');
                btn.prop('disabled', true).html('<i class="bi bi-arrow-repeat" style="animation:spin .7s linear infinite;font-size:16px;display:inline-block"></i> Sending...');
                $('body').css('pointer-events', 'none');

                var formData = new FormData(this);

                $.ajax({
                    url: '@Url.Action("Forgotpassword", "Forgotpassword")',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: 'Processing...',
                                html: 'Please wait while we send your OTP.',
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });
                            setTimeout(function () {
                                Swal.fire({
                                    title: 'OTP Sent!',
                                    text: response.message,
                                    icon: 'success',
                                    confirmButtonText: 'Verify OTP',
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: { confirmButton: 'swal-btn-ok' },
                                    didOpen: () => { $('.swal2-container').css('pointer-events', 'auto'); }
                                }).then(function (result) {
                                    if (result.isConfirmed) {
                                        window.location.href = '@Url.Action("FortgotOTPVerify", "Forgotpassword")';
                                    }
                                });
                            }, 1000);
                        } else {
                            Swal.fire({
                                title: 'Notice',
                                text: response.message,
                                icon: 'info',
                                allowOutsideClick: false,
                                allowEscapeKey: false
                            });
                            resetBtn();
                        }
                    },
                    error: function () {
                        Swal.fire({ title: 'Error', text: 'An unexpected error occurred.', icon: 'error' });
                        resetBtn();
                    }
                });
            });

            function resetBtn() {
                $('#savebutton').prop('disabled', false).html('<i class="bi bi-send"></i> Send OTP');
                $('body').css('pointer-events', 'auto');
            }

            // Ripple on submit button
            document.getElementById('savebutton').addEventListener('click', function (e) {
                var btn  = this;
                var rect = btn.getBoundingClientRect();
                var size = Math.max(rect.width, rect.height);
                var rpl  = document.createElement('span');
                rpl.style.cssText = [
                    'position:absolute','border-radius:50%',
                    'background:rgba(255,255,255,.32)',
                    'width:' + size + 'px','height:' + size + 'px',
                    'top:'  + (e.clientY - rect.top  - size/2) + 'px',
                    'left:' + (e.clientX - rect.left - size/2) + 'px',
                    'transform:scale(0)',
                    'animation:rippleExpand .55s ease forwards',
                    'pointer-events:none'
                ].join(';');
                btn.appendChild(rpl);
                setTimeout(function () { rpl.remove(); }, 600);
            });
        });

        // Back nav prevention
        setTimeout(function () { window.history.forward(); }, 0);
    </script>

    <style>
        @@keyframes spin          { to { transform: rotate(360deg); } }
        @@keyframes rippleExpand  { to { transform: scale(2.4); opacity: 0; } }
        .swal-btn-ok {
            background-color: #6c5ce7 !important;
            color: #fff !important;
            border-radius: 8px !important;
            padding: 8px 22px !important;
            font-weight: 700 !important;
        }
    </style>
</body>
</html>
