@model PSS_CMS.Models.Companies
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Form – Ticket System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link href="~/assets/img/bexlogo_wob (1).png" rel="icon" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link href="~/Content/Companies.css" rel="stylesheet" />

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            min-height: 100%;
            font-family: 'Nunito', sans-serif;
            background: #f0f2f9;
            color: #1a2340;
        }

        /* ── TOP NAV ── */
        .top-nav {
            background: #fff;
            border-bottom: 1px solid #e8edf5;
            padding: .7rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #ede9ff;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-brand-icon i { font-size: 19px; color: #6c5ce7; }

        .nav-brand-text .name { font-size: 15px; font-weight: 700; color: #1a2340; }
        .nav-brand-text .sub  { font-size: 11.5px; color: #9ba8c0; }

        .nav-logo { height: 40px; object-fit: contain; }

        .secure-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: #0d9488;
            font-weight: 600;
        }

        .secure-badge i { font-size: 15px; }

        /* ── PAGE WRAPPER ── */
        .page-wrap {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 2rem 3rem;
        }

        /* ── PAGE HEADING ── */
        .page-heading {
            text-align: center;
            margin-bottom: 1.8rem;
        }

        .page-heading h1 {
            font-size: 1.8rem;
            font-weight: 800;
            color: #1a2340;
            margin-bottom: .3rem;
        }

        .page-heading p {
            font-size: .92rem;
            color: #9ba8c0;
        }

        .page-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 20px;
            background: #ede9ff;
            color: #6c5ce7;
            margin-top: .5rem;
        }

        /* ── PROGRESS STEPS ── */
        .steps-row {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 1.6rem;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .78rem;
            font-weight: 700;
            color: #c5cfe0;
        }

        .step-item.active { color: #6c5ce7; }
        .step-item.done   { color: #0d9488; }

        .step-dot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            border: 2px solid #e2e8f5;
            background: #fff;
            color: #c5cfe0;
            flex-shrink: 0;
        }

        .step-item.active .step-dot {
            background: #6c5ce7;
            border-color: #6c5ce7;
            color: #fff;
            box-shadow: 0 4px 12px rgba(108,92,231,.3);
        }

        .step-item.done .step-dot {
            background: #0d9488;
            border-color: #0d9488;
            color: #fff;
        }

        .step-line {
            flex: 1;
            height: 2px;
            background: #e2e8f5;
            margin: 0 .5rem;
        }

        /* ── MAIN CARD ── */
        .reg-card {
            background: #fff;
            border-radius: 18px;
            border: 1px solid #e8edf5;
            box-shadow: 0 8px 36px rgba(108,92,231,.07);
            overflow: hidden;
        }

        /* ── SECTION HEADER ── */
        .section-header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 1.2rem 2rem 1rem;
            background: #fafaff;
            border-bottom: 1px solid #e8edf5;
        }

        .section-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .section-icon.purple { background: #ede9ff; }
        .section-icon.teal   { background: #e0f7f5; }
        .section-icon.blue   { background: #dbeafe; }

        .section-icon.purple i { color: #6c5ce7; }
        .section-icon.teal   i { color: #0d9488; }
        .section-icon.blue   i { color: #3b82f6; }

        .section-icon i { font-size: 20px; }

        .section-title {
            font-size: 1rem;
            font-weight: 700;
            color: #1a2340;
        }

        .section-sub {
            font-size: .8rem;
            color: #9ba8c0;
            margin-top: 2px;
        }

        /* ── FORM BODY ── */
        .form-body {
            padding: 2rem 2rem 1.5rem;
        }

        .field-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.4rem 2.2rem;
            margin-bottom: 1.4rem;
        }

        .field-row.full { grid-template-columns: 1fr; }

        .field-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .field-group label {
            font-size: .82rem;
            font-weight: 700;
            color: #5a6480;
            display: flex;
            align-items: center;
            gap: 6px;
            letter-spacing: .2px;
        }

        .field-group label i {
            font-size: 16px;
            color: #9ba8c0;
        }

        .field-group label .req {
            color: #ef4444;
            font-size: 12px;
            margin-left: 2px;
        }

        .field-group input,
        .field-group select {
            height: 52px;
            border: 1.5px solid #e2e8f5;
            border-radius: 11px;
            background: #f8faff;
            font-family: 'Nunito', sans-serif;
            font-size: .95rem;
            color: #1a2340;
            padding: 0 16px;
            width: 100%;
            outline: none;
            transition: border-color .18s, box-shadow .18s, background .18s;
        }

        .field-group input::placeholder { color: #c5cfe0; }

        .field-group input:focus,
        .field-group select:focus {
            border-color: #6c5ce7;
            background: #fff;
            box-shadow: 0 0 0 4px rgba(108,92,231,.10);
        }

        .field-hint {
            font-size: .75rem;
            color: #9ba8c0;
        }

        .text-danger {
            font-size: .75rem;
            color: #ef4444;
        }

        /* ── INDUSTRY PICKER ── */
        .industry-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .industry-opt {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 1.1rem 1.25rem;
            border: 1.5px solid #e2e8f5;
            border-radius: 14px;
            cursor: pointer;
            transition: border-color .18s, background .18s;
            background: #f8faff;
        }

        .industry-opt:hover { border-color: #6c5ce7; }

        .industry-opt input[type="radio"] { display: none; }

        .industry-opt.selected {
            border-color: #6c5ce7;
            background: #f3f0ff;
        }

        .industry-icon {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .industry-icon.purple { background: #ede9ff; }
        .industry-icon.teal   { background: #e0f7f5; }
        .industry-icon.purple i { color: #6c5ce7; font-size: 20px; }
        .industry-icon.teal   i { color: #0d9488; font-size: 20px; }

        .industry-label { font-size: .9rem; font-weight: 700; color: #1a2340; }
        .industry-sub   { font-size: .75rem; color: #9ba8c0; margin-top: 2px; }

        /* ── DIVIDER ── */
        .section-divider { border: none; border-top: 1px solid #e8edf5; margin: 0; }

        /* ── FOOTER ── */
        .form-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.25rem 2rem;
            background: #fafaff;
            border-top: 1px solid #e8edf5;
        }

        .footer-note {
            font-size: .82rem;
            color: #9ba8c0;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .footer-note i { font-size: 17px; color: #0d9488; }

        .btn-submit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: .75rem 2.2rem;
            border: none;
            border-radius: 12px;
            background: linear-gradient(90deg, #6c5ce7 0%, #818cf8 100%);
            color: #fff;
            font-family: 'Nunito', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            letter-spacing: .3px;
            cursor: pointer;
            transition: opacity .18s, transform .12s;
            box-shadow: 0 6px 20px rgba(108,92,231,.28);
        }

        .btn-submit:hover   { opacity: .88; }
        .btn-submit:active  { transform: scale(.97); }
        .btn-submit i       { font-size: 17px; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .field-row       { grid-template-columns: 1fr; }
            .industry-grid   { grid-template-columns: 1fr; }
            .form-footer     { flex-direction: column; gap: .75rem; align-items: flex-start; }
            .btn-submit      { width: 100%; justify-content: center; }
            .page-wrap       { padding: 0 1rem 2rem; }
            .top-nav         { padding: .7rem 1rem; }
            .form-body       { padding: 1.5rem 1.25rem; }
            .section-header  { padding: 1rem 1.25rem .8rem; }
            .form-footer     { padding: 1rem 1.25rem; }
        }

        /* swal custom */
        .swal-btn-continue {
            background-color: #6c5ce7 !important;
            color: #fff !important;
            border-radius: 8px;
            padding: 8px 22px;
            font-weight: 700;
        }

        /* ══════════════════════════════════════
           ANIMATIONS
        ══════════════════════════════════════ */

        /* Page load — fade + slide up */
        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(28px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Fade in from left */
        @@keyframes fadeLeft {
            from { opacity: 0; transform: translateX(-22px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* Fade in from right */
        @@keyframes fadeRight {
            from { opacity: 0; transform: translateX(22px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* Subtle scale-in for cards */
       @@keyframes scaleIn {
            from { opacity: 0; transform: scale(.96); }
            to   { opacity: 1; transform: scale(1); }
        }

        /* Nav slide down */
        @@keyframes navSlide {
            from { opacity: 0; transform: translateY(-100%); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Progress step pop */
        @@keyframes stepPop {
            0%   { transform: scale(0.5); opacity: 0; }
            70%  { transform: scale(1.15); }
            100% { transform: scale(1); opacity: 1; }
        }

        /* Continuous pulse ring for active step */
        @@keyframes pulseRing {
            0%   { box-shadow: 0 0 0 0 rgba(108,92,231,.4); }
            70%  { box-shadow: 0 0 0 8px rgba(108,92,231,0); }
            100% { box-shadow: 0 0 0 0 rgba(108,92,231,0); }
        }

        /* Input focus shimmer */
        @@keyframes shimmer {
            0%   { background-position: -200% center; }
            100% { background-position: 200% center; }
        }

        /* Floating label lift */
        @@keyframes labelFloat {
            from { transform: translateY(2px); opacity: .7; }
            to   { transform: translateY(0); opacity: 1; }
        }

        /* Spin for loader */
        @@keyframes spin { to { transform: rotate(360deg); } }

        /* Section header slide-in */
        @@keyframes sectionReveal {
            from { opacity: 0; transform: translateX(-16px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* Badge bounce */
        @@keyframes badgeBounce {
            0%, 100% { transform: translateY(0); }
            40%       { transform: translateY(-5px); }
            60%       { transform: translateY(-2px); }
        }

        /* Button shine sweep */
        @@keyframes btnShine {
            0%   { left: -80%; }
            100% { left: 130%; }
        }

        /* ── Apply page load animations ── */
        .top-nav {
            animation: navSlide .5s cubic-bezier(.22,1,.36,1) both;
        }

        .page-heading {
            animation: fadeUp .6s .1s cubic-bezier(.22,1,.36,1) both;
        }

        .page-badge {
            animation: badgeBounce 2.8s 1.2s ease-in-out infinite;
        }

        .steps-row {
            animation: fadeUp .6s .2s cubic-bezier(.22,1,.36,1) both;
        }

        .step-dot {
            animation: stepPop .5s cubic-bezier(.34,1.56,.64,1) both;
        }

        .step-item:nth-child(1) .step-dot { animation-delay: .3s; }
        .step-item:nth-child(3) .step-dot { animation-delay: .45s; }
        .step-item:nth-child(5) .step-dot { animation-delay: .6s; }

        .step-item.active .step-dot {
            animation: stepPop .5s .3s cubic-bezier(.34,1.56,.64,1) both,
                        pulseRing 2s 1.2s ease-out infinite;
        }

        .reg-card {
            animation: scaleIn .65s .25s cubic-bezier(.22,1,.36,1) both;
        }

        /* ── Section headers reveal on scroll (.revealed added by JS) ── */
        .section-header {
            opacity: 0;
            transform: translateX(-16px);
            transition: opacity .5s ease, transform .5s ease;
        }

        .section-header.revealed {
            opacity: 1;
            transform: translateX(0);
        }

        /* ── Field groups stagger on scroll ── */
        .field-group {
            opacity: 0;
            transform: translateY(18px);
            transition: opacity .45s ease, transform .45s ease;
        }

        .field-group.revealed {
            opacity: 1;
            transform: translateY(0);
        }

        /* ── Industry options stagger ── */
        .industry-opt {
            opacity: 0;
            transform: translateY(14px) scale(.98);
            transition: opacity .4s ease, transform .4s ease,
                        border-color .18s, background .18s;
        }

        .industry-opt.revealed {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        /* ── Inputs: ripple border on focus ── */
        .field-group input,
        .field-group select {
            transition: border-color .22s, box-shadow .22s, background .22s, transform .15s;
        }

        .field-group input:focus,
        .field-group select:focus {
            transform: translateY(-1px);
        }

        /* ── Label animate when sibling input is focused ── */
        .field-group:focus-within label {
            color: #6c5ce7;
            transition: color .2s ease;
        }

        .field-group:focus-within label i {
            color: #6c5ce7;
            transition: color .2s ease;
        }

        /* ── Submit button shine effect ── */
        .btn-submit {
            position: relative;
            overflow: hidden;
        }

        .btn-submit::after {
            content: '';
            position: absolute;
            top: 0;
            left: -80%;
            width: 60%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transform: skewX(-20deg);
        }

        .btn-submit:hover::after {
            animation: btnShine .65s ease forwards;
        }

        .btn-submit:hover {
            opacity: 1;
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(108,92,231,.38);
            transition: transform .2s ease, box-shadow .2s ease;
        }

        .btn-submit:active {
            transform: scale(.97) translateY(0);
        }

        /* ── Nav brand icon spin on hover ── */
        .nav-brand-icon {
            transition: transform .4s cubic-bezier(.34,1.56,.64,1);
        }

        .nav-brand-icon:hover {
            transform: rotate(15deg) scale(1.12);
        }

        /* ── Section icon bounce on hover ── */
        .section-icon {
            transition: transform .3s cubic-bezier(.34,1.56,.64,1);
        }

        .section-header:hover .section-icon {
            transform: scale(1.15) rotate(-6deg);
        }

        /* ── Industry opt hover lift ── */
        .industry-opt:hover {
            border-color: #6c5ce7;
            transform: translateY(-3px) scale(1.01) !important;
            box-shadow: 0 6px 20px rgba(108,92,231,.12);
        }

        .industry-opt.selected {
            border-color: #6c5ce7;
            background: #f3f0ff;
            transform: translateY(-2px) scale(1.005) !important;
            box-shadow: 0 4px 16px rgba(108,92,231,.15);
        }

        /* ── Card hover: faint lift ── */
        .reg-card {
            transition: box-shadow .3s ease;
        }

        /* ── Input icon color transition ── */
        .field-group label i {
            transition: color .2s ease, transform .25s cubic-bezier(.34,1.56,.64,1);
        }

        .field-group:focus-within label i {
            transform: scale(1.2);
        }

        /* ── Step line fill animation ── */
        .step-line {
            position: relative;
            overflow: hidden;
        }

        .step-line::after {
            content: '';
            position: absolute;
            top: 0; left: 0;
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, #0d9488, #6c5ce7);
            border-radius: 2px;
            transition: width .8s .6s ease;
        }

        .steps-row.revealed .step-line::after {
            width: 100%;
        }

        /* ── Footer reveal ── */
        .form-footer {
            opacity: 0;
            transform: translateY(12px);
            transition: opacity .5s ease, transform .5s ease;
        }

        .form-footer.revealed {
            opacity: 1;
            transform: translateY(0);
        }

    </style>
</head>
<body>

    <!-- ── TOP NAV ── -->
    <nav class="top-nav">
        <div class="nav-brand">
            <div class="nav-brand-icon">
                <i class="bi bi-ticket-perforated-fill"></i>
            </div>
            <div class="nav-brand-text">
                <div class="name">Ticket System</div>
                <div class="sub">BeyondEXS Platform</div>
            </div>
        </div>

        <img src="~/assets/img/bexlogo_wob.png" class="nav-logo" alt="BeyondEXS Logo"
             onerror="this.style.display='none'" />

        <div class="secure-badge">
            <i class="bi bi-shield-check"></i>
            Secure Registration
        </div>
    </nav>

    <!-- ── PAGE ── -->
    <div class="page-wrap">

        <!-- heading -->
        <div class="page-heading">
            <h1>Prospective Customer Registration</h1>
            <p>Create your organisation account to access the support ticket system.</p>
            <div class="page-badge">
                <i class="bi bi-building" style="font-size:13px"></i>
                Ticket System Onboarding
            </div>
        </div>

        <!-- progress steps -->
        <div class="steps-row">
            <div class="step-item done">
                <div class="step-dot"><i class="bi bi-check" style="font-size:13px"></i></div>
                <span>Organisation</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item active">
                <div class="step-dot">2</div>
                <span>Contact</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item">
                <div class="step-dot">3</div>
                <span>Credentials</span>
            </div>
        </div>

        <!-- main card -->
        <div class="reg-card">

            @using (Html.BeginForm("Index", "CompanyRegistration", FormMethod.Post, new { id = "regform", enctype = "multipart/form-data" }))
            {
@Html.AntiForgeryToken() <!-- ── SECTION 1: Organisation ── -->
                                <div class="section-header">
                                    <div class="section-icon purple"><i class="bi bi-building"></i></div>
                                    <div>
                                        <div class="section-title">Organisation details</div>
                                        <div class="section-sub">Basic info about your company</div>
                                    </div>
                                </div>

                                                <div class="form-body">
                                                    <div class="field-row">
                                                        <div class="field-group">
                                                            <label for="C_CODE"><i class="bi bi-hash"></i> Company code <span class="req">*</span></label>
                                                            <div>
                                                                @Html.EditorFor(m => m.C_CODE, new { htmlAttributes = new { @class = "form-control", autocomplete = "off", tabindex = "1", required = "required", placeholder = "e.g. COMP001" } })
                                                                @Html.ValidationMessageFor(m => m.C_CODE, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                        <div class="field-group">
                                                            <label for="C_WEB"><i class="bi bi-globe2"></i> Website <span class="req">*</span></label>
                                                            <div>
                                                                @Html.EditorFor(m => m.C_WEB, new { htmlAttributes = new { @class = "form-control", autocomplete = "off", tabindex = "2", required = "required", placeholder = "https://yourcompany.com" } })
                                                                @Html.ValidationMessageFor(m => m.C_WEB, "", new { @class = "text-danger" })
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="field-row">
                                                        <div class="field-group">
                                                            <label for="C_NAME"><i class="bi bi-briefcase"></i> Company name <span class="req">*</span></label>
                                                            <div>
                                                                @Html.EditorFor(m => m.C_NAME, new { htmlAttributes = new { @class = "form-control", autocomplete = "off", tabindex = "3", required = "required", placeholder = "Acme Corp Pvt. Ltd." } })
