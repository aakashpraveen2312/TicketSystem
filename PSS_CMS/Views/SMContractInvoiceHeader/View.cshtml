
@model PSS_CMS.Models.ContractInvoiceHeader

@{ ViewData["Title"] = "View Invoice";
    ViewBag.PageTitle = "View Invoice";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-receipt nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("List", "SMContractInvoiceHeader")">Invoice History</a>
    <i class="bi bi-chevron-right"></i>
    <span>View</span>
</div>

@using (Html.BeginForm("EditInvoice", "SMContractInvoiceHeader", FormMethod.Post, new { id = "createform", @class = "no-preloader" }))
{
@Html.AntiForgeryToken()

                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span class="title-icon">
                                <i class="bi bi-plus-circle"></i>
                            </span>
                            View Invoice
                        </h6>
                    </div>

                    <!-- Form Body -->
                    <div class="form-body">

                        <p class="form-section-title">Invoice </p>

                        <div class="form-grid">

                            <!-- Invoice No -->
                            <div class="form-group">
                                <label class="form-label">
                                    @Html.DisplayNameFor(m => m.CIH_INVOICENO)
                                    <span class="req">*</span>
                                </label>

                                @Html.TextBoxFor(m => m.CIH_INVOICENO, new
                           {
                               @class = "form-input-text",
                               autocomplete = "off",
                               placeholder = "Enter invoice number",
                               @readonly = "readonly"
                           })

                            </div>

                            <!-- Invoice Date -->
                            <div class="form-group">
                                <label class="form-label">
                                    @Html.DisplayNameFor(m => m.CIH_INVOICEDATE)
                                    <span class="req">*</span>
                                </label>

                                @Html.TextBoxFor(m => m.CIH_INVOICEDATE, "{0:yyyy-MM-ddTHH:mm}", new
                           {
                               @class = "form-input-text",
                               type = "datetime-local",
                               autocomplete = "off",
                               @readonly = "readonly"
                           })

                            </div>

                            <!-- Invoice Amount -->
                            <div class="form-group">

                                <label class="form-label">
                                    @Html.DisplayNameFor(m => m.CIH_TOTALINVOICEAMOUNT)
                                    <span class="req">*</span>
                                </label>

                                @Html.TextBoxFor(m => m.CIH_TOTALINVOICEAMOUNT, new
                           {
                               @class = "form-input-num",
                               type = "number",
                               step = "0.01",
                               min = "0",
                               placeholder = "0.00",
                               @readonly = "readonly"
                           })

                                @Html.ValidationMessageFor(m => m.CIH_TOTALINVOICEAMOUNT, "", new { @class = "text-danger" })
                            </div>



                        </div>

                    </div>

                    <!-- Legend -->
                    <div class="legend-bar">

                        <div class="legend-item">
                            <span class="field-dot dot-text"></span>
                            <span>Text Field</span>
                        </div>

                        <div class="legend-item">
                            <span class="field-dot dot-num"></span>
                            <span>Number Field</span>
                        </div>

                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("List", "SMContractInvoiceHeader",new { companyId=  Session["companyId"],CIH_CONTRACTRECID = Session["CIH_CONTRACTRECID"] })" class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>

                </div>}

@section Scripts {

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

}

