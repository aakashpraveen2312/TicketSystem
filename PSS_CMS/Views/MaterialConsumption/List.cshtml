@model IEnumerable<PSS_CMS.Models.Materialconsumption>

@{ ViewData["Title"] = "Material Consumption";
    ViewBag.PageTitle = "Material Consumption";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string searchPhrase = Request["searchPharse"] ?? "";
    string typeName = Session["Type"]?.ToString() ?? "";
    string pName = Session["P_NAME"]?.ToString() ?? "";

    var filtered = Model?.Where(m =>
        string.IsNullOrEmpty(searchPhrase) ||
        (m.TM_MNAME != null && m.TM_MNAME.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (m.tM_TYPE != null && m.tM_TYPE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (m.tM_UOM != null && m.tM_UOM.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
    ).ToList();
 }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    @if (!string.IsNullOrEmpty(pName))
    {
<a href="@Url.Action("RecentTicket","RecentTickets")">@pName</a>
                <i class="bi bi-chevron-right"></i>}
    @if (!string.IsNullOrEmpty(typeName))
    {
@typeName
                <i class="bi bi-chevron-right"></i>}
    <span>List</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("List", "MaterialConsumption", FormMethod.Get, new { id = "searchForm" }))
            {
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               id="searchPharse"
               name="searchPharse"
               placeholder="Search"
               autocomplete="off"
               value="@searchPhrase"
               onkeyup="autoSubmitSearch(this)" />
        @if (!string.IsNullOrEmpty(searchPhrase))
        {
    <a href="@Url.Action("List","MaterialConsumption")" title="Clear">
        <i class="bi bi-x-circle text-muted"></i>
    </a>}
    </div>      }

            <!-- Add -->
            <a href="@Url.Action("Create","MaterialConsumption")" class="btn-add">
                <i class="bi bi-plus-lg"></i> Add Line Item
            </a>

        </div>
    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>
        <tr>
            <th>Line Item</th>
            
            <th>Type</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Price</th>
            <th class="text-end">Discount (%)</th>
            <th class="text-end">SGST (%)</th>
            <th class="text-end">CGST (%)</th>
            <th class="text-end">Total Amount</th>
            <th class="text-end">Net Amount</th>
            <th class="text-center" style="width:100px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var o in Model)
        {
            var editUrl = Url.Action("Edit", "MaterialConsumption", new
            {
                MACRecid = o.tM_RECID,
                MACNAME = o.TM_MNAME,
                TICRECID = o.tM_TCRECID,
                TM_MGRECID = o.tM_MGRECID,
                TM_MRECID = o.tM_MRECID,
                TM_MCRECID = o.tM_MCRECID
            });

            var deleteUrl = Url.Action("Delete", "MaterialConsumption", new { Recid = o.tM_RECID });

            string typeLower = (o.tM_TYPE ?? "").ToLower();
            string typeCls = typeLower == "material" ? "type-material"
                             : typeLower == "service" ? "type-service"
                             : "type-other";

<tr>
    <td>@o.TM_MNAME</td>

    <td>
        <span class="type-badge @typeCls">@o.tM_TYPE</span>
    </td>
    <td class="text-end">@o.tM_QUANTITY</td>
    <td class="amount-cell">@o.tM_PRICE.ToString("F2")</td>
    <td class="text-end">@o.tM_DISCOUNT.ToString("F2")</td>
    <td class="text-end">@o.tM_SGST.ToString("F2")</td>
    <td class="text-end">@o.tM_CGST.ToString("F2")</td>
    <td class="amount-cell">@o.tM_TOTALAMOUNT.ToString("F2")</td>
    <td class="net-amount-cell">@o.tM_NETAMOUNT.ToString("F2")</td>
    <td>
        <div class="action-cell">

            <!-- Edit -->
            <a href="@editUrl"
               class="act-btn act-edit"
               title="Edit">
                <i class="bx bxs-pencil"></i>
            </a>

            <!-- Delete -->
            <a href="@deleteUrl"
               class="act-btn act-delete no-loader"
               title="Delete"
               data-name="@o.TM_MNAME"
               onclick="return confirmDelete(this);">
                <i class="bx bxs-trash"></i>
            </a>

        </div>
    </td>
</tr>}
    </tbody>

</table> <!-- Pagination -->

                <div class="table-pagination">

                    <button id="prevBtn"
                            class="page-btn">

                        <i class="bi bi-chevron-left"></i>

                        Previous

                    </button>

                    <span id="pageInfo"
                          class="page-info">
                    </span>

                    <button id="nextBtn"
                            class="page-btn">

                        Next

                        <i class="bi bi-chevron-right"></i>

                    </button>

                </div> }
            else
            {
<div class="text-center py-5">
    <i class="bi bi-inbox" style="font-size:40px;color:var(--text-muted)"></i>
    <p class="mt-2 text-muted fw-semibold">No line items available</p>
</div>}

    </div>

</div>

<!-- Legend bar -->
<div class="legend-bar">

    <div class="legend-item">
        <i class="bx bxs-pencil" style="color:#6c5ce7;font-size:16px"></i>
        <span>Edit</span>
    </div>

    <div class="legend-item">
        <i class="bx bxs-trash" style="color:#e74c3c;font-size:16px"></i>
        <span>Delete</span>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Fordelete.js"></script>
    <script src="~/Scripts/UIPagination.js"></script>

    <script>
        /* ── Disabled page-btn should not navigate ── */
        document.querySelectorAll('.page-btn.disabled').forEach(function (el) {
            el.addEventListener('click', function (e) { e.preventDefault(); });
        });
    </script>
}
