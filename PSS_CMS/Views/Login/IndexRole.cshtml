    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function togglePwd() {
            var pw = document.getElementById('L_PASSWORD');
            var ic = document.getElementById('eyeIco');
            if (pw.type === 'password') {
                pw.type = 'text';
                ic.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>';
            } else {
                pw.type = 'password';
                ic.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
            }
        }

        var typingTimer;
        $('#L_USERNAME').on('keyup', function () {
            clearTimeout(typingTimer);
            var val = $(this).val();
            if (val.length >= 3) {
                typingTimer = setTimeout(function () {
                    $.ajax({
                        url: '@Url.Action("AutoNameFetch","Login")' + '?input=' + encodeURIComponent(val),
                        type: 'GET',
                        success: function (r) { $('#welcomeName').text(r.name ? 'Welcome! ' + r.name : ''); },
                        error: function () {}
                    });
                }, 500);
            } else { $('#welcomeName').text(''); }
        });

        @if (TempData["ErrorMessage"] != null)
        {
            <text>
            Swal.fire({
                icon: 'info',
                text: '@TempData["ErrorMessage"]',
                showConfirmButton: true,
                confirmButtonColor: '#6c5ce7'
            }).then(function (r) {
                if (r.isConfirmed) {
                    document.getElementById('loadingScreen').style.display = 'flex';
                    window.location.href = '@Url.Action("IndexRole", "Login")';
                }
            });
            </text>
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('loadingScreen').style.display = 'flex';
        });
        window.addEventListener('load', function () {
            setTimeout(function () {
                document.getElementById('loadingScreen').style.display = 'none';
            }, 450);
        });

        setTimeout(function () { window.history.forward(); }, 0);
    </script>
    <script>
        // Push current page to history stack
        history.pushState(null, null, location.href);

        // Disable browser back
        window.onpopstate = function () {
            history.go(1);
        };

        // Prevent page from loading from cache
        window.onload = function () {
            window.history.forward();

            // Extra protection for browser cache
            if (performance.navigation.type === 2) {
                location.reload(true);
            }
        };

        // Disable backspace browser navigation outside inputs
        document.addEventListener("keydown", function (e) {
            if (e.key === "Backspace") {
                var d = e.target.tagName.toLowerCase();

                if (d !== 'input' && d !== 'textarea') {
                    e.preventDefault();
                }
            }
        });
    </script>

    <script>
        // Load remembered credentials
        window.onload = function () {

            var remember = localStorage.getItem("rememberMe");

            if (remember === "true") {

                document.getElementById("rememberMe").checked = true;

                document.getElementById("L_USERNAME").value =
                    localStorage.getItem("username") || "";

                document.getElementById("L_PASSWORD").value =
                    localStorage.getItem("password") || "";

                document.getElementById("L_DOMAIN").value =
                    localStorage.getItem("domain") || "";
            }
        };

        // Save credentials on form submit
        document.getElementById("roleForm").addEventListener("submit", function () {

            if (document.getElementById("rememberMe").checked) {

                localStorage.setItem(
                    "username",
                    document.getElementById("L_USERNAME").value
                );

                localStorage.setItem(
                    "password",
                    document.getElementById("L_PASSWORD").value
                );

                localStorage.setItem(
                    "domain",
                    document.getElementById("L_DOMAIN").value
                );

                localStorage.setItem("rememberMe", "true");

            } else {

                localStorage.removeItem("username");
                localStorage.removeItem("password");
                localStorage.removeItem("domain");
                localStorage.removeItem("rememberMe");
            }
        });
    </script>
    <script>
        document.getElementById('roleForm').addEventListener('submit', function () {
            document.getElementById('loginLoader').classList.add('active');
        });
    </script>
</body>
</html>