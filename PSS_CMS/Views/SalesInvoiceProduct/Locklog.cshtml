@model IEnumerable<PSS_CMS.Models.LockLog>
@using GridMvc.Html

@{ ViewData["Title"] = "Data Audit";
    ViewBag.PageTitle = "Data Audit";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-shield-check nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Data Audit</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-shield-check" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Lock Log
        </h6>

        <!-- Date Filter -->
        <form method="get" action="@Url.Action("Locklog", "SalesInvoiceProduct")"
              style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">

            <div style="display:flex;align-items:center;gap:6px;">
                <label style="font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap;">From</label>
                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="form-input-text"
                       style="width:150px;padding:7px 10px;font-size:12px;" />
            </div>

            <div style="display:flex;align-items:center;gap:6px;">
                <label style="font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap;">To</label>
                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="form-input-text"
                       style="width:150px;padding:7px 10px;font-size:12px;" />
            </div>

            <button type="submit" class="btn-save" style="padding:7px 16px;font-size:12px;">
                <i class="bi bi-funnel"></i> Filter
            </button>

        </form>
    </div>

    <!-- Table -->
    <div class="grid-wrap">
        @if (Model != null && Model.Any())
        {
<table>
    <thead>
        <tr>
            <th style="width:60px;">S.No</th>
            <th>Date of Unlock</th>
            <th>Transaction Type</th>
            <th>Unlock By</th>
            <th>Reason</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
<tr>
    <td>
        <span class="serial-text">@item.SerialNumber</span>
    </td>
    <td>
        @(string.IsNullOrEmpty(item.LL_DATETIME)
                                    ? ""
                                    : Convert.ToDateTime(item.LL_DATETIME).ToString("dd-MM-yyyy"))
    </td>
    <td>
        <span class="service-badge">@item.LL_TRANSACTIONTYPE</span>
    </td>
    <td>@item.UnlockUserName</td>
    <td style="color:var(--text-muted);font-size:12.5px;">@item.LL_REASON</td>
</tr>}
    </tbody>
</table> <!-- Pagination -->

                <div class="table-pagination">

                    <button id="prevBtn"
                            class="page-btn">

                        <i class="bi bi-chevron-left"></i>

                        Previous

                    </button>

                    <span id="pageInfo"
                          class="page-info">
                    </span>

                    <button id="nextBtn"
                            class="page-btn">

                        Next

                        <i class="bi bi-chevron-right"></i>

                    </button>

                </div>}
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-shield-check" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No audit log entries found</span>
    <p style="font-size:12px;margin-top:6px;">Try adjusting the date range filter above.</p>
</div>}
    </div>

</div><!-- /page-card -->
<!-- Legend bar — read-only audit log, no actions -->
<div class="legend-bar">
    <div class="legend-item">
        <i class="bi bi-shield-check" style="font-size:12px;color:#3498db;"></i>
        <span>Audit / Unlock Log</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/UIPagination.js"></script>
}
