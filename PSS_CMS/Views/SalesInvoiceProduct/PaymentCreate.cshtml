@model PSS_CMS.Models.InvoicePayment

@{ ViewData["Title"] = "Payment Create";
    ViewBag.PageTitle = "Payment Create";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Two-column form grid ──────────────────── */
        .pay-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px 32px;
            padding: 28px 28px 8px;
        }

        @@media (max-width: 680px) {
            .pay-grid {
                grid-template-columns: 1fr;
            }
        }

        .pay-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            /* span full width */
            .pay-group.full {
                grid-column: 1 / -1;
            }

        /* ── Field label ───────────────────────────── */
        .pay-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .pay-label .req {
                color: #E24B4A;
            }

        /* ── Actions row ───────────────────────────── */
        .pay-actions {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            padding: 20px 28px 24px;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-credit-card nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("PaymentList", "SalesInvoiceProduct")">Payment List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-credit-card" style="font-size:15px;color:#3C3489;"></i>
            </span>
            New Payment Entry
        </h6>
    </div>

    @using (Html.BeginForm("PaymentCreate", "SalesInvoiceProduct", FormMethod.Post, new { id = "paymentform", @class = "no-preloader" }))
    {<!-- ── 2-column field grid ── -->
                <div class="pay-grid">

                    <!-- Row 1 -->
                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_INVOICENUMBER, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_INVOICENUMBER, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly" } })
                    </div>

                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_INVOICEDATE, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_INVOICEDATE, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", type = "date", @readonly = "readonly" } })
                    </div>

                    <!-- Row 2 -->
                    <div class="pay-group">
                        <label class="pay-label">
                            @Html.LabelFor(m => m.PP_MODEOFPAYMENT)
                            <span class="req">*</span>
                        </label>
                        @Html.DropDownListFor(m => m.PP_MODEOFPAYMENT,
                                 new List<SelectListItem>
                                 {
                        new SelectListItem { Text = "Select Payment Mode", Value = "" },
                        new SelectListItem { Text = "Cash", Value = "Cash" },
                        new SelectListItem { Text = "UPI",  Value = "UPI"  },
                        new SelectListItem { Text = "Bank Transfer", Value = "Bank Transfer" },
                        new SelectListItem { Text = "Cheque", Value = "Cheque" }
                         },
                                 new { @class = "form-select-input" })
                    </div>

                    <div class="pay-group">
                        <label class="pay-label">
                            @Html.LabelFor(m => m.PP_DATEOFPAYMENT)
                            <span class="req">*</span>
                        </label>
                        @Html.EditorFor(m => m.PP_DATEOFPAYMENT, new { htmlAttributes = new { @class = "form-input-text", autocomplete = "off", type = "date" } })
                    </div>

                    <!-- Row 3 -->
                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_SOFARPAID, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_SOFARPAID, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", placeholder = "0.00", @readonly = "readonly", id = "SoFarPaid" } })
                    </div>

                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_TOTALAMOUNT, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_TOTALAMOUNT, new { htmlAttributes = new { @class = "form-input-auto", autocomplete = "off", @readonly = "readonly", id = "TotalAmount" } })
                    </div>

                    <!-- Row 4 -->
                    <div class="pay-group">
                        <label class="pay-label">
                            @Html.LabelFor(m => m.PP_PAIDAMOUNT)
                            <span class="req">*</span>
                        </label>
                        @Html.EditorFor(m => m.PP_PAIDAMOUNT, new { htmlAttributes = new { @class = "form-input-num", autocomplete = "off", id = "PaidAmount", placeholder = "0.00" } })
                    </div>

                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_BALANCEAMOUNT, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_BALANCEAMOUNT, new { htmlAttributes = new { @class = "form-input-auto",  autocomplete = "off", id = "BalanceAmount", @readonly = "readonly" } })
                    </div>

                    <!-- Row 5 — Payment Status (full width) -->
                    <div class="pay-group">
                        @Html.LabelFor(m => m.PP_PAYMENTSTATUS, new { @class = "pay-label" })
                        @Html.EditorFor(m => m.PP_PAYMENTSTATUS, new { htmlAttributes = new { @class = "form-input-auto",  autocomplete = "off", id = "PaymentStatus", @readonly = "readonly" } })
                        <span class="auto-badge"><i class="bi bi-info-circle"></i> Auto-updated</span>
                    </div>

                </div> <!-- ── Actions ── -->
                                                <div class="pay-actions">
                                                    <a href="@Url.Action("PaymentList", "SalesInvoiceProduct")" class="btn-cancel">
                                                        <i class="bi bi-x-lg"></i> Cancel
                                                    </a>
                                                    <button type="submit" class="btn-save" id="savebutton">
                                                        <i class="bi bi-floppy"></i> Update Payment
                                                    </button>
                                                </div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
        <span>Read-only Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
        <span>Text Field</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
        <span>Number Field</span>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Logoutjs.js"></script>

    <script>
        $(document).ready(function () {

            // ── Live calculation ────────────────────────
            function updateCalculation() {
                var total  = parseFloat($("#TotalAmount").val())  || 0;
                var soFar  = parseFloat($("#SoFarPaid").val())    || 0;
                var paid   = parseFloat($("#PaidAmount").val())   || 0;

                var newSoFar = soFar + paid;
                var balance  = total - newSoFar;

                $("#BalanceAmount").val(balance.toFixed(2));

                var status = "";
                var color  = "var(--text-dark)";

                if (newSoFar > 0) {
                    if (newSoFar >= total) {
                        status = "FULLY PAID";
                        color  = "#1D9E75";
                    } else {
                        status = "PARTIALLY PAID";
                        color  = "#e6a817";
                    }
                }

                $("#PaymentStatus").val(status).css("color", color);
            }

            $("#PaidAmount").on("input", function () {
                var total = parseFloat($("#TotalAmount").val()) || 0;
                var soFar = parseFloat($("#SoFarPaid").val())   || 0;
                var paid  = parseFloat($(this).val())           || 0;

                if ((soFar + paid) > total) {
                    Swal.fire({
                        icon: "warning",
                        title: "Invalid Amount",
                        text: "Total paid cannot exceed the invoice amount."
                    });
                    $(this).val("");
                    updateCalculation();
                    return;
                }

                updateCalculation();
            });

            updateCalculation();

            // ── Form Submit ─────────────────────────────
            $("#paymentform").on("submit", function (e) {
                e.preventDefault();

                $("#savebutton").prop("disabled", true);
                $("body").css("pointer-events", "none");

                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: new FormData(this),
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: "Processing...",
                                html: "Please wait while we update your payment details.",
                                allowOutsideClick: false,
                                allowEscapeKey: false,
                                didOpen: () => { Swal.showLoading(); }
                            });

                            setTimeout(function () {
                                Swal.fire({
                                    title: "Success!",
                                    text: response.message,
                                    icon: "success",
                                    confirmButtonText: "Back to List",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false,
                                    customClass: { confirmButton: "swal-btn-continue" },
                                    didOpen: () => { $(".swal2-container").css("pointer-events", "auto"); }
                                }).then(function () {
                                    window.location.href = '@Url.Action("PaymentList", "SalesInvoiceProduct")';
                                });
                            }, 1000);

                        } else {
                            Swal.fire({ title: "Message", text: response.message, icon: "info", allowOutsideClick: false, allowEscapeKey: false });
                            resetForm();
                        }
                    },
                    error: function () {
                        Swal.fire({ title: "Error!", text: "An unexpected error occurred.", icon: "error", allowOutsideClick: false, allowEscapeKey: false });
                        resetForm();
                    }
                });
            });

            function resetForm() {
                $("#savebutton").prop("disabled", false);
                $("body").css("pointer-events", "auto");
            }
        });
    </script>
}
