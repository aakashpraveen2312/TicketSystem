@model IEnumerable<PSS_CMS.Models.Contract>

@{
    ViewData["Title"] = "Party List";
    ViewBag.PageTitle = "Party List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string searchPhrase = Request["searchPharse"] ?? "";

    var filtered = Model?.Where(x =>
        string.IsNullOrEmpty(searchPhrase) ||
        (x.CT_CODE != null && x.CT_CODE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (x.CT_CUSTOMERNAME != null && x.CT_CUSTOMERNAME.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (x.CT_EMAIL != null && x.CT_EMAIL.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0) ||
        (x.CT_MOBILE != null && x.CT_MOBILE.IndexOf(searchPhrase, StringComparison.OrdinalIgnoreCase) >= 0)
    ).ToList();
}

@section Styles {

    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-people nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Party</span>
    <i class="bi bi-chevron-right"></i>
    List
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("ContractList", "Contract", FormMethod.Get, new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@searchPhrase"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(searchPhrase))
                    {
                        <a href="@Url.Action("ContractList","Contract")" title="Clear">
                            <i class="bi bi-x-circle text-muted"></i>
                        </a>
                    }

                </div>
            }

            <!-- Add -->
            <a href="@Url.Action("CreateContract", "Contract")"
               class="btn-add">

                <i class="bi bi-plus-circle"></i>
                Create Party

            </a>

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (filtered != null && filtered.Any())
        {

            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center" style="width:70px;">S.No</th>

                        <th style="min-width:120px;">Code</th>

                        <th style="min-width:220px;">Customer</th>

                        <th style="min-width:150px;">Mobile</th>

                        <th class="text-center" style="width:90px;">Sort</th>

                        <th class="text-center" style="width:170px;">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in filtered)
                    {
                        var editUrl = Url.Action("EditContract", "Contract",
                            new
                            {
                                CT_RECID = o.CT_RECID,
                                CT_CONTRACTREFERENCENUMBER = o.CT_CUSTOMERNAME
                            });

                        var contractUrl = Url.Action("ContractProductList", "Contract",
                            new
                            {
                                CT_CUSTOMERNAME = o.CT_CUSTOMERNAME,
                                CT_RECID = o.CT_RECID,
                                CT_PRECID = o.CT_PRECID,
                                ProductName = o.ProductName,
                                CT_URECID = o.CT_URECID,
                                CT_EXISTINGUSER = o.CT_EXISTINGUSER
                            });

                        var deleteUrl = Url.Action
                            ("DeleteContract",
                            "Contract",
                            new
                            {
                                id = o.CT_RECID
                            });

                        <tr>

                            <td class="text-center serial-text">
                                @o.SerialNumber
                            </td>

                            <td>
                                <span class="customer-code">
                                    @o.CT_CODE
                                </span>
                            </td>

                            <td>

                                <div class="customer-name">
                                    @o.CT_CUSTOMERNAME
                                </div>

                                <div class="customer-email">
                                    @o.CT_EMAIL
                                </div>

                            </td>

                            <td>
                                <i class="bi bi-telephone-fill" style="color: #3498db;"></i>

                                @o.CT_MOBILE
                            </td>

                            <td class="text-center">

                                <span class="sort-badge">
                                    @o.CT_SORTORDER
                                </span>

                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- Edit -->
                                    <a href="@editUrl"
                                       class="act-btn act-edit"
                                       title="Edit">

                                        <i class='bx bxs-pencil'></i>

                                    </a>

                                    <!-- Delete -->
                                    <!-- Delete — FIXED -->
                                    <a href="@deleteUrl"
                                       class="act-btn act-delete no-loader"
                                       title="Delete"
                                       data-name="@o.CT_CUSTOMERNAME"
                                       onclick="return confirmDelete(this);">
                                        <i class='bx bxs-trash'></i>
                                    </a>

                                    <!-- Contract -->
                                    <a href="@contractUrl"
                                       class="act-btn"
                                       title="Contracts">

                                        <i class="bi bi-card-text"
                                           style="color:#1D9E75"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->
            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

        }
        else
        {
            <div class="empty-wrap">

                <i class="bi bi-inbox"></i>

                <h5>No parties available</h5>

            </div>
        }

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    <div class="legend-item">

        <span class="act-btn act-edit"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-pencil'></i>

        </span>

        Edit

    </div>

    <div class="legend-item">

        <span class="act-btn act-delete"
              style="width:22px;height:22px;font-size:13px">

            <i class='bx bxs-trash'></i>

        </span>

        Delete

    </div>

    <div class="legend-item">
        <i class="bi bi-card-text"
           style="color: #1D9E75; width: 22px; height: 22px; font-size: 13px"></i>

        <span>Contracts</span>
    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>


}