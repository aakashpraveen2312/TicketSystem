@model PSS_CMS.Models.ContractServiceProduct

@{
    ViewData["Title"] = "Create Contract Product";
    ViewBag.PageTitle = "Create Contract Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/Content/UIListView.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

    <style>

        .select2-container--default .select2-selection--single {
            height: 38px;
            border: 1px solid var(--border-color);
            border-left: 3px solid var(--primary);
            border-radius: 10px;
            padding: 4px 10px;
            font-size: 13px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99,89,210,.08);
        }

        .select2-container {
            width: 100% !important;
        }

       

       

     
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-box-seam nav-icon"></i>
    <i class="bi bi-chevron-right"></i>

    <span>Party</span>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("ContractList", "Contract")">
        @Session["CT_CUSTOMERNAME"].ToString()
    </a>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("ContractProductList", "Contract")">
        Contract (@Session["CP_CODE"].ToString().ToUpper())
    </a>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("List", "ContractProduct")">
        Products
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Create</span>
</div>

@using (Html.BeginForm("Create", "ContractProduct", FormMethod.Post,
new { id = "createform", @class = "no-preloader" }))
{
    <div class="page-card">

        <!-- Header -->
        <div class="page-card-header">

            <h6 class="page-card-title">
                <span class="title-icon">
                    <i class="bi bi-plus-circle"></i>
                </span>

                Create Contract Product
            </h6>

        </div>

        <!-- Form -->
        <div class="form-body">

          

            <div class="form-grid">

                <!-- Product -->
                <div class="form-group">

                    <label class="form-label">
                        @Html.LabelFor(model => model.CSP_PRECID)
                        <span class="req">*</span>
                    </label>

                    @if (ViewBag.Product != null)
                    {
                        var ProductList = ViewBag.Product as IEnumerable<SelectListItem>;

                        if (ProductList != null && ProductList.Any())
                        {
                            var modifiedProductList = new List<SelectListItem>(ProductList);

                            if (modifiedProductList.Count > 1)
                            {
                                modifiedProductList.Insert(0, new SelectListItem
                                {
                                    Text = "-- Select Product --",
                                    Value = ""
                                });
                            }
                            else
                            {
                                modifiedProductList[0].Selected = true;
                            }

                            @Html.DropDownList("SelectedProduct",
                                modifiedProductList,
                                new
                                {
                                    @class = "form-select-input",
                                    id = "SelectedProduct"
                                })
                        }
                        else
                        {
                            <div class="text-danger">
                                No Products Available
                            </div>
                        }
                    }

                </div>

                <!-- Service Engineer -->
                <div class="form-group">

                    <label class="form-label">
                        Service Engineer
                    </label>

                    <div class="engineer-card">

                      

                        <div style="flex:1;">

                            <select id="AdminDropdown"
                                    class="form-select-input"
                                    disabled>
                                <option value="">
                                    -- Select Service Engineer --
                                </option>
                            </select>

                            <input type="hidden"
                                   id="CSP_ARECID"
                                   name="CSP_ARECID" />

                        </div>

                    </div>

                </div>

                <!-- Serial Number -->
                <div class="form-group">

                    <label class="form-label">
                        Product Serial Number
                    </label>

                    @Html.EditorFor(model => model.CSP_PRODUCTUNIQUENUMBER,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-input-text",
                            autocomplete = "off",
                            placeholder = "Enter serial number"
                        }
                    })

                </div>

                <!-- Amount -->
                <div class="form-group">

                    <label class="form-label">
                        Contract Product Amount
                    </label>

                    @Html.EditorFor(model => model.CSP_PRODUCTAMOUNT,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-input-num",
                            autocomplete = "off",
                            placeholder = "0"
                        }
                    })

                </div>

                <!-- Free Service -->
                <div class="form-group">

                    <label class="form-label">
                        Free Services
                    </label>

                    @Html.EditorFor(model => model.CSP_FREESERVICE,
                    new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-input-num",
                            autocomplete = "off",
                            placeholder = "0"
                        }
                    })

                </div>

            </div>

        </div>

        <!-- Legend -->
        <div class="legend-bar">

            <div class="legend-item">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);"></span>
                <span>Text Fields</span>
            </div>

            <div class="legend-item">
                <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;"></span>
                <span>Number Fields</span>
            </div>

        </div>

        <!-- Actions -->
        <div class="form-actions">

            <a href="@Url.Action("List", "ContractProduct")"
               class="btn-cancel">
                <i class="bi bi-x-lg"></i>
                Cancel
            </a>

            <button type="submit"
                    class="btn-save"
                    id="savebutton">

                <i class="bi bi-floppy"></i>
                Save

            </button>

        </div>

    </div>
}

@section Scripts{

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>

        $(document).ready(function () {

            $('#SelectedProduct').select2();

            $('#AdminDropdown').select2();

        });

    </script>

    <!-- Save -->
    <script>

        $(document).ready(function () {

            $("#createform").submit(function (e) {

                e.preventDefault();

                var btn = $("#savebutton");

                btn.prop("disabled", true);

                var formData = new FormData(this);

                Swal.fire({
                    title: "Processing...",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,

                    didOpen: function () {

                        Swal.showLoading();

                        $.ajax({

                            url: '@Url.Action("Create", "ContractProduct")',

                            type: "POST",

                            data: formData,

                            processData: false,

                            contentType: false,

                            success: function (response) {

                                if (response.success) {

                                    setTimeout(function () {

                                        Swal.fire({

                                            title: "Success!",

                                            text: response.message,

                                            icon: "success",

                                            showCancelButton: true,

                                            confirmButtonText: "Continue",

                                            cancelButtonText: "Back to List",

                                            allowOutsideClick: false,

                                            allowEscapeKey: false,

                                            customClass: {

                                                confirmButton: "swal-btn-continue",

                                                cancelButton: "swal-btn-back"

                                            }

                                        }).then(function (result) {

                                            if (result.isConfirmed) {

                                                location.reload();

                                            }
                                            else {

                                                window.location.href =
                                                    '@Url.Action("List", "ContractProduct")';

                                            }

                                        });

                                    }, 800);

                                }
                                else {

                                    Swal.fire({

                                        title: "Message",

                                        text: response.message,

                                        icon: "info"

                                    });

                                    resetButton();

                                }

                            },

                            error: function () {

                                Swal.fire({

                                    title: "Error!",

                                    text: "An unexpected error occurred.",

                                    icon: "error"

                                });

                                resetButton();

                            }

                        });

                    }

                });

            });

            function resetButton() {

                $("#savebutton").prop("disabled", false);

            }

        });

    </script>

    <!-- Load Engineers -->
    <script>

        $(document).ready(function () {

            function loadAdmins() {

                var precid = $("#SelectedProduct").val();

                var cmprecid = '@Session["CompanyID"]';

                $("#AdminDropdown")
                    .prop("disabled", true)
                    .empty()
                    .append('<option value="">Loading Service Engineer...</option>');

                if (!precid) {

                    $("#AdminDropdown")
                        .empty()
                        .append('<option value="">-- Select Service Engineer --</option>');

                    return;
                }

                $.ajax({

                    url: '@Url.Action("GetProductAdmins", "AccountantCustomerInvoice")',

                    type: 'GET',

                    data: {

                        cmprecid: cmprecid,

                        precid: precid

                    },

                    success: function (res) {

                        $("#AdminDropdown").empty();

                        if (res.status === "Y" &&
                            res.data &&
                            res.data.length > 0) {

                            $("#AdminDropdown")
                                .append('<option value="">-- Select Service Engineer --</option>')
                                .prop("disabled", false);

                            $.each(res.data, function (i, admin) {

                                $("#AdminDropdown").append(

                                    `<option value="${admin.u_RECID}">
                                        ${admin.u_USERNAME}
                                    </option>`

                                );

                            });

                        }
                        else {

                            $("#AdminDropdown")
                                .append('<option value="">No Service Engineer mapped</option>')
                                .prop("disabled", true);

                        }

                        $('#AdminDropdown').trigger('change');

                    },

                    error: function () {

                        $("#AdminDropdown")
                            .empty()
                            .append('<option value="">Error loading Service Engineer</option>')
                            .prop("disabled", true);

                    }

                });

            }

            loadAdmins();

            $("#SelectedProduct").on("change", function () {

                loadAdmins();

            });

            $("#AdminDropdown").on("change", function () {

                $("#CSP_ARECID").val($(this).val());

            });

        });

    </script>
}