@model IEnumerable<PSS_CMS.Models.SalesInvoiceProducts>

@{
    ViewData["Title"] = "Sales Product List";
    ViewBag.PageTitle = "Sales Product List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {

    <!-- List view Css -->
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->

<div class="page-breadcrumb">
    <i class="bi bi-receipt"
       style="color:var(--primary)"></i>

    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("SalesheaderAdminListView", "AccountantCustomerInvoice")">

        Sales Invoice

    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Sales Product List</span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <h6 class="page-card-title">

            <i class="bi bi-box-seam"
               style="color:var(--primary)">
            </i>

            Sales Product List

        </h6>

        <!-- Search -->

        @using (Html.BeginForm(
            "List",
            "SalesInvoiceProduct",
            FormMethod.Get,
            new { id = "searchForm" }))
        {
            <div class="search-box">

                <i class="bi bi-search"></i>

                <input type="text"
                       id="searchPharse"
                       name="searchPharse"
                       placeholder="Search"
                       autocomplete="off"
                       value="@Request["searchPharse"]"
                       onkeyup="autoSubmitSearch(this)" />

                @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                {
                    <a href="@Url.Action("List","SalesInvoiceProduct")"
                       title="Clear">

                        <i class="bi bi-x-circle text-muted"></i>

                    </a>
                }

            </div>
        }

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:70px;">

                            S.No

                        </th>

                        <th>
                            Product Name
                        </th>

                        <th>
                            Product Serial Number
                        </th>

                        <th>
                            Warranty Upto
                        </th>

                        <th class="text-center"
                            style="width:160px;">

                            Status

                        </th>

                        <th class="text-center"
                            style="width:120px;">

                            Actions

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        var viewUrl = Url.Action(
                            "ProductDetailView",
                            "SalesInvoiceProduct",
                            new
                            {
                                Recid = o.SIP_RECID
                            });

                        <tr>

                            <td class="text-center">
                                @o.SerialNumber
                            </td>

                            <td>
                                @o.ProductName
                            </td>

                            <td>

                                <span class="serial-text">

                                    @o.SIP_PRODUCTSERIALNUMBER

                                </span>

                            </td>

                            <td>

                                @(string.IsNullOrEmpty(o.SIP_WARRANTYUPTO)
                                    ? ""
                                    : Convert.ToDateTime(o.SIP_WARRANTYUPTO)
                                        .ToString("dd-MM-yyyy"))

                            </td>

                            <td class="text-center">

                                @if (o.WARRANTY_TYPE == "Active")
                                {
                                    <span class="custom-badge badge-active">

                                        @o.WARRANTY_STATUS

                                    </span>
                                }
                                else if (o.WARRANTY_TYPE == "Going to Expire")
                                {
                                    <span class="custom-badge badge-warning">

                                        @o.WARRANTY_STATUS

                                    </span>
                                }
                                else
                                {
                                    <span class="custom-badge badge-expired">

                                        @o.WARRANTY_STATUS

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="action-cell">

                                    <!-- View -->

                                    <a href="@viewUrl"
                                       title="View"
                                       class="act-btn">

                                        <i class='bx bx-show'
                                           style="color:#00b894">
                                        </i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="bi bi-inbox"
                   style="font-size:40px;color:var(--text-muted)">
                </i>

                <p class="mt-2 text-muted fw-semibold">

                    No Products Available

                </p>

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    <div class="legend-item">

        <i class='bx bx-show'
           style='color:#00b894;font-size:16px'>
        </i>

        <span>View</span>

    </div>

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}