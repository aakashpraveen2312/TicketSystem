@model IEnumerable<PSS_CMS.Models.Prioritywise>
@using Newtonsoft.Json

@{ ViewData["Title"] = "Priority-wise Ticket Report";
    ViewBag.PageTitle = "Priority-wise Ticket Report";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
    <style>
        /* ── Filter strip ───────────────────────────── */
        .filter-card {
            padding: 20px 20px 4px;
            border-bottom: 1px solid var(--border-color);
            background: #fafafa;
        }

        .filter-row {
            display: flex;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
            padding-bottom: 20px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
            flex: 1;
            min-width: 160px;
        }

        .filter-label {
            font-size: 11.5px;
            font-weight: 600;
            color: var(--text-muted);
        }

        /* ── Priority badges ────────────────────────── */
        .pri-normal {
            background: #f5f5f5;
            color: #6b7280;
        }

        .pri-urgent {
            background: #fff4db;
            color: #c47a00;
        }

        .pri-critical {
            background: #ffeaea;
            color: #e74c3c;
        }

        .pri-emergency {
            background: #EEEDFE;
            color: #3C3489;
        }

        .pri-badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Status badges ──────────────────────────── */
        .st-submitted {
            background: #eef6ff;
            color: #1a73e8;
        }

        .st-resolved {
            background: #E1F5EE;
            color: #085041;
        }

        .st-closed {
            background: #f5f5f5;
            color: #6b7280;
        }

        .st-reopened {
            background: #fff4db;
            color: #c47a00;
        }

        .st-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        /* ── Pagination ─────────────────────────────── */
        .report-pagination {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 20px;
            border-top: 1px solid var(--border-color);
            justify-content: flex-end;
        }
    </style>
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-bar-chart-line nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <span>Priority-wise Ticket Report</span>
</div>

<!-- Filter Card -->
<div class="page-card" style="margin-bottom:20px;">

    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-funnel" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Filter Report
        </h6>
    </div>

    <form method="post" action="@Url.Action("PrioritywiseReport","HelpDesk")" id="filterForm">
        <div class="filter-card">
            <div class="filter-row">

                <!-- From Date -->
                <div class="filter-group">
                    <label class="filter-label">From Date</label>
                    <input type="date" name="FromDate" id="fromDate"
                           class="form-input-text" style="font-size:12.5px;padding:8px 10px;" />
                </div>

                <!-- To Date -->
                <div class="filter-group">
                    <label class="filter-label">To Date</label>
                    <input type="date" name="ToDate" id="toDate"
                           class="form-input-text" style="font-size:12.5px;padding:8px 10px;" />
                </div>

                <!-- Priority Type -->
                <div class="filter-group" style="min-width:200px;">
                    <label class="filter-label">Priority Type</label>
                    <select id="comboBox" name="Type" class="form-select-input"
                            style="font-size:12.5px;padding:8px 10px;">
                        <option value="">-- Select Priority Type --</option>
                        <option value="All">All</option>
                        <option value="Normal">Normal</option>
                        <option value="Urgent">Urgent</option>
                        <option value="Critical">Critical</option>
                        <option value="Emergency">Emergency</option>
                    </select>
                </div>

                <!-- Buttons -->
                <div class="filter-group" style="flex-direction:row;gap:8px;align-items:flex-end;min-width:auto;flex:0;">
                    <button type="submit" name="ActionType" value="Filter" class="btn-save">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <button type="submit" name="ActionType" value="PDF"
                            class="btn-save" style="background:#e74c3c;">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                </div>

            </div>
        </div>
    </form>

</div>

<!-- Results Card -->
<div class="page-card">

    <div class="page-card-header">
        <h6 class="page-card-title">
            <span style="width:28px;height:28px;border-radius:8px;background:#EEEDFE;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                <i class="bi bi-table" style="font-size:15px;color:#3C3489;"></i>
            </span>
            Report Results
        </h6>
        @if (Model != null && Model.Any())
        {
<span class="custom-badge badge-active">@Model.Count() Records</span>}
    </div>

    <div class="grid-wrap" id="reportTable">
        @if (Model != null && Model.Any())
        {
<table>
    <thead>
        <tr>
            <th>User Name</th>
            <th>Date</th>
            <th>Product Name</th>
            <th>Subject</th>
            <th>Priority</th>
            <th>Ticket Type</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
 var pri = (item.Priority ?? "").Trim().ToLower();
                        var priClass = pri == "urgent" ? "pri-urgent"
                                     : pri == "critical" ? "pri-critical"
                                     : pri == "emergency" ? "pri-emergency"
                                     : "pri-normal";

                        var st = (item.Status ?? "").Trim().ToUpper();
                        var stClass = st == "SUBMITTED" || st == "S" ? "st-submitted"
                                    : st == "RESOLVED" || st == "R" ? "st-resolved"
                                    : st == "CLOSED" || st == "C" ? "st-closed"
                                    : st == "RE-OPENED" || st == "O" ? "st-reopened"
                                    : "st-closed"; 
                    <tr>
                        <td>@item.UserName</td>
                        <td style="font-size:12px;color:var(--text-muted);">@item.DATES</td>
                        <td><span class="product-serial">@item.Product</span></td>
                        <td>@item.Subject</td>
                        <td><span class="pri-badge @priClass">@item.Priority</span></td>
                        <td><span class="service-badge">@item.TicketType</span></td>
                        <td><span class="st-badge @stClass">@item.Status</span></td>
                    </tr>}
    </tbody>
</table> }
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-bar-chart-line" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No records found</span>
    <p style="font-size:12px;margin-top:6px;">Apply a filter above to view priority-wise ticket data.</p>
</div>}
    </div>

    @if (Model != null && Model.Any())
    {
<div class="report-pagination">
    <button id="prevBtn" class="page-btn" disabled>
        <i class="bi bi-chevron-left"></i> Previous
    </button>
    <span class="page-info" id="pageInfo"></span>
    <button id="nextBtn" class="page-btn">
        Next <i class="bi bi-chevron-right"></i>
    </button>
</div>}

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:10px;background:#f5f5f5;border:1px solid #ddd;flex-shrink:0;"></span>
        <span>Normal</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:10px;background:#fff4db;flex-shrink:0;"></span>
        <span>Urgent</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:10px;background:#ffeaea;flex-shrink:0;"></span>
        <span>Critical</span>
    </div>
    <div class="legend-item">
        <span style="display:inline-block;width:12px;height:12px;border-radius:10px;background:#EEEDFE;flex-shrink:0;"></span>
        <span>Emergency</span>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Logoutjs.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Client-side pagination -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var table = document.querySelector("#reportTable table");
            if (!table) return;

            var rowsPerPage = 10;
            var rows = table.querySelectorAll("tbody tr");
            var totalRows = rows.length;
            var totalPages = Math.ceil(totalRows / rowsPerPage);
            var currentPage = 1;

            function showPage(page) {
                currentPage = page;
                rows.forEach(function (row, i) {
                    row.style.display =
                        (i >= (page - 1) * rowsPerPage && i < page * rowsPerPage) ? "" : "none";
                });
                document.getElementById("pageInfo").innerText =
                    "Page " + currentPage + " of " + totalPages;
                document.getElementById("prevBtn").disabled = currentPage === 1;
                document.getElementById("nextBtn").disabled = currentPage === totalPages;
            }

            document.getElementById("prevBtn").addEventListener("click", function () {
                if (currentPage > 1) showPage(currentPage - 1);
            });
            document.getElementById("nextBtn").addEventListener("click", function () {
                if (currentPage < totalPages) showPage(currentPage + 1);
            });

            showPage(1);
        });
    </script>

    <!-- TempData error -->
    <script>
        $(document).ready(function () {
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                Swal.fire({
                    icon: 'info',
                    title: 'Message',
                    text: '@TempData["ErrorMessage"]',
                    confirmButtonColor: '#034CAE',
                    confirmButtonText: 'OK'
                });
                </text>
            }
        });
    </script>
}
