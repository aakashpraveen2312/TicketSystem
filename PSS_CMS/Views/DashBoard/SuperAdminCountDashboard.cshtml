@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
@{
    var tickets = ViewBag.RecentTickets as List<PSS_CMS.Models.Tickethistorys>;
}
@model PSS_CMS.Models.DashboardSA
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ticket System</title>

    <style>
        .table-pagination {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 12px;
            margin-top: 20px;
            flex-wrap: wrap;
        }

        .page-btn {
            border: none;
            background: #111827;
            color: #fff;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            transition: .3s;
        }

            .page-btn:hover {
                background: #000;
            }

            .page-btn:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .page-info {
            font-size: 14px;
            color: #6b7280;
            font-weight: 600;
        }
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .tickets-table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

            .tickets-table th {
                white-space: nowrap;
            }

            .tickets-table td {
                white-space: nowrap;
            }
    </style>
</head>
<body>

    <!-- ─── MINI ROLE CARDS ROW 1 ─── -->
    <div class="row g-3 mb-3">

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-danger-light"><i class="bi bi-geo-alt"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Location</div>
                    <div class="mini-value">@(Model?.TotalCompanyLocationCount ?? 0)</div>

                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-success-light"><i class="bi bi-person"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Admin</div>
                    <div class="mini-value">@(Model?.TotalAdminCount ?? 0)</div>

                </div>

            </div>
        </div>



        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-info-light"><i class="bi bi-box-seam"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Product</div>
                    <div class="mini-value">@(Model?.TotalProductCount ?? 0)</div>

                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-info-light"><i class="bi bi-clipboard-check"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Closed Ticket</div>
                    <div class="mini-value"> @(Model?.TotalClosedTicketCount ?? 0)</div>

                </div>

            </div>
        </div>

    </div>

    <!-- ─── MINI ROLE CARDS ROW 2 ─── -->
    <div class="row g-3 mb-3">

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-purple-light"><i class="bi bi-people"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Customer</div>
                    <div class="mini-value"> @(Model?.TotalCustomerCount ?? 0)</div>

                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-info-light"><i class="bi bi-headset"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Help Desk</div>
                    <div class="mini-value"> @(Model?.TotalHelpdeskCount ?? 0)</div>

                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-teal-light"><i class="bi bi-calculator"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Accountant</div>
                    <div class="mini-value"> @(Model?.TotalAccountantCount ?? 0)</div>

                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="mini-card">
                <div class="mini-icon bg-pink-light"><i class="bi bi-ticket-perforated"></i></div>
                <div class="mini-body">
                    <div class="mini-label">Total Ticket</div>
                    <div class="mini-value"> @(Model?.TotalTicketCount ?? 0)</div>

                </div>

            </div>
        </div>

    </div>

    <!-- ─── BOTTOM SECTION: Recent Tickets + Ticket Overview + Top Customers ─── -->
    <div class="row g-3">
        <!-- Recent Tickets (left, wide) -->
        <div class="col-12 col-xl-12">
            <div class="dash-card">
                <div class="dash-card-header">
                    <h6 class="dash-card-title">Recent Tickets</h6>

                    <div class="d-flex align-items-center gap-2">
                        <!-- CURRENT WEEK -->
                        <a href="@Url.Action(
                    "SuperAdminCountDashboard",
                    new { filter = "week" })"
                           class="view-all-btn">

                            This Week
                        </a>

                        <!-- ALL TICKETS -->
                        <a href="@Url.Action(
                    "SuperAdminCountDashboard",
                    new { filter = "all" })"
                           class="view-all-btn">

                            View All
                        </a>
                    </div>
                </div>
                <div class="dash-card-body">

                    <!-- RESPONSIVE TABLE -->
                    <div class="table-responsive">

                        <table class="tickets-table">
                            <thead>
                                <tr>
                                    <th>Ticket ID</th>
                                    <th>Subject</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Created At</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>

                                @if (tickets != null && tickets.Count > 0)
                                {
                                    foreach (var item in tickets)
                                    {
                                        string statusClass = "";
                                        string statusText = "";

                                        if (item.Status.Trim() == "O")
                                        {
                                            statusClass = "badge-open";
                                            statusText = "Open";
                                        }
                                        else if (item.Status.Trim() == "S")
                                        {
                                            statusClass = "badge-inprogress";
                                            statusText = "In Progress";
                                        }
                                        else if (item.Status.Trim() == "R")
                                        {
                                            statusClass = "badge-pending";
                                            statusText = "Resolved";
                                        }
                                        else if (item.Status.Trim() == "C")
                                        {
                                            statusClass = "badge-closed";
                                            statusText = "Closed";
                                        }

                                        string priorityClass = "badge-low";

                                        if (item.Priority == "Critical" || item.Priority == "Emergency")
                                        {
                                            priorityClass = "badge-high";
                                        }
                                        else if (item.Priority == "Urgent")
                                        {
                                            priorityClass = "badge-medium";
                                        }

                    <tr>
                        <td>
                            <span class="ticket-id">@item.TicketId</span>
                        </td>

                        <td>@item.Subject</td>

                        <td>@item.CustomerName</td>

                        <td>
                            <span class="badge-status @statusClass">
                                @statusText
                            </span>
                        </td>

                        <td>
                            <span class="badge-priority @priorityClass">
                                @item.Priority
                            </span>
                        </td>

                        <td style="color:var(--text-muted);font-size:12px">
                            @item.Date.ToString("dd MMM yyyy")
                        </td>


                    </tr>
 }
            }
            else
            {
            <tr>
                <td colspan="7" class="text-center p-4">
                    No Tickets Available
                </td>
            </tr>
}

                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="table-pagination mb-3 me-3">

                    <button id="prevBtn" class="page-btn">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>

                    <span id="pageInfo" class="page-info"></span>

                    <button id="nextBtn" class="page-btn">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>


                </div>
            </div>
        </div>
    </div>

    @*Pagination for table*@
    <script>

        const rowsPerPage = 5;

        const table =
            document.querySelector(".tickets-table tbody");

        const rows =
            table.querySelectorAll("tr");

        const pageInfo =
            document.getElementById("pageInfo");

        const prevBtn =
            document.getElementById("prevBtn");

        const nextBtn =
            document.getElementById("nextBtn");

        let currentPage = 1;

        const totalPages =
            Math.ceil(rows.length / rowsPerPage);

        function showPage(page) {
            rows.forEach((row, index) => {
                const start =
                    (page - 1) * rowsPerPage;

                const end =
                    start + rowsPerPage;

                if (index >= start && index < end) {
                    row.style.display = "";
                }
                else {
                    row.style.display = "none";
                }
            });

            pageInfo.innerText =
                "Page " + page + " of " + totalPages;

            prevBtn.disabled = page === 1;

            nextBtn.disabled = page === totalPages;
        }

        prevBtn.addEventListener("click", function () {
            if (currentPage > 1) {
                currentPage--;

                showPage(currentPage);
            }
        });

        nextBtn.addEventListener("click", function () {
            if (currentPage < totalPages) {
                currentPage++;

                showPage(currentPage);
            }
        });

        showPage(currentPage);

    </script>


</body>
</html>

