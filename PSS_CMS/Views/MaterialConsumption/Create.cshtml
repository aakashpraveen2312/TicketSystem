@model PSS_CMS.Models.Materialconsumption

@{ ViewData["Title"] = "Create Line Item";
                ViewBag.PageTitle = "Create Line Item";
                Layout = "~/Views/Shared/_Layout.cshtml";

                string typeName = Session["Type"]?.ToString() ?? "";
                string pName = Session["P_NAME"]?.ToString() ?? ""; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-ticket-perforated nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("RecentTicket","RecentTickets")">Tickets</a>
    <i class="bi bi-chevron-right"></i>
    @if (!string.IsNullOrEmpty(pName))
    {
<a href="@Url.Action("RecentTicket","RecentTickets")">@pName</a>
                <i class="bi bi-chevron-right"></i>}
    @if (!string.IsNullOrEmpty(typeName))
    {
<a href="@Url.Action("List","MaterialConsumption")">@typeName</a>
                <i class="bi bi-chevron-right"></i>}
    <a href="@Url.Action("List","MaterialConsumption")">List</a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Create", "MaterialConsumption", FormMethod.Post,
    new { id = "createform", enctype = "multipart/form-data", @class = "no-preloader" }))
{
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">
        <h6 class="page-card-title">
            <span class="title-icon"><i class="bi bi-basket2"></i></span>
            Create @(string.IsNullOrEmpty(typeName) ? "Line Item" : typeName)
        </h6>
    </div>

    <div class="form-body">

        <!-- ── Item Selection ──────────────── -->

        <div class="form-grid">

            <!-- Item Group -->
            <div class="form-group">
                <label class="form-label" for="itemGroupDropdown">
                    @Html.DisplayNameFor(m => m.ITEMGROUP) <span class="req">*</span>
                </label>
                @Html.DropDownListFor(m => m.SelectedItemGroup, Model.ItemGroups,
                                        "Select an Item Group",
                                        new { id = "itemGroupDropdown", @class = "form-input-text", tabindex = "1" })
            </div>

            <!-- Item Category -->
            <div class="form-group">
                <label class="form-label" for="itemCategoryDropdown">
                    @Html.DisplayNameFor(m => m.ITEMCATEGORY) <span class="req">*</span>
                </label>
                @Html.DropDownListFor(m => m.SelectedItemCategory, Model.ItemCategories,
                                        "Select an Item Category",
                                        new { id = "itemCategoryDropdown", @class = "form-input-text", tabindex = "2" })
            </div>

            <!-- Material / Item -->
            <div class="form-group">
                <label class="form-label" for="MaterialDropdown">
                    @Html.DisplayNameFor(m => m.MATERIAL) <span class="req">*</span>
                </label>
                @Html.DropDownList("SelectedMaterial",
                                        new List<SelectListItem> { new SelectListItem { Text = "Select an Item", Value = "" } },
                                        new { @class = "form-input-text", id = "MaterialDropdown", tabindex = "3" })
            </div>

            <!-- UOM (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_UOM">@Html.DisplayNameFor(m => m.tM_UOM)</label>
                @Html.TextBoxFor(m => m.tM_UOM, new
                {
                    @class = "form-input-auto",
                    autocomplete = "off",
                    @readonly = "readonly",
                    placeholder = "Auto-filled"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Pricing ──────────────────────── -->

        <div class="form-grid">

            <!-- Price (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_PRICE">@Html.DisplayNameFor(m => m.tM_PRICE)</label>
                @Html.TextBoxFor(m => m.tM_PRICE, new
                {
                    @class = "form-input-auto intalignment",
                    autocomplete = "off",
                    placeholder = "0.00",
                    @readonly = "readonly"
                })
            </div>

            <!-- Quantity -->
            <div class="form-group">
                <label class="form-label" for="tM_QUANTITY">
                    @Html.DisplayNameFor(m => m.tM_QUANTITY) <span class="req">*</span>
                </label>
                @Html.TextBoxFor(m => m.tM_QUANTITY, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    oninput = "Netamount()",
                    type = "text",
                    placeholder = "0"
                })
            </div>

            <!-- Discount -->
            <div class="form-group">
                <label class="form-label" for="tM_DISCOUNT">@Html.DisplayNameFor(m => m.tM_DISCOUNT)</label>
                @Html.TextBoxFor(m => m.tM_DISCOUNT, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    oninput = "Netamount()",
                    type = "text",
                    placeholder = "0.00"
                })
            </div>

            <!-- Sort Order -->
            <div class="form-group">
                <label class="form-label" for="tM_SORTORDER">@Html.DisplayNameFor(m => m.tM_SORTORDER)</label>
                @Html.TextBoxFor(m => m.tM_SORTORDER, new
                {
                    @class = "form-input-num",
                    autocomplete = "off",
                    type = "text",
                    placeholder = "0"
                })
            </div>

            <!-- SGST (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_SGST">@Html.DisplayNameFor(m => m.tM_SGST)</label>
                @Html.TextBoxFor(m => m.tM_SGST, "{0:0.00}", new
                {
                    @class = "form-input-auto intalignment",
                    autocomplete = "off",
                    placeholder = "0.00",
                    @readonly = "readonly"
                })
            </div>

            <!-- CGST (readonly) -->
            <div class="form-group">
                <label class="form-label" for="tM_CGST">@Html.DisplayNameFor(m => m.tM_CGST)</label>
                @Html.TextBoxFor(m => m.tM_CGST, new
                {
                    @class = "form-input-auto intalignment",
                    autocomplete = "off",
                    @readonly = "readonly",
                    type = "text"
                })
            </div>

        </div>

        <div class="form-divider"></div>

        <!-- ── Amount Summary ──────────────── -->

        <div class="form-grid">
            <div class="amount-summary">

                <div class="amount-item">
                    <span class="amount-label">
                        <i class="bi bi-calculator"></i>
                        @Html.DisplayNameFor(m => m.tM_TOTALAMOUNT)
                    </span>
                    @Html.TextBoxFor(m => m.tM_TOTALAMOUNT, new
                    {
                        @class = "form-input-calc intalignment",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "0.00"
                    })
                </div>

                <div class="amount-item">
                    <span class="amount-label">
                        <i class="bi bi-currency-rupee"></i>
                        @Html.DisplayNameFor(m => m.tM_NETAMOUNT)
                    </span>
                    @Html.TextBoxFor(m => m.tM_NETAMOUNT, new
                    {
                        @class = "form-input-calc intalignment",
                        autocomplete = "off",
                        @readonly = "readonly",
                        placeholder = "0.00"
                    })
                </div>

            </div>
        </div>

        <div class="form-divider"></div>


        @if (Session["customertypes"].ToString() == "Addon User")
        {
    <div class="form-grid">
       
       
    </div> }
else
{ <!-- ── Settings ────────────────────── -->
                        <p class="form-section-title">Settings</p>
                                            <div class="form-grid">
                                                <!-- Billable checkbox -->
                                                <label class="check-row" for="tM_BILLABLE">
                                                    @Html.CheckBoxFor(m => m.tM_BILLABLE,
                                                                       new { @class = "form-check-input", id = "tM_BILLABLE" })
                                                    <div class="check-row-label">
                                                        <span>@Html.DisplayNameFor(m => m.tM_BILLABLE)</span>
                                                        <small>Mark this line item as billable to the customer</small>
                                                    </div>
                                                </label>
                                            </div>}


    </div>

    <!-- Legend bar -->
    <div class="legend-bar">
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#adb5bd;flex-shrink:0;"></span>
            <span>Read-only</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
            <span>Text</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#185FA5;flex-shrink:0;"></span>
            <span>Number Field</span>
        </div>
        <div class="legend-item">
            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:#BA7517;flex-shrink:0;"></span>
            <span>Calculated Field</span>
        </div>
    </div>

    <!-- Actions -->
    <div class="form-actions">
        <a href="@Url.Action("List","MaterialConsumption")" class="btn-cancel">
            <i class="bi bi-x-lg"></i> Cancel
        </a>
        <button type="submit" class="btn-save" id="savebutton">
            <i class="bi bi-floppy"></i> Save
        </button>
    </div>

</div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        /* ── Material dropdown: populate fields ── */
        var materials = [];

        $('#MaterialDropdown').on('change', function () {
            var selectedId       = $(this).val();
            var selectedMaterial = materials.find(function (m) { return m.I_RECID == selectedId; });

            if (selectedMaterial) {
                $('#tM_UOM').val(selectedMaterial.I_CUOM);
                $('#tM_PRICE').val(selectedMaterial.I_PRICE);
                $('#tM_QUANTITY').val(selectedMaterial.I_SMQUANTITY);
                $('#tM_DISCOUNT').val(selectedMaterial.I_SMDISCOUNT);
                $('#tM_TOTALAMOUNT').val(selectedMaterial.I_SMTOTALAMOUNT);
                $('#tM_CGST').val(selectedMaterial.I_CGST);
                $('#tM_SGST').val(selectedMaterial.I_SGST);
                $('#tM_NETAMOUNT').val(selectedMaterial.I_SMNETAMOUNT);
                $('#tM_TYPE').val(selectedMaterial.I_TYPE);
                $('#tM_SORTORDER').val(selectedMaterial.I_SORTORDER);
                Netamount();
            } else {
                clearMaterialFields();
            }
        });

        function clearMaterialFields() {
            $('#tM_UOM,#tM_PRICE,#tM_QUANTITY,#tM_DISCOUNT,#tM_TOTALAMOUNT,#tM_CGST,#tM_SGST,#tM_NETAMOUNT,#tM_TYPE,#tM_SORTORDER').val('');
        }

        /* ── Net Amount Calculation ──────────── */
        function Netamount() {
            var price    = parseFloat($('#tM_PRICE').val())    || 0;
            var qty      = parseFloat($('#tM_QUANTITY').val()) || 0;
            var discount = parseFloat($('#tM_DISCOUNT').val()) || 0;
            var sgst     = parseFloat($('#tM_SGST').val())     || 0;
            var cgst     = parseFloat($('#tM_CGST').val())     || 0;

            var total  = (price * qty) * (1 - discount / 100);
            var net    = total + (total * sgst / 100) + (total * cgst / 100);

            $('#tM_TOTALAMOUNT').val(total.toFixed(2));
            $('#tM_NETAMOUNT').val(net.toFixed(2));
        }

        /* ── Item Group → Category cascade ────── */
        $(document).ready(function () {

            $('#itemGroupDropdown').on('change', function () {
                var grecid = $(this).val();
                if (grecid) {
                    $.ajax({
                        url: '@Url.Action("ItemGroupCategoryCombo","MaterialConsumption")',
                        type: 'GET',
                        data: { Grouprecid: grecid },
                        success: function (data) {
                            var dd = $('#itemCategoryDropdown').empty();
                            dd.append('<option value="">Select an Item Category</option>');
                            $.each(data, function (i, item) {
                                dd.append($('<option>', { value: item.IC_RECID, text: item.IC_DESCRIPTION }));
                            });
                        },
                        error: function () { alert('Error loading categories.'); }
                    });
                } else {
                    $('#itemCategoryDropdown').empty().append('<option value="">Select an Item Category</option>');
                }
            });

            /* ── Category → Item cascade ─────── */
            $('#itemCategoryDropdown').on('change', function () {
                var catId        = $(this).val();
                var materialDd   = $('#MaterialDropdown').empty();
                materials        = [];

                if (!catId) {
                    materialDd.append('<option value="">Select Item Category first</option>');
                    clearMaterialFields();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("ItemCombo","MaterialConsumption")',
                    type: 'GET',
                    data: { Categoryrecid: catId },
                    success: function (data) {
                        if (data && data.length > 0) {
                            materialDd.append('<option value="">Select an Item</option>');
                            materials = data;
                            $.each(data, function (i, item) {
                                materialDd.append($('<option>', { value: item.I_RECID, text: item.I_DESCRIPTION }));
                            });
                        } else {
                            materialDd.append('<option disabled>No items available</option>');
                            clearMaterialFields();
                        }
                    },
                    error: function () {
                        materialDd.append('<option disabled>Error loading items</option>');
                        clearMaterialFields();
                    }
                });
            });

            /* ── AJAX submit — processing spinner first ── */
            $("#createform").submit(function (e) {
                e.preventDefault();

                var btn      = $("#savebutton");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Create","MaterialConsumption")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to List",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton:  "swal-btn-back"
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) { location.reload(); }
                                            else { window.location.href = '@Url.Action("List","MaterialConsumption")'; }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({ title: "Message", text: response.message, icon: "info", allowOutsideClick: false, allowEscapeKey: false });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({ title: "Error!", text: "An unexpected error occurred.", icon: "error", allowOutsideClick: false, allowEscapeKey: false });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() { $("#savebutton").prop("disabled", false); }
        });
    </script>
}
