@model IEnumerable<PSS_CMS.Models.InvoicePayment>
@using GridMvc.Html

@{ ViewData["Title"] = "Payment List";
    ViewBag.PageTitle = "Payment List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var paidStatus = Session["Paymentstatus"]?.ToString(); }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-receipt nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("SalesheaderList", "AccountantCustomerInvoice", new { CU_CTRECID = Session["RECID"], Name = Session["ContractName"], CT_PRECID = Session["CT_PRECID"], CT_CONTRACTAMOUNT = Session["ContractAmount"] })">
        Sales Invoice Entry
    </a>
    <i class="bi bi-chevron-right"></i>
    <span>Payment List</span>
</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">


        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->
            @using (Html.BeginForm("PaymentList", "SalesInvoiceProduct", FormMethod.Get, new { id = "searchForm" }))
            {
    <div class="search-box">
        <i class="bi bi-search"></i>
        <input type="text"
               id="searchPharse"
               name="searchPharse"
               placeholder="Search"
               autocomplete="off"
               value="@Request["searchPharse"]" />
    </div>      }

            <!-- Add Payment (only if not fully paid) -->
            @if (string.IsNullOrEmpty(paidStatus) || paidStatus != "FULLY PAID")
            {
    <a href="@Url.Action("PaymentCreate", "SalesInvoiceProduct", new {
                    amount      = Session["Invoiceamount"],
                    number      = Session["Invoicenumber"],
                    date        = Session["Invoicedate"],
                    invoiceRecID = Session["SalesinvoiceRecID"]
                })" class="btn-add">
        <i class="bi bi-plus-lg"></i> Add Payment
    </a>        }

        </div>
    </div>

    <!-- Table -->
    <div class="grid-wrap">
        @if (Model != null && Model.Any())
        {
<table>
    <thead>
        <tr>
            <th style="width:50px;">S.No</th>
            <th>Invoice Number</th>
            <th>Invoice Date</th>
            <th>Mode of Payment</th>
            <th class="amount-cell">Total Amount</th>
            <th class="amount-cell">Paid Amount</th>
            <th class="amount-cell">Balance Amount</th>
            <th>Payment Status</th>
        </tr>
    </thead>
    <tbody>
        @{ int sno = 1; }
        @foreach (var item in Model)
        {
<tr>
    <td>
        <span class="serial-text">@sno</span>
    </td>
    <td>
        <span class="inv-code">@item.PP_INVOICENUMBER</span>
    </td>
    <td>
        @(string.IsNullOrEmpty(item.PP_INVOICEDATE)
                                    ? ""
                                    : Convert.ToDateTime(item.PP_INVOICEDATE).ToString("dd-MM-yyyy"))
    </td>
    <td>@item.PP_MODEOFPAYMENT</td>
    <td class="amount-cell">
        @(item.PP_TOTALAMOUNT == null ? "0.00" : Convert.ToDecimal(item.PP_TOTALAMOUNT).ToString("N2"))
    </td>
    <td class="amount-cell">
        @(item.PP_PAIDAMOUNT == null ? "0.00" : Convert.ToDecimal(item.PP_PAIDAMOUNT).ToString("N2"))
    </td>
    <td class="net-amount-cell">
        @(item.PP_BALANCEAMOUNT == null ? "0.00" : Convert.ToDecimal(item.PP_BALANCEAMOUNT).ToString("N2"))
    </td>
    <td>
        @{ var status = (item.PP_PAYMENTSTATUS ?? "").Trim().ToUpper();
                                var badgeClass = status == "FULLY PAID" ? "status-processed" :
                                                 status == "PARTIALLY PAID" ? "status-unlocked" :
                                                 "status-pending";
                                var statusText = System.Globalization.CultureInfo.CurrentCulture
                                                 .TextInfo.ToTitleCase((item.PP_PAYMENTSTATUS ?? "").ToLower()); }
        <span class="@badgeClass">
            @if (status == "FULLY PAID")
            {
        <i class="bi bi-check-circle-fill"></i> }
    else if (status == "PARTIALLY PAID")
    {
        <i class="bi bi-exclamation-circle-fill"></i>}
    else
    {
        <i class="bi bi-clock-history"></i>
    }


            @statusText
        </span>
    </td>
</tr>sno++;
                }
    </tbody>
</table> }
            else
            {
<div style="padding:48px 20px;text-align:center;color:var(--text-muted);">
    <i class="bi bi-inbox" style="font-size:36px;display:block;margin-bottom:10px;opacity:.4;"></i>
    <span style="font-size:14px;font-weight:600;">No payments are available</span>
</div>}
    </div>

</div><!-- /page-card -->
<!-- Legend bar -->
<div class="legend-bar">

    <div class="legend-item">

        <i class="bi bi-check-circle-fill"
           style="color:#00b894;font-size:14px">
        </i>

        <span>Fully Paid</span>

    </div>

    <div class="legend-item">

        <i class="bi bi-exclamation-circle-fill"
           style="color:#e6a817;font-size:14px">
        </i>

        <span>Partially Paid</span>

    </div>



</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Logoutjs.js"></script>
    <script src="~/Scripts/Fordelete.js"></script>

    <!-- Live search filter -->
    <script>
        document.getElementById("searchPharse").addEventListener("input", function () {
            var term = this.value.toLowerCase();
            var rows = document.querySelectorAll(".grid-wrap tbody tr");
            rows.forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(term) ? "" : "none";
            });
        });
    </script>

    <script>
        function DownloadWarrantyPDF(id) {
            Swal.fire({
                title: 'Processing...',
                text: 'Generating Warranty PDF',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/AccountantCustomerInvoice/WarrantyPDF',
                type: 'POST',
                data: { CU_RECID: id },
                xhrFields: { responseType: 'blob' },
                success: function (data) {
                    var blob = new Blob([data], { type: "application/pdf" });
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(blob);
                    link.download = "Warranty.pdf";
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    Swal.close();
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to download PDF' });
                }
            });
        }

        function SendWarrantyEmail(id, email) {
            Swal.fire({
                title: 'Processing...',
                text: 'Sending Warranty PDF to Email',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.ajax({
                url: '/AccountantCustomerInvoice/WarrantyPDFToEmail',
                type: 'POST',
                data: { CU_RECID: id, Email: email },
                success: function (response) {
                    Swal.close();
                    Swal.fire({
                        icon: response.status === "Y" ? 'success' : 'error',
                        title: response.status === "Y" ? 'Success' : 'Error',
                        text: response.message
                    });
                },
                error: function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong' });
                }
            });
        }
    </script>
}
