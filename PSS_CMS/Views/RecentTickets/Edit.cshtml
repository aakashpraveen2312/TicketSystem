@model PSS_CMS.Models.Faq

@{ ViewData["Title"] = "Edit FAQ";
                ViewBag.PageTitle = "Edit FAQ";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />

}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-book nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    Knowledge Base
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("FAQADMIN","RecentTickets")">FAQ</a>
    <i class="bi bi-chevron-right"></i>
    <span>Edit</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("Edit", "RecentTickets", FormMethod.Post,
    new { id = "myForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
@Html.AntiForgeryToken()

                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span class="title-icon">
                                <i class="bi bi-pencil-square"></i>
                            </span>
                            Edit FAQ
                        </h6>
                    </div>

                    <!-- Form body -->
                    <div class="form-body">

                        <p class="form-section-title">FAQ Details</p>

                        <!-- Question -->
                        <div class="form-group-full">
                            <label class="form-label" for="F_QUESTION">
                                Question
                                <span class="req">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.F_QUESTION, new
                            {
                                @class = "form-input-text",
                                tabindex = "1",
                                placeholder = "Enter the question"
                            })
                            @Html.ValidationMessageFor(m => m.F_QUESTION, "", new { @class = "text-danger", style = "font-size:11px" })
                        </div>

                        <!-- Answer -->
                        <div class="form-group-full">
                            <label class="form-label" for="F_ANSWER">
                               Answer
                                <span class="req">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.F_ANSWER, new
                            {
                                @class = "form-textarea",
                                placeholder = "Please enter your answer here…",
                                rows = "8",
                                tabindex = "2"
                            })
                            @Html.ValidationMessageFor(m => m.F_ANSWER, "", new { @class = "text-danger", style = "font-size:11px" })
                        </div>

                        <div class="form-divider"></div>
                        <p class="form-section-title">Attachment</p>

                        <!-- Current attachment preview -->
                        @if (!string.IsNullOrEmpty(ViewBag.IMAGE))
                        {
                            string base64String = ViewBag.IMAGE;
                            string fileType = "unknown";
                            string mimeType = "application/octet-stream";

                            if (base64String.StartsWith("iVBORw0KGgo")) { fileType = "png"; mimeType = "image/png"; }
                            else if (base64String.StartsWith("/9j/")) { fileType = "jpg"; mimeType = "image/jpeg"; }
                            else if (base64String.StartsWith("JVBER")) { fileType = "pdf"; mimeType = "application/pdf"; }
                            else if (base64String.StartsWith("UEsDB"))
                            {
                                fileType = "xlsx";
                                mimeType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                                if (base64String.Contains("word/"))
                                {
                                    fileType = "docx";
                                    mimeType = "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
                                }
                            }
                            else if (base64String.StartsWith("Q0N2")) { fileType = "csv"; mimeType = "text/csv"; }

                            bool isImage = mimeType.StartsWith("image/");
                            string iconClass = isImage ? "bi-image" : (fileType == "pdf" ? "bi-file-earmark-pdf" : fileType == "docx" ? "bi-file-earmark-word" : fileType == "xlsx" ? "bi-file-earmark-excel" : fileType == "csv" ? "bi-file-earmark-spreadsheet" : "bi-file-earmark");

        <div class="form-group-full">
            <label class="form-label">Current Attachment</label>

            @if (isImage)
            {
<div class="attachment-image-wrap">
    <img src="@($"data:{mimeType};base64,{ViewBag.IMAGE}")" alt="Current attachment" />
</div> }
                    else
                    {
<div class="attachment-preview">
    <div class="attachment-preview-icon icon-doc">
        <i class="bi @iconClass"></i>
    </div>
    <div class="attachment-preview-label">
        <span>Attachment.@fileType</span>
        <small>Click Download to save the file</small>
    </div>
    <a href="@($"data:{mimeType};base64,{ViewBag.IMAGE}")"
       download="Attachment.@fileType"
       class="btn-download">
        <i class="bi bi-download"></i> Download
    </a>
</div>                    }

            <p class="attachment-replace-note">
                <i class="bi bi-info-circle"></i>
                To replace this attachment, choose a new file below. Leave empty to keep the current one.
            </p>
        </div>}

                        <!-- File upload -->
                        <div class="file-upload-wrap" id="fileDropArea">
                            <div class="file-upload-icon">
                                <i class="bi bi-paperclip"></i>
                            </div>
                            <div class="file-upload-text">
                                <span id="fileLabel">No file chosen</span>
                                <small>Accepted: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv</small>
                            </div>
                            <label class="btn-browse" for="myfile">
                                <i class="bi bi-folder2-open"></i> Browse
                            </label>
                            <input type="file"
                                   id="myfile"
                                   name="myfile"
                                   class="file-input-hidden"
                                   tabindex="3"
                                   accept=".pdf,.xlsx,.jpeg,.png,.jpg,.docx,.csv"
                                   onchange="handleFileChange(this)" />
                        </div>
                        <p class="file-error" id="fileError">
                            This file format is not supported. Accepted: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv
                        </p>

                    </div>

                    <!-- Legend bar -->
                    <div class="legend-bar">
                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
                            <span>Text Field</span>
                        </div>
                        <div class="legend-item">
                            <i class="bi bi-paperclip" style="color:var(--primary);font-size:13px;"></i>
                            <span>Attachment</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("FAQADMIN","RecentTickets")"
                           class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                        <button type="submit"
                                class="btn-save"
                                id="submitBtn"
                                tabindex="4">
                            <i class="bi bi-floppy"></i> Save Changes
                        </button>
                    </div>

                </div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Formatcheck.js"></script>

    <script>

        /* ── File picker label update ────────────── */
        function handleFileChange(input) {
            var allowed = ['.pdf', '.xlsx', '.jpeg', '.png', '.jpg', '.docx', '.csv'];
            var errorEl = document.getElementById('fileError');
            var labelEl = document.getElementById('fileLabel');

            if (input.files && input.files[0]) {
                var name = input.files[0].name;
                var ext  = name.substring(name.lastIndexOf('.')).toLowerCase();

                if (allowed.indexOf(ext) === -1) {
                    errorEl.style.display = 'block';
                    labelEl.textContent   = 'Invalid file — please choose another';
                    input.value           = '';
                } else {
                    errorEl.style.display = 'none';
                    labelEl.textContent   = name;
                }
            }
        }

        /* ── AJAX submit — processing spinner shows FIRST ── */
        $(document).ready(function () {

            $("#myForm").submit(function (e) {
                e.preventDefault();

                var btn      = $("#submitBtn");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("Edit","RecentTickets")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message || "FAQ edited successfully.",
                                            icon: "success",
                                            confirmButtonText: "OK",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false
                                        }).then(function (result) {
                                            if (result.isConfirmed) {
                                                window.location.href = '@Url.Action("FAQADMIN","RecentTickets")';
                                            }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message || "Something went wrong.",
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#submitBtn").prop("disabled", false);
            }
        });
    </script>
}
