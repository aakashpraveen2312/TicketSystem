@model IEnumerable<PSS_CMS.Models.Viewlist>

@{
    ViewData["Title"] = "View List";
    ViewBag.PageTitle = "View List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var type = Request["type"];

    var productName = Session["P_NAME"] != null
        ? Session["P_NAME"].ToString()
        : "";

    var titleText = type == "IN"
        ? "Inclusions"
        : "Exclusions";
}

@section Styles {

    <link href="~/Content/UIListView.css"
          rel="stylesheet" />

}

<!-- Breadcrumb -->

<div class="page-breadcrumb">

    <i class="bi bi-shield-check"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("CustomerList", "Contract")">

        Warranty Products

    </a>

    <i class="bi bi-chevron-right"></i>

    <span>

        @productName

    </span>

    <i class="bi bi-chevron-right"></i>

    <span>

        @titleText

    </span>

</div>

<!-- Main Card -->

<div class="page-card">

    <!-- Header -->

    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            <!-- Search -->

            @using (Html.BeginForm(
                "ViewList",
                "Contract",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
                <div class="search-box">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="searchPharse"
                           name="searchPharse"
                           placeholder="Search"
                           autocomplete="off"
                           value="@Request["searchPharse"]"
                           onkeyup="autoSubmitSearch(this)" />

                    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
                    {
                        <a href="@Url.Action("ViewList","Contract", new { type = type })"
                           title="Clear">

                            <i class="bi bi-x-circle text-muted"></i>

                        </a>
                    }

                </div>
            }

         

        </div>

    </div>

    <!-- Table -->

    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
            <table class="table align-middle mb-0 tickets-table">

                <thead>

                    <tr>

                        <th class="text-center"
                            style="width:80px;">

                            S.No

                        </th>

                        <th>

                            @(type == "IN"
                                ? "Inclusions"
                                : "Exclusions")

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var o in Model)
                    {
                        <tr>

                            <td class="text-center">

                                @o.SerialNumber

                            </td>

                            <td>

                                @if (type == "IN")
                                {
                                    <div class="d-flex align-items-center gap-2">

                                        <span class="mini-badge text-success">

                                            <i class="bi bi-check-circle-fill"></i>

                                        </span>

                                        <span>

                                            @o.IN_DESCRIPTION

                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center gap-2">

                                        <span class="mini-badge text-danger">

                                            <i class="bi bi-x-circle-fill"></i>

                                        </span>

                                        <span>

                                            @o.EX_DESCRIPTION

                                        </span>

                                    </div>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <!-- Pagination -->

            <div class="table-pagination">

                <button id="prevBtn"
                        class="page-btn">

                    <i class="bi bi-chevron-left"></i>

                    Previous

                </button>

                <span id="pageInfo"
                      class="page-info">
                </span>

                <button id="nextBtn"
                        class="page-btn">

                    Next

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                @if (type == "IN")
                {
                    <i class="bi bi-plus-circle"
                       style="font-size:40px;color:var(--text-muted)">
                    </i>

                    <p class="mt-2 text-muted fw-semibold">

                        No Inclusions Available

                    </p>
                }
                else
                {
                    <i class="bi bi-dash-circle"
                       style="font-size:40px;color:var(--text-muted)">
                    </i>

                    <p class="mt-2 text-muted fw-semibold">

                        No Exclusions Available

                    </p>
                }

            </div>
        }

    </div>

</div>

<!-- Legend -->

<div class="legend-bar">

    @if (type == "IN")
    {
        <div class="legend-item">

            <span class="mini-badge text-success">

                <i class="bi bi-check-circle-fill"></i>

            </span>

            Inclusion

        </div>
    }
    else
    {
        <div class="legend-item">

            <span class="mini-badge text-danger">

                <i class="bi bi-x-circle-fill"></i>

            </span>

            Exclusion

        </div>
    }

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/Scripts/UIPagination.js"></script>

   

}