@model IEnumerable<PSS_CMS.Models.SalesInvoiceProducts>

@{ ViewData["Title"] = "Sales Product List";
    ViewBag.PageTitle = "Sales Product List";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var invoiceStatus = ViewBag.InvoiceStatus?.ToString();
    var isProcessed = invoiceStatus == "P"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />
}

<!-- Breadcrumb -->
<div class="page-breadcrumb">

    <i class="bi bi-receipt-cutoff nav-icon"></i>

    <i class="bi bi-chevron-right"></i>

    <a href="@Url.Action("SalesheaderList", "HelpdeskSalesInvoice")">
        Sales Invoice Entry
    </a>

    <i class="bi bi-chevron-right"></i>

    <span>Sales Product List</span>

</div>

<!-- Main Card -->
<div class="page-card">

    <!-- Header -->
    <div class="page-card-header">

        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 w-100">

            @using (Html.BeginForm("List",
                "HelpdeskSalesInvoice",
                FormMethod.Get,
                new { id = "searchForm" }))
            {
<div class="search-box">

    <i class="bi bi-search"></i>

    <input type="text"
           id="searchPharse"
           name="searchPharse"
           placeholder="Search"
           autocomplete="off"
           value="@Request["searchPharse"]"
           onkeyup="autoSubmitSearch(this)" />

    @if (!string.IsNullOrEmpty(Request["searchPharse"]))
    {
<a href="@Url.Action("List", "HelpdeskSalesInvoice")"
   title="Clear">
    <i class="bi bi-x-circle text-muted"></i>
</a>}

</div>      }

            @if (!isProcessed)
            {
<a href="@Url.Action("Create", "HelpdeskSalesInvoice", new { SIP_PRECID = Session["SIP_PRECID"] })"
   class="btn-add">

    <i class="bi bi-plus-lg"></i>

    Add Product

</a>        }

        </div>

    </div>

    <!-- Table -->
    <div class="grid-wrap table-responsive">

        @if (Model != null && Model.Any())
        {
<table class="table align-middle mb-0 tickets-table">

    <thead>

        <tr>

            <th class="text-center"
                style="width:60px;">
                S.No
            </th>

            <th>
                Product Name
            </th>

            <th>
                Serial Number
            </th>

            <th class="text-center">
                Warranty Upto
            </th>

            <th class="text-right"
                style="text-align:right;">
                Price (Incl. GST)
            </th>

            <th class="text-center">
                Status
            </th>

            <th class="text-center"
                style="width:100px;">
                Actions
            </th>

        </tr>

    </thead>

    <tbody>

        @foreach (var o in Model)
        {
            var editUrl = Url.Action("Edit", "HelpdeskSalesInvoice", new { Recid = o.SIP_RECID });
            var viewUrl = Url.Action("View", "HelpdeskSalesInvoice", new { Recid = o.SIP_RECID });
            var deleteUrl = Url.Action("Delete", "HelpdeskSalesInvoice", new { Recid = o.SIP_RECID });

            var warrantyDate = string.IsNullOrEmpty(o.SIP_WARRANTYUPTO)
                ? ""
                : Convert.ToDateTime(o.SIP_WARRANTYUPTO).ToString("dd-MM-yyyy");

            var price = o.SIP_PRODUCTAMOUNT == null
                ? "0.00"
                : Convert.ToDecimal(o.SIP_PRODUCTAMOUNT).ToString("N2");

            var badgeClass = o.WARRANTY_TYPE == "Active"
                ? "badge-active"
                : o.WARRANTY_TYPE == "Going to Expire"
                    ? "badge-warning"
                    : "badge-expired";

<tr>

    <td class="text-center">
        <span class="serial-text">@o.SerialNumber</span>
    </td>

    <td>
        <span style="font-weight:600;">@o.ProductName</span>
    </td>

    <td>
        <span class="product-serial">@o.SIP_PRODUCTSERIALNUMBER</span>
    </td>

    <td class="text-center">
        <span class="date-cell">@warrantyDate</span>
    </td>

    <td class="amount-cell">
        @price
    </td>

    <td class="text-center">
        <span class="custom-badge @badgeClass">
            @o.WARRANTY_STATUS
        </span>
    </td>

    <td>

        <div class="action-cell">

            @if (isProcessed)
            {
<a href="@viewUrl"
   title="View"
   class="act-btn act-view">
    <i class='bx bx-show'></i>
</a> }
else
{
<a href="@editUrl"
   title="Edit"
   class="act-btn act-edit">
    <i class='bx bxs-pencil'></i>
</a>

                        <a href="@deleteUrl"
                           data-id="@o.SIP_RECID"
                           data-name="@o.ProductName"
                           title="Delete"
                           class="act-btn act-delete no-loader"
                           onclick="return confirmDelete(this);">
                            <i class='bx bxs-trash'></i>
                        </a>}

        </div>

    </td>

</tr>
}

    </tbody>

</table> <!-- Pagination -->
                <div class="table-pagination">

                    <button id="prevBtn"
                            class="page-btn">
                        <i class="bi bi-chevron-left"></i>
                        Previous
                    </button>

                    <span id="pageInfo"
                          class="page-info">
                    </span>

                    <button id="nextBtn"
                            class="page-btn">
                        Next
                        <i class="bi bi-chevron-right"></i>
                    </button>

                </div> }
            else
            {
<div class="text-center py-5">

    <i class="bi bi-box-seam"
       style="font-size:40px;color:var(--text-muted)"></i>

    <p class="mt-2 text-muted fw-semibold">
        No products available
    </p>


</div>}

    </div>

</div>

<!-- Legend -->
<div class="legend-bar">

    @if (isProcessed)
    {
<div class="legend-item">
    <span class="act-btn act-view"
          style="width:22px;height:22px;font-size:13px">
        <i class='bx bx-show'></i>
    </span>
    View
</div> }
else
{
<div class="legend-item">
    <span class="act-btn act-edit"
          style="width:22px;height:22px;font-size:13px">
        <i class='bx bxs-pencil'></i>
    </span>
    Edit
</div>

                <div class="legend-item">
                    <span class="act-btn act-delete"
                          style="width:22px;height:22px;font-size:13px">
                        <i class='bx bxs-trash'></i>
                    </span>
                    Delete
                </div>}

</div>

@section Scripts {

    <link href='https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css'
          rel='stylesheet'>

    <script src="@Url.Content("~/Scripts/jquery-1.9.1.min.js")"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="~/Scripts/Fordelete.js"></script>

    <script src="~/Scripts/UIPagination.js"></script>

}
