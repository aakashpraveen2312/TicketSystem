@model PSS_CMS.Models.Faq

@{ ViewData["Title"] = "Create FAQ";
                ViewBag.PageTitle = "Create FAQ";
                Layout = "~/Views/Shared/_Layout.cshtml"; }

@section Styles {
    <link href="~/Content/UIListView.css" rel="stylesheet" />

}

<!-- Breadcrumb -->
<div class="page-breadcrumb">
    <i class="bi bi-book nav-icon"></i>
    <i class="bi bi-chevron-right"></i>
    Knowledge Base
    <i class="bi bi-chevron-right"></i>
    <a href="@Url.Action("FAQADMIN","RecentTickets")">FAQ</a>
    <i class="bi bi-chevron-right"></i>
    <span>Create</span>
</div>

<!-- Main Card -->
@using (Html.BeginForm("FAQADMINPOST", "RecentTickets", FormMethod.Post,
    new { id = "myForm", enctype = "multipart/form-data", @class = "no-preloader" }))
{
@Html.AntiForgeryToken()

                <div class="page-card">

                    <!-- Header -->
                    <div class="page-card-header">
                        <h6 class="page-card-title">
                            <span class="title-icon">
                                <i class="bi bi-question-circle"></i>
                            </span>
                            Create FAQ
                        </h6>
                    </div>

                    <!-- Form body -->
                    <div class="form-body">

                        <p class="form-section-title">FAQ Details</p>

                        <!-- Product selector -->
                        <div class="form-group-full">
                            <label class="form-label" for="projectTypeFilter1">
                                Product <span class="req">*</span>
                            </label>

                            @if (ViewBag.Product != null)
                            {
                                var projectTypeList = ViewBag.Product as IEnumerable<SelectListItem>;
                                if (projectTypeList != null && projectTypeList.Any())
                                {
                                    var list = new List<SelectListItem>(projectTypeList);
            @Html.DropDownList("SelectedProjectType1", list, "Select Product",
                     new { @class = "form-select-input", id = "projectTypeFilter1" }) }
                                else
                                {
            @Html.DropDownList("SelectedProjectType1",
                     new List<SelectListItem>(), "No products available",
                     new { @class = "form-select-input", id = "projectTypeFilter1" }) }
                            }
                            else
                            {
            <p style="font-size:12px;color:var(--text-muted);">No products available</p>                }
                        </div>

                        <!-- Question -->
                        <div class="form-group-full">
                            <label class="form-label" for="F_QUESTION">
                                Question
                                <span class="req">*</span>
                            </label>
                            @Html.TextBoxFor(m => m.F_QUESTION, new
                            {
                                @class = "form-input-text",
                                tabindex = "1",
                                placeholder = "Enter the question"
                            })
                            @Html.ValidationMessageFor(m => m.F_QUESTION, "", new { @class = "text-danger", style = "font-size:11px" })
                        </div>

                        <!-- Answer -->
                        <div class="form-group-full">
                            <label class="form-label" for="F_ANSWER">
                               Answer
                                <span class="req">*</span>
                            </label>
                            @Html.TextAreaFor(m => m.F_ANSWER, new
                            {
                                @class = "form-textarea",
                                placeholder = "Please enter your answer here…",
                                rows = "8",
                                tabindex = "2"
                            })
                            @Html.ValidationMessageFor(m => m.F_ANSWER, "", new { @class = "text-danger", style = "font-size:11px" })
                        </div>

                        <div class="form-divider"></div>
                        <p class="form-section-title">Attachment</p>

                        <!-- File upload -->
                        <div class="file-upload-wrap" id="fileDropArea">
                            <div class="file-upload-icon">
                                <i class="bi bi-paperclip"></i>
                            </div>
                            <div class="file-upload-text">
                                <span id="fileLabel">No file chosen</span>
                                <small>Accepted: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv</small>
                            </div>
                            <label class="btn-browse" for="myfile">
                                <i class="bi bi-folder2-open"></i> Browse
                            </label>
                            <input type="file"
                                   id="myfile"
                                   name="myfile"
                                   class="file-input-hidden"
                                   tabindex="3"
                                   accept=".pdf,.xlsx,.jpeg,.png,.jpg,.docx,.csv"
                                   onchange="handleFileChange(this)" />
                        </div>
                        <p class="file-error" id="fileError">
                            This file format is not supported. Accepted: .pdf, .xlsx, .jpeg, .png, .jpg, .docx, .csv
                        </p>

                    </div>

                    <!-- Legend bar -->
                    <div class="legend-bar">
                        <div class="legend-item">
                            <span style="display:inline-block;width:12px;height:12px;border-radius:3px;background:var(--primary);flex-shrink:0;"></span>
                            <span>Text Field</span>
                        </div>
                        <div class="legend-item">
                            <i class="bi bi-paperclip" style="color:var(--primary);font-size:13px;"></i>
                            <span>Attachment</span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="form-actions">
                        <a href="@Url.Action("FAQADMIN","RecentTickets")"
                           class="btn-cancel">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                        <button type="submit"
                                class="btn-save"
                                id="submitBtn"
                                tabindex="4">
                            <i class="bi bi-floppy"></i> Submit
                        </button>
                    </div>

                </div>}

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/Formatcheck.js"></script>

    <script>

        /* ── File picker label update ────────────── */
        function handleFileChange(input) {
            var allowed = ['.pdf', '.xlsx', '.jpeg', '.png', '.jpg', '.docx', '.csv'];
            var errorEl = document.getElementById('fileError');
            var labelEl = document.getElementById('fileLabel');

            if (input.files && input.files[0]) {
                var name = input.files[0].name;
                var ext  = name.substring(name.lastIndexOf('.')).toLowerCase();

                if (allowed.indexOf(ext) === -1) {
                    errorEl.style.display = 'block';
                    labelEl.textContent   = 'Invalid file — please choose another';
                    input.value           = '';
                } else {
                    errorEl.style.display = 'none';
                    labelEl.textContent   = name;
                }
            }
        }

        /* ── AJAX submit — processing spinner shows FIRST ── */
        $(document).ready(function () {

            $("#myForm").submit(function (e) {
                e.preventDefault();

                var btn      = $("#submitBtn");
                var formData = new FormData(this);

                btn.prop("disabled", true);

                Swal.fire({
                    title: "Processing…",
                    html: "Please wait while we save your changes.",
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: function () {
                        Swal.showLoading();

                        $.ajax({
                            url: '@Url.Action("FAQADMINPOST","RecentTickets")',
                            type: "POST",
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                if (response.success) {
                                    setTimeout(function () {
                                        Swal.fire({
                                            title: "Success!",
                                            text: response.message,
                                            icon: "success",
                                            showCancelButton: true,
                                            confirmButtonText: "Continue",
                                            cancelButtonText: "Back to FAQ",
                                            allowOutsideClick: false,
                                            allowEscapeKey: false,
                                            customClass: {
                                                confirmButton: "swal-btn-continue",
                                                cancelButton:  "swal-btn-back"
                                            }
                                        }).then(function (result) {
                                            if (result.isConfirmed) {
                                                location.reload();
                                            } else {
                                                window.location.href = '@Url.Action("FAQADMIN","RecentTickets")';
                                            }
                                        });
                                    }, 800);
                                } else {
                                    Swal.fire({
                                        title: "Message",
                                        text: response.message,
                                        icon: "info",
                                        allowOutsideClick: false,
                                        allowEscapeKey: false
                                    });
                                    resetButton();
                                }
                            },
                            error: function () {
                                Swal.fire({
                                    title: "Error!",
                                    text: "An unexpected error occurred.",
                                    icon: "error",
                                    allowOutsideClick: false,
                                    allowEscapeKey: false
                                });
                                resetButton();
                            }
                        });
                    }
                });
            });

            function resetButton() {
                $("#submitBtn").prop("disabled", false);
            }
        });
    </script>
}
