@* Manager Calendar Dashboard — ManagerCalender.cshtml *@
@{ ViewBag.PageTitle = "Calendar";
    ViewBag.PageSubtitle = "Ticket schedule & assignment overview"; }

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        /* ══════════════════════════════════════
           VARIABLES  (same as ticket dashboard)
        ══════════════════════════════════════ */
        :root {
            --purple: #6c5ce7;
            --purple-soft: #eeeaff;
            --purple-mid: #a29bfe;
            --amber: #f39c12;
            --amber-soft: #fff3dc;
            --green: #00b894;
            --green-soft: #d8f5ed;
            --blue: #0984e3;
            --blue-soft: #dfe6f7;
            --red: #e17055;
            --red-soft: #fde8e4;
            --slate: #636e72;
            --slate-soft: #f1f3f5;
            --bg: #f4f5f9;
            --surface: #ffffff;
            --border: #e8eaed;
            --text: #1a1d23;
            --text-2: #6b7280;
            --text-3: #9ca3af;
            --shadow: 0 1px 4px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.04);
            --shadow-md: 0 4px 18px rgba(0,0,0,.09);
            --r: 12px;
        }

        body {
            background: var(--bg) !important;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        .db-wrap {
            background: var(--bg);
            padding: 20px 22px 32px;
        }

        /* ── page header ── */
        .db-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 18px;
        }

            .db-header h2 {
                font-size: 20px;
                font-weight: 800;
                color: var(--text);
                margin: 0;
            }

            .db-header p {
                font-size: 12px;
                color: var(--text-3);
                margin: 3px 0 0;
            }

        .db-date-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 7px 13px;
            font-size: 12px;
            font-weight: 600;
            color: var(--text);
            box-shadow: var(--shadow);
        }

            .db-date-pill i {
                color: var(--purple);
            }

        /* ── section label ── */
        .db-sec {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.1px;
            color: var(--text-3);
            margin: 16px 0 10px;
        }

        /* ══════════════════════════════════════
           HERO CARDS  — 4 col (same as ticket)
        ══════════════════════════════════════ */
        .hero-row {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 13px;
        }

        @@media (max-width: 1100px) {
            .hero-row {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width:  580px) {
            .hero-row {
                grid-template-columns: 1fr;
            }
        }

        .hero-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 15px 17px 0 17px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            transition: box-shadow .2s, transform .18s;
            cursor: pointer;
            min-height: 102px;
        }

            .hero-card:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
            }

            .hero-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                border-radius: var(--r) var(--r) 0 0;
            }

        .hc-purple::before {
            background: var(--purple);
        }

        .hc-amber::before {
            background: var(--amber);
        }

        .hc-blue::before {
            background: var(--blue);
        }

        .hc-red::before {
            background: var(--red);
        }

        .hc-green::before {
            background: var(--green);
        }

        .hc-slate::before {
            background: var(--slate);
        }

        .hc-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 5px;
        }

        .hc-label {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-2);
        }

        .hc-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

        .hi-purple {
            background: var(--purple-soft);
            color: var(--purple);
        }

        .hi-amber {
            background: var(--amber-soft);
            color: var(--amber);
        }

        .hi-blue {
            background: var(--blue-soft);
            color: var(--blue);
        }

        .hi-red {
            background: var(--red-soft);
            color: var(--red);
        }

        .hi-green {
            background: var(--green-soft);
            color: var(--green);
        }

        .hi-slate {
            background: var(--slate-soft);
            color: var(--slate);
        }

        .hc-value {
            font-size: 32px;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
            letter-spacing: -1.2px;
        }

        .hc-sub {
            font-size: 11px;
            color: var(--text-3);
            margin-top: 2px;
            margin-bottom: 6px;
        }

        .hc-spark {
            display: block;
            width: 100%;
            height: 42px;
        }

        /* open sub-badges (same as ticket dash) */
        .hc-open-subs {
            display: flex;
            gap: 5px;
            margin-top: 8px;
            margin-bottom: 10px;
        }

        .hc-open-sub {
            flex: 1;
            text-align: center;
            border-radius: 7px;
            padding: 5px 3px;
            cursor: pointer;
            transition: background .15s;
        }

            .hc-open-sub:hover {
                background: #fff8ee;
            }

        .hc-open-sub-lbl {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
            color: var(--text-3);
        }

        .hc-open-sub-val {
            font-size: 16px;
            font-weight: 800;
            line-height: 1.2;
        }

        .sv-current {
            color: var(--text);
        }

        .sv-week {
            color: var(--purple);
        }

        .sv-month {
            color: var(--red);
        }

        /* animated counter */
        .anim-num {
            display: inline-block;
        }

        /* ══════════════════════════════════════
           ASSIGNMENT PILLS (same as ticket dash)
        ══════════════════════════════════════ */
        .pill-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px;
        }

        @@media (max-width: 580px) {
            .pill-row {
                grid-template-columns: 1fr;
            }
        }

        .mini-pill {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 14px 17px 0 17px;
            display: flex;
            align-items: center;
            gap: 13px;
            box-shadow: var(--shadow);
            position: relative;
            overflow: hidden;
            transition: box-shadow .2s, transform .18s;
            min-height: 78px;
        }

            .mini-pill:hover {
                box-shadow: var(--shadow-md);
                transform: translateY(-2px);
            }

        .pill-blue {
            background: #f0f7ff;
            border-color: #c6dff7;
        }

        .pill-amber {
            background: #fffbf0;
            border-color: #fde8b4;
        }

        .pill-spark {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
            height: 50px;
        }

        .mp-icon {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
            position: relative;
            z-index: 1;
        }

        .mp-text {
            position: relative;
            z-index: 1;
            margin-bottom: 12px;
        }

        .mp-lbl {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--text-2);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .mp-val {
            font-size: 26px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.1;
        }

        /* ══════════════════════════════════════
           MAIN LAYOUT: calendar + sidebar
        ══════════════════════════════════════ */
        .cal-layout {
            display: grid;
            grid-template-columns: 1fr 310px;
            gap: 13px;
            align-items: start;
        }

        @@media (max-width:1060px) {
            .cal-layout {
                grid-template-columns: 1fr;
            }
        }

        /* ══════════════════════════════════════
           CALENDAR CARD
        ══════════════════════════════════════ */
        .cal-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .cal-nav-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 13px 17px;
            border-bottom: 1px solid var(--border);
        }

        .cal-nav-left {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .cal-nav-btn {
            height: 31px;
            min-width: 31px;
            padding: 0 8px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: var(--surface);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            color: var(--text-2);
            cursor: pointer;
            transition: background .15s, color .15s, border-color .15s;
            font-family: inherit;
            font-weight: 700;
        }

            .cal-nav-btn:hover {
                background: var(--purple-soft);
                color: var(--purple);
                border-color: var(--purple-soft);
            }

        .cal-title {
            font-size: 15px;
            font-weight: 800;
            color: var(--text);
            min-width: 155px;
            text-align: center;
        }

        /* DOW header */
        .cal-dow-row {
            display: grid;
            grid-template-columns: repeat(7,1fr);
            background: #fafbfc;
            border-bottom: 1px solid var(--border);
        }

        .cal-dow {
            padding: 8px 0;
            text-align: center;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .7px;
            color: var(--text-3);
        }

            .cal-dow.sun, .cal-dow.sat {
                color: var(--red);
            }

        /* grid */
        .cal-grid {
            display: grid;
            grid-template-columns: repeat(7,1fr);
        }

        .cal-cell {
            min-height: 80px;
            padding: 7px 8px 5px;
            border-right: 1px solid #f0f1f3;
            border-bottom: 1px solid #f0f1f3;
            position: relative;
            cursor: pointer;
            transition: background .12s;
        }

            .cal-cell:nth-child(7n) {
                border-right: none;
            }

            .cal-cell:nth-last-child(-n+7) {
                border-bottom: none;
            }

            .cal-cell:hover {
                background: #f8f7ff;
            }

            .cal-cell.other {
                opacity: .25;
                pointer-events: none;
            }

            .cal-cell.today {
                background: var(--purple-soft);
            }

            .cal-cell.selected {
                background: var(--purple);
            }

                .cal-cell.selected:hover {
                    background: #5a4cd6;
                }

                .cal-cell.selected .c-date {
                    color: #fff;
                }

                .cal-cell.selected .c-dot {
                    background: rgba(255,255,255,.65) !important;
                }

                .cal-cell.selected .c-count {
                    background: rgba(255,255,255,.2);
                    color: #fff;
                }

        .c-date-wrap {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 4px;
        }

        .c-date {
            font-size: 12px;
            font-weight: 700;
            color: var(--text);
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cal-cell.today .c-date {
            background: var(--purple);
            color: #fff;
        }

        .cal-cell.weekend:not(.today):not(.selected) .c-date {
            color: var(--red);
        }

        .c-count {
            position: absolute;
            top: 5px;
            right: 5px;
            background: var(--purple);
            color: #fff;
            font-size: 8.5px;
            font-weight: 800;
            padding: 1px 5px;
            border-radius: 20px;
            line-height: 1.5;
        }

        .c-dots {
            display: flex;
            flex-wrap: wrap;
            gap: 3px;
        }

        .c-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .d-open {
            background: var(--amber);
        }

        .d-assigned {
            background: var(--blue);
        }

        .d-resolved {
            background: var(--green);
        }

        .d-overdue {
            background: var(--red);
        }

        /* legend */
        .cal-legend {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
            padding: 9px 17px 11px;
            border-top: 1px solid var(--border);
            background: #fafbfc;
        }

        .leg-item {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: var(--text-2);
            font-weight: 600;
        }

        .leg-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        /* ══════════════════════════════════════
           RIGHT SIDEBAR
        ══════════════════════════════════════ */
        .sidebar-col {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .panel-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 11px 14px 10px;
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

        .panel-badge {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 20px;
        }

        .pb-purple {
            background: var(--purple-soft);
            color: var(--purple);
        }

        .pb-amber {
            background: var(--amber-soft);
            color: var(--amber);
        }

        .pb-green {
            background: var(--green-soft);
            color: var(--green);
        }

        .pb-red {
            background: var(--red-soft);
            color: var(--red);
        }

        /* selected day header */
        .day-detail-header {
            padding: 13px 15px 10px;
            background: linear-gradient(135deg,var(--purple) 0%,var(--purple-mid) 100%);
        }

        .day-detail-date {
            font-size: 10px;
            font-weight: 700;
            color: rgba(255,255,255,.75);
            text-transform: uppercase;
            letter-spacing: .7px;
        }

        .day-detail-num {
            font-size: 40px;
            font-weight: 800;
            color: #fff;
            line-height: 1;
            letter-spacing: -2px;
            margin: 2px 0 0;
        }

        .day-detail-day {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255,255,255,.8);
            margin-top: 1px;
        }

        .day-stat-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid var(--border);
        }

        .day-stat {
            background: var(--surface);
            padding: 9px 10px;
            text-align: center;
            border-right: 1px solid var(--border);
        }

            .day-stat:nth-child(even) {
                border-right: none;
            }

            .day-stat:nth-child(3), .day-stat:nth-child(4) {
                border-top: 1px solid var(--border);
            }

        .day-stat-val {
            font-size: 20px;
            font-weight: 800;
            line-height: 1;
        }

        .day-stat-lbl {
            font-size: 9px;
            font-weight: 700;
            color: var(--text-3);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-top: 2px;
        }

        /* ticket list */
        .ticket-list {
            max-height: 230px;
            overflow-y: auto;
        }

            .ticket-list::-webkit-scrollbar {
                width: 3px;
            }

            .ticket-list::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 4px;
            }

        .ticket-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 13px;
            border-bottom: 1px solid #f4f5f7;
            cursor: pointer;
            transition: background .12s;
        }

            .ticket-item:last-child {
                border-bottom: none;
            }

            .ticket-item:hover {
                background: var(--bg);
            }

        .ti-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .ti-body {
            flex: 1;
            min-width: 0;
        }

        .ti-id {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-3);
        }

        .ti-title {
            font-size: 12px;
            font-weight: 600;
            color: var(--text);
            line-height: 1.3;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ti-meta {
            font-size: 11px;
            color: var(--text-3);
            margin-top: 1px;
        }

        .ti-badge {
            flex-shrink: 0;
            font-size: 9px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 20px;
        }

        .tib-open {
            background: var(--amber-soft);
            color: var(--amber);
        }

        .tib-assigned {
            background: var(--blue-soft);
            color: var(--blue);
        }

        .tib-resolved {
            background: var(--green-soft);
            color: var(--green);
        }

        .tib-overdue {
            background: var(--red-soft);
            color: var(--red);
        }

        /* empty state */
        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 24px 12px;
            color: var(--text-3);
        }

            .empty-state i {
                font-size: 28px;
                opacity: .35;
                margin-bottom: 7px;
            }

            .empty-state p {
                font-size: 11.5px;
                text-align: center;
                line-height: 1.5;
            }

        /* upcoming timeline */
        .tl-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 13px;
            border-bottom: 1px solid #f4f5f7;
            transition: background .12s;
        }

            .tl-item:last-child {
                border-bottom: none;
            }

            .tl-item:hover {
                background: var(--bg);
            }

        .tl-date-box {
            flex-shrink: 0;
            width: 36px;
            text-align: center;
            background: var(--bg);
            border-radius: 7px;
            padding: 4px 2px;
        }

        .tl-day {
            font-size: 15px;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
        }

        .tl-mon {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--text-3);
            letter-spacing: .4px;
        }

        .tl-body {
            flex: 1;
            min-width: 0;
        }

        .tl-title {
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .tl-meta {
            font-size: 10.5px;
            color: var(--text-3);
            margin-top: 2px;
        }

        /* engineer workload */
        .eng-item {
            padding: 9px 13px;
            border-bottom: 1px solid #f4f5f7;
        }

            .eng-item:last-child {
                border-bottom: none;
            }

        .eng-top {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 5px;
        }

        .eng-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 800;
            color: #fff;
            flex-shrink: 0;
        }

        .eng-name {
            font-size: 12px;
            font-weight: 700;
            color: var(--text);
            flex: 1;
        }

        .eng-count {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-2);
        }

        .eng-bar-bg {
            height: 5px;
            background: var(--bg);
            border-radius: 10px;
            overflow: hidden;
        }

        .eng-bar-fill {
            height: 100%;
            border-radius: 10px;
            transition: width .7s cubic-bezier(.4,0,.2,1);
        }

        /* summary stats row (below hero) */
        .summary-row {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 13px;
        }

        @@media (max-width: 760px) {
            .summary-row {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 480px) {
            .summary-row {
                grid-template-columns: 1fr;
            }
        }

        .sum-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--r);
            padding: 13px 15px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sum-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .sum-val {
            font-size: 22px;
            font-weight: 800;
            color: var(--text);
            line-height: 1;
        }

        .sum-lbl {
            font-size: 11px;
            color: var(--text-3);
            margin-top: 1px;
        }
    </style>
}

@{ int totalTickets = (ViewBag.TotalTickets != null) ? (int)ViewBag.TotalTickets : 0;
                int openTickets = (ViewBag.OpenTickets != null) ? (int)ViewBag.OpenTickets : 0;
                int closedTickets = (ViewBag.ClosedTickets != null) ? (int)ViewBag.ClosedTickets : 0;
                int resolvedTickets = (ViewBag.ResolvedTickets != null) ? (int)ViewBag.ResolvedTickets : 0;
                int assignedTickets = (ViewBag.AssignedTickets != null) ? (int)ViewBag.AssignedTickets : 0;
                int unassigned = (ViewBag.UnassignedCount != null) ? (int)ViewBag.UnassignedCount : 0;
                int overdueTickets = (ViewBag.OverdueTickets != null) ? (int)ViewBag.OverdueTickets : 0;
                int openCurrentDay = (ViewBag.OpenCurrentDay != null) ? (int)ViewBag.OpenCurrentDay : 0;
